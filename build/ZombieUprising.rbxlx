      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">MathUtil</string>
          <string name="Source"><![CDATA[--!strict
-- Small shared math helpers.

local MathUtil = {}
export type SpreadRand = (number, number) -> number

function MathUtil.Clamp(v: number, lo: number, hi: number): number
	if v < lo then return lo end
	if v > hi then return hi end
	return v
end

function MathUtil.Lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function MathUtil.Round(v: number): number
	return math.floor(v + 0.5)
end

-- Spread a ray direction by up to `degrees` for weapon cone fire.
--
-- NOTE: deliberately not `--!strict`-analyzable in isolation because luau-analyze
-- has no Vector3 operator overloads; every Vector3 here is cast to `any` for the
-- arithmetic only, then cast back. The unit-testable scalar math above is typed.
function MathUtil.ApplySpread(dir: Vector3, degrees: number, rand: SpreadRand): Vector3
	if degrees <= 0 then
		return dir
	end
	local rad = math.rad(degrees)
	local up: Vector3 = if math.abs(dir.Y) > 0.99 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
	local right: Vector3 = (dir:Cross(up)).Unit
	local localUp: Vector3 = (right:Cross(dir)).Unit

	local a = rand(-rad, rad)
	local b = rand(-rad, rad)

	local sa = math.sin(a)
	local sb = math.sin(b)

	-- Component access is done through `any` views purely because the offline
	-- analyzer cannot resolve Vector3 members. All values are real Vector3s.
	local rv: any = right
	local uv: any = localUp
	local dv: any = dir

	local ox = rv.X * sa + uv.X * sb
	local oy = rv.Y * sa + uv.Y * sb
	local oz = rv.Z * sa + uv.Z * sb

	local nx: number = dv.X + ox
	local ny: number = dv.Y + oy
	local nz: number = dv.Z + oz
	local mag = math.sqrt(nx * nx + ny * ny + nz * nz)
	if mag <= 0 then
		return dir
	end
	return Vector3.new(nx / mag, ny / mag, nz / mag)
end

return MathUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">RNG</string>
          <string name="Source"><![CDATA[--!strict
-- Deterministic PRNG so procedural map geometry is identical on every build
-- and identical across server/client when needed.

local RNG = {}
RNG.__index = RNG

export type Random = typeof(setmetatable({} :: { _seed: number }, RNG))

function RNG.new(seed: number): Random
	local self = {}
	self._seed = (math.floor(seed) % 2147483647)
	if self._seed <= 0 then
		self._seed = self._seed + 2147483646
	end
	return setmetatable(self, RNG)
end

function RNG.Next(self: Random): number
	-- Park-Miller minimal standard
	self._seed = (self._seed * 16807) % 2147483647
	return self._seed / 2147483647
end

function RNG.Range(self: Random, min: number, max: number): number
	return min + self.Next(self) * (max - min)
end

function RNG.Int(self: Random, min: number, max: number): number
	return math.floor(self.Range(self, min, max + 1))
end

function RNG.Pick(self: Random, list: { any }): any
	if #list == 0 then
		return nil
	end
	return list[self.Int(self, 1, #list)]
end

-- Weighted pick. entries: array of { weight = number, value = any }
function RNG.Weighted(self: Random, entries: { { weight: number, value: any } }): any
	local total = 0
	for _, e in ipairs(entries) do
		total += (e.weight :: number) or 0
	end
	if total <= 0 then
		return nil
	end
	local roll = self.Next(self) * total
	local acc = 0
	for _, e in ipairs(entries) do
		acc += (e.weight :: number) or 0
		if roll <= acc then
			return e.value
		end
	end
	return entries[#entries].value
end

return RNG
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Single source of truth for client<->server networking.
-- All RemoteEvents/RemoteFunctions live under ReplicatedStorage.Remotes,
-- created by this module on the server once at boot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local folderName = "Remotes"

local function ensureFolder(): Folder
	local f = ReplicatedStorage:FindFirstChild(folderName)
	if f and f:IsA("Folder") then
		return f
	end
	f = Instance.new("Folder")
	f.Name = folderName
	f.Parent = ReplicatedStorage
	return f
end

export type RemoteMap = {
	-- Client -> Server
	RequestFire: RemoteEvent,
	RequestReload: RemoteEvent,
	RequestPurchaseWeapon: RemoteEvent,
	RequestPurchasePerk: RemoteEvent,
	RequestRespawn: RemoteEvent,
	RequestOpenDoor: RemoteEvent,
	RequestMachine: RemoteEvent,
	RequestSwitchWeapon: RemoteEvent,

	-- Server -> Client
	WeaponStateChanged: RemoteEvent,
	PlayerStatsChanged: RemoteEvent,
	WaveStateChanged: RemoteEvent,
	DamageDealt: RemoteEvent,       -- for hit markers / floating numbers
	ZombieDamagedPlayer: RemoteEvent,
	ShopStateChanged: RemoteEvent,
	Notify: RemoteEvent,
	RunEnded: RemoteEvent,
}

local cache: { [string]: RemoteEvent } = {}

local function get(name: string): RemoteEvent
	local c = cache[name]
	if c then
		return c
	end
	local folder = ensureFolder()
	local existing = folder:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		cache[name] = existing
		return existing
	end
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = folder
	cache[name] = r
	return r
end

-- Lazily resolved accessors. Used by both client and server code so a missing
-- remote can never nil-index at runtime.
function Remotes.RequestFire(): RemoteEvent return get("RequestFire") end
function Remotes.RequestReload(): RemoteEvent return get("RequestReload") end
function Remotes.RequestPurchaseWeapon(): RemoteEvent return get("RequestPurchaseWeapon") end
function Remotes.RequestPurchasePerk(): RemoteEvent return get("RequestPurchasePerk") end
function Remotes.RequestRespawn(): RemoteEvent return get("RequestRespawn") end
function Remotes.RequestOpenDoor(): RemoteEvent return get("RequestOpenDoor") end
function Remotes.RequestMachine(): RemoteEvent return get("RequestMachine") end
function Remotes.RequestSwitchWeapon(): RemoteEvent return get("RequestSwitchWeapon") end

function Remotes.WeaponStateChanged(): RemoteEvent return get("WeaponStateChanged") end
function Remotes.PlayerStatsChanged(): RemoteEvent return get("PlayerStatsChanged") end
function Remotes.WaveStateChanged(): RemoteEvent return get("WaveStateChanged") end
function Remotes.DamageDealt(): RemoteEvent return get("DamageDealt") end
function Remotes.ZombieDamagedPlayer(): RemoteEvent return get("ZombieDamagedPlayer") end
function Remotes.ShopStateChanged(): RemoteEvent return get("ShopStateChanged") end
function Remotes.Notify(): RemoteEvent return get("Notify") end
function Remotes.RunEnded(): RemoteEvent return get("RunEnded") end

-- Server-only prewarm; safe to call repeatedly.
function Remotes.InitServer()
	for _, n in ipairs({
		"RequestFire", "RequestReload", "RequestPurchaseWeapon", "RequestPurchasePerk", "RequestRespawn",
		"RequestOpenDoor",
		"RequestMachine",
		"RequestSwitchWeapon",
		"WeaponStateChanged", "PlayerStatsChanged", "WaveStateChanged", "DamageDealt",
		"ZombieDamagedPlayer", "ShopStateChanged", "Notify", "RunEnded",
	}) do
		get(n)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared data shapes exchanged between systems and across the network.
-- Kept dependency-free so every system can require it.

local Types = {}

export type WavePhase = "Intermission" | "Active" | "Ended"

export type WaveState = {
	Wave: number,
	Phase: WavePhase,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

export type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

export type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

export type PerkStacks = { [string]: number }

export type RunState = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: PerkStacks,
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
}

-- Modifiers derived from perk stacks; computed by Progression, consumed by
-- Weapons and the player controller.
export type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

export type PurchaseResult = {
	Ok: boolean,
	Reason: string?,
}

function Types.NewStatModifiers(): StatModifiers
	return {
		DamageMult = 1,
		FireRateMult = 1,
		ReloadMult = 1,
		MagazineMult = 1,
		MoveSpeedFlat = 0,
		MaxHealthFlat = 0,
		LifestealPct = 0,
		CoinMult = 1,
	}
end

return Types
]]></string>
        </Properties>
      </Item>
