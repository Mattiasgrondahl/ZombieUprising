local function ensureGui(): ScreenGui
	if gui then
		return gui
	end

	local existing = playerGui:FindFirstChild("ZombieHUD")
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "ZombieHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	screen = gui

	local vign = buildVignette()
	vign.Parent = gui
	vignette = vign

	local flash = buildMuzzleFlash()
	flash.Parent = gui
	muzzleFlash = flash

	local health = buildHealth()
	health.Parent = gui

	local wave = buildWave()
	wave.Parent = gui

	local stats = buildStats()
	stats.Parent = gui

	local ammoRoot = buildAmmo()
	ammoRoot.Parent = gui

	local cross = buildCrosshair()
	cross.Parent = gui
	crosshair = cross

	local dmgs = buildDamageNumbers()
	dmgs.Parent = gui
	damageNumbersFrame = dmgs

	local notifs = buildNotifications()
	notifs.Parent = gui
	notificationsFrame = notifs

	local banner = buildIntermissionBanner()
	banner.Parent = gui

	local over = buildGameOver()
	over.Parent = gui
	gameOverPanel = over

	return gui
end

-- Setters -------------------------------------------------------------------

function HUD.SetHealth(health: number, maxHealth: number)
	if not healthFill then return end
	local frac: number = clamp01(health / math.max(1, maxHealth))
	healthFill.Size = UDim2.new(frac, 0, 1, 0)
	if healthText then
		healthText.Text = string.format("%d / %d", math.floor(health), math.floor(maxHealth))
	end
	-- Colour-shift toward red as health drops.
	local r: number = lerp(0.35, 0.89, 1 - frac)
	local g: number = lerp(0.82, 0.31, 1 - frac)
	healthFill.BackgroundColor3 = Color3.new(r, g, 0.5)
end

function HUD.SetAmmo(state: WeaponState?)
	if not state then return end
	if weaponText then
		local defs: any = Config.Weapons
		local def: WeaponDef? = defs[state.WeaponId]
		weaponText.Text = if def then def.DisplayName else state.WeaponId
	end
	if ammoText then
		ammoText.Text = string.format("%d / %d", state.AmmoInMag, state.AmmoReserve)
		if state.AmmoInMag <= 0 then
			ammoText.TextColor3 = COL_BAD
		else
			ammoText.TextColor3 = COL_TEXT
		end
	end
	if reloadFrame and reloadFill then
		reloadFrame.Visible = state.Reloading
		if state.Reloading then
			local frac: number = 0
			local endsAt: number? = state.ReloadEndsAt
			local t: number = now()
			if endsAt then
				local total: number = 1.5
				local remaining: number = math.max(0, endsAt - t)
				frac = clamp01(1 - remaining / total)
			end
			reloadFill.Size = UDim2.new(frac, 0, 1, 0)
		end
	end
end

function HUD.SetWave(state: WaveState?)
	if not state then return end
	if waveText then
		waveText.Text = string.format("WAVE %d", state.Wave)
	end
	if zombiesText then
		if state.Phase == "Active" then
			zombiesText.Text = string.format("Zombies %d / %d", state.ZombiesRemaining, state.ZombiesTotal)
			zombiesText.TextColor3 = COL_TEXT
		else
			zombiesText.Text = string.format("Killed %d", state.ZombiesTotal)
			zombiesText.TextColor3 = COL_DIM
		end
	end
	if timerText then
		local secs: number = math.max(0, state.TimeRemaining)
		if state.Phase == "Intermission" then
			timerText.Text = string.format("Next wave in %ds", math.ceil(secs))
			timerText.TextColor3 = COL_WARN
		elseif state.Phase == "Active" then
			timerText.Text = wavePhaseName(state.Phase)
			timerText.TextColor3 = COL_GOOD
		else
			timerText.Text = wavePhaseName(state.Phase)
			timerText.TextColor3 = COL_BAD
		end
	end
	HUD.ShowBanner(wavePhaseName(state.Phase) .. " - " .. string.format("WAVE %d", state.Wave), 1.6)
end

function HUD.SetStats(stats: PlayerStats?)
	if not stats then return end
	cachedStats = stats
	if coinsText then
		coinsText.Text = string.format("Coins %d", stats.Coins)
	end
	if killsText then
		killsText.Text = string.format("Kills %d", stats.Kills)
	end
	if xpText then
		xpText.Text = string.format("Level %d  •  %d XP", stats.Level, stats.XP)
	end
	if xpFill then
		-- XP curve mirrors Config.Economy so the bar shows progress to next level.
		local base: number = 100
		local growth: number = 1.35
		local need: number = base * math.pow(growth, math.max(0, stats.Level - 1))
		local frac: number = clamp01(stats.XP / math.max(1, need))
		xpFill.Size = UDim2.new(frac, 0, 1, 0)
	end
	HUD.SetHealth(stats.Health, stats.MaxHealth)
	if not gameOverPanel.Visible then
		HUD.SetGameOverVisible(false)
	end
end

function HUD.GetCachedStats(): PlayerStats?
	return cachedStats
end

function HUD.SetCrosshairSpread(spread: number)
	crosshairSpread = spread
	spreadDecayAt = now() + 0.12
end

function HUD.PulseCrosshair(spread: number)
	HUD.SetCrosshairSpread(spread)
	crosshairUntilSpread = now() + 0.08
end

function HUD.ShowHitmarker(killed: boolean?)
	if not hitmarker then return end
	hitmarker.Visible = true
	hitmarkerUntil = now() + (if killed then 0.22 else 0.12)
	if killed then
		local ticks: any = hitmarker:GetChildren()
		for _, t in ipairs(ticks) do
			t.BackgroundColor3 = COL_BAD
		end
	else
		local ticks2: any = hitmarker:GetChildren()
		for _, t in ipairs(ticks2) do
			t.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		end
	end
end

function HUD.ShowMuzzleFlash()
	if not muzzleFlash then return end
	muzzleFlash.Visible = true
	flashUntil = now() + 0.06
	muzzleFlash.BackgroundTransparency = 0.1
end

function HUD.FlashDamage(intensity: number?)
	local amount: number = intensity or 1
	vignetteLevel = clamp01(vignetteLevel + amount)
	if vignette then
		vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
	end
end

function HUD.ShowBanner(text: string, duration: number?)
	if not bannerText then return end
	bannerText.Text = text
	bannerText.TextTransparency = 0
	bannerText.TextStrokeTransparency = 0.6
	local dur: number = duration or 2
	task.delay(dur, function()
		if bannerText then
			bannerText.TextTransparency = 1
		end
	end)
end

function HUD.Notify(text: string, kind: string?)
	if not notificationsFrame then return end
	if not text or text == "" then return end

	local label = newTextLabel("Toast")
	label.Size = UDim2.new(0, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Text = text
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.BackgroundTransparency = 1
	label.TextStrokeTransparency = 0.5
	label.LayoutOrder = math.floor(now() * 100)
	label.Parent = notificationsFrame

	if kind == "kill" then
		label.TextColor3 = COL_GOOD
	elseif kind == "hit" then
		label.TextColor3 = COL_TEXT
	elseif kind == "warn" then
		label.TextColor3 = COL_WARN
	elseif kind == "bad" then
		label.TextColor3 = COL_BAD
	elseif kind == "coin" then
		label.TextColor3 = COL_ACCENT
	else
		label.TextColor3 = COL_TEXT
	end

	table.insert(toasts, { Label = label, ExpiresAt = now() + TOAST_LIFE })

	while #toasts > MAX_TOASTS do
		local oldest: Toast? = table.remove(toasts, 1)
		if oldest then
			oldest.Label:Destroy()
		end
	end
end

-- Optional floating number above a world position (uses Camera projection if
-- the camera is available; otherwise it is pinned near the crosshair).
function HUD.ShowDamageNumber(amount: number, worldPos: Vector3?, killed: boolean?)
	if not damageNumbersFrame then return end
	if #activeDamageNumbers >= MAX_DAMAGE_NUMBERS then
		local oldest: any = table.remove(activeDamageNumbers, 1)
		if oldest and oldest.Label then
			oldest.Label:Destroy()
		end
	end

	local label = newTextLabel("Dmg")
	label.Size = UDim2.new(0, 80, 0, 24)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.new(0.5, 0, 0.42, 0)
	label.Text = string.format("%d", math.floor(amount))
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextStrokeTransparency = 0.4
	label.BackgroundTransparency = 1
	label.ZIndex = 6
	if killed then
		label.TextColor3 = COL_BAD
		label.TextSize = 22
	else
		label.TextColor3 = Color3.fromRGB(255, 240, 210)
	end
	label.Parent = damageNumbersFrame

	local entry: any = {
		Label = label,
		ExpiresAt = now() + DAMAGE_NUMBER_LIFE,
		Origin = worldPos,
		Any = nil,
	}
	table.insert(activeDamageNumbers, entry)
end

function HUD.SetGameOverVisible(visible: boolean, data: any?)
	if not gameOverPanel then return end
	gameOverPanel.Visible = visible
	if not visible then return end
	if not data then return end

	if gameOverTitle then
		local titleText: string = "RUN OVER"
		local d: any = data
		local reason: string? = d.Reason
		if reason == "killed" then titleText = "YOU DIED" end
		if reason == "won" then titleText = "ARENA CLEARED" end
		gameOverTitle.Text = titleText
	end
	if gameOverBody then
		local d2: any = data
		local wave: number = tonumber(d2.Wave) or 0
		local kills: number = tonumber(d2.Kills) or 0
		local coins: number = tonumber(d2.Coins) or 0
		gameOverBody.Text = string.format("Wave %d  •  Kills %d  •  Coins %d", wave, kills, coins)
	end
	if respawnButton and spectateLabel then
		local d3: any = data
		local canRespawn: boolean = true
		if d3.CanRespawn == false then canRespawn = false end
		if d3.Reason == "won" then canRespawn = false end
		respawnButton.Visible = canRespawn
		spectateLabel.Visible = not canRespawn
		if not canRespawn then
			spectateLabel.Text = "Spectating... waiting for the next run."
		end
	end
end

function HUD.OnRespawnRequested(cb: any)
	respawnCallback = cb
	if respawnButton then
		respawnButton.MouseButton1Click:Connect(function()
			if respawnCallback then
				pcall(function()
					respawnCallback()
				end)
			end
		end)
	end
end

-- Update loop ---------------------------------------------------------------

local function updateCrosshair(t: number, dt: number)
	if not crosshair then return end
	local alpha: number = 0
	if now() < crosshairUntilSpread then
		alpha = 1
	elseif spreadDecayAt > t then
		alpha = 0.5
	end
	local spread: number = crosshairSpread * alpha
	local gap: number = 6 + spread * 40

	chTop.Position = UDim2.new(0.5, 0, 0.5, -gap - 8)
	chBottom.Position = UDim2.new(0.5, 0, 0.5, gap + 8)
	chLeft.Position = UDim2.new(0.5, -gap - 8, 0.5, 0)
	chRight.Position = UDim2.new(0.5, gap + 8, 0.5, 0)
	chDot.BackgroundTransparency = 0.5 + spread * 0.4
end

local function updateVignette(dt: number)
	if not vignette then return end
	if vignetteLevel > 0 then
		vignetteLevel = math.max(0, vignetteLevel - dt * 1.6)
		vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
	end
end

local function updateToasts(t: number)
	local alive: number = 0
	for i = #toasts, 1, -1 do
		local toast: Toast = toasts[i]
		if toast.ExpiresAt <= t then
			toast.Label:Destroy()
			table.remove(toasts, i)
		else
			alive += 1
			local remaining: number = toast.ExpiresAt - t
			local fade: number = clamp01(remaining / 0.6)
			toast.Label.TextTransparency = 1 - fade
		end
	end
	if alive > MAX_TOASTS then
		-- Safety net: structural limit enforced elsewhere.
	end
end

local function updateDamageNumbers(dt: number)
	local t: number = now()
	for i = #activeDamageNumbers, 1, -1 do
		local entry: any = activeDamageNumbers[i]
		if entry.ExpiresAt <= t then
			entry.Label:Destroy()
			table.remove(activeDamageNumbers, i)
		else
			local age: number = t - (entry.ExpiresAt - DAMAGE_NUMBER_LIFE)
			local frac: number = clamp01(age / DAMAGE_NUMBER_LIFE)
			entry.Label.Position = UDim2.new(0.5, 0, 0.42 - frac * 0.08, 0)
			entry.Label.TextTransparency = frac
		end
	end
end

local function updateHitmarker(t: number)
	if not hitmarker then return end
	if hitmarker.Visible and t >= hitmarkerUntil then
		hitmarker.Visible = false
	end
end

local function updateFlash(t: number)
	if not muzzleFlash then return end
	if muzzleFlash.Visible and t >= flashUntil then
		muzzleFlash.Visible = false
	end
end

local function updateLowHealthPulse(dt: number)
	if not cachedStats then return end
	local frac: number = clamp01(cachedStats.Health / math.max(1, cachedStats.MaxHealth))
	if frac < 0.3 then
		lowHealthPulse += dt * 4
		local pulse: number = (math.sin(lowHealthPulse) + 1) * 0.5
		vignetteLevel = math.max(vignetteLevel, 0.12 + pulse * 0.13)
		if vignette then
			vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
		end
	end
end

local function onRenderStep(dt: number)
	if not started then return end
	local t: number = now()
	updateCrosshair(t, dt)
	updateVignette(dt)
	updateLowHealthPulse(dt)
	updateToasts(t)
	updateDamageNumbers(dt)
	updateHitmarker(t)
	updateFlash(t)
end

-- Lifecycle ----------------------------------------------------------------

function HUD.Start(plrGui: any)
	if started then return end
	playerGui = plrGui
	ensureGui()
	started = true

	local rs: any = game:GetService("RunService")
	_runServiceConn = rs.RenderStepped:Connect(function(dt: number)
		pcall(onRenderStep, dt)
	end)
end

function HUD.IsStarted(): boolean
	return started
end

function HUD.GetScreenGui(): ScreenGui?
	return screen
end

function HUD.Reset()
	if gameOverPanel then gameOverPanel.Visible = false end
	vignetteLevel = 0
	if vignette then vignette.BackgroundTransparency = 1 end
	for _, toast in ipairs(toasts) do
		toast.Label:Destroy()
	end
	table.clear(toasts)
	for _, entry in ipairs(activeDamageNumbers) do
		local e: any = entry
		e.Label:Destroy()
	end
	table.clear(activeDamageNumbers)
end

-- Expose local mirrors for the sibling client modules (types are lint-only).
export type PlayerStatsMirror = PlayerStats
export type WaveStateMirror = WaveState
export type WeaponStateMirror = WeaponState
export type WeaponDefMirror = WeaponDef
export type RunStateMirror = RunState

return HUD
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="29">
        <Properties>
          <string name="Name">Instructions</string>
          <string name="Source"><![CDATA[--!strict
-- How-to-play panel.
--
-- The game's objective and controls were nowhere in the client: a new player
-- joined into a dark arena with no idea what to do or which key did what. This
-- module owns a single "ZombieHelp" ScreenGui that:
--   * auto-opens once per session the first time the player spawns in
--   * is toggled with F1 / H (and a persistent "?" button)
--   * lists the objective and every control from one table, so the controls
--     can never drift from what is actually bound in ClientController.
--
-- Everything is built in code with no external assets, matching the rest of
-- the UI layer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Instructions = {}

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local COL_BG = Color3.fromRGB(10, 12, 17)
local COL_PANEL = Color3.fromRGB(20, 23, 31)
local COL_TEXT = Color3.fromRGB(236, 240, 247)
local COL_DIM = Color3.fromRGB(150, 158, 172)
local COL_ACCENT = Color3.fromRGB(232, 196, 88)
local COL_GOOD = Color3.fromRGB(88, 208, 128)

-- Single source of truth for what we tell the player. Keep this in sync with
-- ClientController.bindActions().
type ControlRow = { Key: string, Desc: string }

local CONTROLS: { ControlRow } = {
	{ Key = "Left Mouse", Desc = "Fire your weapon" },
	{ Key = "R", Desc = "Reload" },
	{ Key = "Shift", Desc = "Sprint — faster than zombies, use it to escape" },
	{ Key = "E", Desc = "Hold near doors, vending machines and other objects to use them" },
	{ Key = "B", Desc = "Open the shop between waves" },
	{ Key = "1 – 4", Desc = "Switch weapon" },
	{ Key = "F1 / H", Desc = "Show or hide these instructions" },
}

local OBJECTIVE_LINES: { string } = {
	"The horde has overrun Lovisedalsskolan in Vallentuna — the schoolyard, the pitch and the parking lot.",
	"Survive escalating waves of the undead and get as deep as you can.",
	"You start with a sidearm: aim with the crosshair, Left Mouse to shoot, R to reload.",
	"Zombies spawn around you and hunt you down — they are faster than you walk, so keep moving.",
	"Kill them for coins. Aim for the head: headshots pay double and kill far quicker.",
	"Walk up to doors, vending machines and mystery boxes and HOLD E when the prompt appears.",
	"Between waves the shop opens. Spend coins on better weapons and perks.",
	"Open doors to unlock new zones — the pitch, the sports hall and stronger gear lie deeper in.",
	"Reach wave " .. tostring(Config.Wave.ExtractionWave) .. " to extract and win the run.",
}

local started: boolean = false
local gui: any = nil
local panel: any = nil
local toggleButton: any = nil
local visible: boolean = false
local autoShown: boolean = false

local localPlayer: any = Players.LocalPlayer

local function newFrame(name: string): any
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(0, 0, 0, 0)
	f.Position = UDim2.new(0, 0, 0, 0)
	return f
end

local function newLabel(name: string): any
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.new(0, 0, 0, 0)
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Text = ""
	l.TextColor3 = COL_TEXT
	l.TextSize = 16
	l.Font = Enum.Font.Gotham
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Top
	return l
end

local function setVisible(next: boolean)
	visible = next
	pcall(function()
		if panel then
			panel.Visible = visible
		end
	end)
end

local function build(parent: any)
	gui = Instance.new("ScreenGui")
	gui.Name = "ZombieHelp"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 60
	gui.Parent = parent

	panel = newFrame("HelpPanel")
	panel.Size = UDim2.new(0.52, 0, 0.7, 0)
	panel.Position = UDim2.new(0.5, 0, 0.5, 0)
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.BackgroundColor3 = COL_BG
	panel.BackgroundTransparency = 0.06
	panel.Visible = false
	panel.ZIndex = 60
	panel.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = panel

	local stroke = Instance.new("UIStroke")
	stroke.Color = COL_ACCENT
	stroke.Thickness = 2
	stroke.Parent = panel

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 18)
	pad.PaddingBottom = UDim.new(0, 18)
	pad.PaddingLeft = UDim.new(0, 22)
	pad.PaddingRight = UDim.new(0, 22)
	pad.Parent = panel

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 8)
	layout.Parent = panel

	local title = newLabel("Title")
	title.Size = UDim2.new(1, 0, 0, 40)
	title.Text = "ZOMBIE UPRISING — HOW TO PLAY"
	title.TextSize = 24
	title.TextColor3 = COL_ACCENT
	title.Font = Enum.Font.GothamBold
	title.LayoutOrder = 1
	title.Parent = panel

	local objHeader = newLabel("ObjHeader")
	objHeader.Size = UDim2.new(1, 0, 0, 26)
	objHeader.Text = "OBJECTIVE"
	objHeader.TextSize = 17
	objHeader.TextColor3 = COL_GOOD
	objHeader.Font = Enum.Font.GothamBold
	objHeader.LayoutOrder = 2
	objHeader.Parent = panel

	local objective = newLabel("Objective")
	objective.Size = UDim2.new(1, 0, 0, 120)
	objective.AutomaticSize = Enum.AutomaticSize.Y
	objective.Text = "• " .. table.concat(OBJECTIVE_LINES, "\n• ")
	objective.TextSize = 15
	objective.TextColor3 = COL_TEXT
	objective.TextWrapped = true
	objective.LayoutOrder = 3
	objective.Parent = panel

	local ctrlHeader = newLabel("CtrlHeader")
	ctrlHeader.Size = UDim2.new(1, 0, 0, 26)
	ctrlHeader.Text = "CONTROLS"
	ctrlHeader.TextSize = 17
	ctrlHeader.TextColor3 = COL_GOOD
	ctrlHeader.Font = Enum.Font.GothamBold
	ctrlHeader.LayoutOrder = 4
	ctrlHeader.Parent = panel

	for i, entry in ipairs(CONTROLS) do
		local row = newFrame("Row_" .. tostring(i))
		row.Size = UDim2.new(1, 0, 0, 24)
		row.LayoutOrder = 10 + i
		row.Parent = panel

		local key = newLabel("Key")
		key.Size = UDim2.new(0.3, 0, 1, 0)
		key.Text = entry.Key
		key.TextSize = 15
		key.TextColor3 = COL_ACCENT
		key.Font = Enum.Font.GothamBold
		key.Parent = row

		local desc = newLabel("Desc")
		desc.Size = UDim2.new(0.7, 0, 1, 0)
		desc.Position = UDim2.new(0.3, 0, 0, 0)
		desc.Text = entry.Desc
		desc.TextSize = 15
		desc.TextColor3 = COL_DIM
		desc.Parent = row
	end

	local close = Instance.new("TextButton")
	close.Name = "Close"
	close.Size = UDim2.new(0.4, 0, 0, 40)
	close.BackgroundColor3 = COL_GOOD
	close.BackgroundTransparency = 0.12
	close.Text = "GOT IT — PLAY"
	close.TextSize = 17
	close.TextColor3 = COL_BG
	close.Font = Enum.Font.GothamBold
	close.LayoutOrder = 99
	close.Parent = panel

	local closeCorner = Instance.new("UICorner")
	closeCorner.CornerRadius = UDim.new(0, 6)
	closeCorner.Parent = close

	close.MouseButton1Click:Connect(function()
		setVisible(false)
	end)

	-- Always-available help button, bottom-centre, so the panel is discoverable
	-- long after this first-run panel has been dismissed.
	toggleButton = Instance.new("TextButton")
	toggleButton.Name = "HelpButton"
	toggleButton.Size = UDim2.new(0, 34, 0, 34)
	toggleButton.Position = UDim2.new(0.5, 0, 1, -46)
	toggleButton.AnchorPoint = Vector2.new(0.5, 0)
	toggleButton.BackgroundColor3 = COL_PANEL
	toggleButton.BackgroundTransparency = 0.25
	toggleButton.Text = "?"
	toggleButton.TextSize = 20
	toggleButton.TextColor3 = COL_ACCENT
	toggleButton.Font = Enum.Font.GothamBold
	toggleButton.ZIndex = 61
	toggleButton.Parent = gui

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 17)
	btnCorner.Parent = toggleButton

	toggleButton.MouseButton1Click:Connect(function()
		setVisible(not visible)
	end)
end

local function toggleHelp()
	setVisible(not visible)
end

function Instructions.Init()
	if started then return end
	started = true

	pcall(function()
		local pgui = localPlayer and localPlayer:WaitForChild("PlayerGui", 8)
		if pgui then
			build(pgui)
		end
	end)

	pcall(function()
		ContextActionService:BindAction("ZU_Help", function(_n: string, state: any, _i: any)
			if state == Enum.UserInputState.Begin then
				pcall(toggleHelp)
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.F1, Enum.KeyCode.H)
	end)

	pcall(function()
		UserInputService.InputBegan:Connect(function(input: any, gameProcessed: boolean)
			if gameProcessed then return end
			local kc: any = input.KeyCode
			if kc == Enum.KeyCode.F1 or kc == Enum.KeyCode.H then
				pcall(toggleHelp)
			end
		end)
	end)

	-- Auto-open once, shortly after the first character spawns, so the very
	-- first thing a new player reads is what they are supposed to do.
	if not autoShown then
		autoShown = true
		task.delay(2.5, function()
			setVisible(true)
			task.delay(22, function()
				-- Auto-dismiss if they clearly got the idea and started playing.
				if visible then
					setVisible(false)
				end
			end)
		end)
	end
end

-- Called by ClientController so the panel can also be opened from elsewhere.
function Instructions.Show()
	setVisible(true)
end

function Instructions.Hide()
	setVisible(false)
end

function Instructions.IsVisible(): boolean
	return visible
end

return Instructions
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="30">
        <Properties>
          <string name="Name">Interact</string>
          <string name="Source"><![CDATA[--!strict
-- Client-side interaction + downed UI for the Tier 1-3 systems.
--
-- Doors and machines are server-authoritative, but nothing on the client was
-- triggering them, so they were unreachable in play. This module:
--   * detects proximity to doors/machines via ProximityPrompt
--   * shows a downed overlay with revive progress
--   * mirrors server state into readable UI

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Interact = {}

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local player = Players.LocalPlayer
if not player then
	return Interact
end

----------------------------------------------------------------------
-- Downed overlay
----------------------------------------------------------------------
local downedGui: ScreenGui? = nil
local downedLabel: TextLabel? = nil

local function ensureDownedGui(): TextLabel?
	if downedGui then
		return downedLabel
	end
	local ok = pcall(function()
		local pgui = player:WaitForChild("PlayerGui", 8)
		if not pgui then
			return
		end
		local gui = Instance.new("ScreenGui")
		gui.Name = "ZombieDowned"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.Parent = pgui

		local frame = Instance.new("Frame")
		frame.Name = "Vignette"
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
		frame.BackgroundTransparency = 0.55
		frame.BorderSizePixel = 0
		frame.Parent = gui

		local label = Instance.new("TextLabel")
		label.Name = "Text"
		label.Size = UDim2.new(0.6, 0, 0.16, 0)
		label.Position = UDim2.new(0.2, 0, 0.42, 0)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 240, 240)
		label.TextStrokeTransparency = 0.3
		label.TextScaled = true
		label.Font = Enum.Font.GothamBold
		label.Text = "DOWNED"
		label.Parent = gui

		downedGui = gui
		downedLabel = label
	end)
	if not ok then
		return nil
	end
	return downedLabel
end

local function setDownedVisible(visible: boolean, text: string?)
	pcall(function()
		local label = ensureDownedGui()
		if downedGui then
			local gui: any = downedGui
			gui.Enabled = visible
		end
		if label and text then
			label.Text = text
		end
	end)
end

----------------------------------------------------------------------
-- Proximity prompts for doors and machines
----------------------------------------------------------------------
local function attachPrompt(part: Instance, actionText: string, objectText: string, onTrigger: () -> ())
	pcall(function()
		if part:FindFirstChildOfClass("ProximityPrompt") then
			return
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "InteractPrompt"
		prompt.ActionText = actionText
		prompt.ObjectText = objectText
		prompt.HoldDuration = 0.35
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Parent = part

		prompt.Triggered:Connect(function(_plr: Player)
			pcall(onTrigger)
		end)
	end)
end

local function wireDoor(door: Instance)
	local any: any = door
	local index: number = tonumber(any:GetAttribute("DoorIndex")) or 0
	local cost: number = tonumber(any:GetAttribute("Cost")) or 0
	if index <= 0 then
		return
	end
	attachPrompt(door, string.format("Open (%d)", cost), "Door", function()
		pcall(function()
			Remotes.RequestOpenDoor():FireServer(index)
		end)
	end)
end

local function wireMachine(machine: Instance)
	local any: any = machine
	local id: string = tostring(any:GetAttribute("MachineId") or machine.Name)
	attachPrompt(machine, "Use", id, function()
		pcall(function()
			Remotes.RequestMachine():FireServer(id)
		end)
	end)
end

local function wireExisting()
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		if not map then
			return
		end
		local doors = map:FindFirstChild("Doors")
		if doors then
			for _, d in ipairs(doors:GetChildren()) do
				wireDoor(d)
			end
		end
		local machinesAny: any = map:FindFirstChild("Machines")
		if machinesAny then
			local mKids: any = machinesAny:GetChildren()
			for _, m in ipairs(mKids) do
				wireMachine(m)
			end
		end
	end)
end

-- Wire anything added after we booted (map is built by the server on join).
local function wireContainer(container: any)
	pcall(function()
		if container == nil then
			return
		end
		local c: any = container
		if c.Name == "Doors" then
			local kids: any = c:GetChildren()
			for _, d in ipairs(kids) do
				wireDoor(d)
			end
		elseif c.Name == "Machines" then
			local kids: any = c:GetChildren()
			for _, m in ipairs(kids) do
				wireMachine(m)
			end
		end
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function Interact.Init()
	task.delay(1.0, wireExisting)

	-- Map objects may appear after we boot; re-check periodically.
	pcall(function()
		task.spawn(function()
			for _ = 1, 40 do
				task.wait(1.0)
				pcall(function()
					local map: any = Workspace:FindFirstChild("Map")
					if not map then
						return
					end
					wireContainer(map:FindFirstChild("Doors"))
					wireContainer(map:FindFirstChild("Machines"))
				end)
			end
		end)
	end)

	-- Mirror the downed attribute into the overlay.
	pcall(function()
		player:GetAttributeChangedSignal("Downed"):Connect(function()
			local downed = player:GetAttribute("Downed") == true
			setDownedVisible(downed, if downed then "DOWNED — stay still!" else "")
		end)
	end)

	-- Cheap polling fallback if the attribute signal never fires.
	pcall(function()
		RunService.Heartbeat:Connect(function()
			local downed = player:GetAttribute("Downed") == true
			if downedGui then
				local gui: any = downedGui
				if gui.Enabled ~= downed then
					setDownedVisible(downed, if downed then "DOWNED — stay still!" else "")
				end
			end
		end)
	end)
end

return Interact
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="31">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- Intermission shop UI.
--
-- Builds a code-only purchase panel (weapons + perks) that is shown during the
-- "Intermission" wave phase and hidden the moment the phase flips to "Active".
--
-- Everything here is defensive: the server may not have booted yet (or may not
-- exist in a client-only test place), so remotes are resolved through a
-- timeout-guarded WaitForChild and every fire is wrapped in pcall. A missing
-- remote degrades to a silent no-op instead of an error.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

-- Cross-module requires are filtered analyzer noise (Unknown require).
local Config = require(Shared:WaitForChild("Config"))
local _Types = require(Shared:WaitForChild("Types"))

-- Structural mirrors of Config tables. luau-analyze cannot resolve exported
-- types across `require`, so each shape is redeclared here (kept in sync with
-- Shared/Config.luau). Lint-time aliases only; runtime values are real.
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type PerkDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Cost: number,
	MaxStacks: number,
	DamageMult: number?,
	FireRateMult: number?,
	ReloadMult: number?,
	MoveSpeedFlat: number?,
	MaxHealthFlat: number?,
	MagazineMult: number?,
	LifestealPct: number?,
	ExtraLives: number?,
	CoinMult: number?,
}

type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type RunState = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: { [string]: number },
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
}

type ShopState = {
	Phase: string,
	OwnedWeapons: { [string]: boolean }?,
	CurrentWeapon: string?,
	Perks: { [string]: number }?,
	Coins: number?,
}

type RowRefs = {
	Root: Frame,
	Button: TextButton,
	NameLabel: TextLabel,
	CostLabel: TextLabel,
	StacksLabel: TextLabel,
}

local ShopUI = {}

local COL_BG = Color3.fromRGB(14, 16, 22)
local COL_PANEL = Color3.fromRGB(22, 25, 33)
local COL_ROW = Color3.fromRGB(28, 32, 42)
local COL_TEXT = Color3.fromRGB(236, 240, 247)
local COL_DIM = Color3.fromRGB(148, 156, 170)
local COL_GOOD = Color3.fromRGB(88, 208, 128)
local COL_BAD = Color3.fromRGB(226, 88, 88)
local COL_ACCENT = Color3.fromRGB(232, 196, 88)

local playerGui: any = nil
local gui: ScreenGui = nil :: any
local root: Frame = nil :: any
local titleLabel: TextLabel = nil :: any
local coinsLabel: TextLabel = nil :: any
local hintLabel: TextLabel = nil :: any
local weaponsScroll: ScrollingFrame = nil :: any
local perksScroll: ScrollingFrame = nil :: any
local weaponsList: Frame = nil :: any
local perksList: Frame = nil :: any

local weaponRows: { [string]: RowRefs } = {}
local perkRows: { [string]: RowRefs } = {}

local started: boolean = false
local visibleNow: boolean = false
local currentStats: PlayerStats? = nil
local _currentRun: RunState? = nil
local ownedWeapons: { [string]: boolean } = {}
local perkStacks: { [string]: number } = {}
local currentWeapon: string = "Pistol"

local purchaseWeaponRemote: any = nil
local purchasePerkRemote: any = nil

local REMOTE_TIMEOUT: number = 5

-- Helpers -------------------------------------------------------------------

local function newFrame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(0, 0, 0, 0)
	f.Position = UDim2.new(0, 0, 0, 0)
	return f
end

local function newTextLabel(name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.new(0, 0, 0, 0)
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Text = ""
	l.TextColor3 = COL_TEXT
	l.TextSize = 15
	l.Font = Enum.Font.GothamSemibold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	return l
end

local function newTextButton(name: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.BorderSizePixel = 0
	b.Size = UDim2.new(0, 0, 0, 0)
	b.Position = UDim2.new(0, 0, 0, 0)
	b.Text = ""
	b.TextColor3 = COL_TEXT
	b.TextSize = 15
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	return b
end

local function addCorner(parent: Instance, r: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function addList(parent: Instance, pad: number): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Parent = parent
	return l
end

local function safeNumber(v: any, fallback: number): number
	local n = tonumber(v)
	if n then return n end
	return fallback
end

-- Remote access -------------------------------------------------------------

local function waitForRemote(name: string): any
	-- Resolve a RemoteEvent defensively: never let a missing instance break the
	-- client. Returns nil if the server has not created it (yet).
	local ok: boolean, result: any = pcall(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
		if not folder then return nil end
		local r = folder:WaitForChild(name, REMOTE_TIMEOUT)
		return r
	end)
	if ok then
		return result
	end
	return nil
end

local function ensureRemotes()
	if purchaseWeaponRemote == nil then
		purchaseWeaponRemote = waitForRemote("RequestPurchaseWeapon")
	end
	if purchasePerkRemote == nil then
		purchasePerkRemote = waitForRemote("RequestPurchasePerk")
	end
end

local function fireWeaponPurchase(weaponId: string)
	ensureRemotes()
	if not purchaseWeaponRemote then return end
	pcall(function()
		purchaseWeaponRemote:FireServer(weaponId)
	end)
end

local function firePerkPurchase(perkId: string)
	ensureRemotes()
	if not purchasePerkRemote then return end
	pcall(function()
		purchasePerkRemote:FireServer(perkId)
	end)
end

-- UI construction ----------------------------------------------------------

local function buildRow(
	id: string,
	displayName: string,
	cost: number,
	subText: string,
	onClick: () -> ()
): RowRefs
	local row = newFrame("Row_" .. id)
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundColor3 = COL_ROW
	row.BackgroundTransparency = 0.1
	row.LayoutOrder = 0

	local corner = addCorner(row, 6)

	local nameLabel = newTextLabel("Name")
	nameLabel.Size = UDim2.new(0.62, -14, 0.45, 0)
	nameLabel.Position = UDim2.new(0, 12, 0.06, 0)
	nameLabel.Text = displayName
	nameLabel.TextSize = 16
	nameLabel.Parent = row

	local sub = newTextLabel("Sub")
	sub.Size = UDim2.new(0.62, -14, 0.4, 0)
	sub.Position = UDim2.new(0, 12, 0.54, 0)
	sub.Text = subText
	sub.TextSize = 13
	sub.TextColor3 = COL_DIM
	sub.Parent = row

	local costLabel = newTextLabel("Cost")
	costLabel.Size = UDim2.new(0.38, -8, 0.5, 0)
	costLabel.Position = UDim2.new(0.62, 0, 0.06, 0)
	costLabel.TextXAlignment = Enum.TextXAlignment.Right
	costLabel.Text = if cost <= 0 then "FREE" else string.format("%d c", cost)
	costLabel.TextSize = 15
	costLabel.TextColor3 = COL_ACCENT
	costLabel.Parent = row

	local stacksLabel = newTextLabel("Stacks")
	stacksLabel.Size = UDim2.new(0.38, -8, 0.4, 0)
	stacksLabel.Position = UDim2.new(0.62, 0, 0.54, 0)
	stacksLabel.TextXAlignment = Enum.TextXAlignment.Right
	stacksLabel.Text = ""
	stacksLabel.TextSize = 13
	stacksLabel.TextColor3 = COL_DIM
	stacksLabel.Parent = row

	local button = newTextButton("Buy")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Position = UDim2.new(0, 0, 0, 0)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.Parent = row
	button.MouseButton1Click:Connect(function()
		pcall(onClick)
	end)

	-- Keep the row graphic above the transparent hit-target button.
	corner.Parent = row
	nameLabel.ZIndex = 2
	sub.ZIndex = 2
	costLabel.ZIndex = 2
	stacksLabel.ZIndex = 2

	return {
		Root = row,
		Button = button,
		NameLabel = nameLabel,
		CostLabel = costLabel,
		StacksLabel = stacksLabel,
	}
end

local function ensureGui(): ScreenGui
	if gui then
		return gui
	end

	local existing = playerGui:FindFirstChild("ZombieShop")
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "ZombieShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 20
	gui.Enabled = true
	gui.Parent = playerGui

	root = newFrame("ShopRoot")
	root.Size = UDim2.new(0.62, 0, 0.56, 0)
	root.Position = UDim2.new(0.5, 0, 0.5, 0)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.BackgroundColor3 = COL_PANEL
	root.BackgroundTransparency = 0.08
	root.Visible = false
	root.Parent = gui
	addCorner(root, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = COL_ACCENT
	stroke.Thickness = 2
	stroke.Parent = root

	local header = newFrame("Header")
	header.Size = UDim2.new(1, 0, 0, 54)
	header.Position = UDim2.new(0, 0, 0, 0)
	header.BackgroundTransparency = 1
	header.Parent = root

	titleLabel = newTextLabel("Title")
	titleLabel.Size = UDim2.new(0.6, -20, 0.55, 0)
	titleLabel.Position = UDim2.new(0, 20, 0.1, 0)
	titleLabel.Text = "ARMORY — Intermission"
	titleLabel.TextSize = 22
	titleLabel.TextColor3 = COL_ACCENT
	titleLabel.Parent = header

	coinsLabel = newTextLabel("Coins")
	coinsLabel.Size = UDim2.new(0.4, -20, 0.45, 0)
	coinsLabel.Position = UDim2.new(0.6, 0, 0.1, 0)
	coinsLabel.TextXAlignment = Enum.TextXAlignment.Right
	coinsLabel.Text = "Coins 0"
	coinsLabel.TextSize = 17
	coinsLabel.TextColor3 = COL_ACCENT
	coinsLabel.Parent = header

	hintLabel = newTextLabel("Hint")
	hintLabel.Size = UDim2.new(1, -40, 0.4, 0)
	hintLabel.Position = UDim2.new(0, 20, 0.62, 0)
	hintLabel.Text = "Spend coins before the next wave. Purchases are permanent for this run."
	hintLabel.TextSize = 13
	hintLabel.TextColor3 = COL_DIM
	hintLabel.Parent = header

	local columns = newFrame("Columns")
	columns.Size = UDim2.new(1, -32, 1, -110)
	columns.Position = UDim2.new(0, 16, 0, 64)
	columns.BackgroundTransparency = 1
	columns.Parent = root

	local weaponsColumn = newFrame("WeaponsColumn")
	weaponsColumn.Size = UDim2.new(0.5, -8, 1, 0)
	weaponsColumn.Position = UDim2.new(0, 0, 0, 0)
	weaponsColumn.BackgroundColor3 = COL_BG
	weaponsColumn.BackgroundTransparency = 0.35
	weaponsColumn.Parent = columns
	addCorner(weaponsColumn, 8)

	local weaponsPad = Instance.new("UIPadding")
	weaponsPad.PaddingTop = UDim.new(0, 8)
	weaponsPad.PaddingLeft = UDim.new(0, 10)
	weaponsPad.PaddingRight = UDim.new(0, 8)
	weaponsPad.PaddingBottom = UDim.new(0, 8)
	weaponsPad.Parent = weaponsColumn

	local perksColumn = newFrame("PerksColumn")
	perksColumn.Size = UDim2.new(0.5, -8, 1, 0)
	perksColumn.Position = UDim2.new(0.5, 8, 0, 0)
	perksColumn.BackgroundColor3 = COL_BG
	perksColumn.BackgroundTransparency = 0.35
	perksColumn.Parent = columns
	addCorner(perksColumn, 8)

	local perksPad = Instance.new("UIPadding")
	perksPad.PaddingTop = UDim.new(0, 8)
	perksPad.PaddingLeft = UDim.new(0, 10)
	perksPad.PaddingRight = UDim.new(0, 8)
	perksPad.PaddingBottom = UDim.new(0, 8)
	perksPad.Parent = perksColumn

	-- Headings are children of the padded columns; the scrollers fill below.
	local wHeading = newTextLabel("WHeading")
	wHeading.Size = UDim2.new(1, 0, 0, 24)
	wHeading.Position = UDim2.new(0, 0, 0, 0)
	wHeading.Text = "WEAPONS"
	wHeading.TextSize = 17
	wHeading.TextColor3 = COL_ACCENT
	wHeading.Parent = weaponsColumn

	local pHeading = newTextLabel("PHeading")
	pHeading.Size = UDim2.new(1, 0, 0, 24)
	pHeading.Position = UDim2.new(0, 0, 0, 0)
	pHeading.Text = "PERKS"
	pHeading.TextSize = 17
	pHeading.TextColor3 = COL_ACCENT
	pHeading.Parent = perksColumn

	weaponsScroll = Instance.new("ScrollingFrame")
	weaponsScroll.Name = "WeaponsScroll"
	weaponsScroll.Size = UDim2.new(1, 0, 1, -32)
	weaponsScroll.Position = UDim2.new(0, 0, 0, 32)
	weaponsScroll.BackgroundTransparency = 1
	weaponsScroll.BorderSizePixel = 0
	weaponsScroll.ScrollBarThickness = 6
	weaponsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	weaponsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	weaponsScroll.Parent = weaponsColumn

	perksScroll = Instance.new("ScrollingFrame")
	perksScroll.Name = "PerksScroll"
	perksScroll.Size = UDim2.new(1, 0, 1, -32)
	perksScroll.Position = UDim2.new(0, 0, 0, 32)
	perksScroll.BackgroundTransparency = 1
	perksScroll.BorderSizePixel = 0
	perksScroll.ScrollBarThickness = 6
	perksScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	perksScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	perksScroll.Parent = perksColumn

	weaponsList = newFrame("WeaponsList")
	weaponsList.Size = UDim2.new(1, -8, 0, 0)
	weaponsList.Position = UDim2.new(0, 0, 0, 0)
	weaponsList.AutomaticSize = Enum.AutomaticSize.Y
	weaponsList.BackgroundTransparency = 1
	weaponsList.Parent = weaponsScroll
	addList(weaponsList, 6)

	perksList = newFrame("PerksList")
	perksList.Size = UDim2.new(1, -8, 0, 0)
	perksList.Position = UDim2.new(0, 0, 0, 0)
	perksList.AutomaticSize = Enum.AutomaticSize.Y
	perksList.BackgroundTransparency = 1
	perksList.Parent = perksScroll
	addList(perksList, 6)

	return gui
end

-- Item population -----------------------------------------------------------

local function weaponSubText(def: WeaponDef): string
	local fireType: string = if def.Auto then "Auto" else "Single"
	return string.format(
		"%d dmg  •  %s  •  mag %d  •  %s",
		def.Damage,
		string.format("%.1f/s", def.FireRate),
		def.MagazineSize,
		fireType
	)
end

local function perkSubText(def: PerkDef, stacks: number): string
	local base: string = string.format("%s (%d/%d)", def.Description, stacks, def.MaxStacks)
	return base
end

local function buildWeaponRows()
	local defs: any = Config.Weapons
	local order: { string } = { "Pistol", "SMG", "Shotgun", "Rifle" }
	local index: number = 0

	for _, id in ipairs(order) do
		local def: WeaponDef? = defs[id]
		if def then
			index += 1
			local d: WeaponDef = def
			local refs = buildRow(id, d.DisplayName, d.UnlockCost, weaponSubText(d), function()
				fireWeaponPurchase(id)
			end)
			refs.Root.LayoutOrder = index
			refs.Root.Parent = weaponsList
			weaponRows[id] = refs
		end
	end
end

local function buildPerkRows()
	local defs: any = Config.Perks
	local order: { string } = {
		"Damage",
		"FireRate",
		"Reload",
		"MoveSpeed",
		"MaxHealth",
		"Magazine",
		"Lifesteal",
		"ExtraLife",
		"Greed",
	}
	local index: number = 0

	for _, id in ipairs(order) do
		local def: PerkDef? = defs[id]
		if def then
			index += 1
			local d: PerkDef = def
			local refs = buildRow(id, d.DisplayName, d.Cost, perkSubText(d, 0), function()
				firePerkPurchase(id)
			end)
			refs.Root.LayoutOrder = index
			refs.Root.Parent = perksList
			perkRows[id] = refs
		end
	end
end

-- Affordability / state refresh ---------------------------------------------

local function refreshWeaponRow(id: string)
	local refs: RowRefs? = weaponRows[id]
	if not refs then return end
	local r: RowRefs = refs

	local defs: any = Config.Weapons
	local def: WeaponDef? = defs[id]
	local owned: boolean = ownedWeapons[id] == true
	local equipped: boolean = currentWeapon == id
	local coins: number = 0
	if currentStats then
		coins = safeNumber(currentStats.Coins, 0)
	end

	local affordable: boolean = true
	if def then
		local d: WeaponDef = def
		affordable = coins >= d.UnlockCost
	end

	if equipped then
		r.Root.BackgroundColor3 = Color3.fromRGB(40, 62, 44)
		r.NameLabel.TextColor3 = COL_GOOD
		r.CostLabel.Text = "EQUIPPED"
		r.CostLabel.TextColor3 = COL_GOOD
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.05
	elseif owned then
		r.Root.BackgroundColor3 = Color3.fromRGB(32, 44, 40)
		r.NameLabel.TextColor3 = COL_TEXT
		r.CostLabel.Text = "OWNED"
		r.CostLabel.TextColor3 = COL_GOOD
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.1
	elseif affordable then
		r.Root.BackgroundColor3 = COL_ROW
		r.NameLabel.TextColor3 = COL_TEXT
		r.CostLabel.TextColor3 = COL_ACCENT
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.1
	else
		-- Cannot afford: greyed out and non-interactive.
		r.Root.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		r.NameLabel.TextColor3 = COL_DIM
		r.CostLabel.TextColor3 = COL_BAD
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.45
	end

	if not equipped and not owned and def then
		local d2: WeaponDef = def
		r.CostLabel.Text = if d2.UnlockCost <= 0 then "FREE" else string.format("%d c", d2.UnlockCost)
	end

	r.Root.Visible = true
end

local function refreshPerkRow(id: string)
	local refs: RowRefs? = perkRows[id]
	if not refs then return end
	local r: RowRefs = refs

	local defs: any = Config.Perks
	local def: PerkDef? = defs[id]
	local stacks: number = safeNumber(perkStacks[id], 0)
	local coins: number = 0
	if currentStats then
		coins = safeNumber(currentStats.Coins, 0)
	end

	local maxed: boolean = false
	local affordable: boolean = false
	if def then
		local d: PerkDef = def
		maxed = stacks >= d.MaxStacks
		affordable = coins >= d.Cost
	end

	r.Root.BackgroundTransparency = 0.1
	r.NameLabel.TextColor3 = COL_TEXT
	r.Button.Active = true

	if maxed then
		r.Root.BackgroundColor3 = Color3.fromRGB(52, 44, 26)
		r.CostLabel.Text = "MAX"
		r.CostLabel.TextColor3 = COL_ACCENT
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.2
	elseif affordable then
		r.Root.BackgroundColor3 = COL_ROW
		r.CostLabel.TextColor3 = COL_ACCENT
	else
		r.Root.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		r.NameLabel.TextColor3 = COL_DIM
		r.CostLabel.TextColor3 = COL_BAD
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.45
	end

	if not maxed and def then
		local d2: PerkDef = def
		r.CostLabel.Text = string.format("%d c", d2.Cost)
	end

	if def then
		local d3: PerkDef = def
		r.StacksLabel.Text = string.format("%d / %d stacks", stacks, d3.MaxStacks)
	end

	r.Root.Visible = true
end

local function refreshAll()
	if coinsLabel then
		local coins: number = 0
		if currentStats then
			coins = safeNumber(currentStats.Coins, 0)
		end
		coinsLabel.Text = string.format("Coins %d", coins)
	end
	for id, _ in pairs(weaponRows) do
		refreshWeaponRow(id)
	end
	for id, _ in pairs(perkRows) do
		refreshPerkRow(id)
	end
end

-- Public API ----------------------------------------------------------------

function ShopUI.Start(plrGui: any)
	if started then return end
	playerGui = plrGui
	ensureGui()
	buildWeaponRows()
	buildPerkRows()
	started = true
	refreshAll()
end

function ShopUI.IsStarted(): boolean
	return started
end

function ShopUI.SetVisible(visible: boolean)
	visibleNow = visible
	if not started then return end
	if root then
		root.Visible = visible
	end
	if visible then
		refreshAll()
	end
end

function ShopUI.IsVisible(): boolean
	return visibleNow
end

-- Called by ClientController on ShopStateChanged with the server payload.
function ShopUI.SetShopState(state: any?)
	if not started then return end
	if not state then return end

	local s: ShopState = state

	if s.OwnedWeapons then
		ownedWeapons = s.OwnedWeapons
	end
	if s.CurrentWeapon then
		currentWeapon = s.CurrentWeapon
	end
	if s.Perks then
		perkStacks = s.Perks
	end
	if s.Coins then
		if not currentStats then
			currentStats = {
				Coins = safeNumber(s.Coins, 0),
				XP = 0,
				Level = 1,
				Kills = 0,
				Health = 100,
				MaxHealth = 100,
				Lives = 0,
				BestWave = 0,
			}
		else
			local coins: number = safeNumber(s.Coins, 0)
			local old: PlayerStats = currentStats
			currentStats = {
				Coins = coins,
				XP = old.XP,
				Level = old.Level,
				Kills = old.Kills,
				Health = old.Health,
				MaxHealth = old.MaxHealth,
				Lives = old.Lives,
				BestWave = old.BestWave,
			}
		end
	end

	-- Show only during Intermission; the phase -> Active transition hides it.
	if s.Phase == "Intermission" then
		ShopUI.SetVisible(true)
	else
		ShopUI.SetVisible(false)
	end

	refreshAll()
end

-- Called on every PlayerStatsChanged so affordability tracks the live wallet.
function ShopUI.SetStats(stats: any?)
	if not stats then return end
	currentStats = stats
	if visibleNow then
		refreshAll()
	end
end

-- Called on every PlayerStatsChanged-shaped run payload (perks/owned weapons).
function ShopUI.SetRunState(run: any?)
	if not run then return end
	_currentRun = run
	if run.OwnedWeapons then
		ownedWeapons = run.OwnedWeapons
	end
	if run.Perks then
		perkStacks = run.Perks
	end
	if run.CurrentWeapon then
		currentWeapon = run.CurrentWeapon
	end
	if visibleNow then
		refreshAll()
	end
end

function ShopUI.Refresh()
	if started then
		refreshAll()
	end
end

function ShopUI.GetWeaponRows(): { [string]: RowRefs }
	return weaponRows
end

function ShopUI.GetPerkRows(): { [string]: RowRefs }
	return perkRows
end

export type WeaponDefMirror = WeaponDef
export type PerkDefMirror = PerkDef
export type RowRefsMirror = RowRefs

return ShopUI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>