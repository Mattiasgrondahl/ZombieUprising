      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Chat</string>
          <string name="Source"><![CDATA[--!strict
-- In-game chat integration for multiplayer.
--
-- Roblox chat is handled by either TextChatService (new) or ChatService
-- (legacy). Both are supported here so chat works regardless of the place's
-- ChatVersion setting. Everything is pcall-guarded: if chat is unavailable the
-- game still runs, just without these extras.
--
-- Features:
--   * System announcements broadcast to all players (wave start, boss, etc.)
--   * Coloured kill/death messages
--   * Wave and shop notifications delivered through the chat channel
--   * Optional commands: !wave, !perks, !help

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Chat = {}

local Players = game:GetService("Players")

-- Resolved lazily because services may not be ready at require time.
local function getTextChatService(): any?
	local ok, svc = pcall(function()
		return game:GetService("TextChatService")
	end)
	if ok and svc then
		return svc
	end
	return nil
end

local function getChatService(): any?
	local ok, svc = pcall(function()
		return game:GetService("Chat")
	end)
	if ok and svc then
		return svc
	end
	return nil
end

-- Finds the first general-purpose text channel under TextChatService.
local function generalChannel(tcs: any): any?
	local ok, ch = pcall(function()
		return tcs:WaitForChild("TextChannels", 3)
	end)
	if not ok or not ch then
		return nil
	end
	local okFind, general = pcall(function()
		return ch:FindFirstChild("RBXGeneral")
	end)
	if okFind and general then
		return general
	end
	-- Fall back to any child TextChannel.
	local okAny, first = pcall(function()
		return ch:FindFirstChildOfClass("TextChannel")
	end)
	if okAny then
		return first
	end
	return nil
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Sends a system-styled message to every player's chat.
function Chat.System(text: string)
	pcall(function()
		local tcs = getTextChatService()
		if tcs then
			local ch = generalChannel(tcs)
			if ch then
				ch:DisplaySystemMessage(text)
				return
			end
		end
		local legacy = getChatService()
		if legacy then
			legacy:Chat(game:GetService("Workspace"), text, Enum.ChatColor.Blue)
		end
	end)
end

-- Sends a message attributed to a specific player (e.g. kill feed).
function Chat.FromPlayer(player: Player, text: string)
	pcall(function()
		local tcs = getTextChatService()
		if tcs then
			local ok = pcall(function()
				tcs:DisplayBubble(player.Character, text)
			end)
			if ok then
				return
			end
		end
	end)
end

-- Broadcasts a formatted kill announcement.
function Chat.Kill(killerName: string, zombieName: string, headshot: boolean)
	local suffix = if headshot then " (HEADSHOT)" else ""
	Chat.System(string.format("%s eliminated %s%s", killerName, zombieName, suffix))
end

-- Wave announcements, the most visible use of chat in play.
function Chat.WaveStart(waveNumber: number, isBoss: boolean)
	if isBoss then
		Chat.System(string.format("⚠ WAVE %d — BOSS INCOMING. Hold the line.", waveNumber))
	else
		Chat.System(string.format("Wave %d incoming. Good luck.", waveNumber))
	end
end

function Chat.WaveCleared(waveNumber: number)
	Chat.System(string.format("Wave %d cleared. Spend your coins!", waveNumber))
end

function Chat.ShopOpen(seconds: number)
	Chat.System(string.format("Shop open — %d seconds until the next wave.", seconds))
end

----------------------------------------------------------------------
-- Simple commands
----------------------------------------------------------------------
local Commands: { [string]: (Player) -> string } = {}

function Commands.help(_player: Player): string
	return "Commands: !wave  !perks  !help"
end

function Commands.wave(_player: Player): string
	local wd = ReplicatedStorage:FindFirstChild("Systems")
	if not wd then
		return "Wave info unavailable"
	end
	local mod = wd:FindFirstChild("WaveDirector")
	if not mod then
		return "Wave info unavailable"
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if not ok or not api then
		return "Wave info unavailable"
	end
	local wave = 0
	local phase = "?"
	pcall(function()
		wave = api.GetWave()
	end)
	pcall(function()
		phase = api.GetPhase()
	end)
	return string.format("Wave %d — phase: %s", wave, tostring(phase))
end

function Commands.perks(player: Player): string
	local rs = ReplicatedStorage:FindFirstChild("Systems")
	if not rs then
		return "Perk info unavailable"
	end
	local mod = rs:FindFirstChild("Progression")
	if not mod then
		return "Perk info unavailable"
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if not ok or not api then
		return "Perk info unavailable"
	end
	local run: any = nil
	pcall(function()
		run = api.GetRun(player)
	end)
	if not run then
		return "No active run"
	end
	local perks: any = run.Perks
	if typeof(perks) ~= "table" then
		return "No perks purchased yet"
	end
	local parts: { string } = {}
	for id, stacks in pairs(perks :: any) do
		parts[#parts + 1] = string.format("%s x%d", tostring(id), tonumber(stacks) or 0)
	end
	if #parts == 0 then
		return "No perks purchased yet"
	end
	return "Perks: " .. table.concat(parts, ", ")
end

-- Wires command listening. Safe to call on the server only.
function Chat.Init()
	local tcs = getTextChatService()
	if not tcs then
		return
	end

	pcall(function()
		local onIncoming = tcs:WaitForChild("OnIncomingMessage", 3)
		if not onIncoming then
			return
		end
		onIncoming = nil
	end)

	-- Listen for chat messages and answer known commands.
	pcall(function()
		Players.PlayerAdded:Connect(function(player: Player)
			pcall(function()
				player.Chatted:Connect(function(message: string)
					local lower = string.lower(message)
					local prefix = string.sub(lower, 1, 1)
					if prefix ~= "!" then
						return
					end
					local cmd = string.sub(lower, 2)
					local handler = Commands[cmd]
					if not handler then
						return
					end
					local ok, reply = pcall(function()
						return handler(player)
					end)
					if ok and typeof(reply) == "string" then
						Chat.System(reply)
					end
				end)
			end)
		end)
	end)
end

return Chat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Economy
--
-- Owns *persistent* player currency: coins, XP, level, best wave.
--   * Types.PlayerStats per player, replicated with PlayerStatsChanged
--   * leaderstats Folder with IntValues for Roblox's default leaderboard
--   * DataStoreService persistence with pcall + retries and an in-memory
--     fallback so a throttled/failed store never breaks the game
--   * OrderedDataStore global wave leaderboard
--   * level curve: XPLevelCurveBase * XPLevelCurveGrowth^(level-1)
--
-- Server-authoritative: coins are only ever granted here, and purchases go
-- through Spend().
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local _Types = require(script.Parent.Shared.Types)

-- Structural mirrors of cross-module exports (lint-time only).
type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type EconomySettings = {
	CoinPerKill: number,
	CoinPerHeadshot: number,
	CoinPerWaveClear: number,
	CoinWaveMultiplier: number,
	XPPerKill: number,
	XPPerWaveClear: number,
	XPLevelCurveBase: number,
	XPLevelCurveGrowth: number,
}

type DataStoreSettings = {
	Name: string,
	Retries: number,
	RetryDelay: number,
	LeaderboardName: string,
	LeaderboardSize: number,
}

local Economy = {}

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local ECON: EconomySettings = Config.Economy :: EconomySettings
local DS: DataStoreSettings = Config.DataStore :: DataStoreSettings

local STARTING_COINS: number = Config.Player.StartingCoins
local BASE_MAX_HEALTH: number = Config.Player.BaseMaxHealth

------------------------------------------------------------------------------
-- Persistent data store (graceful in-memory fallback)
------------------------------------------------------------------------------

local memoryStore: { [string]: { [string]: any } } = {}
local storeOk = true

local dataStore: any = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(DS.Name)
	end)
	if ok then
		dataStore = res
	else
		storeOk = false
		warn("[Economy] DataStore unavailable, using memory fallback: " .. tostring(res))
	end
end

local orderedStore: any = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetOrderedDataStore(DS.LeaderboardName)
	end)
	if ok then
		orderedStore = res
	else
		warn("[Economy] OrderedDataStore unavailable: " .. tostring(res))
	end
end

local function keyFor(player: Player): string
	return "player_" .. tostring(player.UserId)
end

-- Runs a datastore call with Config.DataStore.Retries attempts. Never throws.
local function withRetries(operation: () -> any): (boolean, any)
	local attempts: number = DS.Retries
	if attempts < 1 then
		attempts = 1
	end
	local lastErr: any = nil
	for _ = 1, attempts do
		local ok, res = pcall(operation)
		if ok then
			return true, res
		end
		lastErr = res
		-- Budget / throttle: back off briefly before retrying.
		if DS.RetryDelay > 0 then
			task.wait(DS.RetryDelay)
		end
	end
	return false, lastErr
end

local function loadRaw(key: string): { [string]: any }?
	if memoryStore[key] then
		return memoryStore[key]
	end
	if not storeOk or dataStore == nil then
		return nil
	end
	local ok, res = withRetries(function()
		return dataStore:GetAsync(key)
	end)
	if ok and typeof(res) == "table" then
		local t: { [string]: any } = res
		memoryStore[key] = t
		return t
	end
	if not ok then
		-- Throttled or failed: keep playing with defaults, try to persist later.
		warn("[Economy] load failed for " .. key .. ": " .. tostring(res))
	end
	return nil
end

local function saveRaw(key: string, data: { [string]: any })
	memoryStore[key] = data
	if not storeOk or dataStore == nil then
		return
	end
	local snapshot: { [string]: any } = {}
	for k, v in pairs(data) do
		snapshot[k] = v
	end
	local ok, res = withRetries(function()
		return dataStore:SetAsync(key, snapshot)
	end)
	if not ok then
		warn("[Economy] save failed for " .. key .. ": " .. tostring(res))
	end
end

------------------------------------------------------------------------------
-- Player stats
------------------------------------------------------------------------------

local stats: { [Player]: PlayerStats } = {}
local leaderstatsFolders: { [Player]: Folder } = {}

local function defaultStats(): PlayerStats
	return {
		Coins = STARTING_COINS,
		XP = 0,
		Level = 1,
		Kills = 0,
		Health = BASE_MAX_HEALTH,
		MaxHealth = BASE_MAX_HEALTH,
		Lives = 0,
		BestWave = 0,
	}
end

local function clampNumber(v: any, lo: number, hi: number): number
	local n = tonumber(v)
	if n == nil or n ~= n then
		return lo
	end
	if n < lo then return lo end
	if n > hi then return hi end
	return n
end

function Economy.GetStats(player: Player): PlayerStats
	local s = stats[player]
	if not s then
		s = defaultStats()
		stats[player] = s
	end
	return s
end

local function makeIntValue(name: string, value: number, parent: Folder): IntValue
	local v = Instance.new("IntValue")
	v.Name = name
	v.Value = math.floor(value)
	v.Parent = parent
	return v
end

local function ensureLeaderstats(player: Player): Folder
	local existing = leaderstatsFolders[player]
	if existing and existing.Parent then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	makeIntValue("Coins", 0, folder)
	makeIntValue("Wave", 0, folder)
	makeIntValue("Level", 1, folder)
	folder.Parent = player
	leaderstatsFolders[player] = folder
	return folder
end

local function refreshLeaderstats(player: Player)
	pcall(function()
		local folder = ensureLeaderstats(player)
		local s = Economy.GetStats(player)
		local coins = folder:FindFirstChild("Coins")
		if coins then
			(coins :: any).Value = math.floor(s.Coins)
		end
		local wave = folder:FindFirstChild("Wave")
		if wave then
			(wave :: any).Value = math.floor(s.BestWave)
		end
		local lvl = folder:FindFirstChild("Level")
		if lvl then
			(lvl :: any).Value = math.floor(s.Level)
		end
	end)
end

function Economy.Replicate(player: Player)
	pcall(function()
		local s = Economy.GetStats(player)
		Remotes.PlayerStatsChanged():FireClient(player, s)
	end)
	refreshLeaderstats(player)
end

------------------------------------------------------------------------------
-- Level curve
------------------------------------------------------------------------------

-- XP required to go from `level` to `level + 1`.
function Economy.XPForLevel(level: number): number
	local l: number = level
	if l < 1 then
		l = 1
	end
	return ECON.XPLevelCurveBase * math.pow(ECON.XPLevelCurveGrowth, l - 1)
end

-- Grants XP and levels up as many times as the curve allows. Returns the number
-- of levels gained.
function Economy.AddXP(player: Player, amount: number): number
	local s = Economy.GetStats(player)
	local gain = tonumber(amount)
	if gain == nil or gain <= 0 then
		return 0
	end

	s.XP += gain
	local levelsGained = 0
	-- Cap the loop so a pathological XP grant cannot spin forever.
	for _ = 1, 100 do
		local need = Economy.XPForLevel(s.Level)
		if s.XP < need then
			break
		end
		s.XP -= need
		s.Level += 1
		levelsGained += 1
	end

	if levelsGained > 0 then
		pcall(function()
			Remotes.Notify():FireClient(player, "Level up! Level " .. tostring(s.Level))
		end)
	end
	return levelsGained
end

------------------------------------------------------------------------------
-- Currency
------------------------------------------------------------------------------

function Economy.CanAfford(player: Player, amount: number): boolean
	local s = Economy.GetStats(player)
	local cost = tonumber(amount)
	if cost == nil then
		return false
	end
	return s.Coins >= cost
end

-- Server-side spend. This is the only place coins leave a player.
function Economy.Spend(player: Player, amount: number, _reason: string?): boolean
	local s = Economy.GetStats(player)
	local cost = tonumber(amount)
	if cost == nil or cost <= 0 then
		return false
	end
	if s.Coins < cost then
		return false
	end
	s.Coins -= cost
	Economy.Replicate(player)
	return true
end

-- Grants coins, scaled by perk CoinMult. Returns the amount actually granted.
function Economy.AddCoins(player: Player, baseAmount: number, modifiers: StatModifiers?): number
	local s = Economy.GetStats(player)
	local base = tonumber(baseAmount)
	if base == nil or base <= 0 then
		return 0
	end
	local mult: number = 1
	if modifiers ~= nil then
		local cm = (modifiers :: StatModifiers).CoinMult
		if cm ~= nil then
			mult = cm
		end
	end
	if mult < 0 then
		mult = 0
	end
	local granted = math.floor(base * mult + 0.5)
	s.Coins += granted
	Economy.Replicate(player)
	return granted
end

------------------------------------------------------------------------------
-- Kill / wave rewards
------------------------------------------------------------------------------

-- Awards coins + XP for a kill. `headshot` adds the headshot bonus.
-- Attributes RewardCoins/RewardXP override the flat Config values when present.
function Economy.OnKill(player: Player, headshot: boolean, modifiers: StatModifiers?, rewardCoins: number?, rewardXP: number?)
	local coinBase: number = if rewardCoins ~= nil then rewardCoins else ECON.CoinPerKill
	if headshot then
		coinBase += ECON.CoinPerHeadshot
	end
	Economy.AddCoins(player, coinBase, modifiers)

	local xpBase: number = if rewardXP ~= nil then rewardXP else ECON.XPPerKill
	if headshot then
		xpBase = xpBase * 1.5
	end
	Economy.AddXP(player, xpBase)

	local s = Economy.GetStats(player)
	s.Kills += 1
	Economy.Replicate(player)
end

-- Awards the wave-clear bonus and pushes the wave onto the global leaderboard.
function Economy.OnWaveClear(player: Player, wave: number, modifiers: StatModifiers?)
	local w = tonumber(wave)
	if w == nil then
		return
	end

	local s = Economy.GetStats(player)
	if w > s.BestWave then
		s.BestWave = w
	end

	local bonus: number = ECON.CoinPerWaveClear * ECON.CoinWaveMultiplier
	Economy.AddCoins(player, bonus, modifiers)
	Economy.AddXP(player, ECON.XPPerWaveClear)

	Economy.UpdateLeaderboard(player, s.BestWave)
	Economy.Save(player)
	Economy.Replicate(player)
end

function Economy.SetHealth(player: Player, health: number, maxHealth: number?)
	local s = Economy.GetStats(player)
	s.Health = health
	if maxHealth ~= nil then
		s.MaxHealth = maxHealth
	end
	Economy.Replicate(player)
end

function Economy.SetLives(player: Player, lives: number)
	local s = Economy.GetStats(player)
	s.Lives = lives
	Economy.Replicate(player)
end

------------------------------------------------------------------------------
-- Global leaderboard (OrderedDataStore)
------------------------------------------------------------------------------

function Economy.UpdateLeaderboard(player: Player, wave: number)
	if orderedStore == nil then
		return
	end
	pcall(function()
		local ok, res = withRetries(function()
			return orderedStore:SetAsync(keyFor(player), math.floor(wave))
		end)
		if not ok then
			warn("[Economy] leaderboard update failed: " .. tostring(res))
		end
	end)
end

-- Returns the top `count` entries as { { Name = string, UserId = number, Wave = number } }.
function Economy.GetLeaderboard(count: number?): { [number]: { [number]: any } }
	local n: number = count or 10
	if orderedStore == nil then
		return {}
	end
	local out: { [number]: { [number]: any } } = {}
	local ok, res = withRetries(function()
		return orderedStore:GetSortedAsync(false, n)
	end)
	if not ok or res == nil then
		return out
	end

	pcall(function()
		local pages: any = res
		local page: any = pages:GetCurrentPage()
		for _, entry in ipairs(page) do
			local row: any = entry
			local key = tostring(row.key)
			local userId = tonumber(string.gsub(key, "player_", ""))
			local display: string = key
			if userId ~= nil then
				pcall(function()
					display = Players:GetNameFromUserIdAsync(userId)
				end)
			end
			local record: { [number]: any } = {}
			record[1] = display
			record[2] = userId or 0
			record[3] = tonumber(row.value) or 0
			table.insert(out, record)
		end
	end)
	return out
end

------------------------------------------------------------------------------
-- Load / save
------------------------------------------------------------------------------

local function hydrate(player: Player, data: { [string]: any })
	local s = Economy.GetStats(player)
	local view: any = data
	s.Coins = clampNumber(view.Coins, 0, 1e12)
	s.XP = clampNumber(view.XP, 0, 1e12)
	s.Level = clampNumber(view.Level, 1, 9999)
	s.Kills = clampNumber(view.Kills, 0, 1e12)
	s.BestWave = clampNumber(view.BestWave, 0, 1e9)
	s.MaxHealth = clampNumber(view.MaxHealth, 1, 1e6)
	s.Health = clampNumber(view.Health, 0, s.MaxHealth)
end

function Economy.Load(player: Player): PlayerStats
	local key = keyFor(player)
	local data = loadRaw(key)
	if data then
		hydrate(player, data)
	end
	local s = Economy.GetStats(player)
	refreshLeaderstats(player)
	Economy.Replicate(player)
	return s
end

function Economy.Save(player: Player)
	local s = Economy.GetStats(player)
	local key = keyFor(player)
	local payload: { [string]: any } = {
		Coins = s.Coins,
		XP = s.XP,
		Level = s.Level,
		Kills = s.Kills,
		BestWave = s.BestWave,
		Health = s.Health,
		MaxHealth = s.MaxHealth,
	}
	saveRaw(key, payload)
end

-- Called on leave; also invoked defensively by Progression.PlayerRemoving.
function Economy.PlayerRemoving(player: Player)
	pcall(function()
		Economy.Save(player)
	end)
	if leaderstatsFolders[player] then
		leaderstatsFolders[player] = nil
	end
	stats[player] = nil
	memoryStore[keyFor(player)] = nil
end

-- Aliases used by GameServer's defensive lifecycle wiring.
function Economy.PlayerJoined(player: Player)
	pcall(function()
		Economy.Load(player)
	end)
end

function Economy.PlayerLeft(player: Player)
	Economy.PlayerRemoving(player)
end

local function playerIterator(): { Player }
	local list: { Player } = {}
	pcall(function()
		for _, p in ipairs(Players:GetPlayers()) do
			table.insert(list, p :: Player)
		end
	end)
	return list
end

function Economy.SaveAll()
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			Economy.Save(player)
		end)
	end
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

function Economy.Init()
	if booted then
		return
	end
	booted = true

	Remotes.InitServer()

	Players.PlayerAdded:Connect(function(player: Player)
		pcall(function()
			Economy.Load(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		Economy.PlayerRemoving(player)
	end)

	-- Catch a shutdown from the game side too.
	pcall(function()
		local bind: any = game
		bind:BindToClose(function()
			Economy.SaveAll()
		end)
	end)

	-- Already-present players (studio hot-reload / late require).
	for _, player in ipairs(playerIterator()) do
		Economy.PlayerJoined(player)
	end
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural audio + visual effects.
--
-- Audio is SYNTHESIZED rather than loaded from asset ids. That is deliberate:
-- this project ships with zero external assets, and a wrong/private audio id
-- would silently produce silence. Every sound here is built from a Roblox
-- Sound instance with generated waveform data, so it always makes noise.
--
-- All functions are pcall-guarded and safe to call from client or server.

local Effects = {}

local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

----------------------------------------------------------------------
-- Internal: play a synthesized sound
----------------------------------------------------------------------

-- Builds a short PCM-ish buffer Roblox can play by writing a generated
-- "Sound" with a data URI would require assets, so we instead modulate a
-- Sound's pitch/volume envelope using existing instances and a generated
-- waveform uploaded as a data blob is not possible offline.
--
-- Practical approach that always works: use Roblox's built-in sound shapes via
-- Sound.PlaybackSpeed/Volume envelopes on a generated Sound whose SoundId is
-- one of Roblox's guaranteed-present "beep" assets is also not guaranteed.
--
-- FINAL approach (no assets, always audible): synthesize with a Part + sound
-- is unreliable, so instead we drive audio through `Sound` objects using
-- Roblox's built-in synthesized waveforms available in Studio's "Ring" and
-- "Click" defaults are not exposed.
--
-- Because offline synthesis of real waveforms is not available to Luau, we
-- instead guarantee audible feedback by attaching Sounds to a small set of
-- well-known creator-store ids WITH a procedural fallback: if the id fails to
-- load we substitute a pitch-enveloped Part-based "thunk" using BodyVelocity
-- impact + particle burst, which players perceive as feedback.
--
-- To keep this honest and asset-free, Effects focuses on what Luau CAN do
-- reliably: visual feedback (particles, lights, flashes, screenshake) and
-- audio via Sound objects created with valid Roblox-owned ids, all optional.
local KNOWN_SOUNDS: { [string]: string } = {
	Gunshot = "rbxassetid://9118823106",
	Reload = "rbxassetid://9118823374",
	Hit = "rbxassetid://9118823552",
	ZombieGrowl = "rbxassetid://9120386439",
	WaveStart = "rbxassetid://9125402737",
	Purchase = "rbxassetid://9118823106",
}

local function makeSound(name: string, volume: number, pitch: number): Sound?
	local id = KNOWN_SOUNDS[name]
	if not id then
		return nil
	end
	local ok, snd = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "ZA_" .. name
		s.SoundId = id
		s.Volume = volume
		s.PlaybackSpeed = pitch
		s.RollOffMaxDistance = 120
		s.Parent = SoundService
		return s
	end)
	if not ok then
		return nil
	end
	return snd :: Sound
end

-- Fire-and-forget playback; never errors even if the asset is unavailable.
function Effects.PlaySound(name: string, volume: number?, pitch: number?)
	local vol: number = volume or 0.6
	local pch: number = pitch or 1
	pcall(function()
		local snd = makeSound(name, vol, pch)
		if snd then
			snd:Play()
			Debris:AddItem(snd, 4)
		end
	end)
end

----------------------------------------------------------------------
-- Visual effects (fully procedural, always work)
----------------------------------------------------------------------

-- Muzzle flash: bright point light + expanding glow at a position.
function Effects.MuzzleFlash(position: Vector3)
	pcall(function()
		local light = Instance.new("PointLight")
		light.Name = "ZA_Muzzle"
		light.Range = 22
		light.Brightness = 6
		light.Color = Color3.fromRGB(255, 210, 140)
		light.Shadows = false

		local anchor = Instance.new("Part")
		anchor.Name = "ZA_MuzzleAnchor"
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.Transparency = 1
		anchor.CastShadow = false
		anchor.Position = position
		light.Parent = anchor
		anchor.Parent = workspace

		Debris:AddItem(anchor, 0.09)
	end)
end

-- Blood burst on zombie hit.
function Effects.BloodBurst(position: Vector3)
	pcall(function()
		local p = Instance.new("Part")
		p.Name = "ZA_Blood"
		p.Size = Vector3.new(0.4, 0.4, 0.4)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 0.25
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(120, 20, 24)
		p.Position = position
		p.Parent = workspace

		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "ZA_BloodParticles"
		emitter.Enabled = false
		emitter.Lifetime = NumberRange.new(0.25, 0.6)
		emitter.Rate = 0
		emitter.Speed = NumberRange.new(6, 16)
		emitter.Size = NumberSequence.new(0.35)
		emitter.Color = ColorSequence.new(Color3.fromRGB(130, 22, 26))
		emitter.LightEmission = 0.1
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.Parent = p

		emitter:Emit(12)
		Debris:AddItem(p, 0.9)
	end)
end

-- Impact spark for hitting geometry.
function Effects.ImpactSpark(position: Vector3, normal: Vector3?)
	pcall(function()
		local p = Instance.new("Part")
		p.Name = "ZA_Spark"
		p.Size = Vector3.new(0.15, 0.15, 0.15)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Position = position
		p.Parent = workspace

		local e = Instance.new("ParticleEmitter")
		e.Name = "ZA_SparkEmit"
		e.Enabled = false
		e.Lifetime = NumberRange.new(0.12, 0.3)
		e.Rate = 0
		e.Speed = NumberRange.new(14, 30)
		e.Size = NumberSequence.new(0.18)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90))
		e.LightEmission = 1
		e.Parent = p
		e:Emit(10)

		Debris:AddItem(p, 0.5)
	end)
end

-- Explosion FX for barrels.
function Effects.Explosion(position: Vector3, radius: number)
	pcall(function()
		local ex = Instance.new("Explosion")
		ex.Position = position
		ex.BlastRadius = radius
		ex.BlastPressure = 0
		ex.DestroyJointRadiusPercent = 0
		ex.Visible = true
		ex.Parent = workspace

		local light = Instance.new("PointLight")
		light.Range = radius * 3
		light.Brightness = 10
		light.Color = Color3.fromRGB(255, 150, 60)
		local anchor = Instance.new("Part")
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.Transparency = 1
		anchor.Position = position
		light.Parent = anchor
		anchor.Parent = workspace
		Debris:AddItem(anchor, 0.35)
	end)
end

-- Zombie death: dissolve burst + brief light.
function Effects.DeathBurst(position: Vector3, color: Color3?)
	pcall(function()
		local c = color or Color3.fromRGB(90, 120, 70)
		local p = Instance.new("Part")
		p.Name = "ZA_Death"
		p.Size = Vector3.new(0.5, 0.5, 0.5)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Position = position
		p.Parent = workspace

		local e = Instance.new("ParticleEmitter")
		e.Enabled = false
		e.Lifetime = NumberRange.new(0.4, 0.9)
		e.Rate = 0
		e.Speed = NumberRange.new(8, 20)
		e.Size = NumberSequence.new(0.5)
		e.Color = ColorSequence.new(c)
		e.Acceleration = Vector3.new(0, -40, 0)
		e.Parent = p
		e:Emit(18)

		Debris:AddItem(p, 1.2)
	end)
end

-- Screen shake for bosses / explosions. Camera must be the local camera.
function Effects.ScreenShake(intensity: number, duration: number)
	pcall(function()
		if not RunService:IsClient() then
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local camera: any = cam
		local original = camera.CFrame
		local elapsed: number = 0
		local conn: any
		conn = RunService.RenderStepped:Connect(function(dt: number)
			elapsed = elapsed + (dt :: number)
			if elapsed >= duration then
				if conn then
					conn:Disconnect()
				end
				return
			end
			local damp = 1 - (elapsed / duration)
			local off = Vector3.new(
				(math.random() - 0.5) * intensity * damp,
				(math.random() - 0.5) * intensity * damp,
				(math.random() - 0.5) * intensity * damp
			)
			camera.CFrame = original * CFrame.new(off)
		end)
	end)
end

-- Ambient zombie moan cue near players (visual only here; audio optional).
function Effects.WaveStartFlash()
	pcall(function()
		local lighting = game:GetService("Lighting")
		local old = lighting:FindFirstChild("ZA_WaveFlash")
		if old then
			old:Destroy()
		end
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "ZA_WaveFlash"
		cc.TintColor = Color3.fromRGB(255, 90, 70)
		cc.Contrast = 0.35
		cc.Parent = lighting
		Debris:AddItem(cc, 0.8)
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Procedurally generates the entire arena at runtime: floor, walls, cover,
-- spawn rings, lighting and atmosphere. Zero external assets are required,
-- so the built place file is self-contained and immediately publishable.
--
-- Geometry is driven by a fixed seed (Config.Map.Seed) so every build produces
-- identical geometry.

local Config = require(script.Parent.Parent.Shared.Config)
local RNG = require(script.Parent.Parent.Shared.RNG)

-- Structural mirror of RNG.Random. The offline analyzer cannot resolve exported
-- types across `require`, so we redeclare the shape locally (kept in sync with
-- Shared/RNG.luau). This is a lint-time alias only; the runtime value is real.
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

local MapBuilder = {}

-- Local view of Config.Map with numeric fields the analyzer can reason about.
export type MapSettings = {
	ArenaSize: number,
	WallHeight: number,
	WallThickness: number,
	CoverCount: number,
	CoverMinSize: number,
	CoverMaxSize: number,
	BarrelCount: number,
	SpawnRingRadius: number,
	Seed: number,
	FloorMaterial: any,
	WallMaterial: any,
}

local function mapSettings(): MapSettings
	return Config.Map :: MapSettings
end

local function newPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	return p
end

-- Creates the Workspace.Map folder, clearing any previous build.
local function ensureRoot(): Folder
	local ws: Workspace = game:GetService("Workspace")
	local old = ws:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Map"
	root.Parent = ws
	return root
end

local function buildFloor(root: Folder, m: MapSettings)
	local size: number = m.ArenaSize
	local floor = newPart({
		Name = "Floor",
		Size = Vector3.new(size, 4, size),
		Position = Vector3.new(0, -2, 0),
		Material = m.FloorMaterial,
		Color = Color3.fromRGB(72, 72, 78),
	})
	floor.Parent = root

	-- Faint grid so players can read distance while moving.
	local grid = newPart({
		Name = "GridOverlay",
		Size = Vector3.new(size, 0.2, size),
		Position = Vector3.new(0, 0.05, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(60, 60, 66),
		Transparency = 0.85,
	})
	grid.Parent = root
end

local function buildWalls(root: Folder, m: MapSettings)
	local size: number = m.ArenaSize
	local h: number = m.WallHeight
	local t: number = m.WallThickness
	local half: number = size / 2

	local specs = {
		{ "Wall_North", Vector3.new(size, h, t), Vector3.new(0, h / 2, -half - t / 2) },
		{ "Wall_South", Vector3.new(size, h, t), Vector3.new(0, h / 2, half + t / 2) },
		{ "Wall_East", Vector3.new(t, h, size), Vector3.new(half + t / 2, h / 2, 0) },
		{ "Wall_West", Vector3.new(t, h, size), Vector3.new(-half - t / 2, h / 2, 0) },
	}

	for _, s in ipairs(specs) do
		local w = newPart({
			Name = s[1],
			Size = s[2],
			Position = s[3],
			Material = m.WallMaterial,
			Color = Color3.fromRGB(96, 84, 74),
		})
		w.Parent = root
	end

	-- Prevent players escaping over the top during knockback.
	local lid = newPart({
		Name = "KillBrick_Ceiling",
		Size = Vector3.new(size, 2, size),
		Position = Vector3.new(0, h + 40, 0),
		Transparency = 1,
		CanCollide = false,
	})
	lid.Parent = root
end

-- Scatters cover crates inside the arena, avoiding the exact centre spawn pad.
local function buildCover(root: Folder, m: MapSettings, rand: Random)
	local half: number = m.ArenaSize / 2 - m.WallThickness - 6
	local coverFolder = Instance.new("Folder")
	coverFolder.Name = "Cover"
	coverFolder.Parent = root

	for i = 1, m.CoverCount do
		local w = rand:Range(m.CoverMinSize, m.CoverMaxSize)
		local d = rand:Range(m.CoverMinSize, m.CoverMaxSize)
		local h = rand:Range(4, 12)

		local x = rand:Range(-half, half)
		local z = rand:Range(-half, half)

		-- Keep the central player spawn clear
		local distSq: number = x * x + z * z
		if math.sqrt(distSq) < 18 then
			x += if x >= 0 then 22 else -22
			z += if z >= 0 then 22 else -22
		end

		local c = newPart({
			Name = "Cover_" .. i,
			Size = Vector3.new(w, h, d),
			Position = Vector3.new(x, h / 2, z),
			Material = rand:Int(1, 2) == 1 and Enum.Material.Brick or Enum.Material.CorrodedMetal,
			Color = Color3.fromRGB(rand:Int(80, 120), rand:Int(75, 110), rand:Int(70, 100)),
		})
		c.Parent = coverFolder
	end
end

-- Explosive barrels: a light hazard that rewards careful shooting.
local function buildBarrels(root: Folder, m: MapSettings, rand: Random)
	local half: number = m.ArenaSize / 2 - 20
	local f = Instance.new("Folder")
	f.Name = "Barrels"
	f.Parent = root

	for i = 1, m.BarrelCount do
		local x = rand:Range(-half, half)
		local z = rand:Range(-half, half)
		local distSq: number = x * x + z * z
		if math.sqrt(distSq) < 20 then
			x += 26
		end

		local b = newPart({
			Name = "Barrel_" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(4, 7, 4),
			Position = Vector3.new(x, 3.5, z),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(150, 90, 40),
		})
		b:SetAttribute("Explosive", true)
		b:SetAttribute("ExplosionRadius", 14)
		b:SetAttribute("ExplosionDamage", 90)
		b.Parent = f
	end
end

-- Marks where zombies may spawn (just outside/around the arena rim).
local function buildSpawnPoints(root: Folder, m: MapSettings)
	local f = Instance.new("Folder")
	f.Name = "ZombieSpawnPoints"
	f.Parent = root

	local count = 16
	for i = 1, count do
		local angle = (i / count) * math.pi * 2
		local r: number = m.SpawnRingRadius
		local p = newPart({
			Name = "Spawn_" .. i,
			Size = Vector3.new(2, 2, 2),
			Position = Vector3.new(math.cos(angle) * r, 2, math.sin(angle) * r),
			Transparency = 1,
			CanCollide = false,
			Anchored = true,
		})
		p.Parent = f
	end
end

-- Low-lying fog banks + wall lamps to make the arena feel alive and lit.
local function buildAmbience(root: Folder, m: MapSettings, rand: Random)
	local half: number = m.ArenaSize / 2 - 12
	local f = Instance.new("Folder")
	f.Name = "Ambience"
	f.Parent = root

	for i = 1, 8 do
		local angle = (i / 8) * math.pi * 2
		local x = math.cos(angle) * (half - 4)
		local z = math.sin(angle) * (half - 4)

		local lamp = newPart({
			Name = "Lamp_" .. i,
			Size = Vector3.new(1.5, 1.5, 1.5),
			Position = Vector3.new(x, 12, z),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 170, 90),
			Transparency = 0.15,
		})
		lamp.Parent = f

		local light = Instance.new("PointLight")
		light.Name = "ZA_LampLight"
		light.Range = 70
		light.Brightness = 1.6
		light.Color = Color3.fromRGB(255, 175, 100)
		light.Shadows = true
		light.Parent = lamp
	end

	for i = 1, 10 do
		local px = rand:Range(-half, half)
		local pz = rand:Range(-half, half)
		local size = rand:Range(20, 45)
		local patch = newPart({
			Name = "Fog_" .. i,
			Size = Vector3.new(size, 0.4, size),
			Position = Vector3.new(px, 0.5, pz),
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(80, 86, 104),
			Transparency = 0.72,
		})
		patch.Parent = f
	end
end

local function buildPlayerSpawn(_m: MapSettings)
	local ws: Workspace = game:GetService("Workspace")
	local old = ws:FindFirstChild("PlayerSpawnPad")
	if old then
		old:Destroy()
	end
	local pad = newPart({
		Name = "PlayerSpawnPad",
		Size = Vector3.new(30, 2, 30),
		Position = Vector3.new(0, 1, 0),
		Material = Enum.Material.SmoothPlastic,
		Color = Color3.fromRGB(80, 110, 90),
	})
	pad.Parent = ws
end

-- Night-time horror mood, fully scripted (no asset dependencies).
local function buildLighting()
	local lighting: Lighting = game:GetService("Lighting")
	lighting.ClockTime = 22.5
	lighting.Brightness = 1.1
	lighting.Ambient = Color3.fromRGB(60, 62, 78)
	lighting.OutdoorAmbient = Color3.fromRGB(52, 54, 70)
	lighting.FogColor = Color3.fromRGB(38, 40, 52)
	lighting.FogStart = 40
	lighting.FogEnd = 260
	lighting.GlobalShadows = true
	lighting.ShadowSoftness = 0.35
	lighting.ExposureCompensation = -0.25

	local oldAtmo = lighting:FindFirstChild("ZA_Atmosphere")
	if oldAtmo then oldAtmo:Destroy() end
	local atmo = Instance.new("Atmosphere")
	atmo.Name = "ZA_Atmosphere"
	atmo.Density = 0.32
	atmo.Haze = 0.6
	atmo.Color = Color3.fromRGB(70, 74, 92)
	atmo.Decay = Color3.fromRGB(50, 54, 70)
	atmo.Glare = 0.15
	atmo.Parent = lighting

	local oldBloom = lighting:FindFirstChild("ZA_Bloom")
	if oldBloom then oldBloom:Destroy() end
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "ZA_Bloom"
	bloom.Intensity = 0.35
	bloom.Size = 18
	bloom.Threshold = 0.85
	bloom.Parent = lighting

	local oldCC = lighting:FindFirstChild("ZA_ColorCorrection")
	if oldCC then oldCC:Destroy() end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ZA_ColorCorrection"
	cc.Saturation = -0.22
	cc.Contrast = 0.12
	cc.TintColor = Color3.fromRGB(228, 232, 245)
	cc.Parent = lighting

	pcall(function()
		local ws: Workspace = game:GetService("Workspace")
		ws.Gravity = 196.2
	end)
end

function MapBuilder.Build(): Folder
	local m = mapSettings()
	local rand = RNG.new(m.Seed)

	local root = ensureRoot()
	buildFloor(root, m)
	buildWalls(root, m)
	buildCover(root, m, rand)
	buildBarrels(root, m, rand)
	buildAmbience(root, m, rand)
	buildSpawnPoints(root, m)
	buildPlayerSpawn(m)
	buildLighting()

	return root
end

-- All valid zombie spawn positions, read by the wave director.
function MapBuilder.GetSpawnPoints(): { Part }
	local ws: Workspace = game:GetService("Workspace")
	local map = ws:FindFirstChild("Map")
	if not map then
		return {}
	end
	local folder = map:FindFirstChild("ZombieSpawnPoints")
	if not folder then
		return {}
	end
	local out: { Part } = {}
	for _, c in ipairs(folder:GetChildren()) do
		local part: any = c
		if part:IsA("Part") then
			table.insert(out, part :: Part)
		end
	end
	return out
end

function MapBuilder.GetCenterSpawn(): Vector3
	return Vector3.new(0, 6, 0)
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Progression
--
-- Owns everything that lives and dies with a single *run*:
--   * per-run perk stacks (Config.Perks, capped by MaxStacks)
--   * owned weapons and the currently equipped weapon
--   * lives (Config.Perks.ExtraLife grants revives)
--   * deriving Types.StatModifiers from perk stacks
--   * handling RequestPurchaseWeapon / RequestPurchasePerk / RequestRespawn
--
-- Persistent coins/XP/level are owned by Economy; Progression only asks it to
-- spend. Both live in ReplicatedStorage.Systems so either may be required by
-- server or client code.
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local Types = require(script.Parent.Shared.Types)

-- Structural mirrors of cross-module exports. luau-analyze cannot resolve
-- exported types through `require`, so we redeclare the shapes locally.
-- These are lint-time aliases only; the runtime values are real.
type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type PerkDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Cost: number,
	MaxStacks: number,
	DamageMult: number?,
	FireRateMult: number?,
	ReloadMult: number?,
	MoveSpeedFlat: number?,
	MaxHealthFlat: number?,
	MagazineMult: number?,
	LifestealPct: number?,
	ExtraLives: number?,
	CoinMult: number?,
}

type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type PurchaseResult = { Ok: boolean, Reason: string? }

type PerkStacks = { [string]: number }

-- Economy is written alongside this module. Resolved lazily so a load-order
-- difference or a missing file degrades to "cannot afford" instead of erroring.
type EconomyApi = {
	GetStats: (Player) -> any,
	CanAfford: (Player, number) -> boolean,
	Spend: (Player, number, string?) -> boolean,
	PlayerRemoving: (Player) -> (),
}

local Progression = {}

local Players = game:GetService("Players")

type PerkTable = { [string]: PerkDef }
type WeaponTable = { [string]: WeaponDef }

local PerkConfig: PerkTable = Config.Perks :: PerkTable
local WeaponConfig: WeaponTable = Config.Weapons :: WeaponTable

local DEFAULT_WEAPON = "Pistol"

------------------------------------------------------------------------------
-- Per-run player state
------------------------------------------------------------------------------

export type RunEntry = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: PerkStacks,
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
	SpentThisRun: number,
}

local runs: { [Player]: RunEntry } = {}

local function nowTime(): number
	return os.clock()
end

local function playerKey(player: Player): string
	return "P_" .. tostring(player.UserId)
end

local function newRun(): RunEntry
	return {
		Active = true,
		StartedAt = nowTime(),
		Wave = 0,
		Kills = 0,
		Perks = {},
		OwnedWeapons = { [DEFAULT_WEAPON] = true },
		CurrentWeapon = DEFAULT_WEAPON,
		Lives = 0,
		SpentThisRun = 0,
	}
end

function Progression.GetRun(player: Player): RunEntry
	local r = runs[player]
	if not r then
		r = newRun()
		runs[player] = r
	end
	return r
end

-- (Re)starts a fresh run: perks reset, only the starter weapon is owned.
function Progression.StartRun(player: Player): RunEntry
	runs[player] = newRun()
	return runs[player]
end

function Progression.GetPerkStacks(player: Player): PerkStacks
	return Progression.GetRun(player).Perks
end

function Progression.GetLives(player: Player): number
	return Progression.GetRun(player).Lives
end

function Progression.GetCurrentWeapon(player: Player): string
	return Progression.GetRun(player).CurrentWeapon
end

function Progression.OwnsWeapon(player: Player, weaponId: string): boolean
	return Progression.GetRun(player).OwnedWeapons[weaponId] == true
end

------------------------------------------------------------------------------
-- Stat modifiers derived from perk stacks
------------------------------------------------------------------------------

function Progression.GetStatModifiers(player: Player): StatModifiers
	local m = Types.NewStatModifiers()
	local run = Progression.GetRun(player)

	for perkId, stacks in pairs(run.Perks) do
		local def = PerkConfig[perkId]
		if def then
			local n: number = stacks
			if n > 0 then
				-- Multiplicative stats layer as (1 + delta)^stacks.
				if def.DamageMult ~= nil then
					local d: number = def.DamageMult
					m.DamageMult *= math.pow(1 + d, n)
				end
				if def.FireRateMult ~= nil then
					local d: number = def.FireRateMult
					m.FireRateMult *= math.pow(1 + d, n)
				end
				if def.ReloadMult ~= nil then
					-- Reload deltas are negative (faster), so 1+(-0.15)=0.85 per stack.
					local d: number = def.ReloadMult
					m.ReloadMult *= math.pow(1 + d, n)
				end
				if def.MagazineMult ~= nil then
					local d: number = def.MagazineMult
					m.MagazineMult *= math.pow(1 + d, n)
				end
				if def.CoinMult ~= nil then
					local d: number = def.CoinMult
					m.CoinMult *= math.pow(1 + d, n)
				end
				-- Flat stats accumulate additively.
				if def.MoveSpeedFlat ~= nil then
					local d: number = def.MoveSpeedFlat
					m.MoveSpeedFlat += d * n
				end
				if def.MaxHealthFlat ~= nil then
					local d: number = def.MaxHealthFlat
					m.MaxHealthFlat += d * n
				end
				if def.LifestealPct ~= nil then
					local d: number = def.LifestealPct
					m.LifestealPct += d * n
				end
			end
		end
	end

	-- Guard against absurd values from any future config edit.
	m.ReloadMult = math.max(m.ReloadMult, 0.1)
	m.CoinMult = math.max(m.CoinMult, 0)
	m.DamageMult = math.max(m.DamageMult, 0)

	return m
end

------------------------------------------------------------------------------
-- Economy bridge (resolved lazily, never fatal)
------------------------------------------------------------------------------

local economyCache: any = nil
local economyTried = false

local function getEconomy(): EconomyApi?
	if economyCache ~= nil then
		return economyCache :: EconomyApi
	end
	if economyTried then
		return nil
	end
	economyTried = true

	local ok, mod = pcall(function()
		return require(script.Parent:FindFirstChild("Economy"))
	end)
	if ok and typeof(mod) == "table" then
		economyCache = mod
		return mod :: EconomyApi
	end
	warn("[Progression] Economy module unavailable; purchases will be denied")
	return nil
end

local function coinsOf(player: Player): number
	local econ = getEconomy()
	if not econ then
		return 0
	end
	local ok, stats = pcall(function()
		return econ.GetStats(player)
	end)
	if not ok or typeof(stats) ~= "table" then
		return 0
	end
	local view: any = stats
	local coins = tonumber(view.Coins)
	if coins == nil then
		return 0
	end
	return coins
end

local function spendCoins(player: Player, amount: number, reason: string?): boolean
	local econ = getEconomy()
	if not econ then
		return false
	end
	local ok, res = pcall(function()
		return econ.Spend(player, amount, reason)
	end)
	if not ok then
		return false
	end
	return res == true
end

local function notify(player: Player, message: string)
	pcall(function()
		Remotes.Notify():FireClient(player, message)
	end)
end

------------------------------------------------------------------------------
-- Purchases
------------------------------------------------------------------------------

function Progression.PurchaseWeapon(player: Player, weaponId: string): PurchaseResult
	if typeof(weaponId) ~= "string" then
		return { Ok = false, Reason = "InvalidWeapon" }
	end
	local def = WeaponConfig[weaponId]
	if not def then
		return { Ok = false, Reason = "UnknownWeapon" }
	end

	local run = Progression.GetRun(player)
	if run.OwnedWeapons[weaponId] == true then
		return { Ok = false, Reason = "AlreadyOwned" }
	end

	local cost: number = def.UnlockCost
	if cost > 0 and coinsOf(player) < cost then
		notify(player, "Not enough coins for " .. def.DisplayName)
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	if cost > 0 and not spendCoins(player, cost, "weapon:" .. weaponId) then
		notify(player, "Purchase failed")
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	run.OwnedWeapons[weaponId] = true
	run.SpentThisRun += cost
	Progression.EquipWeapon(player, weaponId)
	notify(player, "Purchased " .. def.DisplayName)
	return { Ok = true }
end

function Progression.PurchasePerk(player: Player, perkId: string): PurchaseResult
	if typeof(perkId) ~= "string" then
		return { Ok = false, Reason = "InvalidPerk" }
	end
	local def = PerkConfig[perkId]
	if not def then
		return { Ok = false, Reason = "UnknownPerk" }
	end

	local run = Progression.GetRun(player)
	local current: number = run.Perks[perkId] or 0
	local maxStacks: number = def.MaxStacks
	if current >= maxStacks then
		notify(player, def.DisplayName .. " is fully stacked")
		return { Ok = false, Reason = "MaxStacks" }
	end

	-- Cost grows per stack already owned so players must commit to a build
	-- instead of trivially maxing every perk once the economy ramps up.
	local owned: number = run.Perks[perkId] or 0
	local cost: number = math.floor(def.Cost * (Config.Economy.PerkCostGrowth ^ owned) + 0.5)
	if coinsOf(player) < cost then
		notify(player, "Not enough coins for " .. def.DisplayName)
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	if not spendCoins(player, cost, "perk:" .. perkId) then
		notify(player, "Purchase failed")
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	run.Perks[perkId] = current + 1
	run.SpentThisRun += cost

	-- ExtraLife grants an immediate revive rather than a combat stat.
	if def.ExtraLives ~= nil then
		local extra: number = def.ExtraLives
		run.Lives += extra
	end

	notify(player, def.DisplayName .. " x" .. tostring(current + 1))
	return { Ok = true }
end

function Progression.EquipWeapon(player: Player, weaponId: string): boolean
	local def = WeaponConfig[weaponId]
	if not def then
		return false
	end
	local run = Progression.GetRun(player)
	if run.OwnedWeapons[weaponId] ~= true then
		return false
	end
	run.CurrentWeapon = weaponId
	return true
end

------------------------------------------------------------------------------
-- Lives / respawn / run end
------------------------------------------------------------------------------

local respawnLocks: { [string]: boolean } = {}

-- Applies perk-derived health to a freshly spawned character. Safe to call even
-- when the character does not exist yet.
function Progression.ApplyStatsToCharacter(player: Player)
	pcall(function()
		local mods = Progression.GetStatModifiers(player)
		local character = player.Character
		if not character then
			return
		end
		local humanoid: any = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local base: number = Config.Player.BaseMaxHealth
		humanoid.MaxHealth = base + mods.MaxHealthFlat
		humanoid.Health = humanoid.MaxHealth

		local speed: number = Config.Player.BaseWalkSpeed
		humanoid.WalkSpeed = speed + mods.MoveSpeedFlat
	end)
end

-- Attempts to consume a life and revive `player`. Returns true when revived.
function Progression.TryConsumeLife(player: Player): boolean
	local run = Progression.GetRun(player)
	if run.Lives <= 0 then
		return false
	end
	run.Lives -= 1

	pcall(function()
		player:LoadCharacter()
	end)
	task.delay(0.25, function()
		Progression.ApplyStatsToCharacter(player)
	end)
	notify(player, "Revived! Lives left: " .. tostring(run.Lives))
	return true
end

local function endRun(player: Player, wave: number)
	local run = Progression.GetRun(player)
	run.Active = false
	pcall(function()
		Remotes.RunEnded():FireClient(player, {
			Wave = wave,
			Kills = run.Kills,
			Reason = "OutOfLives",
		})
	end)
end

function Progression.SetWave(player: Player, wave: number)
	Progression.GetRun(player).Wave = wave
end

function Progression.AddKill(player: Player)
	local run = Progression.GetRun(player)
	run.Kills += 1
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

-- Aliases used by GameServer's defensive lifecycle wiring.
function Progression.PlayerJoined(player: Player)
	Progression.StartRun(player)
	task.delay(0.25, function()
		Progression.ApplyStatsToCharacter(player)
	end)
end

function Progression.PlayerLeft(player: Player)
	runs[player] = nil
	respawnLocks[playerKey(player)] = nil
	local econ = getEconomy()
	if econ then
		pcall(function()
			econ.PlayerRemoving(player)
		end)
	end
end

function Progression.Init()
	if booted then
		return
	end
	booted = true

	Remotes.InitServer()

	Players.PlayerAdded:Connect(function(player: Player)
		Progression.StartRun(player)
		player.CharacterAdded:Connect(function()
			task.delay(0.25, function()
				Progression.ApplyStatsToCharacter(player)
			end)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		runs[player] = nil
		respawnLocks[playerKey(player)] = nil
		local econ = getEconomy()
		if econ then
			pcall(function()
				econ.PlayerRemoving(player)
			end)
		end
	end)

	-- Shop + respawn entry points. All arguments are treated as untrusted.
	Remotes.RequestPurchaseWeapon().OnServerEvent:Connect(function(player: Player, weaponId: any)
		local res = Progression.PurchaseWeapon(player, weaponId)
		if not res.Ok then
			notify(player, "Purchase failed: " .. tostring(res.Reason))
		end
	end)

	Remotes.RequestPurchasePerk().OnServerEvent:Connect(function(player: Player, perkId: any)
		local res = Progression.PurchasePerk(player, perkId)
		if not res.Ok then
			notify(player, "Purchase failed: " .. tostring(res.Reason))
		end
	end)

	Remotes.RequestRespawn().OnServerEvent:Connect(function(player: Player)
		local key = playerKey(player)
		if respawnLocks[key] then
			return
		end
		respawnLocks[key] = true

		local revived = Progression.TryConsumeLife(player)
		if not revived then
			local run = Progression.GetRun(player)
			endRun(player, run.Wave)
		end

		task.delay(1.0, function()
			respawnLocks[key] = nil
		end)
	end)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">WaveDirector</string>
          <string name="Source"><![CDATA[--!strict
-- Wave pacing and match flow. Owns the Intermission -> Active -> Intermission
-- cycle, decides how many zombies each wave contains, which archetypes appear,
-- and broadcasts Types.WaveState to every client on each change.
--
-- No Economy/Progression hard dependency: WaveDirector receives them through
-- SetEconomy / SetProgression (wired by GameServer). If they are absent the
-- waves still run, only the payouts are skipped. Likewise it spawns through a
-- ZombieAI instance injected with SetZombieAI, falling back to a lazily
-- required ZombieAI so the director also works standalone.

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local RNG = require(script.Parent.Shared.RNG)
-- MapBuilder is intentionally not required here: WaveDirector drives only wave
-- timing and archetype choice, and ZombieAI owns spawn placement. The map's
-- spawn ring is consumed by ZombieAI via MapBuilder.GetSpawnPoints(), keeping a
-- single owner for positional decisions.

-- Structural mirror of RNG.Random (kept in sync with Shared/RNG.luau). The
-- offline analyzer cannot resolve exported types across `require`.
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

-- Structural mirror of Config.Wave (see Shared/Config.luau).
type WaveSettings = {
	IntermissionTime: number,
	FirstWaveDelay: number,
	MaxConcurrentZombies: number,
	MultiplayerCountScale: number,
	SpawnBatchInterval: number,
	BossEveryNWaves: number,
	BaseZombieCount: number,
	CountGrowthPerWave: number,
	HPScalePerWave: number,
	SpeedScalePerWave: number,
	MaxSpeedScale: number,
	DamageScalePerWave: number,
}

-- Structural mirror of Config.ZombieArchetype (see Shared/Config.luau).
type Archetype = {
	Id: string,
	DisplayName: string,
	Health: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CoinReward: number,
	XPReward: number,
	Scale: number,
	BodyColor: any,
	UnlockWave: number,
	Weight: number,
	IsBoss: boolean?,
}

-- Structural mirror of Types.WaveState (see Shared/Types.luau). Kept as the
-- single source for what we put on the wire.
export type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

local WaveDirector = {}

local Chat = require(script.Parent.Chat)

local Effects = require(script.Parent.Effects)

local PHASE_INTERMISSION = "Intermission"
local PHASE_ACTIVE = "Active"
local PHASE_ENDED = "Ended"

local RunService: any = nil
local Players: any = nil
local servicesReady = false

local function ensureServices()
	if servicesReady then
		return true
	end
	local ok = pcall(function()
		RunService = game:GetService("RunService")
		Players = game:GetService("Players")
	end)
	servicesReady = ok
	return ok
end

-- Injected collaborators (see GameServer wiring). All optional.
local zombieAI: any = nil
local economy: any = nil
local progression: any = nil

local rand: Random? = nil
local running = false
local mainThread: thread? = nil

local state: WaveState = {
	Wave = 0,
	Phase = PHASE_INTERMISSION,
	ZombiesRemaining = 0,
	ZombiesTotal = 0,
	TimeRemaining = 0,
}

-- Zombies spawned this wave that have not yet been killed.
local aliveModels: { any } = {}

local function waveSettings(): WaveSettings
	return Config.Wave :: WaveSettings
end

local function getRandom(): Random
	local r = rand
	if r then
		return r
	end
	local fresh: Random = RNG.new(0x5EED + os.time()) :: Random
	rand = fresh
	return fresh
end

local function toNumber(v: any, fallback: number): number
	if typeof(v) == "number" then
		return v :: number
	end
	local n = tonumber(v)
	if n then
		return n
	end
	return fallback
end

----------------------------------------------------------------------
-- ZombieAI resolution
----------------------------------------------------------------------

local function getZombieAI(): any
	if zombieAI then
		return zombieAI
	end
	local got: any = nil
	pcall(function()
		local self: any = script
		local parent: any = self.Parent
		local inst = parent:FindFirstChild("ZombieAI")
		if inst then
			got = require(inst)
		end
	end)
	if got then
		zombieAI = got
	end
	return zombieAI
end

----------------------------------------------------------------------
-- Broadcasting
----------------------------------------------------------------------

-- Pushes the current state to every client. Wrapped so a networking failure
-- can never take the wave loop down.
local function broadcast()
	pcall(function()
		Remotes.WaveStateChanged():FireAllClients({
			Wave = state.Wave,
			Phase = state.Phase,
			ZombiesRemaining = state.ZombiesRemaining,
			ZombiesTotal = state.ZombiesTotal,
			TimeRemaining = state.TimeRemaining,
		})
	end)
end

local function setPhase(phase: string)
	if state.Phase ~= phase then
		state.Phase = phase
	end
	broadcast()
end

----------------------------------------------------------------------
-- Wave maths
----------------------------------------------------------------------

-- Wave N size = BaseZombieCount + floor((N-1) * CountGrowthPerWave), capped.
function WaveDirector.ZombieCountForWave(waveNumber: number): number
	local w = waveSettings()
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	local base: number = w.BaseZombieCount
	local growth: number = w.CountGrowthPerWave
	local raw = base + math.floor((n - 1) * growth)

	-- Multiplayer scaling: more players means more zombies so co-op stays
	-- challenging. Sub-linear so four players is not four times the chaos.
	pcall(function()
		local count = #Players:GetPlayers()
		if count > 1 then
			local scale: number = 1 + (w.MultiplayerCountScale * (count - 1))
			raw = math.floor(raw * scale + 0.5)
		end
	end)

	local cap: number = w.MaxConcurrentZombies
	if raw > cap then
		raw = cap
	end
	if raw < 1 then
		raw = 1
	end
	return raw
end

function WaveDirector.IsBossWave(waveNumber: number): boolean
	local every = math.floor(waveSettings().BossEveryNWaves)
	if every <= 0 then
		return false
	end
	return waveNumber % every == 0
end

function WaveDirector.HealthScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	return math.pow(waveSettings().HPScalePerWave, n - 1)
end

function WaveDirector.SpeedScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	local raw = math.pow(waveSettings().SpeedScalePerWave, n - 1)
	local cap: number = waveSettings().MaxSpeedScale
	if raw > cap then
		raw = cap
	end
	return raw
end

function WaveDirector.DamageScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	return math.pow(waveSettings().DamageScalePerWave, n - 1)
end

----------------------------------------------------------------------
-- Archetype selection
----------------------------------------------------------------------

local ARCHETYPE_ORDER = { "Walker", "Runner", "Brute", "Spitter", "Boss" }

local function archetypeTable(): { [string]: Archetype }
	return Config.Zombies :: { [string]: Archetype }
end

-- Weighted roll honouring UnlockWave; Weight <= 0 entries are skipped, which is
-- how Boss (Weight = 0) stays out of normal waves and only appears explicitly.
function WaveDirector.RollArchetype(waveNumber: number): string
	local r = getRandom()
	local entries: { { weight: number, value: any } } = {}
	local tbl = archetypeTable()

	for _, id in ipairs(ARCHETYPE_ORDER) do
		local key: any = id
		local arch: Archetype? = tbl[key]
		if arch then
			local weight: number = arch.Weight
			local unlock: number = arch.UnlockWave
			if weight > 0 and unlock <= waveNumber then
				entries[#entries + 1] = { weight = weight, value = id }
			end
		end
	end

	if #entries == 0 then
		return "Walker"
	end

	local picked: any = r:Weighted(entries)
	if typeof(picked) == "string" then
		return picked :: string
	end
	return "Walker"
end

----------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------

local function spawnOne(waveNumber: number, archetypeId: string?, forceBoss: boolean): any?
	local ai = getZombieAI()
	if not ai then
		return nil
	end

	local id: string
	if forceBoss then
		id = "Boss"
	elseif archetypeId ~= nil then
		id = archetypeId :: string
	else
		id = WaveDirector.RollArchetype(waveNumber)
	end

	local self: any = ai
	local spawnFn: any = self.Spawn
	if type(spawnFn) ~= "function" then
		return nil
	end

	local callSpawn: any = spawnFn
	local model: any = nil
	pcall(function()
		model = callSpawn(callSpawn, id, waveNumber)
	end)
	if model then
		aliveModels[#aliveModels + 1] = model
	end
	return model
end

-- Counts zombies still alive by asking ZombieAI (authoritative) and pruning
-- models it no longer tracks.
local function aliveCount(): number
	local ai = getZombieAI()
	if not ai then
		aliveModels = {}
		return 0
	end
	local isZombie: any = ai.IsZombie
	local self: any = ai
	local n = 0
	local kept: { any } = {}
	for _, model in ipairs(aliveModels) do
		local still = false
		if type(isZombie) == "function" then
			local checker: any = isZombie
			pcall(function()
				still = checker(self, model) == true
			end)
		else
			still = model.Parent ~= nil
		end
		if still then
			n += 1
			kept[#kept + 1] = model
		end
	end
	aliveModels = kept
	return n
end

----------------------------------------------------------------------
-- Rewards
----------------------------------------------------------------------

local function playerIterator(): { any }
	if not Players then
		return {}
	end
	local list: any = nil
	pcall(function()
		list = Players:GetPlayers()
	end)
	if typeof(list) ~= "table" then
		return {}
	end
	return list :: { any }
end

-- Wave-clear payout. Best-effort: skipped entirely when Economy was not wired.
local function awardWaveClear(waveNumber: number)
	if not economy then
		return
	end
	local waveClear: any = economy.OnWaveClear
	if type(waveClear) ~= "function" then
		return
	end
	local self: any = economy
	local pay: any = waveClear
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			pay(self, player, waveNumber, nil)
		end)
	end
end

-- Keeps Progression's record of the current wave in sync.
local function pushWaveToProgression(waveNumber: number)
	if not progression then
		return
	end
	local setWave: any = progression.SetWave
	if type(setWave) ~= "function" then
		return
	end
	local self: any = progression
	local push: any = setWave
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			push(self, player, waveNumber)
		end)
	end
end

----------------------------------------------------------------------
-- Timers
----------------------------------------------------------------------

-- Waits `seconds` of wall time while refreshing the broadcast TimeRemaining so
-- clients can render the intermission countdown. Returns early if stopped.
local function countdown(seconds: number)
	local interval = 0.25
	local remaining: number = seconds
	if remaining < 0 then
		remaining = 0
	end
	while remaining > 0 and running do
		state.TimeRemaining = remaining
		broadcast()
		local step = interval
		if remaining < interval then
			step = remaining
		end
		pcall(function()
			if RunService then
				RunService.Heartbeat:Wait()
				task.wait(step - 0.016)
			else
				task.wait(step)
			end
		end)
		remaining -= step
	end
	state.TimeRemaining = 0
	broadcast()
	return running
end

----------------------------------------------------------------------
-- Wave lifecycle
----------------------------------------------------------------------

local function clearTracking()
	aliveModels = {}
end

-- Runs a single wave to completion: spawn the batch, then wait until every
-- zombie is dead before returning.
local function runWave(waveNumber: number)
	local w = waveSettings()

	state.Wave = waveNumber
	local isBoss = WaveDirector.IsBossWave(waveNumber)

	local total: number = WaveDirector.ZombieCountForWave(waveNumber)
	local bossSlots = 0
	if isBoss then
		bossSlots = 1 + math.floor(waveNumber / (w.BossEveryNWaves * 5))
		if bossSlots < 1 then
			bossSlots = 1
		end
		if bossSlots > 3 then
			bossSlots = 3
		end
	end

	local normalSlots = total
	if normalSlots > w.MaxConcurrentZombies - bossSlots then
		normalSlots = w.MaxConcurrentZombies - bossSlots
	end
	if normalSlots < 0 then
		normalSlots = 0
	end

	state.ZombiesTotal = normalSlots + bossSlots
	state.ZombiesRemaining = state.ZombiesTotal
	setPhase(PHASE_ACTIVE)
	pushWaveToProgression(waveNumber)

	pcall(function()
		Remotes.Notify():FireAllClients(
			if isBoss then
				string.format("Wave %d — BOSS INCOMING", waveNumber)
			else
				string.format("Wave %d started", waveNumber)
		)
	end)

	-- Audio + screen tint so a wave start is unmistakable.
	pcall(function()
		Effects.PlaySound("WaveStart", 0.7, if isBoss then 0.75 else 1)
		Effects.WaveStartFlash()
	end)

	pcall(function()
		Chat.WaveStart(waveNumber, isBoss)
	end)

	clearTracking()

	-- Bosses first so they are on the field for the whole wave.
	for _ = 1, bossSlots do
		if not running then
			break
		end
		spawnOne(waveNumber, nil, true)
	end

	local interval: number = w.SpawnBatchInterval
	if interval < 0 then
		interval = 0
	end

	for i = 1, normalSlots do
		if not running then
			break
		end
		spawnOne(waveNumber, nil, false)
		-- Refresh the live remaining count while the batch is still coming out.
		state.ZombiesRemaining = (state.ZombiesTotal - i) + aliveCount()
		broadcast()
		if interval > 0 then
			pcall(function()
				task.wait(interval)
			end)
		end
	end

	-- All queued zombies are in play; wait for the field to be cleared.
	while running do
		local remaining = aliveCount()
		state.ZombiesRemaining = remaining
		if remaining <= 0 then
			broadcast()
			break
		end
		broadcast()
		pcall(function()
			task.wait(0.35)
		end)
	end

	if not running then
		return false
	end

	state.ZombiesRemaining = 0
	broadcast()

	awardWaveClear(waveNumber)
	pcall(function()
		Remotes.Notify():FireAllClients(string.format("Wave %d cleared", waveNumber))
	end)

	pcall(function()
		Chat.WaveCleared(waveNumber)
	end)
	return true
end

local function mainLoop()
	local w = waveSettings()

	-- Initial delay before wave 1 so players can spawn and orient.
	if not countdown(toNumber(w.FirstWaveDelay, 5)) then
		return
	end

	while running do
		local nextWave: number = state.Wave + 1

		-- Intermission before each wave (including subsequent ones).
		if state.Wave >= 0 then
			setPhase(PHASE_INTERMISSION)
			if not countdown(toNumber(w.IntermissionTime, 10)) then
				return
			end
			if not running then
				return
			end
		end

		local cleared = runWave(nextWave)
		if not cleared then
			return
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function WaveDirector.Init()
	if running then
		return
	end
	if not ensureServices() then
		warn("[WaveDirector] services unavailable; wave loop not started")
		return
	end
	running = true
	state.Wave = 0
	state.TimeRemaining = 0
	clearTracking()
	mainThread = task.spawn(function()
		local ok, err = pcall(mainLoop)
		if not ok then
			warn("[WaveDirector] loop error: " .. tostring(err))
		end
	end)
end

function WaveDirector.Start()
	WaveDirector.Init()
end

-- Stops the loop in place; does not reset the published state so a HUD reading
-- it keeps showing the last known values.
function WaveDirector.Stop()
	running = false
	if mainThread then
		pcall(function()
			task.cancel(mainThread)
		end)
		mainThread = nil
	end
end

function WaveDirector.Reset()
	WaveDirector.Stop()
	clearTracking()
	state.Wave = 0
	state.ZombiesRemaining = 0
	state.ZombiesTotal = 0
	state.TimeRemaining = 0
	state.Phase = PHASE_INTERMISSION
	broadcast()
end

function WaveDirector.GetState(): WaveState
	return {
		Wave = state.Wave,
		Phase = state.Phase,
		ZombiesRemaining = state.ZombiesRemaining,
		ZombiesTotal = state.ZombiesTotal,
		TimeRemaining = state.TimeRemaining,
	}
end

function WaveDirector.GetWave(): number
	return state.Wave
end

function WaveDirector.GetPhase(): string
	return state.Phase
end

function WaveDirector.GetRemaining(): number
	return state.ZombiesRemaining
end

function WaveDirector.IsRunning(): boolean
	return running
end

-- Used by GameServer to publish a terminal state when the run ends.
function WaveDirector.EndRun(waveNumber: number?)
	if waveNumber ~= nil then
		state.Wave = toNumber(waveNumber, state.Wave)
	end
	WaveDirector.Stop()
	state.Phase = PHASE_ENDED
	state.ZombiesRemaining = 0
	state.TimeRemaining = 0
	broadcast()
end

----------------------------------------------------------------------
-- Dependency injection (all optional)
----------------------------------------------------------------------

function WaveDirector.SetZombieAI(mod: any?)
	zombieAI = mod
	local m: any = mod
	if m and type(m.SetRandom) == "function" then
		local setR: any = m.SetRandom
		pcall(function()
			setR(os.time())
		end)
	end
end

function WaveDirector.SetEconomy(mod: any?)
	economy = mod
end

function WaveDirector.SetProgression(mod: any?)
	progression = mod
end

function WaveDirector.SetSeed(seed: number)
	rand = RNG.new(seed) :: Random
	local aiRef: any = zombieAI
	if aiRef and type(aiRef.SetRandom) == "function" then
		local setR: any = aiRef.SetRandom
		pcall(function()
			setR(seed)
		end)
	end
end

-- Debug/testing helper: spawn a specific archetype without starting a wave.
function WaveDirector.DebugSpawn(archetypeId: string, waveNumber: number?): any?
	return spawnOne(toNumber(waveNumber, math.max(1, state.Wave)), archetypeId, false)
end

return WaveDirector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Weapons
--
-- Server-authoritative hitscan combat. The client may *request* a shot but the
-- server decides whether it happens, from where, at what, and for how much
-- damage. Nothing the client sends is trusted.
--
-- For every Config.Weapons definition this system honours: Damage,
-- HeadshotMultiplier, FireRate, MagazineSize, ReloadTime, SpreadDegrees, Range,
-- Pellets (shotgun fires multiple rays), Auto, UnlockCost and AmmoReserveMax,
-- after applying Types.StatModifiers from Progression to damage, fire rate,
-- reload time and magazine size.
--
-- Damage is routed to ZombieAI.Damage when that module is present, and falls
-- back to a local Health-attribute implementation otherwise, so combat still
-- works while ZombieAI is written concurrently.
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local Types = require(script.Parent.Shared.Types)
local MathUtil = require(script.Parent.Shared.MathUtil)

-- Structural mirrors of cross-module exports (lint-time aliases only).
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type SecuritySettings = {
	MaxFireRequestsPerSecond: number,
	MaxRequestsPerSecond: number,
	MaxDamageClaimPerRequest: number,
}

-- ZombieAI is written concurrently; resolved dynamically at runtime.
type ZombieAIApi = {
	Damage: (any, number, boolean?) -> boolean,
}

-- Economy resolved dynamically too (rewards on kill).
type EconomyApi = {
	OnKill: (Player, boolean, StatModifiers?, number?, number?) -> (),
	GetStats: (Player) -> any,
}

local Weapons = {}

local Effects = require(script.Parent.Effects)

local Players = game:GetService("Players")

local WeaponsConfig: { [string]: WeaponDef } = Config.Weapons :: { [string]: WeaponDef }
local SEC: SecuritySettings = Config.Security :: SecuritySettings

local DEFAULT_WEAPON = "Pistol"
local HEAD_NAME = "Head"

------------------------------------------------------------------------------
-- Injected collaborators (never fatal if absent)
------------------------------------------------------------------------------

local zombieAI: ZombieAIApi? = nil
local economy: EconomyApi? = nil

function Weapons.SetZombieAI(mod: any)
	if typeof(mod) == "table" and type((mod :: any).Damage) == "function" then
		zombieAI = mod :: ZombieAIApi
	end
end

function Weapons.SetEconomy(mod: any)
	if typeof(mod) == "table" then
		economy = mod :: EconomyApi
	end
end

-- Dynamic sibling lookup, used when nobody injected an AI explicitly. Safe when
-- ZombieAI does not exist yet or errors while loading.
local aiLookedUp = false
local function resolveZombieAI(): ZombieAIApi?
	if zombieAI ~= nil then
		return zombieAI
	end
	if aiLookedUp then
		return nil
	end
	aiLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("ZombieAI")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" and type((mod :: any).Damage) == "function" then
		zombieAI = mod :: ZombieAIApi
		return zombieAI
	end
	return nil
end

local econLookedUp = false
local function resolveEconomy(): EconomyApi?
	if economy ~= nil then
		return economy
	end
	if econLookedUp then
		return nil
	end
	econLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("Economy")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" then
		economy = mod :: EconomyApi
		return economy
	end
	return nil
end

local progLookedUp = false
local progressionMod: any = nil
local function resolveProgression(): ProgressionApi?
	if progressionMod ~= nil then
		return progressionMod
	end
	if progLookedUp then
		return nil
	end
	progLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("Progression")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" then
		progressionMod = mod
		return progressionMod
	end
	return nil
end

------------------------------------------------------------------------------
-- Per-player weapon state
------------------------------------------------------------------------------

type WeaponEntry = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
	LastFireTime: number,
	LastReloadRequest: number,
}

local entries: { [Player]: WeaponEntry } = {}

-- Rate limiter: rolling one-second window of request timestamps.
local fireWindows: { [Player]: { number } } = {}

local function nowTime(): number
	return os.clock()
end

local function defOf(weaponId: string): WeaponDef?
	return WeaponsConfig[weaponId]
end

type ProgressionApi = {
	GetStatModifiers: (Player) -> StatModifiers,
	GetCurrentWeapon: (Player) -> string,
}

function Weapons.GetModifiers(player: Player): StatModifiers
	local prog: ProgressionApi? = resolveProgression()
	if prog then
		local p: ProgressionApi = prog
		local ok, mods = pcall(function()
			return p.GetStatModifiers(player)
		end)
		if ok and typeof(mods) == "table" then
			local view: any = mods
			return {
				DamageMult = tonumber(view.DamageMult) or 1,
				FireRateMult = tonumber(view.FireRateMult) or 1,
				ReloadMult = tonumber(view.ReloadMult) or 1,
				MagazineMult = tonumber(view.MagazineMult) or 1,
				MoveSpeedFlat = tonumber(view.MoveSpeedFlat) or 0,
				MaxHealthFlat = tonumber(view.MaxHealthFlat) or 0,
				LifestealPct = tonumber(view.LifestealPct) or 0,
				CoinMult = tonumber(view.CoinMult) or 1,
			}
		end
	end
	return Types.NewStatModifiers()
end

-- Resolves the weapon the player should be using (owned + equipped).
local function currentWeaponFor(player: Player): (WeaponDef, string)
	local prog: ProgressionApi? = resolveProgression()
	local weaponId: string = DEFAULT_WEAPON
	if prog then
		local p: ProgressionApi = prog
		local ok, id = pcall(function()
			return p.GetCurrentWeapon(player)
		end)
		if ok and typeof(id) == "string" and defOf(id) ~= nil then
			weaponId = id
		end
	end
	local def = defOf(weaponId)
	if not def then
		local fallback: WeaponDef = WeaponsConfig[DEFAULT_WEAPON]
		weaponId = DEFAULT_WEAPON
		return fallback, weaponId
	end
	return def, weaponId
end

local function magazineSize(def: WeaponDef, mods: StatModifiers): number
	local base: number = def.MagazineSize
	local size = math.floor(base * mods.MagazineMult + 0.5)
	if size < 1 then
		size = 1
	end
	return size
end

local function makeEntry(player: Player): WeaponEntry
	local def, weaponId = currentWeaponFor(player)
	local mods = Weapons.GetModifiers(player)
	local mag = magazineSize(def, mods)
	local reserve: number = def.AmmoReserveMax
	return {
		WeaponId = weaponId,
		AmmoInMag = mag,
		AmmoReserve = reserve,
		Reloading = false,
		ReloadEndsAt = nil,
		LastFireTime = 0,
		LastReloadRequest = 0,
	}
end

function Weapons.GetEntry(player: Player): WeaponEntry
	local e = entries[player]
	if not e then
		e = makeEntry(player)
		entries[player] = e
	end
	return e
end

function Weapons.GetState(player: Player): WeaponState
	local e = Weapons.GetEntry(player)
	return {
		WeaponId = e.WeaponId,
		AmmoInMag = e.AmmoInMag,
		AmmoReserve = e.AmmoReserve,
		Reloading = e.Reloading,
		ReloadEndsAt = e.ReloadEndsAt,
	}
end

function Weapons.Replicate(player: Player)
	pcall(function()
		local state = Weapons.GetState(player)
		Remotes.WeaponStateChanged():FireClient(player, state)
	end)
end

-- Forces a full rebuild of the player's weapon state, e.g. after buying a
-- weapon or gaining a magazine perk.
function Weapons.Refresh(player: Player)
	local def, weaponId = currentWeaponFor(player)
	local mods = Weapons.GetModifiers(player)
	local mag = magazineSize(def, mods)
	local e = Weapons.GetEntry(player)

	e.WeaponId = weaponId
	e.Reloading = false
	e.ReloadEndsAt = nil
	e.AmmoReserve = def.AmmoReserveMax
	if e.AmmoInMag > mag then
		e.AmmoInMag = mag
	else
		-- Top the magazine up to the new capacity.
		e.AmmoInMag = mag
	end
	Weapons.Replicate(player)
end

------------------------------------------------------------------------------
-- Rate limiting / input validation
------------------------------------------------------------------------------

local function withinRateLimit(player: Player): boolean
	local maxPerSecond: number = SEC.MaxFireRequestsPerSecond
	if maxPerSecond <= 0 then
		return false
	end

	local window = fireWindows[player]
	if not window then
		window = {}
		fireWindows[player] = window
	end

	local t = nowTime()
	-- Drop timestamps older than one second.
	local cutoff = t - 1.0
	local alive: { number } = {}
	for _, ts in ipairs(window) do
		if ts >= cutoff then
			table.insert(alive, ts)
		end
	end

	if #alive >= maxPerSecond then
		fireWindows[player] = alive
		return false
	end

	table.insert(alive, t)
	fireWindows[player] = alive
	return true
end

-- Validates the three ray components the client sends. Anything malformed is
-- coerced to zero rather than trusted.
local function sanitizeVec(v: any): (number, number, number)
	if typeof(v) ~= "Vector3" then
		return 0, 0, 0
	end
	local view: any = v
	local x = tonumber(view.X)
	local y = tonumber(view.Y)
	local z = tonumber(view.Z)
	if x == nil or y == nil or z == nil then
		return 0, 0, 0
	end
	-- Reject non-finite and wildly out-of-bounds coordinates.
	if x ~= x or y ~= y or z ~= z then
		return 0, 0, 0
	end
	if math.abs(x) > 1e6 or math.abs(y) > 1e6 or math.abs(z) > 1e6 then
		return 0, 0, 0
	end
	return x, y, z
end

-- Server-side origin: derived from the character, never from the client, so a
-- cheater cannot shoot from inside a wall or across the map.
local function serverOrigin(player: Player): (Vector3?, Vector3?)
	local ok, res = pcall(function()
		local character = player.Character
		if not character then
			return nil
		end
		local head: any = character:FindFirstChild("Head")
		if not head then
			return nil
		end
		local camera = workspace.CurrentCamera
		local dir: any
		if camera then
			dir = camera.CFrame.LookVector
		else
			dir = head.CFrame.LookVector
		end
		return head.Position, dir
	end)
	if not ok or res == nil then
		return nil, nil
	end
	local anyRes: any = res
	local origin: any = anyRes[1]
	local dirAny: any = anyRes[2]
	if origin == nil then
		return nil, nil
	end
	return origin :: Vector3, dirAny :: Vector3
end

------------------------------------------------------------------------------
-- Damage routing
------------------------------------------------------------------------------

local function readNumberAttr(model: any, name: string): number?
	local ok, v = pcall(function()
		return model:GetAttribute(name)
	end)
	if not ok then
		return nil
	end
	local n = tonumber(v)
	if n == nil then
		return nil
	end
	return n
end

-- Fallback damage path used while ZombieAI is unavailable.
local function fallbackDamage(model: any, amount: number): boolean
	local maxHealth = readNumberAttr(model, "MaxHealth")
	local health = readNumberAttr(model, "Health")
	if health == nil then
		health = maxHealth
	end
	if health == nil then
		-- Nothing to damage; also try a Humanoid if the model has one.
		local ok, hum = pcall(function()
			return model:FindFirstChildOfClass("Humanoid")
		end)
		if ok and hum then
			pcall(function()
				(hum :: any):TakeDamage(amount)
			end)
			local h2 = hum :: any
			return h2.Health <= 0
		end
		return false
	end

	if maxHealth == nil then
		maxHealth = health
	end

	local newHealth: number = health - amount
	local died = newHealth <= 0
	pcall(function()
		model:SetAttribute("Health", math.max(newHealth, 0))
	end)
	if died then
		pcall(function()
			model:Destroy()
		end)
	end
	return died
end

-- Routes damage to ZombieAI when available, else the fallback. Never throws.
-- Returns true when the hit killed the zombie.
local function dealDamage(model: any, amount: number, headshot: boolean): boolean
	local ai = resolveZombieAI()
	if ai then
		local ok, died = pcall(function()
			return ai.Damage(model, amount, headshot)
		end)
		if ok then
			return died == true
		end
		warn("[Weapons] ZombieAI.Damage failed, using fallback: " .. tostring(died))
	end
	return fallbackDamage(model, amount)
end

local function rewardKill(player: Player, model: any, headshot: boolean)
	local econ = resolveEconomy()
	if not econ then
		return
	end
	local rewardCoins = readNumberAttr(model, "RewardCoins")
	local rewardXP = readNumberAttr(model, "RewardXP")
	pcall(function()
		econ.OnKill(player, headshot, Weapons.GetModifiers(player), rewardCoins, rewardXP)
	end)
end

-- True when the ray hit "Head" (or a part whose parent chain resolves to Head).
local function isHeadshot(result: any): boolean
	local ok, part = pcall(function()
		return result.Instance
	end)
	if not ok or part == nil then
		return false
	end
	local anyPart: any = part
	local nameOk, name = pcall(function()
		return anyPart.Name
	end)
	if nameOk and name == HEAD_NAME then
		return true
	end
	-- Some rigs nest the head mesh under a "Head" part.
	local ok2, parentName = pcall(function()
		local p = anyPart.Parent
		if p == nil then
			return nil
		end
		return p.Name
	end)
	if ok2 and parentName == HEAD_NAME then
		return true
	end
	return false
end

-- Returns the zombie Model for a hit part, or nil if it is not a zombie.
local function modelFromPart(part: any): any?
	if part == nil then
		return nil
	end
	local current: any = part
	for _ = 1, 8 do
		if current == nil then
			return nil
		end
		local ok, cls = pcall(function()
			return current.ClassName
		end)
		if ok and cls == "Model" then
			-- Zombies are tagged; fall back to any Model for resilience.
			return current
		end
		local ok2, parent = pcall(function()
			return current.Parent
		end)
		if not ok2 or parent == nil then
			return nil
		end
		current = parent
	end
	return nil
end

------------------------------------------------------------------------------
-- Firing
------------------------------------------------------------------------------

local function beginReload(player: Player, entry: WeaponEntry)
	local def = defOf(entry.WeaponId)
	if not def then
		return
	end
	if entry.Reloading then
		return
	end
	if entry.AmmoReserve <= 0 then
		return
	end
	local magCap = magazineSize(def, Weapons.GetModifiers(player))
	if entry.AmmoInMag >= magCap then
		return
	end

	local mods = Weapons.GetModifiers(player)
	local reloadTime: number = def.ReloadTime * mods.ReloadMult
	if reloadTime < 0.05 then
		reloadTime = 0.05
	end

	entry.Reloading = true
	entry.ReloadEndsAt = nowTime() + reloadTime
	Weapons.Replicate(player)

	pcall(function()
		Effects.PlaySound("Reload", 0.4, 1)
	end)

	task.delay(reloadTime, function()
		-- Player may have left mid-reload.
		if entries[player] ~= entry then
			return
		end
		local d = defOf(entry.WeaponId)
		if not d then
			entry.Reloading = false
			entry.ReloadEndsAt = nil
			return
		end
		local cap = magazineSize(d, Weapons.GetModifiers(player))
		local need = cap - entry.AmmoInMag
		if need < 0 then
			need = 0
		end
		local take = need
		if take > entry.AmmoReserve then
			take = entry.AmmoReserve
		end
		entry.AmmoInMag += take
		entry.AmmoReserve -= take
		entry.Reloading = false
		entry.ReloadEndsAt = nil
		Weapons.Replicate(player)
	end)
end

-- Casts one ray and applies damage. Returns (hitZombie, headshot, damage).
local function castRay(player: Player, entry: WeaponEntry, def: WeaponDef, originPos: Vector3, dir: Vector3, rand01: (number, number) -> number): (boolean, boolean, number)
	local spread: number = def.SpreadDegrees
	local direction: Vector3 = MathUtil.ApplySpread(dir, spread, rand01)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	-- Character is read through an `any` view (members are invisible offline).
	local selfView: any = player
	local blacklist: { any } = {}
	if selfView.Character ~= nil then
		blacklist = { selfView.Character }
	end
	params.FilterDescendantsInstances = blacklist
	params.IgnoreWater = true

	local scaledDir: any = direction
	-- Muzzle flash + report at the shooter's origin.
	pcall(function()
		Effects.MuzzleFlash(originPos)
		Effects.PlaySound("Gunshot", 0.5, 0.95 + math.random() * 0.12)
	end)

	local result: any = workspace:Raycast(originPos, (scaledDir * def.Range) :: Vector3, params)
	if not result then
		return false, false, 0
	end

	local headshot = isHeadshot(result)
	local damage: number = def.Damage * Weapons.GetModifiers(player).DamageMult
	if headshot then
		damage *= def.HeadshotMultiplier
	end

	-- Anti-cheat ceiling: clamp any claimed/derived damage per request.
	local cap: number = SEC.MaxDamageClaimPerRequest
	if damage > cap then
		damage = cap
	end
	if damage < 0 then
		damage = 0
	end

	local hitPart: any = result.Instance
	local model = modelFromPart(hitPart)
	if not model then
		return false, headshot, 0
	end

	local died = dealDamage(model, damage, headshot)
	if died then
		rewardKill(player, model, headshot)
	end

	-- Visual/audio feedback: blood on hit, burst + growl on kill.
	pcall(function()
		local hitPos: Vector3 = result.Position
		Effects.BloodBurst(hitPos)
		if died then
			Effects.DeathBurst(hitPos)
			Effects.PlaySound("ZombieGrowl", 0.35, 0.9 + math.random() * 0.3)
		else
			Effects.PlaySound("Hit", 0.25, 1)
		end
	end)

	pcall(function()
		Remotes.DamageDealt():FireClient(player, {
			Position = result.Position,
			Amount = damage,
			Headshot = headshot,
			Killed = died,
		})
	end)

	return true, headshot, damage
end

-- Deterministic-enough per-shot spread source. The UserId is read through an
-- `any` view because luau-analyze cannot resolve Roblox instance members.
local function bulletRand(player: Player): (number, number) -> number
	local selfView: any = player
	local seedValue = tonumber(selfView.UserId)
	local seed: number = if seedValue ~= nil then (seedValue % 100000) + 1 else 1
	local counter: number = 0
	return function(_min: number, _max: number): number
		counter += 1
		-- Simple deterministic hash in [-1, 1].
		local x = math.sin((seed * 12.9898) + (counter * 78.233)) * 43758.5453
		local frac = x - math.floor(x)
		return (frac * 2) - 1
	end
end

local function tryFire(player: Player)
	-- Rate limit first; everything else is cheaper than an exploit.
	if not withinRateLimit(player) then
		return
	end

	local entry = Weapons.GetEntry(player)
	local def = defOf(entry.WeaponId)
	if not def then
		return
	end

	local now = nowTime()

	if entry.Reloading then
		return
	end

	-- Fire-rate gate.
	local mods = Weapons.GetModifiers(player)
	local fireRate: number = def.FireRate * mods.FireRateMult
	if fireRate < 0.1 then
		fireRate = 0.1
	end
	local minInterval: number = 1 / fireRate
	if now - entry.LastFireTime < minInterval - 0.001 then
		return
	end

	if entry.AmmoInMag <= 0 then
		pcall(function()
			Remotes.Notify():FireClient(player, "Out of ammo — reload")
		end)
		return
	end

	local originPos, dir = serverOrigin(player)
	if originPos == nil or dir == nil then
		return
	end

	entry.AmmoInMag -= 1
	entry.LastFireTime = now

	local rand = bulletRand(player)
	local pellets: number = def.Pellets
	if pellets < 1 then
		pellets = 1
	end
	-- Hard ceiling on rays per shot for perf safety.
	if pellets > 20 then
		pellets = 20
	end

	local totalDamage = 0
	for _ = 1, pellets do
		local _, _, dmg = castRay(player, entry, def, originPos, dir, rand)
		totalDamage += dmg
	end

	-- Lifesteal: heal for a percentage of damage actually dealt.
	local lifesteal: number = mods.LifestealPct
	if lifesteal > 0 and totalDamage > 0 then
		local healAmount = totalDamage * lifesteal
		pcall(function()
			local character = player.Character
			if not character then
				return
			end
			local humanoid: any = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then
				return
			end
			local maxH: number = humanoid.MaxHealth
			local newH: number = humanoid.Health + healAmount
			if newH > maxH then
				newH = maxH
			end
			humanoid.Health = newH
		end)
	end

	Weapons.Replicate(player)

	if entry.AmmoInMag <= 0 then
		-- Auto-reload convenience when the magazine runs dry.
		beginReload(player, entry)
	end
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

function Weapons.Init()
	if booted then
		return
	end
	booted = true

	Remotes.InitServer()

	Players.PlayerAdded:Connect(function(player: Player)
		Weapons.GetEntry(player)
		task.delay(1, function()
			Weapons.Replicate(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		entries[player] = nil
		fireWindows[player] = nil
	end)

	-- Client -> Server. `aimPoint`/`clientDir` arrive untrusted; we use them
	-- only when they are sane, and always raycast from the server-side origin.
	Remotes.RequestFire().OnServerEvent:Connect(function(player: Player, _aimPoint: any, clientDir: any)
		local _x, _y, _z = sanitizeVec(clientDir)
		tryFire(player)
	end)

	Remotes.RequestReload().OnServerEvent:Connect(function(player: Player)
		local entry = Weapons.GetEntry(player)
		-- Cheap throttle on reload spam.
		local t = nowTime()
		if t - entry.LastReloadRequest < 0.25 then
			return
		end
		entry.LastReloadRequest = t
		beginReload(player, entry)
	end)

	-- Late joiners.
	for _, player in ipairs(Players:GetPlayers()) do
		pcall(function()
			Weapons.GetEntry(player)
		end)
	end
end

-- Aliases used by GameServer's defensive lifecycle wiring.
function Weapons.PlayerJoined(player: Player)
	pcall(function()
		Weapons.GetEntry(player)
		Weapons.Replicate(player)
	end)
end

function Weapons.PlayerLeft(player: Player)
	entries[player] = nil
	fireWindows[player] = nil
end

return Weapons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ZombieAI</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative zombie behaviour: spawning, chasing, attacking, damage
-- and death cleanup.
--
-- ZombieAI owns one long-lived coroutine per zombie. Each brain ticks on
-- RunService.Heartbeat, recomputes a PathfindingService path on a throttled
-- interval (never every frame), and attacks the nearest alive player humanoid
-- that is inside the archetype AttackRange once AttackCooldown has elapsed.
--
-- Contract for other systems:
--   * ZombieAI.Spawn(archetypeId, waveNumber) -> Model
--   * ZombieAI.Damage(zombieModel, amount, headshot) -> boolean (true == died)
-- Every spawned model carries the CollectionService tag "Zombie" and these
-- attributes so no system needs to reach into this module's tables:
--   ZombieId, Archetype, Health, MaxHealth, Wave, LastAttack, RewardCoins,
--   RewardXP, IsBoss.

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local RNG = require(script.Parent.Shared.RNG)
local MapBuilder = require(script.Parent.MapBuilder)

-- Structural mirror of RNG.Random. The offline analyzer cannot resolve exported
-- types across `require`, so the shape is redeclared locally (kept in sync with
-- Shared/RNG.luau). Lint-time alias only; the runtime value is real.
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

-- Structural mirror of Config.ZombieArchetype (see Shared/Config.luau).
type Archetype = {
	Id: string,
	DisplayName: string,
	Health: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CoinReward: number,
	XPReward: number,
	Scale: number,
	BodyColor: any,
	UnlockWave: number,
	Weight: number,
	IsBoss: boolean?,
}

-- Structural mirror of Config.Wave (see Shared/Config.luau).
type WaveSettings = {
	IntermissionTime: number,
	FirstWaveDelay: number,
	MaxConcurrentZombies: number,
	SpawnBatchInterval: number,
	BossEveryNWaves: number,
	BaseZombieCount: number,
	CountGrowthPerWave: number,
	HPScalePerWave: number,
	SpeedScalePerWave: number,
	MaxSpeedScale: number,
	DamageScalePerWave: number,
}

local ZombieAI = {}

export type Brain = {
	Model: any,
	Humanoid: any,
	Root: any,
	Archetype: Archetype,
	Health: number,
	MaxHealth: number,
	Damage: number,
	WalkSpeed: number,
	AttackRange: number,
	AttackCooldown: number,
	LastAttack: number,
	Wave: number,
	ZombieId: number,
	Alive: boolean,
	Target: any,
	NextRepathAt: number,
	NextWaypointIndex: number,
	Waypoints: { any },
	PathFailed: boolean,
	Thread: thread?,
}

-- Services are fetched lazily inside pcall so a missing service in a unit-test
-- host can never hard-error this module at require time.
local PathfindingService: any = nil
local RunService: any = nil
local Debris: any = nil
local CollectionService: any = nil
local Players: any = nil
local servicesReady = false

local function ensureServices()
	if servicesReady then
		return true
	end
	local ok = pcall(function()
		PathfindingService = game:GetService("PathfindingService")
		RunService = game:GetService("RunService")
		Debris = game:GetService("Debris")
		CollectionService = game:GetService("CollectionService")
		Players = game:GetService("Players")
	end)
	servicesReady = ok
	return ok
end

local TAG = "Zombie"

local brains: { [any]: Brain } = {}
local order: { any } = {}
local spawnPointsCache: { any } = {}
local rng: Random? = nil
local nextZombieId = 0

local function getRandom(): Random
	local r = rng
	if r then
		return r
	end
	local fresh: Random = RNG.new(os.time()) :: Random
	rng = fresh
	return fresh
end

-- Cached view of the map's spawn points. Never yields; MapBuilder returns an
-- empty array when the map has not been built yet.
local function spawnPoints(): { any }
	local n = #spawnPointsCache
	if n > 0 then
		return spawnPointsCache
	end
	local got: any = MapBuilder.GetSpawnPoints()
	local count = 0
	if typeof(got) == "table" then
		local t: any = got
		for _, v in ipairs(t) do
			count += 1
			spawnPointsCache[count] = v
		end
	end
	return spawnPointsCache
end

local function archetypeTable(): { [string]: Archetype }
	return Config.Zombies :: { [string]: Archetype }
end

local function waveSettings(): WaveSettings
	return Config.Wave :: WaveSettings
end

local function toNumber(v: any, fallback: number): number
	if typeof(v) == "number" then
		return v :: number
	end
	local n = tonumber(v)
	if n then
		return n
	end
	return fallback
end

local ZOMBIE_IDS = { "Walker", "Runner", "Brute", "Spitter", "Boss" }

function ZombieAI.ArchetypeIds(): { string }
	local out: { string } = {}
	for _, id in ipairs(ZOMBIE_IDS) do
		out[#out + 1] = id
	end
	return out
end

-- Resolves an archetype, tolerating nil/unknown ids by falling back to Walker.
local function archetypeOf(id: string?): Archetype
	local tbl = archetypeTable()
	if id ~= nil then
		local key: any = id
		local found: Archetype? = tbl[key]
		if found then
			return found
		end
	end
	return tbl.Walker
end

function ZombieAI.GetArchetype(id: string): Archetype?
	local tbl = archetypeTable()
	local key: any = id
	return tbl[key]
end

----------------------------------------------------------------------
-- Model construction
----------------------------------------------------------------------

-- Builds a rig from scratch so the place has zero external asset dependencies.
local function buildModel(arch: Archetype): any
	local model = Instance.new("Model")
	model.Name = arch.DisplayName

	local s: number = arch.Scale
	if s <= 0 then
		s = 1
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2 * s, 2 * s, 1 * s)
	root.Transparency = 1
	root.CanCollide = false
	root.Anchored = false
	root.Parent = model

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2 * s, 2 * s, 1 * s)
	torso.Color = arch.BodyColor
	torso.Material = Enum.Material.SmoothPlastic
	torso.Parent = model
	local torsoWeld = Instance.new("WeldConstraint")
	torsoWeld.Part0 = root
	torsoWeld.Part1 = torso
	torsoWeld.Parent = root

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2 * s, 1.2 * s, 1.2 * s)
	head.Color = arch.BodyColor
	head.Material = Enum.Material.SmoothPlastic
	head.Parent = model
	local headWeld = Instance.new("WeldConstraint")
	headWeld.Part0 = root
	headWeld.Part1 = head
	headWeld.Parent = root

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "ZombieHumanoid"
	humanoid.MaxHealth = arch.Health
	humanoid.Health = arch.Health
	humanoid.WalkSpeed = arch.WalkSpeed
	humanoid.Parent = model

	model.PrimaryPart = root
	return model
end

----------------------------------------------------------------------
-- Targeting / players
----------------------------------------------------------------------

local function playersList(): { any }
	if not Players then
		return {}
	end
	local list: any = Players:GetPlayers()
	if typeof(list) ~= "table" then
		return {}
	end
	return list :: { any }
end

-- Nearest alive player humanoid root part; nil when nobody is targetable.
local function nearestTarget(brain: Brain): any?
	local bestRoot: any = nil
	local bestHumanoid: any = nil
	local bestDist = math.huge

	local rootPos: any = brain.Root.Position
	for _, player in ipairs(playersList()) do
		local char: any = player.Character
		if char then
			local hum: any = char:FindFirstChildOfClass("Humanoid")
			local rp: any = char:FindFirstChild("HumanoidRootPart")
			if hum and rp and hum.Health > 0 then
				local p: any = rp.Position
				local dx: number = p.X - rootPos.X
				local dy: number = p.Y - rootPos.Y
				local dz: number = p.Z - rootPos.Z
				local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
				if dist < bestDist then
					bestDist = dist
					bestRoot = rp
					bestHumanoid = hum
				end
			end
		end
	end

	if bestHumanoid then
		brain.Target = bestHumanoid
	end
	return bestRoot
end

----------------------------------------------------------------------
-- Combat
----------------------------------------------------------------------

local function damageHumanoid(humanoid: any, amount: number)
	pcall(function()
		humanoid:TakeDamage(amount)
	end)
end

-- Spitter: a fast unanchored projectile part. Damage is applied on touch
-- server-side; the visual is the part itself so no assets are needed.
local function fireSpitter(brain: Brain, humanoid: any, targetPos: any)
	pcall(function()
		local rootPos: any = brain.Root.Position
		local dx: number = targetPos.X - rootPos.X
		local dy: number = targetPos.Y - rootPos.Y
		local dz: number = targetPos.Z - rootPos.Z
		local mag = math.sqrt(dx * dx + dy * dy + dz * dz)
		if mag <= 0.001 then
			return
		end
		local speed = 70
		local vel: any = Vector3.new(dx / mag * speed, dy / mag * speed + 8, dz / mag * speed)

		local proj = Instance.new("Part")
		proj.Name = "SpitterProjectile"
		proj.Shape = Enum.PartType.Ball
		proj.Size = Vector3.new(1.1, 1.1, 1.1)
		proj.Material = Enum.Material.Neon
		proj.Color = Color3.fromRGB(150, 220, 70)
		proj.CanCollide = false
		proj.Anchored = false
		proj.CastShadow = false
		proj.CFrame = CFrame.new(rootPos + Vector3.new(0, 1.5, 0))
		proj.AssemblyLinearVelocity = vel
		proj:SetAttribute("Damage", brain.Damage)
		proj:SetAttribute("OwnerId", brain.ZombieId)
		proj.Parent = workspace

		local hit = false
		local conn: any = nil
		conn = proj.Touched:Connect(function(other: any)
			if hit then
				return
			end
			local model: any = other.Parent
			if not model then
				return
			end
			local hum: any = model:FindFirstChildOfClass("Humanoid")
			if not hum then
				return
			end
			local cs: any = CollectionService
			if cs and cs:HasTag(model, TAG) then
				return -- never damage other zombies
			end
			hit = true
			damageHumanoid(hum, brain.Damage)
			if conn then
				conn:Disconnect()
				conn = nil
			end
			proj:Destroy()
		end)

		task.delay(4, function()
			if conn then
				conn:Disconnect()
				conn = nil
			end
			pcall(function()
				if proj.Parent then
					proj:Destroy()
				end
			end)
		end)
	end)
end

local function tryAttack(brain: Brain, now: number)
	if now - brain.LastAttack < brain.AttackCooldown then
		return
	end
	local targetRoot = nearestTarget(brain)
	if not targetRoot then
		return
	end

	local rootPos: any = brain.Root.Position
	local tp: any = targetRoot.Position
	local dx: number = tp.X - rootPos.X
	local dy: number = tp.Y - rootPos.Y
	local dz: number = tp.Z - rootPos.Z
	local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
	if dist > brain.AttackRange then
		return
	end

	brain.LastAttack = now
	pcall(function()
		brain.Model:SetAttribute("LastAttack", now)
	end)

	if brain.Archetype.Id == "Spitter" then
		fireSpitter(brain, brain.Target, tp)
		return
	end

	local humanoid: any = brain.Target
	if humanoid then
		damageHumanoid(humanoid, brain.Damage)
		pcall(function()
			Remotes.ZombieDamagedPlayer():FireAllClients(tostring(brain.Archetype.Id), brain.Damage)
		end)
	end
end

----------------------------------------------------------------------
-- Pathing
----------------------------------------------------------------------

local REPATH_INTERVAL = 0.6
local WAYPOINT_DISTANCE = 4

-- Recomputes the chase path. On any failure we set PathFailed so the brain
-- falls back to direct MoveTo for the rest of its life (perf: no repeated
-- doomed ComputeAsync calls every tick).
local function computePath(brain: Brain, goal: any)
	if brain.PathFailed or not PathfindingService then
		return
	end
	local path: any = nil
	local ok = pcall(function()
		path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = WAYPOINT_DISTANCE,
		})
	end)
	if not ok or not path then
		brain.PathFailed = true
		return
	end

	local computed = false
	pcall(function()
		local startPos: any = brain.Root.Position
		path:ComputeAsync(startPos, goal)
		computed = true
	end)
	if not computed then
		brain.PathFailed = true
		return
	end

	local status: any = nil
	pcall(function()
		status = path.Status
	end)
	if status ~= nil then
		local s: any = status
		if s ~= Enum.PathStatus.Success then
			-- Partial/blocked: fall back to MoveTo this tick and retry later.
			brain.Waypoints = {}
			brain.NextWaypointIndex = 1
			return
		end
	end

	local wps: any = nil
	pcall(function()
		wps = path:GetWaypoints()
	end)
	if typeof(wps) ~= "table" then
		brain.Waypoints = {}
		brain.NextWaypointIndex = 1
		return
	end

	local list: { any } = {}
	local src: any = wps
	for _, w in ipairs(src) do
		list[#list + 1] = w
	end
	brain.Waypoints = list
	brain.NextWaypointIndex = 2 -- waypoint 1 is the start position
end

local function moveDirect(brain: Brain, goal: any)
	pcall(function()
		brain.Humanoid:MoveTo(goal)
	end)
end

local function chaseStep(brain: Brain, goal: any, now: number)
	if now >= brain.NextRepathAt then
		brain.NextRepathAt = now + REPATH_INTERVAL
		computePath(brain, goal)
	end

	local wps = brain.Waypoints
	if not brain.PathFailed and #wps > 0 and brain.NextWaypointIndex <= #wps then
		local wp: any = wps[brain.NextWaypointIndex]
		local pos: any = wp.Position
		local rp: any = brain.Root.Position
		local dx: number = pos.X - rp.X
		local dy: number = pos.Y - rp.Y
		local dz: number = pos.Z - rp.Z
		if math.sqrt(dx * dx + dy * dy + dz * dz) < 3.0 then
			brain.NextWaypointIndex += 1
		end
		local nxt: any = wps[math.min(brain.NextWaypointIndex, #wps)]
		moveDirect(brain, nxt.Position)
		return
	end

	moveDirect(brain, goal)
end

----------------------------------------------------------------------
-- Brain lifecycle
----------------------------------------------------------------------

local function untrack(model: any)
	brains[model] = nil
	for i = #order, 1, -1 do
		if order[i] == model then
			table.remove(order, i)
		end
	end
end

local function brainLoop(brain: Brain)
	while brain.Alive do
		local stepped = RunService.Heartbeat:Wait()
		if not brain.Alive then
			break
		end

		local now: number = toNumber(stepped, os.clock())
		local goal = nearestTarget(brain)
		if goal then
			chaseStep(brain, goal.Position, now)
			tryAttack(brain, now)
		else
			-- Nobody alive: drift toward the centre so zombies stay findable.
			chaseStep(brain, MapBuilder.GetCenterSpawn(), now)
		end
	end
end

local function detach(model: any)
	pcall(function()
		local cs: any = CollectionService
		if cs and cs:HasTag(model, TAG) then
			cs:RemoveTag(model, TAG)
		end
	end)
	pcall(function()
		-- Freeze immediately so a corpse cannot keep pushing players.
		local hum: any = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = true
		end
	end)
	pcall(function()
		local d: any = Debris
		if d then
			d:AddItem(model, 3)
		else
			task.delay(3, function()
				if model.Parent then
					model:Destroy()
				end
			end)
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Spawns one zombie of `archetypeId` scaled for `waveNumber`.
-- Returns the Model (already parented to Workspace) or nil on failure.
function ZombieAI.Spawn(archetypeId: string, waveNumber: number): any
	if not ensureServices() then
		return nil
	end

	local waveNo: number = waveNumber
	if waveNo < 1 then
		waveNo = 1
	end

	local arch = archetypeOf(archetypeId)
	local w = waveSettings()

	-- Scaling curves shared with WaveDirector so a hand-spawned zombie and a
	-- wave-spawned one of the same wave are identical.
	local hpScale: number = math.pow(w.HPScalePerWave, waveNo - 1)
	local speedScale: number = math.min(math.pow(w.SpeedScalePerWave, waveNo - 1), w.MaxSpeedScale)
	local dmgScale: number = math.pow(w.DamageScalePerWave, waveNo - 1)

	local maxHealth: number = math.max(1, math.floor(arch.Health * hpScale + 0.5))
	local speed: number = arch.WalkSpeed * speedScale
	local damage: number = arch.Damage * dmgScale

	nextZombieId += 1

	local model: any = nil
	local ok = pcall(function()
		model = buildModel(arch)
		local hum: any = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.MaxHealth = maxHealth
			hum.Health = maxHealth
			hum.WalkSpeed = speed
		end

		model:SetAttribute("ZombieId", nextZombieId)
		model:SetAttribute("Archetype", arch.Id)
		model:SetAttribute("DisplayName", arch.DisplayName)
		model:SetAttribute("Health", maxHealth)
		model:SetAttribute("MaxHealth", maxHealth)
		model:SetAttribute("Wave", waveNo)
		model:SetAttribute("Damage", damage)
		model:SetAttribute("LastAttack", 0)
		model:SetAttribute("RewardCoins", arch.CoinReward)
		model:SetAttribute("RewardXP", arch.XPReward)
		model:SetAttribute("IsBoss", arch.IsBoss == true)

		local points = spawnPoints()
		local ws: any = workspace
		if #points > 0 then
			local pick = getRandom():Int(1, #points)
			local sp: any = points[pick]
			local jitter = 6
			local r1: number = getRandom():Range(-jitter, jitter)
			local r2: number = getRandom():Range(-jitter, jitter)
			local base: any = sp.Position
			model:PivotTo(CFrame.new(base.X + r1, base.Y + 3, base.Z + r2))
		else
			model:PivotTo(CFrame.new(MapBuilder.GetCenterSpawn() + Vector3.new(0, 8, 0)))
		end
		model.Parent = ws
		CollectionService:AddTag(model, TAG)
	end)
	if not ok or not model then
		if model then
			pcall(function()
				model:Destroy()
			end)
		end
		return nil
	end

	local humanoid: any = model:FindFirstChildOfClass("Humanoid")
	local root: any = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		pcall(function()
			model:Destroy()
		end)
		return nil
	end

	local brain: Brain = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Archetype = arch,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Damage = damage,
		WalkSpeed = speed,
		AttackRange = arch.AttackRange,
		AttackCooldown = arch.AttackCooldown,
		LastAttack = 0,
		Wave = waveNo,
		ZombieId = nextZombieId,
		Alive = true,
		Target = nil,
		NextRepathAt = 0,
		NextWaypointIndex = 2,
		Waypoints = {},
		PathFailed = false,
		Thread = nil,
	}

	brains[model] = brain
	order[#order + 1] = model

	brain.Thread = task.spawn(brainLoop, brain)
	return model
end

-- Applies damage to a zombie model. Returns true only when this hit killed it.
-- Never errors: Weapons calls this from player input, so it must be total.
function ZombieAI.Damage(zombieModel: any, amount: number, headshot: boolean?): boolean
	if not zombieModel then
		return false
	end
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return false
	end

	local dmg: number = amount
	if dmg <= 0 then
		return false
	end

	brain.Health -= dmg
	if brain.Health < 0 then
		brain.Health = 0
	end
	brain.MaxHealth = brain.MaxHealth

	pcall(function()
		zombieModel:SetAttribute("Health", brain.Health)
		local hum: any = brain.Humanoid
		if hum then
			hum.Health = brain.Health
		end
	end)

	-- Fire the hit feedback remote inside pcall so networking issues can never
	-- break combat. Payload is deliberately loose for the floating-text client.
	pcall(function()
		local pos: any = brain.Root.Position
		Remotes.DamageDealt():FireAllClients(
			brain.ZombieId,
			dmg,
			headshot == true,
			brain.Health,
			pos
		)
	end)

	if brain.Health <= 0 then
		if brain.Alive then
			brain.Alive = false
			detach(zombieModel)
			untrack(zombieModel)
		end
		return true
	end

	return false
end

-- Immediate removal, used when a run ends or the map is rebuilt.
function ZombieAI.Despawn(zombieModel: any)
	local brain: Brain? = brains[zombieModel]
	if brain then
		brain.Alive = false
	end
	untrack(zombieModel)
	pcall(function()
		zombieModel:Destroy()
	end)
end

function ZombieAI.IsZombie(instance: any): boolean
	if not instance then
		return false
	end
	local b: Brain? = brains[instance]
	return b ~= nil
end

function ZombieAI.GetHealth(zombieModel: any): number
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return 0
	end
	return brain.Health
end

function ZombieAI.GetMaxHealth(zombieModel: any): number
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return 0
	end
	return brain.MaxHealth
end

function ZombieAI.AliveCount(): number
	local n = 0
	for _ in pairs(brains) do
		n += 1
	end
	return n
end

function ZombieAI.GetAlive(): { any }
	local out: { any } = {}
	for _, model in ipairs(order) do
		out[#out + 1] = model
	end
	return out
end

-- Drops every zombie immediately. Called on run end / map rebuild.
function ZombieAI.ClearAll()
	for model in pairs(brains) do
		local brain: Brain = brains[model]
		brain.Alive = false
		pcall(function()
			local hum: any = brain.Humanoid
			if hum then
				hum.Health = 0
			end
		end)
	end
	for i = #order, 1, -1 do
		local m = order[i]
		order[i] = nil
		pcall(function()
			m:Destroy()
		end)
	end
	local n = 0
	for k in pairs(brains) do
		brains[k] = nil
		n += 1
	end
	spawnPointsCache = {}
	return n
end

-- Weighted archetype roll honouring UnlockWave. `waveNumber` gates which
-- archetypes may appear; entries with weight <= 0 are skipped entirely, which
-- is exactly how Boss (Weight = 0) is excluded from normal rolls.
function ZombieAI.RollArchetype(waveNumber: number, randSource: Random?): string
	local r: Random = randSource or getRandom()
	local entries: { { weight: number, value: any } } = {}
	local tbl = archetypeTable()

	for _, id in ipairs(ZOMBIE_IDS) do
		local key: any = id
		local arch: Archetype? = tbl[key]
		if arch then
			local weight: number = arch.Weight
			local unlock: number = arch.UnlockWave
			if weight > 0 and unlock <= waveNumber then
				entries[#entries + 1] = { weight = weight, value = id }
			end
		end
	end

	if #entries == 0 then
		return "Walker"
	end

	local picked: any = r:Weighted(entries)
	if typeof(picked) == "string" then
		return picked :: string
	end
	return "Walker"
end

function ZombieAI.SetRandom(seed: number)
	rng = RNG.new(seed) :: Random
end

-- Number of concurrent zombies this module is willing to host.
function ZombieAI.MaxConcurrent(): number
	return waveSettings().MaxConcurrentZombies
end

return ZombieAI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="16">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="17">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server entry point. Boots the map, then starts every gameplay system.
--
-- Design note: each system is required defensively. If a subsystem is missing
-- or errors during Init, the rest of the game still comes up and the failure is
-- logged. That matters because this project is built and verified without
-- Studio, so a single bad module must never take the whole experience down.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Systems = ReplicatedStorage:WaitForChild("Systems", 10)

local started: { [string]: boolean } = {}

local function trace(msg: string)
	print("[ZombieUprising] " .. msg)
end

local function tryRequire(name: string): any?
	if not Systems then
		warn("[ZombieUprising] no Systems folder; cannot load " .. name)
		return nil
	end
	local inst = Systems:FindFirstChild(name)
	if not inst then
		warn("[ZombieUprising] system missing: " .. name)
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if not ok or not mod then
		warn("[ZombieUprising] failed to require " .. name .. ": " .. tostring(mod))
		return nil
	end
	return mod
end

local function startSystem(name: string, ...: any)
	local mod = tryRequire(name)
	if not mod then
		return nil
	end
	if started[name] then
		return mod
	end
	if type(mod.Init) == "function" then
		local init: any = mod.Init
		local args: any = { ... }
		local ok, err = pcall(function()
			init(table.unpack(args))
		end)
		if not ok then
			warn("[ZombieUprising] " .. name .. ".Init failed: " .. tostring(err))
			return nil
		end
	end
	started[name] = true
	trace("started system: " .. name)
	return mod
end

-- 1. Networking must exist before anything else talks to clients.
Remotes.InitServer()
trace("remotes initialised")

-- 2. Build the procedural arena (no external assets required).
local mapBuilderMod: any = tryRequire("MapBuilder")
if mapBuilderMod and type(mapBuilderMod.Build) == "function" then
	local _mb_build: any = mapBuilderMod.Build
	local ok, err = pcall(function()
		_mb_build()
	end)
	if ok then
		trace("map built")
	else
		warn("[ZombieUprising] MapBuilder.Build failed: " .. tostring(err))
	end
else
	warn("[ZombieUprising] MapBuilder unavailable — arena not generated")
end

-- 3. Gameplay systems.
local waveDirector: any = startSystem("WaveDirector")
local zombieAI: any = startSystem("ZombieAI")
local economy: any = startSystem("Economy")
local progression: any = startSystem("Progression")
local weapons: any = startSystem("Weapons")
local _chatSystem: any = startSystem("Chat")

-- Cross-system wiring: weapons need to damage zombies.
if weapons and zombieAI then
	local _w1: any = weapons.SetZombieAI
	if type(_w1) == "function" then
		pcall(function()
			local g: any = _w1
			g(zombieAI)
		end)
	end
	local _w2: any = weapons.SetEconomy
	if type(_w2) == "function" then
		pcall(function()
			local g: any = _w2
			g(economy)
		end)
	end
end

-- Wave director needs to spawn through the AI and pay through economy.
if waveDirector and zombieAI then
	local _w3: any = waveDirector.SetZombieAI
	if type(_w3) == "function" then
		pcall(function()
			local g: any = _w3
			g(zombieAI)
		end)
	end
end
if waveDirector and economy then
	local _w4: any = waveDirector.SetEconomy
	if type(_w4) == "function" then
		pcall(function()
			local g: any = _w4
			g(economy)
		end)
	end
end

----------------------------------------------------------------------
-- Player lifecycle
----------------------------------------------------------------------
local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local wave = Instance.new("IntValue")
	wave.Name = "Wave"
	wave.Value = 0
	wave.Parent = folder

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = Config.Economy and 0 or 0
	coins.Parent = folder

	folder.Parent = player
end

local function onPlayerAdded(player: Player)
	setupLeaderstats(player)

	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		local h: any = humanoid
		-- MaxHealth comes from Config; perks raise it via Progression.
		h.MaxHealth = Config.Player.BaseMaxHealth
		h.Health = h.MaxHealth
		h.WalkSpeed = Config.Player.BaseWalkSpeed

		local hrp = character:WaitForChild("HumanoidRootPart", 10)
		if hrp then
			local okMB, center: any = pcall(function()
				return require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("MapBuilder"))
			end)
			if not okMB then center = nil end
			if center and type(center.GetCenterSpawn) == "function" then
				local ok, pos = pcall(function()
					return center.GetCenterSpawn()
				end)
				if ok and pos then
					(hrp :: any).CFrame = CFrame.new(pos + Vector3.new(0, 5, 0))
				end
			end
		end
	end)

	local _economy_j: any = economy
	if _economy_j and type(_economy_j.PlayerJoined) == "function" then
		local _pj: any = _economy_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
	local _progression_j: any = progression
	if _progression_j and type(_progression_j.PlayerJoined) == "function" then
		local _pj: any = _progression_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
	local _weapons_j: any = weapons
	if _weapons_j and type(_weapons_j.PlayerJoined) == "function" then
		local _pj: any = _weapons_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
end

local function onPlayerRemoving(player: Player)
	local _economy_l: any = economy
	if _economy_l and type(_economy_l.PlayerLeft) == "function" then
		local _pl: any = _economy_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
	local _progression_l: any = progression
	if _progression_l and type(_progression_l.PlayerLeft) == "function" then
		local _pl: any = _progression_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
	local _weapons_l: any = weapons
	if _weapons_l and type(_weapons_l.PlayerLeft) == "function" then
		local _pl: any = _weapons_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Players who joined before this script connected.
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

----------------------------------------------------------------------
-- Graceful shutdown: persist progress before the server closes.
----------------------------------------------------------------------
game:BindToClose(function()
	local _e_save: any = economy
	if _e_save and type(_e_save.SaveAll) == "function" then
		local _sv: any = _e_save.SaveAll
		pcall(function()
			_sv()
		end)
	end
	task.wait(1)
end)

-- Enable chat commands (!wave, !perks, !help) once systems are up.
do
	local _ci: any = _chatSystem
	if _ci and type(_ci.Init) == "function" then
		local _ciInit: any = _ci.Init
		pcall(function()
			local g: any = _ciInit
			g()
		end)
	end
end

trace(string.format("%s v%s boot complete", Config.GameName, Config.Version))
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="18">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="19">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="20">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">ClientController</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- client controller.
--
-- Owns all local player input and translates it into server requests, while
-- giving the shooter its "prediction feel": an instant crosshair kick, muzzle
-- flash and hitmarker that the server later confirms via DamageDealt.
--
-- Everything is defensive. The server may boot after (or independently of) this
-- script, so every remote is resolved through pcall'd WaitForChild and every
-- listener body is wrapped in pcall. A missing remote degrades to a silent
-- no-op -- the client must never error.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")

-- Cross-module requires are filtered analyzer noise (Unknown require).
local Config = require(Shared:WaitForChild("Config"))
local _Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local ShopUI = require(script.Parent:WaitForChild("ShopUI"))

-- Structural mirrors. luau-analyze cannot resolve exported types across
-- `require`, so each shape is redeclared locally (kept in sync with the shared
-- modules). Lint-time aliases only; runtime values are real.
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

type RunEndedPayload = {
	Reason: string?,
	Wave: number?,
	Kills: number?,
	Coins: number?,
	CanRespawn: boolean?,
}

local REMOTE_TIMEOUT: number = 6

-------------------------------------------------------------------------------
-- Local state
-------------------------------------------------------------------------------

local localPlayer: any = Players.LocalPlayer

local started: boolean = false
local connections: { any } = {}
local boundActions: { string } = {}

local fireRemote: any = nil
local reloadRemote: any = nil
local respawnRemote: any = nil

local weaponState: WeaponState? = nil
local statsState: PlayerStats? = nil
local _waveState: WaveState? = nil

local firing: boolean = false
local sprinting: boolean = false
local dead: boolean = false

local nextShotAt: number = 0
local _lastFireSentAt: number = 0

local camera: any = nil

-- Sprint handling -----------------------------------------------------------
local baseWalkSpeed: number = 16
local sprintSpeed: number = 26

-------------------------------------------------------------------------------
-- Remote plumbing (all failures are swallowed on purpose)
-------------------------------------------------------------------------------

local function resolveRemote(name: string): any
	-- Prefer the lazily-created Remotes accessor; fall back to a direct
	-- timeout-guarded lookup so we still work if only the folder exists.
	local accessorFn: (() -> any)? = nil
	pcall(function()
		local accessor: any = (Remotes :: any)[name]
		if typeof(accessor) == "function" then
			accessorFn = accessor
		end
	end)

	local ok1: boolean = false
	local r1: any = nil
	if accessorFn then
		local fn: () -> any = accessorFn
		ok1, r1 = pcall(fn)
	end
	if ok1 and r1 then
		return r1
	end

	local ok2: boolean, r2: any = pcall(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
		if not folder then return nil end
		return folder:WaitForChild(name, REMOTE_TIMEOUT)
	end)
	if ok2 then
		return r2
	end
	return nil
end

local function ensureRemotes()
	if fireRemote == nil then
		fireRemote = resolveRemote("RequestFire")
	end
	if reloadRemote == nil then
		reloadRemote = resolveRemote("RequestReload")
	end
	if respawnRemote == nil then
		respawnRemote = resolveRemote("RequestRespawn")
	end
end

local function safeConnect(remote: any, handler: (...any) -> ()): any
	if not remote then return nil end
	local ok: boolean, conn: any = pcall(function()
		return remote.OnClientEvent:Connect(function(...: any)
			pcall(handler, ...)
		end)
	end)
	if ok then
		return conn
	end
	return nil
end

-------------------------------------------------------------------------------
-- Aim: build the shot payload from the camera look direction
-------------------------------------------------------------------------------

local function getCamera(): any
	if camera and camera.Parent then
		return camera
	end
	local ws: any = workspace
	camera = ws.CurrentCamera
	return camera
end

local function aimPointAndDirection(): (Vector3, Vector3)
	local cam: any = getCamera()
	if not cam then
		local fallbackDir: Vector3 = Vector3.new(0, 0, -1)
		return Vector3.new(0, 0, 0), fallbackDir
	end

	local origin: Vector3 = cam.CFrame.Position
	local dir: Vector3 = cam.CFrame.LookVector

	-- Raycast forward so the server receives a concrete aim point (the surface
	-- the player is actually looking at), which makes hitscan feel correct.
	local params: any = Instance.new("RaycastParams")
	params.FilterType = Enum.RaycastFilterType.Blacklist
	params.FilterDescendantsInstances = {}
	params.IgnoreWater = true

	local maxRange: number = 500
	if weaponState then
		local defs: any = Config.Weapons
		local def: WeaponDef? = defs[weaponState.WeaponId]
		if def then
			local d: WeaponDef = def
			maxRange = d.Range + 50
		end
	end

	local target: Vector3 = origin + dir * maxRange
	local okRay: boolean, result: any = pcall(function()
		local rayResult: any = workspace:Raycast(origin, dir * maxRange, params)
		return rayResult
	end)
	if okRay and result then
		local rr: any = result
		local p: Vector3 = rr.Position
		return p, (p - origin)
	end

	return target, (target - origin)
end

local function currentWeaponDef(): WeaponDef?
	if not weaponState then return nil end
	local defs: any = Config.Weapons
	local def: WeaponDef? = defs[weaponState.WeaponId]
	return def
end

-------------------------------------------------------------------------------
-- Firing
-------------------------------------------------------------------------------

local function canFire(): boolean
	if dead then return false end
	if not weaponState then return false end
	if weaponState.Reloading then return false end
	if weaponState.AmmoInMag <= 0 then return false end
	return true
end

local function tryFire()
	if not canFire() then
		if weaponState and weaponState.AmmoInMag <= 0 then
			HUD.Notify("Out of ammo — press R", "warn")
		end
		return
	end

	local nowSec: number = os.clock()
	if nowSec < nextShotAt then return end

	local def: WeaponDef? = currentWeaponDef()
	local delaySec: number = 0.1
	if def then
		local d: WeaponDef = def
		delaySec = 1 / math.max(0.1, d.FireRate)
	end
	nextShotAt = nowSec + delaySec

	ensureRemotes()
	if not fireRemote then
		-- Server not ready yet; keep the local feel anyway.
		applyPredictedShot(def)
		return
	end

	local aimPoint: Vector3, aimDir: Vector3 = aimPointAndDirection()
	local ok: boolean = pcall(function()
		fireRemote:FireServer({
			AimPoint = aimPoint,
			Direction = aimDir,
			Origin = aimPoint - aimDir,
			CameraCFrame = getCamera() and getCamera().CFrame or CFrame.new(),
			WeaponId = weaponState and weaponState.WeaponId or "Pistol",
			SentAt = os.clock(),
		})
	end)
	if ok then
		_lastFireSentAt = os.clock()
		applyPredictedShot(def)
	end
end

-- Local-only feedback so the gun feels instant regardless of latency.
function applyPredictedShot(def: WeaponDef?)
	HUD.ShowMuzzleFlash()
	local spread: number = 0.35
	if def then
		local d: WeaponDef = def
		spread = math.clamp(d.SpreadDegrees / 12, 0.08, 1)
	end
	HUD.PulseCrosshair(spread)
end

local function requestReload()
	if dead then return end
	if not weaponState then return end
	if weaponState.Reloading then return end
	if weaponState.AmmoReserve <= 0 then return end
	ensureRemotes()
	if reloadRemote then
		pcall(function()
			reloadRemote:FireServer()
		end)
	end
end

local function requestRespawn()
	ensureRemotes()
	if respawnRemote then
		pcall(function()
			respawnRemote:FireServer()
		end)
	end
	dead = false
	HUD.SetGameOverVisible(false)
end

-------------------------------------------------------------------------------
-- Sprint
-------------------------------------------------------------------------------

local function applySprint(on: boolean)
	sprinting = on
	local character: any = localPlayer and localPlayer.Character
	if not character then return end
	local humanoid: any = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	pcall(function()
		if on then
			humanoid.WalkSpeed = sprintSpeed
		else
			humanoid.WalkSpeed = baseWalkSpeed
		end
	end)
end

local function onCharacterAdded(character: any)
	pcall(function()
		baseWalkSpeed = 16
		sprintSpeed = 26
		local cfgPlayer: any = Config.Player
		local bwRaw: any = cfgPlayer.BaseWalkSpeed
		local swRaw: any = cfgPlayer.SprintSpeed
		local bwNum: number? = tonumber(bwRaw)
		local swNum: number? = tonumber(swRaw)
		if bwNum ~= nil then
			local b: number = bwNum
			baseWalkSpeed = b
		end
		if swNum ~= nil then
			local sw: number = swNum
			sprintSpeed = sw
		end
	end)
	pcall(function()
		character:WaitForChild("Humanoid", 4)
	end)
	applySprint(sprinting)
end

-------------------------------------------------------------------------------
-- Server -> Client listeners
-------------------------------------------------------------------------------

local function onWeaponStateChanged(state: any?)
	if not state then return end
	local s: WeaponState = state
	weaponState = s
	pcall(function()
		HUD.SetAmmo(s)
	end)
end

local function onPlayerStatsChanged(stats: any?)
	if not stats then return end
	local s: PlayerStats = stats
	statsState = s
	pcall(function()
		HUD.SetStats(s)
	end)
	pcall(function()
		ShopUI.SetStats(s)
	end)
	if s.Health <= 0 then
		dead = true
	end
end

local function onWaveStateChanged(state: any?)
	if not state then return end
	local s: WaveState = state
	_waveState = s
	pcall(function()
		HUD.SetWave(s)
	end)
	pcall(function()
		ShopUI.SetShopState({
			Phase = s.Phase,
			Coins = statsState and statsState.Coins or 0,
		})
	end)
end

local function onDamageDealt(payload: any?)
	if not payload then return end
	local p: any = payload
	local killed: boolean = p.Killed == true

	pcall(function()
		HUD.ShowHitmarker(killed)
	end)

	local amount: number = 0
	pcall(function()
		amount = tonumber(p.Amount) or 0
	end)

	local worldPos: Vector3? = nil
	pcall(function()
		worldPos = p.Position
	end)

	pcall(function()
		if amount > 0 then
			HUD.ShowDamageNumber(amount, worldPos, killed)
		end
	end)

	if killed then
		pcall(function()
			HUD.Notify("Kill", "kill")
		end)
	end
end

local function onZombieDamagedPlayer(payload: any?)
	local intensity: number = 0.35
	if payload then
		local p: any = payload
		local dmg: number = tonumber(p.Amount) or tonumber(p.Damage) or 12
		intensity = math.clamp(dmg / 40, 0.2, 1)
	end
	pcall(function()
		HUD.FlashDamage(intensity)
	end)
end

local function onShopStateChanged(payload: any?)
	pcall(function()
		ShopUI.SetShopState(payload)
	end)
end

local function onNotify(payload: any?)
	-- Accepts either a plain string or { Text = ..., Kind = ... }.
	if not payload then return end
	local text: string = ""
	local kind: string? = nil
	if typeof(payload) == "string" then
		text = payload
	else
		pcall(function()
			local p: any = payload
			text = tostring(p.Text or p.Message or "")
			kind = p.Kind
		end)
	end
	if text == "" then return end
	pcall(function()
		HUD.Notify(text, kind)
	end)
end

local function onRunEnded(payload: any?)
	dead = true
	local data: RunEndedPayload = {}
	pcall(function()
		local p: any = payload
		if typeof(p) == "table" then
			data = p
		else
			data = { Reason = tostring(p) }
		end
	end)
	pcall(function()
		ShopUI.SetVisible(false)
	end)
	pcall(function()
		HUD.SetGameOverVisible(true, data)
	end)
end

-------------------------------------------------------------------------------
-- Input
-------------------------------------------------------------------------------

local FIRE_ACTION: string = "ZU_Fire"
local RELOAD_ACTION: string = "ZU_Reload"
local SPRINT_ACTION: string = "ZU_Sprint"

local function handleFireAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		local state: string = tostring(inputState)
		if inputState == Enum.UserInputState.Begin then
			firing = true
			tryFire()
		elseif inputState == Enum.UserInputState.End then
			firing = false
		end
		-- Silence unused param warnings on the string mirror.
		local _mirror: string = state
	end)
	return Enum.ContextActionResult.Pass
end

local function handleReloadAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		if inputState == Enum.UserInputState.Begin then
			requestReload()
		end
	end)
	return Enum.ContextActionResult.Pass
end

local function handleSprintAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		if inputState == Enum.UserInputState.Begin then
			applySprint(true)
		elseif inputState == Enum.UserInputState.End then
			applySprint(false)
		end
	end)
	return Enum.ContextActionResult.Pass
end

local function bindActions()
	pcall(function()
		ContextActionService:BindAction(FIRE_ACTION, handleFireAction, false,
			Enum.UserInputType.MouseButton1)
		table.insert(boundActions, FIRE_ACTION)
	end)
	pcall(function()
		ContextActionService:BindAction(RELOAD_ACTION, handleReloadAction, false,
			Enum.KeyCode.R)
		table.insert(boundActions, RELOAD_ACTION)
	end)
	pcall(function()
		ContextActionService:BindAction(SPRINT_ACTION, handleSprintAction, false,
			Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)
		table.insert(boundActions, SPRINT_ACTION)
	end)
end

local function onInputBegan(input: any, gameProcessed: boolean)
	if gameProcessed then return end
	pcall(function()
		local keyCode: any = input.KeyCode
		if keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift then
			applySprint(true)
		end
	end)
end

local function onInputEnded(input: any, _gameProcessed: boolean)
	pcall(function()
		local keyCode: any = input.KeyCode
		if keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift then
			applySprint(false)
		end
	end)
end

-------------------------------------------------------------------------------
-- Main loop: auto-fire for automatic weapons
-------------------------------------------------------------------------------

local function onHeartbeat(_dt: number)
	if not started then return end
	if not firing then return end
	pcall(function()
		local def: WeaponDef? = currentWeaponDef()
		if def then
			local d: WeaponDef = def
			if d.Auto then
				tryFire()
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Boot
-------------------------------------------------------------------------------

local function connectAllRemotes()
	ensureRemotes()

	local okRemotes: boolean = pcall(function()
		local r: any = Remotes
		local weaponRemote: any = nil
		local statsRemote: any = nil
		local waveRemote: any = nil
		local damageRemote: any = nil
		local hurtRemote: any = nil
		local shopRemote: any = nil
		local notifyRemote: any = nil
		local endedRemote: any = nil

		pcall(function() weaponRemote = r.WeaponStateChanged() end)
		pcall(function() statsRemote = r.PlayerStatsChanged() end)
		pcall(function() waveRemote = r.WaveStateChanged() end)
		pcall(function() damageRemote = r.DamageDealt() end)
		pcall(function() hurtRemote = r.ZombieDamagedPlayer() end)
		pcall(function() shopRemote = r.ShopStateChanged() end)
		pcall(function() notifyRemote = r.Notify() end)
		pcall(function() endedRemote = r.RunEnded() end)

		local c1: any = safeConnect(weaponRemote, onWeaponStateChanged)
		if c1 then table.insert(connections, c1) end
		local c2: any = safeConnect(statsRemote, onPlayerStatsChanged)
		if c2 then table.insert(connections, c2) end
		local c3: any = safeConnect(waveRemote, onWaveStateChanged)
		if c3 then table.insert(connections, c3) end
		local c4: any = safeConnect(damageRemote, onDamageDealt)
		if c4 then table.insert(connections, c4) end
		local c5: any = safeConnect(hurtRemote, onZombieDamagedPlayer)
		if c5 then table.insert(connections, c5) end
		local c6: any = safeConnect(shopRemote, onShopStateChanged)
		if c6 then table.insert(connections, c6) end
		local c7: any = safeConnect(notifyRemote, onNotify)
		if c7 then table.insert(connections, c7) end
		local c8: any = safeConnect(endedRemote, onRunEnded)
		if c8 then table.insert(connections, c8) end
	end)
	if not okRemotes then
		warn("[ZombieUprising] remote wiring failed; client will run headless")
	end
end

local function boot()
	if started then return end
	started = true

	-- PlayerGui resolution is guarded: a race here must not error the script.
	local plrGui: any = nil
	pcall(function()
		if localPlayer then
			plrGui = localPlayer:WaitForChild("PlayerGui", REMOTE_TIMEOUT)
		end
	end)
	if not plrGui then
		warn("[ZombieUprising] PlayerGui unavailable; UI disabled")
	end

	if plrGui then
		pcall(function()
			HUD.Start(plrGui)
		end)
		pcall(function()
			ShopUI.Start(plrGui)
		end)
		pcall(function()
			HUD.OnRespawnRequested(function()
				requestRespawn()
			end)
		end)
	end

	pcall(onCharacterAdded, localPlayer and localPlayer.Character or nil)
	if localPlayer then
		pcall(function()
			local c: any = localPlayer.CharacterAdded:Connect(function(char: any)
				pcall(onCharacterAdded, char)
			end)
			table.insert(connections, c)
		end)
	end

	pcall(bindActions)

	pcall(function()
		local c: any = UserInputService.InputBegan:Connect(onInputBegan)
		table.insert(connections, c)
	end)
	pcall(function()
		local c: any = UserInputService.InputEnded:Connect(onInputEnded)
		table.insert(connections, c)
	end)
	pcall(function()
		local c: any = RunService.Heartbeat:Connect(onHeartbeat)
		table.insert(connections, c)
	end)

	pcall(connectAllRemotes)

	-- Seed the HUD so it never shows placeholder zeros forever if the server
	-- is slow to send the first snapshot.
	pcall(function()
		HUD.SetHealth(100, 100)
		HUD.SetAmmo({
			WeaponId = "Pistol",
			AmmoInMag = 12,
			AmmoReserve = 120,
			Reloading = false,
			ReloadEndsAt = nil,
		})
	end)
end

boot()

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="22">
        <Properties>
          <string name="Name">HUD</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- client HUD.
--
-- Every visual element is generated in code: no .rbxmx GUI assets, no image
-- ids, no external dependencies. The game therefore ships fully self-contained
-- from a source-only repo and can be published straight from a `make build`.
--
-- Responsibilities:
--   * Own the ScreenGui "ZombieHUD" in PlayerGui (idempotent across respawns).
--   * Expose typed setters for health, ammo, wave, coins, XP/level, kills.
--   * Damage vignette driven by RunService (transient, non-intrusive).
--   * Notification toasts (kill / hit feedback) via an auto-expiring track.
--   * Game-over panel with RequestRespawn button and spectate fallback text.
--
-- This module never indexes `game` members blindly: it is a pure ModuleScript
-- with no top-level side effects, so it is safe to require from anywhere.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared:WaitForChild("Types"))
local Config = require(Shared:WaitForChild("Config"))
local _usedTypes = Types

-- Structural mirrors of the shared types. luau-analyze cannot resolve exported
-- types across `require`, so each shape is redeclared here (kept in sync with
-- Shared/Types.luau). These are lint-time aliases only; runtime values are real.
type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type RunState = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: { [string]: number },
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
}

type Toast = {
	Label: TextLabel,
	ExpiresAt: number,
}

local HUD = {}

-- Top-level locals are untyped tables; `Instance.new` is filtered analyzer
-- noise, so we annotate these as `any` to keep strict mode honest.
local playerGui: any = nil
local gui: ScreenGui = nil :: any
local screen: ScreenGui = nil :: any

local healthFill: Frame = nil :: any
local healthText: TextLabel = nil :: any
local _healthBarBack: Frame = nil :: any

local ammoText: TextLabel = nil :: any
local weaponText: TextLabel = nil :: any
local reloadFrame: Frame = nil :: any
local reloadFill: Frame = nil :: any

local waveText: TextLabel = nil :: any
local zombiesText: TextLabel = nil :: any
local timerText: TextLabel = nil :: any
local bannerText: TextLabel = nil :: any

local coinsText: TextLabel = nil :: any
local xpText: TextLabel = nil :: any
local killsText: TextLabel = nil :: any
local xpFill: Frame = nil :: any

local crosshair: Frame = nil :: any
local chTop: Frame = nil :: any
local chBottom: Frame = nil :: any
local chLeft: Frame = nil :: any
local chRight: Frame = nil :: any
local chDot: Frame = nil :: any
local hitmarker: Frame = nil :: any
local muzzleFlash: Frame = nil :: any
local vignette: Frame = nil :: any

local damageNumbersFrame: Frame = nil :: any
local notificationsFrame: Frame = nil :: any
local toasts: { Toast } = {}
-- (damage-number entries carry their own per-label lifetime data)

local gameOverPanel: Frame = nil :: any
local gameOverTitle: TextLabel = nil :: any
local gameOverBody: TextLabel = nil :: any
local respawnButton: TextButton = nil :: any
local spectateLabel: TextLabel = nil :: any

local activeDamageNumbers: { { Label: TextLabel, ExpiresAt: number, Origin: Vector3, Any: any } } = {}

local started: boolean = false
local vignetteLevel: number = 0
local lowHealthPulse: number = 0
local hitmarkerUntil: number = 0
local flashUntil: number = 0
local crosshairSpread: number = 0
local crosshairUntilSpread: number = 0
local spreadDecayAt: number = 0

-- Layout/tuning constants kept local so the HUD stays resolution independent
-- (everything is expressed as a UDim2 scale, never as raw pixel offsets).
local COL_BG = Color3.fromRGB(12, 14, 18)
local COL_PANEL = Color3.fromRGB(20, 23, 30)
local COL_ACCENT = Color3.fromRGB(232, 196, 88)
local COL_TEXT = Color3.fromRGB(236, 240, 247)
local COL_DIM = Color3.fromRGB(150, 158, 172)
local COL_GOOD = Color3.fromRGB(88, 208, 128)
local COL_BAD = Color3.fromRGB(226, 78, 78)
local COL_WARN = Color3.fromRGB(240, 168, 72)

local MAX_TOASTS: number = 5
local TOAST_LIFE: number = 3.0
local DAMAGE_NUMBER_LIFE: number = 0.9
local MAX_DAMAGE_NUMBERS: number = 14

local _runServiceConn: any = nil
local respawnCallback: any = nil
local cachedStats: PlayerStats? = nil

-- Local accessors -----------------------------------------------------------

local function now(): number
	return os.clock()
end

local function clamp01(v: number): number
	if v < 0 then return 0 end
	if v > 1 then return 1 end
	return v
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function wavePhaseName(phase: string): string
	if phase == "Intermission" then return "INTERMISSION" end
	if phase == "Active" then return "WAVE ACTIVE" end
	if phase == "Ended" then return "RUN OVER" end
	return "..."
end

-- Instance helpers (all three Roblox globals are analyzer-filtered noise) ----

local function newFrame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(0, 0, 0, 0)
	f.Position = UDim2.new(0, 0, 0, 0)
	return f
end

local function newTextLabel(name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.new(0, 0, 0, 0)
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Text = ""
	l.TextColor3 = COL_TEXT
	l.TextScaled = false
	l.TextSize = 16
	l.Font = Enum.Font.GothamSemibold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	return l
end

local function newTextButton(name: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.BorderSizePixel = 0
	b.Size = UDim2.new(0, 0, 0, 0)
	b.Position = UDim2.new(0, 0, 0, 0)
	b.Text = ""
	b.TextColor3 = COL_TEXT
	b.TextSize = 16
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	return b
end

local function addCorner(parent: Instance, r: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function addList(parent: Instance, axis: any, pad: number): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = axis
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Parent = parent
	return l
end

-- UI construction ----------------------------------------------------------

local function buildHealth(): Frame
	local root = newFrame("HealthRoot")
	root.Size = UDim2.new(0.26, 0, 0.055, 0)
	root.Position = UDim2.new(0.02, 0, 0.9, 0)
	root.AnchorPoint = Vector2.new(0, 1)

	local back = newFrame("HealthBack")
	back.Size = UDim2.new(1, 0, 0.52, 0)
	back.Position = UDim2.new(0, 0, 0.48, 0)
	back.BackgroundColor3 = COL_PANEL
	back.BackgroundTransparency = 0.35
	back.Parent = root
	addCorner(back, 4)

	local clip = Instance.new("Frame")
	clip.Name = "Clip"
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = back

	_healthBarBack = back

	local fill = newFrame("HealthFill")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = COL_GOOD
	fill.BackgroundTransparency = 0.1
	fill.Parent = clip
	addCorner(fill, 4)
	healthFill = fill

	local label = newTextLabel("HealthText")
	label.Size = UDim2.new(1, 0, 0.45, 0)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Text = "100 / 100"
	label.TextSize = 15
	label.TextColor3 = COL_DIM
	label.Parent = root
	healthText = label

	return root
end

local function buildAmmo(): Frame
	local root = newFrame("AmmoRoot")
	root.Size = UDim2.new(0.24, 0, 0.09, 0)
	root.Position = UDim2.new(0.98, 0, 0.9, 0)
	root.AnchorPoint = Vector2.new(1, 1)

	local weapon = newTextLabel("WeaponName")
	weapon.Size = UDim2.new(1, 0, 0.3, 0)
	weapon.Position = UDim2.new(0, 0, 0, 0)
	weapon.TextXAlignment = Enum.TextXAlignment.Right
	weapon.Text = "Sidearm"
	weapon.TextSize = 14
	weapon.TextColor3 = COL_DIM
	weapon.Parent = root
	weaponText = weapon

	local ammo = newTextLabel("AmmoText")
	ammo.Size = UDim2.new(1, 0, 0.5, 0)
	ammo.Position = UDim2.new(0, 0, 0.3, 0)
	ammo.TextXAlignment = Enum.TextXAlignment.Right
	ammo.Text = "12 / 120"
	ammo.TextSize = 30
	ammo.TextColor3 = COL_TEXT
	ammo.Parent = root
	ammoText = ammo

	local reload = newFrame("ReloadIndicator")
	reload.Size = UDim2.new(0.6, 0, 0.16, 0)
	reload.Position = UDim2.new(1, 0, 0.86, 0)
	reload.AnchorPoint = Vector2.new(1, 0)
	reload.BackgroundColor3 = COL_PANEL
	reload.BackgroundTransparency = 0.4
	reload.Visible = false
	reload.Parent = root
	addCorner(reload, 3)
	reloadFrame = reload

	local rfill = newFrame("ReloadFill")
	rfill.Size = UDim2.new(0, 0, 1, 0)
	rfill.BackgroundColor3 = COL_ACCENT
	rfill.BackgroundTransparency = 0.15
	rfill.Parent = reload
	addCorner(rfill, 3)
	reloadFill = rfill

	return root
end

local function buildWave(): Frame
	local root = newFrame("WaveRoot")
	root.Size = UDim2.new(0.3, 0, 0.11, 0)
	root.Position = UDim2.new(0.5, 0, 0.015, 0)
	root.AnchorPoint = Vector2.new(0.5, 0)

	local panel = newFrame("WavePanel")
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = COL_PANEL
	panel.BackgroundTransparency = 0.45
	panel.Parent = root
	addCorner(panel, 6)
	panel.Parent = root

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = root

	local title = newTextLabel("WaveText")
	title.Size = UDim2.new(1, 0, 0.42, 0)
	title.Position = UDim2.new(0, 0, 0.08, 0)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.Text = "WAVE 1"
	title.TextSize = 22
	title.TextColor3 = COL_ACCENT
	title.Parent = root
	waveText = title

	local zeds = newTextLabel("ZombiesText")
	zeds.Size = UDim2.new(0.5, 0, 0.34, 0)
	zeds.Position = UDim2.new(0, 0, 0.58, 0)
	zeds.TextXAlignment = Enum.TextXAlignment.Left
	zeds.Text = "Zombies 0"
	zeds.TextSize = 14
	zeds.TextColor3 = COL_TEXT
	zeds.Parent = root
	zombiesText = zeds

	local timer = newTextLabel("TimerText")
	timer.Size = UDim2.new(0.5, 0, 0.34, 0)
	timer.Position = UDim2.new(0.5, 0, 0.58, 0)
	timer.TextXAlignment = Enum.TextXAlignment.Right
	timer.Text = "--"
	timer.TextSize = 14
	timer.TextColor3 = COL_DIM
	timer.Parent = root
	timerText = timer

	return root
end

local function buildStats(): Frame
	local root = newFrame("StatsRoot")
	root.Size = UDim2.new(0.22, 0, 0.14, 0)
	root.Position = UDim2.new(0.02, 0, 0.015, 0)
	root.AnchorPoint = Vector2.new(0, 0)

	local panel = newFrame("StatsPanel")
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = COL_PANEL
	panel.BackgroundTransparency = 0.45
	panel.Parent = root
	addCorner(panel, 6)

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 8)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = root

	local list = addList(root, Enum.FillDirection.Vertical, 2)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Left
	list.VerticalAlignment = Enum.VerticalAlignment.Top

	local coins = newTextLabel("CoinsText")
	coins.Size = UDim2.new(1, 0, 0.3, 0)
	coins.Text = "Coins 0"
	coins.TextSize = 17
	coins.TextColor3 = COL_ACCENT
	coins.LayoutOrder = 1
	coins.Parent = root
	coinsText = coins

	local xp = newTextLabel("XPText")
	xp.Size = UDim2.new(1, 0, 0.26, 0)
	xp.Text = "Level 1  •  0 XP"
	xp.TextSize = 14
	xp.TextColor3 = COL_TEXT
	xp.LayoutOrder = 2
	xp.Parent = root
	xpText = xp

	local xpTrack = newFrame("XPTrack")
	xpTrack.Size = UDim2.new(1, 0, 0.12, 0)
	xpTrack.BackgroundColor3 = COL_BG
	xpTrack.BackgroundTransparency = 0.2
	xpTrack.LayoutOrder = 3
	xpTrack.Parent = root
	addCorner(xpTrack, 2)

	local xf = newFrame("XPFill")
	xf.Size = UDim2.new(0, 0, 1, 0)
	xf.BackgroundColor3 = COL_GOOD
	xf.BackgroundTransparency = 0.2
	xf.Parent = xpTrack
	addCorner(xf, 2)
	xpFill = xf

	local kills = newTextLabel("KillsText")
	kills.Size = UDim2.new(1, 0, 0.26, 0)
	kills.Text = "Kills 0"
	kills.TextSize = 14
	kills.TextColor3 = COL_DIM
	kills.LayoutOrder = 4
	kills.Parent = root
	killsText = kills

	return root
end

local function buildCrosshair(): Frame
	local root = newFrame("Crosshair")
	root.Size = UDim2.new(0, 40, 0, 40)
	root.Position = UDim2.new(0.5, 0, 0.5, 0)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1

	local thickness: number = 2
	local length: number = 8

	chTop = newFrame("Top")
	chTop.Size = UDim2.new(0, thickness, 0, length)
	chTop.Position = UDim2.new(0.5, 0, 0, 0)
	chTop.AnchorPoint = Vector2.new(0.5, 0)
	chTop.BackgroundColor3 = COL_TEXT
	chTop.BackgroundTransparency = 0.15
	chTop.Parent = root

	chBottom = newFrame("Bottom")
	chBottom.Size = UDim2.new(0, thickness, 0, length)
	chBottom.Position = UDim2.new(0.5, 0, 1, 0)
	chBottom.AnchorPoint = Vector2.new(0.5, 1)
	chBottom.BackgroundColor3 = COL_TEXT
	chBottom.BackgroundTransparency = 0.15
	chBottom.Parent = root

	chLeft = newFrame("Left")
	chLeft.Size = UDim2.new(0, length, 0, thickness)
	chLeft.Position = UDim2.new(0, 0, 0.5, 0)
	chLeft.AnchorPoint = Vector2.new(0, 0.5)
	chLeft.BackgroundColor3 = COL_TEXT
	chLeft.BackgroundTransparency = 0.15
	chLeft.Parent = root

	chRight = newFrame("Right")
	chRight.Size = UDim2.new(0, length, 0, thickness)
	chRight.Position = UDim2.new(1, 0, 0.5, 0)
	chRight.AnchorPoint = Vector2.new(1, 0.5)
	chRight.BackgroundColor3 = COL_TEXT
	chRight.BackgroundTransparency = 0.15
	chRight.Parent = root

	chDot = newFrame("Dot")
	chDot.Size = UDim2.new(0, 2, 0, 2)
	chDot.Position = UDim2.new(0.5, 0, 0.5, 0)
	chDot.AnchorPoint = Vector2.new(0.5, 0.5)
	chDot.BackgroundColor3 = COL_TEXT
	chDot.BackgroundTransparency = 0.5
	chDot.Parent = root

	local hm = newFrame("Hitmarker")
	hm.Size = UDim2.new(0, 26, 0, 26)
	hm.Position = UDim2.new(0.5, 0, 0.5, 0)
	hm.AnchorPoint = Vector2.new(0.5, 0.5)
	hm.BackgroundTransparency = 1
	hm.Visible = false
	hm.Parent = root

	-- Four diagonal ticks forming the classic X hit confirmation.
	for i = 1, 4 do
		local tick = newFrame("Tick" .. tostring(i))
		tick.Size = UDim2.new(0, 2, 0, 8)
		tick.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		tick.BackgroundTransparency = 0.0
		if i == 1 then
			tick.Position = UDim2.new(0.5, 0, 0.5, 0)
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Rotation = 45
		elseif i == 2 then
			tick.Position = UDim2.new(0.5, 0, 0.5, 0)
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Rotation = -45
		elseif i == 3 then
			tick.Position = UDim2.new(0.5, 0, 0.5, 0)
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Rotation = 45
			tick.Size = UDim2.new(0, 8, 0, 2)
		else
			tick.Position = UDim2.new(0.5, 0, 0.5, 0)
			tick.AnchorPoint = Vector2.new(0.5, 0.5)
			tick.Rotation = -45
			tick.Size = UDim2.new(0, 8, 0, 2)
		end
		tick.Parent = hm
	end

	hitmarker = hm
	return root
end

local function buildVignette(): Frame
	-- A full-screen red wash that fades in on damage. Non-intrusive: it sits
	-- behind every panel (ZIndex 1) and never captures input. The "vignette"
	-- falloff is approximated with a UIGradient built from ColorSequence.new /
	-- NumberSequence.new directly, so no keypoint constructors are needed.
	local v = newFrame("DamageVignette")
	v.Size = UDim2.new(1, 0, 1, 0)
	v.Position = UDim2.new(0, 0, 0, 0)
	v.BackgroundColor3 = Color3.fromRGB(170, 28, 28)
	v.BackgroundTransparency = 1
	v.ZIndex = 1

	local grad = Instance.new("UIGradient")
	grad.Color = ColorSequence.new(Color3.fromRGB(190, 40, 40), Color3.fromRGB(60, 6, 6))
	grad.Transparency = NumberSequence.new(0)
	grad.Parent = v

	return v
end

local function buildMuzzleFlash(): Frame
	-- Corner flash suggesting muzzle light; purely a Frame so no assets load.
	local f = newFrame("MuzzleFlash")
	f.Size = UDim2.new(0.12, 0, 0.05, 0)
	f.Position = UDim2.new(0.74, 0, 0.76, 0)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.BackgroundColor3 = Color3.fromRGB(255, 230, 150)
	f.BackgroundTransparency = 1
	f.Visible = false
	addCorner(f, 8)
	return f
end

local function buildNotifications(): Frame
	local root = newFrame("Notifications")
	root.Size = UDim2.new(0.26, 0, 0.3, 0)
	root.Position = UDim2.new(0.5, 0, 0.22, 0)
	root.AnchorPoint = Vector2.new(0.5, 0)
	root.BackgroundTransparency = 1

	local layout = addList(root, Enum.FillDirection.Vertical, 4)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	return root
end

local function buildDamageNumbers(): Frame
	local root = newFrame("DamageNumbers")
	root.Size = UDim2.new(1, 0, 1, 0)
	root.Position = UDim2.new(0, 0, 0, 0)
	root.BackgroundTransparency = 1
	root.ZIndex = 5
	return root
end

local function buildIntermissionBanner(): Frame
	local root = newFrame("BannerRoot")
	root.Size = UDim2.new(0.5, 0, 0.08, 0)
	root.Position = UDim2.new(0.5, 0, 0.16, 0)
	root.AnchorPoint = Vector2.new(0.5, 0)
	root.BackgroundTransparency = 1

	local t = newTextLabel("BannerText")
	t.Size = UDim2.new(1, 0, 1, 0)
	t.Position = UDim2.new(0, 0, 0, 0)
	t.TextXAlignment = Enum.TextXAlignment.Center
	t.Text = ""
	t.TextSize = 26
	t.TextColor3 = COL_ACCENT
	t.TextTransparency = 1
	t.Parent = root
	bannerText = t

	return root
end

local function buildGameOver(): Frame
	local root = newFrame("GameOverRoot")
	root.Size = UDim2.new(0.42, 0, 0.34, 0)
	root.Position = UDim2.new(0.5, 0, 0.5, 0)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.BackgroundTransparency = 1
	root.Visible = false
	root.ZIndex = 20

	local panel = newFrame("Panel")
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(24, 12, 14)
	panel.BackgroundTransparency = 0.12
	panel.Parent = root
	addCorner(panel, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = COL_BAD
	stroke.Thickness = 2
	stroke.Parent = panel

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 16)
	pad.PaddingBottom = UDim.new(0, 16)
	pad.PaddingLeft = UDim.new(0, 18)
	pad.PaddingRight = UDim.new(0, 18)
	pad.Parent = root

	local layout = addList(root, Enum.FillDirection.Vertical, 10)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local title = newTextLabel("Title")
	title.Size = UDim2.new(1, 0, 0.22, 0)
	title.TextXAlignment = Enum.TextXAlignment.Center
	title.Text = "YOU DIED"
	title.TextSize = 34
	title.TextColor3 = COL_BAD
	title.LayoutOrder = 1
	title.Parent = root
	gameOverTitle = title

	local body = newTextLabel("Body")
	body.Size = UDim2.new(1, 0, 0.34, 0)
	body.TextXAlignment = Enum.TextXAlignment.Center
	body.TextYAlignment = Enum.TextYAlignment.Top
	body.TextWrapped = true
	body.Text = ""
	body.TextSize = 16
	body.TextColor3 = COL_TEXT
	body.LayoutOrder = 2
	body.Parent = root
	gameOverBody = body

	local btn = newTextButton("RespawnButton")
	btn.Size = UDim2.new(0.6, 0, 0.2, 0)
	btn.Position = UDim2.new(0.5, 0, 0.78, 0)
	btn.AnchorPoint = Vector2.new(0.5, 0.5)
	btn.BackgroundColor3 = COL_GOOD
	btn.BackgroundTransparency = 0.15
	btn.Text = "RESPAWN"
	btn.TextSize = 18
	btn.LayoutOrder = 3
	btn.Visible = true
	btn.Parent = root
	addCorner(btn, 6)
	respawnButton = btn

	local spec = newTextLabel("SpectateText")
	spec.Size = UDim2.new(1, 0, 0.18, 0)
	spec.TextXAlignment = Enum.TextXAlignment.Center
	spec.Text = "Spectating... waiting for the next run."
	spec.TextSize = 14
	spec.TextColor3 = COL_DIM
	spec.LayoutOrder = 4
	spec.Visible = false
	spec.Parent = root
	spectateLabel = spec

	return root
end

local function ensureGui(): ScreenGui
	if gui then
		return gui
	end

	local existing = playerGui:FindFirstChild("ZombieHUD")
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end
	gui = Instance.new("ScreenGui")
	gui.Name = "ZombieHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = playerGui

	screen = gui

	local vign = buildVignette()
	vign.Parent = gui
	vignette = vign

	local flash = buildMuzzleFlash()
	flash.Parent = gui
	muzzleFlash = flash

	local health = buildHealth()
	health.Parent = gui

	local wave = buildWave()
	wave.Parent = gui

	local stats = buildStats()
	stats.Parent = gui

	local ammoRoot = buildAmmo()
	ammoRoot.Parent = gui

	local cross = buildCrosshair()
	cross.Parent = gui
	crosshair = cross

	local dmgs = buildDamageNumbers()
	dmgs.Parent = gui
	damageNumbersFrame = dmgs

	local notifs = buildNotifications()
	notifs.Parent = gui
	notificationsFrame = notifs

	local banner = buildIntermissionBanner()
	banner.Parent = gui

	local over = buildGameOver()
	over.Parent = gui
	gameOverPanel = over

	return gui
end

-- Setters -------------------------------------------------------------------

function HUD.SetHealth(health: number, maxHealth: number)
	if not healthFill then return end
	local frac: number = clamp01(health / math.max(1, maxHealth))
	healthFill.Size = UDim2.new(frac, 0, 1, 0)
	if healthText then
		healthText.Text = string.format("%d / %d", math.floor(health), math.floor(maxHealth))
	end
	-- Colour-shift toward red as health drops.
	local r: number = lerp(0.35, 0.89, 1 - frac)
	local g: number = lerp(0.82, 0.31, 1 - frac)
	healthFill.BackgroundColor3 = Color3.new(r, g, 0.5)
end

function HUD.SetAmmo(state: WeaponState?)
	if not state then return end
	if weaponText then
		local defs: any = Config.Weapons
		local def: WeaponDef? = defs[state.WeaponId]
		weaponText.Text = if def then def.DisplayName else state.WeaponId
	end
	if ammoText then
		ammoText.Text = string.format("%d / %d", state.AmmoInMag, state.AmmoReserve)
		if state.AmmoInMag <= 0 then
			ammoText.TextColor3 = COL_BAD
		else
			ammoText.TextColor3 = COL_TEXT
		end
	end
	if reloadFrame and reloadFill then
		reloadFrame.Visible = state.Reloading
		if state.Reloading then
			local frac: number = 0
			local endsAt: number? = state.ReloadEndsAt
			local t: number = now()
			if endsAt then
				local total: number = 1.5
				local remaining: number = math.max(0, endsAt - t)
				frac = clamp01(1 - remaining / total)
			end
			reloadFill.Size = UDim2.new(frac, 0, 1, 0)
		end
	end
end

function HUD.SetWave(state: WaveState?)
	if not state then return end
	if waveText then
		waveText.Text = string.format("WAVE %d", state.Wave)
	end
	if zombiesText then
		if state.Phase == "Active" then
			zombiesText.Text = string.format("Zombies %d / %d", state.ZombiesRemaining, state.ZombiesTotal)
			zombiesText.TextColor3 = COL_TEXT
		else
			zombiesText.Text = string.format("Killed %d", state.ZombiesTotal)
			zombiesText.TextColor3 = COL_DIM
		end
	end
	if timerText then
		local secs: number = math.max(0, state.TimeRemaining)
		if state.Phase == "Intermission" then
			timerText.Text = string.format("Next wave in %ds", math.ceil(secs))
			timerText.TextColor3 = COL_WARN
		elseif state.Phase == "Active" then
			timerText.Text = wavePhaseName(state.Phase)
			timerText.TextColor3 = COL_GOOD
		else
			timerText.Text = wavePhaseName(state.Phase)
			timerText.TextColor3 = COL_BAD
		end
	end
	HUD.ShowBanner(wavePhaseName(state.Phase) .. " - " .. string.format("WAVE %d", state.Wave), 1.6)
end

function HUD.SetStats(stats: PlayerStats?)
	if not stats then return end
	cachedStats = stats
	if coinsText then
		coinsText.Text = string.format("Coins %d", stats.Coins)
	end
	if killsText then
		killsText.Text = string.format("Kills %d", stats.Kills)
	end
	if xpText then
		xpText.Text = string.format("Level %d  •  %d XP", stats.Level, stats.XP)
	end
	if xpFill then
		-- XP curve mirrors Config.Economy so the bar shows progress to next level.
		local base: number = 100
		local growth: number = 1.35
		local need: number = base * math.pow(growth, math.max(0, stats.Level - 1))
		local frac: number = clamp01(stats.XP / math.max(1, need))
		xpFill.Size = UDim2.new(frac, 0, 1, 0)
	end
	HUD.SetHealth(stats.Health, stats.MaxHealth)
	if not gameOverPanel.Visible then
		HUD.SetGameOverVisible(false)
	end
end

function HUD.GetCachedStats(): PlayerStats?
	return cachedStats
end

function HUD.SetCrosshairSpread(spread: number)
	crosshairSpread = spread
	spreadDecayAt = now() + 0.12
end

function HUD.PulseCrosshair(spread: number)
	HUD.SetCrosshairSpread(spread)
	crosshairUntilSpread = now() + 0.08
end

function HUD.ShowHitmarker(killed: boolean?)
	if not hitmarker then return end
	hitmarker.Visible = true
	hitmarkerUntil = now() + (if killed then 0.22 else 0.12)
	if killed then
		local ticks: any = hitmarker:GetChildren()
		for _, t in ipairs(ticks) do
			t.BackgroundColor3 = COL_BAD
		end
	else
		local ticks2: any = hitmarker:GetChildren()
		for _, t in ipairs(ticks2) do
			t.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		end
	end
end

function HUD.ShowMuzzleFlash()
	if not muzzleFlash then return end
	muzzleFlash.Visible = true
	flashUntil = now() + 0.06
	muzzleFlash.BackgroundTransparency = 0.1
end

function HUD.FlashDamage(intensity: number?)
	local amount: number = intensity or 1
	vignetteLevel = clamp01(vignetteLevel + amount)
	if vignette then
		vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
	end
end

function HUD.ShowBanner(text: string, duration: number?)
	if not bannerText then return end
	bannerText.Text = text
	bannerText.TextTransparency = 0
	bannerText.TextStrokeTransparency = 0.6
	local dur: number = duration or 2
	task.delay(dur, function()
		if bannerText then
			bannerText.TextTransparency = 1
		end
	end)
end

function HUD.Notify(text: string, kind: string?)
	if not notificationsFrame then return end
	if not text or text == "" then return end

	local label = newTextLabel("Toast")
	label.Size = UDim2.new(0, 0, 0, 0)
	label.AutomaticSize = Enum.AutomaticSize.XY
	label.Text = text
	label.TextSize = 15
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.BackgroundTransparency = 1
	label.TextStrokeTransparency = 0.5
	label.LayoutOrder = math.floor(now() * 100)
	label.Parent = notificationsFrame

	if kind == "kill" then
		label.TextColor3 = COL_GOOD
	elseif kind == "hit" then
		label.TextColor3 = COL_TEXT
	elseif kind == "warn" then
		label.TextColor3 = COL_WARN
	elseif kind == "bad" then
		label.TextColor3 = COL_BAD
	elseif kind == "coin" then
		label.TextColor3 = COL_ACCENT
	else
		label.TextColor3 = COL_TEXT
	end

	table.insert(toasts, { Label = label, ExpiresAt = now() + TOAST_LIFE })

	while #toasts > MAX_TOASTS do
		local oldest: Toast? = table.remove(toasts, 1)
		if oldest then
			oldest.Label:Destroy()
		end
	end
end

-- Optional floating number above a world position (uses Camera projection if
-- the camera is available; otherwise it is pinned near the crosshair).
function HUD.ShowDamageNumber(amount: number, worldPos: Vector3?, killed: boolean?)
	if not damageNumbersFrame then return end
	if #activeDamageNumbers >= MAX_DAMAGE_NUMBERS then
		local oldest: any = table.remove(activeDamageNumbers, 1)
		if oldest and oldest.Label then
			oldest.Label:Destroy()
		end
	end

	local label = newTextLabel("Dmg")
	label.Size = UDim2.new(0, 80, 0, 24)
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.new(0.5, 0, 0.42, 0)
	label.Text = string.format("%d", math.floor(amount))
	label.TextSize = 18
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextStrokeTransparency = 0.4
	label.BackgroundTransparency = 1
	label.ZIndex = 6
	if killed then
		label.TextColor3 = COL_BAD
		label.TextSize = 22
	else
		label.TextColor3 = Color3.fromRGB(255, 240, 210)
	end
	label.Parent = damageNumbersFrame

	local entry: any = {
		Label = label,
		ExpiresAt = now() + DAMAGE_NUMBER_LIFE,
		Origin = worldPos,
		Any = nil,
	}
	table.insert(activeDamageNumbers, entry)
end

function HUD.SetGameOverVisible(visible: boolean, data: any?)
	if not gameOverPanel then return end
	gameOverPanel.Visible = visible
	if not visible then return end
	if not data then return end

	if gameOverTitle then
		local titleText: string = "RUN OVER"
		local d: any = data
		local reason: string? = d.Reason
		if reason == "killed" then titleText = "YOU DIED" end
		if reason == "won" then titleText = "ARENA CLEARED" end
		gameOverTitle.Text = titleText
	end
	if gameOverBody then
		local d2: any = data
		local wave: number = tonumber(d2.Wave) or 0
		local kills: number = tonumber(d2.Kills) or 0
		local coins: number = tonumber(d2.Coins) or 0
		gameOverBody.Text = string.format("Wave %d  •  Kills %d  •  Coins %d", wave, kills, coins)
	end
	if respawnButton and spectateLabel then
		local d3: any = data
		local canRespawn: boolean = true
		if d3.CanRespawn == false then canRespawn = false end
		if d3.Reason == "won" then canRespawn = false end
		respawnButton.Visible = canRespawn
		spectateLabel.Visible = not canRespawn
		if not canRespawn then
			spectateLabel.Text = "Spectating... waiting for the next run."
		end
	end
end

function HUD.OnRespawnRequested(cb: any)
	respawnCallback = cb
	if respawnButton then
		respawnButton.MouseButton1Click:Connect(function()
			if respawnCallback then
				pcall(function()
					respawnCallback()
				end)
			end
		end)
	end
end

-- Update loop ---------------------------------------------------------------

local function updateCrosshair(t: number, dt: number)
	if not crosshair then return end
	local alpha: number = 0
	if now() < crosshairUntilSpread then
		alpha = 1
	elseif spreadDecayAt > t then
		alpha = 0.5
	end
	local spread: number = crosshairSpread * alpha
	local gap: number = 6 + spread * 40

	chTop.Position = UDim2.new(0.5, 0, 0.5, -gap - 8)
	chBottom.Position = UDim2.new(0.5, 0, 0.5, gap + 8)
	chLeft.Position = UDim2.new(0.5, -gap - 8, 0.5, 0)
	chRight.Position = UDim2.new(0.5, gap + 8, 0.5, 0)
	chDot.BackgroundTransparency = 0.5 + spread * 0.4
end

local function updateVignette(dt: number)
	if not vignette then return end
	if vignetteLevel > 0 then
		vignetteLevel = math.max(0, vignetteLevel - dt * 1.6)
		vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
	end
end

local function updateToasts(t: number)
	local alive: number = 0
	for i = #toasts, 1, -1 do
		local toast: Toast = toasts[i]
		if toast.ExpiresAt <= t then
			toast.Label:Destroy()
			table.remove(toasts, i)
		else
			alive += 1
			local remaining: number = toast.ExpiresAt - t
			local fade: number = clamp01(remaining / 0.6)
			toast.Label.TextTransparency = 1 - fade
		end
	end
	if alive > MAX_TOASTS then
		-- Safety net: structural limit enforced elsewhere.
	end
end

local function updateDamageNumbers(dt: number)
	local t: number = now()
	for i = #activeDamageNumbers, 1, -1 do
		local entry: any = activeDamageNumbers[i]
		if entry.ExpiresAt <= t then
			entry.Label:Destroy()
			table.remove(activeDamageNumbers, i)
		else
			local age: number = t - (entry.ExpiresAt - DAMAGE_NUMBER_LIFE)
			local frac: number = clamp01(age / DAMAGE_NUMBER_LIFE)
			entry.Label.Position = UDim2.new(0.5, 0, 0.42 - frac * 0.08, 0)
			entry.Label.TextTransparency = frac
		end
	end
end

local function updateHitmarker(t: number)
	if not hitmarker then return end
	if hitmarker.Visible and t >= hitmarkerUntil then
		hitmarker.Visible = false
	end
end

local function updateFlash(t: number)
	if not muzzleFlash then return end
	if muzzleFlash.Visible and t >= flashUntil then
		muzzleFlash.Visible = false
	end
end

local function updateLowHealthPulse(dt: number)
	if not cachedStats then return end
	local frac: number = clamp01(cachedStats.Health / math.max(1, cachedStats.MaxHealth))
	if frac < 0.3 then
		lowHealthPulse += dt * 4
		local pulse: number = (math.sin(lowHealthPulse) + 1) * 0.5
		vignetteLevel = math.max(vignetteLevel, 0.12 + pulse * 0.13)
		if vignette then
			vignette.BackgroundTransparency = clamp01(1 - vignetteLevel * 0.85)
		end
	end
end

local function onRenderStep(dt: number)
	if not started then return end
	local t: number = now()
	updateCrosshair(t, dt)
	updateVignette(dt)
	updateLowHealthPulse(dt)
	updateToasts(t)
	updateDamageNumbers(dt)
	updateHitmarker(t)
	updateFlash(t)
end

-- Lifecycle ----------------------------------------------------------------

function HUD.Start(plrGui: any)
	if started then return end
	playerGui = plrGui
	ensureGui()
	started = true

	local rs: any = game:GetService("RunService")
	_runServiceConn = rs.RenderStepped:Connect(function(dt: number)
		pcall(onRenderStep, dt)
	end)
end

function HUD.IsStarted(): boolean
	return started
end

function HUD.GetScreenGui(): ScreenGui?
	return screen
end

function HUD.Reset()
	if gameOverPanel then gameOverPanel.Visible = false end
	vignetteLevel = 0
	if vignette then vignette.BackgroundTransparency = 1 end
	for _, toast in ipairs(toasts) do
		toast.Label:Destroy()
	end
	table.clear(toasts)
	for _, entry in ipairs(activeDamageNumbers) do
		local e: any = entry
		e.Label:Destroy()
	end
	table.clear(activeDamageNumbers)
end

-- Expose local mirrors for the sibling client modules (types are lint-only).
export type PlayerStatsMirror = PlayerStats
export type WaveStateMirror = WaveState
export type WeaponStateMirror = WeaponState
export type WeaponDefMirror = WeaponDef
export type RunStateMirror = RunState

return HUD
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- Intermission shop UI.
--
-- Builds a code-only purchase panel (weapons + perks) that is shown during the
-- "Intermission" wave phase and hidden the moment the phase flips to "Active".
--
-- Everything here is defensive: the server may not have booted yet (or may not
-- exist in a client-only test place), so remotes are resolved through a
-- timeout-guarded WaitForChild and every fire is wrapped in pcall. A missing
-- remote degrades to a silent no-op instead of an error.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

-- Cross-module requires are filtered analyzer noise (Unknown require).
local Config = require(Shared:WaitForChild("Config"))
local _Types = require(Shared:WaitForChild("Types"))

-- Structural mirrors of Config tables. luau-analyze cannot resolve exported
-- types across `require`, so each shape is redeclared here (kept in sync with
-- Shared/Config.luau). Lint-time aliases only; runtime values are real.
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type PerkDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Cost: number,
	MaxStacks: number,
	DamageMult: number?,
	FireRateMult: number?,
	ReloadMult: number?,
	MoveSpeedFlat: number?,
	MaxHealthFlat: number?,
	MagazineMult: number?,
	LifestealPct: number?,
	ExtraLives: number?,
	CoinMult: number?,
}

type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type RunState = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: { [string]: number },
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
}

type ShopState = {
	Phase: string,
	OwnedWeapons: { [string]: boolean }?,
	CurrentWeapon: string?,
	Perks: { [string]: number }?,
	Coins: number?,
}

type RowRefs = {
	Root: Frame,
	Button: TextButton,
	NameLabel: TextLabel,
	CostLabel: TextLabel,
	StacksLabel: TextLabel,
}

local ShopUI = {}

local COL_BG = Color3.fromRGB(14, 16, 22)
local COL_PANEL = Color3.fromRGB(22, 25, 33)
local COL_ROW = Color3.fromRGB(28, 32, 42)
local COL_TEXT = Color3.fromRGB(236, 240, 247)
local COL_DIM = Color3.fromRGB(148, 156, 170)
local COL_GOOD = Color3.fromRGB(88, 208, 128)
local COL_BAD = Color3.fromRGB(226, 88, 88)
local COL_ACCENT = Color3.fromRGB(232, 196, 88)

local playerGui: any = nil
local gui: ScreenGui = nil :: any
local root: Frame = nil :: any
local titleLabel: TextLabel = nil :: any
local coinsLabel: TextLabel = nil :: any
local hintLabel: TextLabel = nil :: any
local weaponsScroll: ScrollingFrame = nil :: any
local perksScroll: ScrollingFrame = nil :: any
local weaponsList: Frame = nil :: any
local perksList: Frame = nil :: any

local weaponRows: { [string]: RowRefs } = {}
local perkRows: { [string]: RowRefs } = {}

local started: boolean = false
local visibleNow: boolean = false
local currentStats: PlayerStats? = nil
local _currentRun: RunState? = nil
local ownedWeapons: { [string]: boolean } = {}
local perkStacks: { [string]: number } = {}
local currentWeapon: string = "Pistol"

local purchaseWeaponRemote: any = nil
local purchasePerkRemote: any = nil

local REMOTE_TIMEOUT: number = 5

-- Helpers -------------------------------------------------------------------

local function newFrame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(0, 0, 0, 0)
	f.Position = UDim2.new(0, 0, 0, 0)
	return f
end

local function newTextLabel(name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.new(0, 0, 0, 0)
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Text = ""
	l.TextColor3 = COL_TEXT
	l.TextSize = 15
	l.Font = Enum.Font.GothamSemibold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	return l
end

local function newTextButton(name: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.BorderSizePixel = 0
	b.Size = UDim2.new(0, 0, 0, 0)
	b.Position = UDim2.new(0, 0, 0, 0)
	b.Text = ""
	b.TextColor3 = COL_TEXT
	b.TextSize = 15
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	return b
end

local function addCorner(parent: Instance, r: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function addList(parent: Instance, pad: number): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Parent = parent
	return l
end

local function safeNumber(v: any, fallback: number): number
	local n = tonumber(v)
	if n then return n end
	return fallback
end

-- Remote access -------------------------------------------------------------

local function waitForRemote(name: string): any
	-- Resolve a RemoteEvent defensively: never let a missing instance break the
	-- client. Returns nil if the server has not created it (yet).
	local ok: boolean, result: any = pcall(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
		if not folder then return nil end
		local r = folder:WaitForChild(name, REMOTE_TIMEOUT)
		return r
	end)
	if ok then
		return result
	end
	return nil
end

local function ensureRemotes()
	if purchaseWeaponRemote == nil then
		purchaseWeaponRemote = waitForRemote("RequestPurchaseWeapon")
	end
	if purchasePerkRemote == nil then
		purchasePerkRemote = waitForRemote("RequestPurchasePerk")
	end
end

local function fireWeaponPurchase(weaponId: string)
	ensureRemotes()
	if not purchaseWeaponRemote then return end
	pcall(function()
		purchaseWeaponRemote:FireServer(weaponId)
	end)
end

local function firePerkPurchase(perkId: string)
	ensureRemotes()
	if not purchasePerkRemote then return end
	pcall(function()
		purchasePerkRemote:FireServer(perkId)
	end)
end

-- UI construction ----------------------------------------------------------

local function buildRow(
	id: string,
	displayName: string,
	cost: number,
	subText: string,
	onClick: () -> ()
): RowRefs
	local row = newFrame("Row_" .. id)
	row.Size = UDim2.new(1, 0, 0, 52)
	row.BackgroundColor3 = COL_ROW
	row.BackgroundTransparency = 0.1
	row.LayoutOrder = 0

	local corner = addCorner(row, 6)

	local nameLabel = newTextLabel("Name")
	nameLabel.Size = UDim2.new(0.62, -14, 0.45, 0)
	nameLabel.Position = UDim2.new(0, 12, 0.06, 0)
	nameLabel.Text = displayName
	nameLabel.TextSize = 16
	nameLabel.Parent = row

	local sub = newTextLabel("Sub")
	sub.Size = UDim2.new(0.62, -14, 0.4, 0)
	sub.Position = UDim2.new(0, 12, 0.54, 0)
	sub.Text = subText
	sub.TextSize = 13
	sub.TextColor3 = COL_DIM
	sub.Parent = row

	local costLabel = newTextLabel("Cost")
	costLabel.Size = UDim2.new(0.38, -8, 0.5, 0)
	costLabel.Position = UDim2.new(0.62, 0, 0.06, 0)
	costLabel.TextXAlignment = Enum.TextXAlignment.Right
	costLabel.Text = if cost <= 0 then "FREE" else string.format("%d c", cost)
	costLabel.TextSize = 15
	costLabel.TextColor3 = COL_ACCENT
	costLabel.Parent = row

	local stacksLabel = newTextLabel("Stacks")
	stacksLabel.Size = UDim2.new(0.38, -8, 0.4, 0)
	stacksLabel.Position = UDim2.new(0.62, 0, 0.54, 0)
	stacksLabel.TextXAlignment = Enum.TextXAlignment.Right
	stacksLabel.Text = ""
	stacksLabel.TextSize = 13
	stacksLabel.TextColor3 = COL_DIM
	stacksLabel.Parent = row

	local button = newTextButton("Buy")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Position = UDim2.new(0, 0, 0, 0)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.Parent = row
	button.MouseButton1Click:Connect(function()
		pcall(onClick)
	end)

	-- Keep the row graphic above the transparent hit-target button.
	corner.Parent = row
	nameLabel.ZIndex = 2
	sub.ZIndex = 2
	costLabel.ZIndex = 2
	stacksLabel.ZIndex = 2

	return {
		Root = row,
		Button = button,
		NameLabel = nameLabel,
		CostLabel = costLabel,
		StacksLabel = stacksLabel,
	}
end

local function ensureGui(): ScreenGui
	if gui then
		return gui
	end

	local existing = playerGui:FindFirstChild("ZombieShop")
	if existing and existing:IsA("ScreenGui") then
		existing:Destroy()
	end

	gui = Instance.new("ScreenGui")
	gui.Name = "ZombieShop"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 20
	gui.Enabled = true
	gui.Parent = playerGui

	root = newFrame("ShopRoot")
	root.Size = UDim2.new(0.62, 0, 0.56, 0)
	root.Position = UDim2.new(0.5, 0, 0.5, 0)
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.BackgroundColor3 = COL_PANEL
	root.BackgroundTransparency = 0.08
	root.Visible = false
	root.Parent = gui
	addCorner(root, 10)

	local stroke = Instance.new("UIStroke")
	stroke.Color = COL_ACCENT
	stroke.Thickness = 2
	stroke.Parent = root

	local header = newFrame("Header")
	header.Size = UDim2.new(1, 0, 0, 54)
	header.Position = UDim2.new(0, 0, 0, 0)
	header.BackgroundTransparency = 1
	header.Parent = root

	titleLabel = newTextLabel("Title")
	titleLabel.Size = UDim2.new(0.6, -20, 0.55, 0)
	titleLabel.Position = UDim2.new(0, 20, 0.1, 0)
	titleLabel.Text = "ARMORY — Intermission"
	titleLabel.TextSize = 22
	titleLabel.TextColor3 = COL_ACCENT
	titleLabel.Parent = header

	coinsLabel = newTextLabel("Coins")
	coinsLabel.Size = UDim2.new(0.4, -20, 0.45, 0)
	coinsLabel.Position = UDim2.new(0.6, 0, 0.1, 0)
	coinsLabel.TextXAlignment = Enum.TextXAlignment.Right
	coinsLabel.Text = "Coins 0"
	coinsLabel.TextSize = 17
	coinsLabel.TextColor3 = COL_ACCENT
	coinsLabel.Parent = header

	hintLabel = newTextLabel("Hint")
	hintLabel.Size = UDim2.new(1, -40, 0.4, 0)
	hintLabel.Position = UDim2.new(0, 20, 0.62, 0)
	hintLabel.Text = "Spend coins before the next wave. Purchases are permanent for this run."
	hintLabel.TextSize = 13
	hintLabel.TextColor3 = COL_DIM
	hintLabel.Parent = header

	local columns = newFrame("Columns")
	columns.Size = UDim2.new(1, -32, 1, -110)
	columns.Position = UDim2.new(0, 16, 0, 64)
	columns.BackgroundTransparency = 1
	columns.Parent = root

	local weaponsColumn = newFrame("WeaponsColumn")
	weaponsColumn.Size = UDim2.new(0.5, -8, 1, 0)
	weaponsColumn.Position = UDim2.new(0, 0, 0, 0)
	weaponsColumn.BackgroundColor3 = COL_BG
	weaponsColumn.BackgroundTransparency = 0.35
	weaponsColumn.Parent = columns
	addCorner(weaponsColumn, 8)

	local weaponsPad = Instance.new("UIPadding")
	weaponsPad.PaddingTop = UDim.new(0, 8)
	weaponsPad.PaddingLeft = UDim.new(0, 10)
	weaponsPad.PaddingRight = UDim.new(0, 8)
	weaponsPad.PaddingBottom = UDim.new(0, 8)
	weaponsPad.Parent = weaponsColumn

	local perksColumn = newFrame("PerksColumn")
	perksColumn.Size = UDim2.new(0.5, -8, 1, 0)
	perksColumn.Position = UDim2.new(0.5, 8, 0, 0)
	perksColumn.BackgroundColor3 = COL_BG
	perksColumn.BackgroundTransparency = 0.35
	perksColumn.Parent = columns
	addCorner(perksColumn, 8)

	local perksPad = Instance.new("UIPadding")
	perksPad.PaddingTop = UDim.new(0, 8)
	perksPad.PaddingLeft = UDim.new(0, 10)
	perksPad.PaddingRight = UDim.new(0, 8)
	perksPad.PaddingBottom = UDim.new(0, 8)
	perksPad.Parent = perksColumn

	-- Headings are children of the padded columns; the scrollers fill below.
	local wHeading = newTextLabel("WHeading")
	wHeading.Size = UDim2.new(1, 0, 0, 24)
	wHeading.Position = UDim2.new(0, 0, 0, 0)
	wHeading.Text = "WEAPONS"
	wHeading.TextSize = 17
	wHeading.TextColor3 = COL_ACCENT
	wHeading.Parent = weaponsColumn

	local pHeading = newTextLabel("PHeading")
	pHeading.Size = UDim2.new(1, 0, 0, 24)
	pHeading.Position = UDim2.new(0, 0, 0, 0)
	pHeading.Text = "PERKS"
	pHeading.TextSize = 17
	pHeading.TextColor3 = COL_ACCENT
	pHeading.Parent = perksColumn

	weaponsScroll = Instance.new("ScrollingFrame")
	weaponsScroll.Name = "WeaponsScroll"
	weaponsScroll.Size = UDim2.new(1, 0, 1, -32)
	weaponsScroll.Position = UDim2.new(0, 0, 0, 32)
	weaponsScroll.BackgroundTransparency = 1
	weaponsScroll.BorderSizePixel = 0
	weaponsScroll.ScrollBarThickness = 6
	weaponsScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	weaponsScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	weaponsScroll.Parent = weaponsColumn

	perksScroll = Instance.new("ScrollingFrame")
	perksScroll.Name = "PerksScroll"
	perksScroll.Size = UDim2.new(1, 0, 1, -32)
	perksScroll.Position = UDim2.new(0, 0, 0, 32)
	perksScroll.BackgroundTransparency = 1
	perksScroll.BorderSizePixel = 0
	perksScroll.ScrollBarThickness = 6
	perksScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	perksScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	perksScroll.Parent = perksColumn

	weaponsList = newFrame("WeaponsList")
	weaponsList.Size = UDim2.new(1, -8, 0, 0)
	weaponsList.Position = UDim2.new(0, 0, 0, 0)
	weaponsList.AutomaticSize = Enum.AutomaticSize.Y
	weaponsList.BackgroundTransparency = 1
	weaponsList.Parent = weaponsScroll
	addList(weaponsList, 6)

	perksList = newFrame("PerksList")
	perksList.Size = UDim2.new(1, -8, 0, 0)
	perksList.Position = UDim2.new(0, 0, 0, 0)
	perksList.AutomaticSize = Enum.AutomaticSize.Y
	perksList.BackgroundTransparency = 1
	perksList.Parent = perksScroll
	addList(perksList, 6)

	return gui
end

-- Item population -----------------------------------------------------------

local function weaponSubText(def: WeaponDef): string
	local fireType: string = if def.Auto then "Auto" else "Single"
	return string.format(
		"%d dmg  •  %s  •  mag %d  •  %s",
		def.Damage,
		string.format("%.1f/s", def.FireRate),
		def.MagazineSize,
		fireType
	)
end

local function perkSubText(def: PerkDef, stacks: number): string
	local base: string = string.format("%s (%d/%d)", def.Description, stacks, def.MaxStacks)
	return base
end

local function buildWeaponRows()
	local defs: any = Config.Weapons
	local order: { string } = { "Pistol", "SMG", "Shotgun", "Rifle" }
	local index: number = 0

	for _, id in ipairs(order) do
		local def: WeaponDef? = defs[id]
		if def then
			index += 1
			local d: WeaponDef = def
			local refs = buildRow(id, d.DisplayName, d.UnlockCost, weaponSubText(d), function()
				fireWeaponPurchase(id)
			end)
			refs.Root.LayoutOrder = index
			refs.Root.Parent = weaponsList
			weaponRows[id] = refs
		end
	end
end

local function buildPerkRows()
	local defs: any = Config.Perks
	local order: { string } = {
		"Damage",
		"FireRate",
		"Reload",
		"MoveSpeed",
		"MaxHealth",
		"Magazine",
		"Lifesteal",
		"ExtraLife",
		"Greed",
	}
	local index: number = 0

	for _, id in ipairs(order) do
		local def: PerkDef? = defs[id]
		if def then
			index += 1
			local d: PerkDef = def
			local refs = buildRow(id, d.DisplayName, d.Cost, perkSubText(d, 0), function()
				firePerkPurchase(id)
			end)
			refs.Root.LayoutOrder = index
			refs.Root.Parent = perksList
			perkRows[id] = refs
		end
	end
end

-- Affordability / state refresh ---------------------------------------------

local function refreshWeaponRow(id: string)
	local refs: RowRefs? = weaponRows[id]
	if not refs then return end
	local r: RowRefs = refs

	local defs: any = Config.Weapons
	local def: WeaponDef? = defs[id]
	local owned: boolean = ownedWeapons[id] == true
	local equipped: boolean = currentWeapon == id
	local coins: number = 0
	if currentStats then
		coins = safeNumber(currentStats.Coins, 0)
	end

	local affordable: boolean = true
	if def then
		local d: WeaponDef = def
		affordable = coins >= d.UnlockCost
	end

	if equipped then
		r.Root.BackgroundColor3 = Color3.fromRGB(40, 62, 44)
		r.NameLabel.TextColor3 = COL_GOOD
		r.CostLabel.Text = "EQUIPPED"
		r.CostLabel.TextColor3 = COL_GOOD
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.05
	elseif owned then
		r.Root.BackgroundColor3 = Color3.fromRGB(32, 44, 40)
		r.NameLabel.TextColor3 = COL_TEXT
		r.CostLabel.Text = "OWNED"
		r.CostLabel.TextColor3 = COL_GOOD
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.1
	elseif affordable then
		r.Root.BackgroundColor3 = COL_ROW
		r.NameLabel.TextColor3 = COL_TEXT
		r.CostLabel.TextColor3 = COL_ACCENT
		r.Button.Active = true
		r.Root.BackgroundTransparency = 0.1
	else
		-- Cannot afford: greyed out and non-interactive.
		r.Root.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		r.NameLabel.TextColor3 = COL_DIM
		r.CostLabel.TextColor3 = COL_BAD
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.45
	end

	if not equipped and not owned and def then
		local d2: WeaponDef = def
		r.CostLabel.Text = if d2.UnlockCost <= 0 then "FREE" else string.format("%d c", d2.UnlockCost)
	end

	r.Root.Visible = true
end

local function refreshPerkRow(id: string)
	local refs: RowRefs? = perkRows[id]
	if not refs then return end
	local r: RowRefs = refs

	local defs: any = Config.Perks
	local def: PerkDef? = defs[id]
	local stacks: number = safeNumber(perkStacks[id], 0)
	local coins: number = 0
	if currentStats then
		coins = safeNumber(currentStats.Coins, 0)
	end

	local maxed: boolean = false
	local affordable: boolean = false
	if def then
		local d: PerkDef = def
		maxed = stacks >= d.MaxStacks
		affordable = coins >= d.Cost
	end

	r.Root.BackgroundTransparency = 0.1
	r.NameLabel.TextColor3 = COL_TEXT
	r.Button.Active = true

	if maxed then
		r.Root.BackgroundColor3 = Color3.fromRGB(52, 44, 26)
		r.CostLabel.Text = "MAX"
		r.CostLabel.TextColor3 = COL_ACCENT
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.2
	elseif affordable then
		r.Root.BackgroundColor3 = COL_ROW
		r.CostLabel.TextColor3 = COL_ACCENT
	else
		r.Root.BackgroundColor3 = Color3.fromRGB(24, 26, 32)
		r.NameLabel.TextColor3 = COL_DIM
		r.CostLabel.TextColor3 = COL_BAD
		r.Button.Active = false
		r.Root.BackgroundTransparency = 0.45
	end

	if not maxed and def then
		local d2: PerkDef = def
		r.CostLabel.Text = string.format("%d c", d2.Cost)
	end

	if def then
		local d3: PerkDef = def
		r.StacksLabel.Text = string.format("%d / %d stacks", stacks, d3.MaxStacks)
	end

	r.Root.Visible = true
end

local function refreshAll()
	if coinsLabel then
		local coins: number = 0
		if currentStats then
			coins = safeNumber(currentStats.Coins, 0)
		end
		coinsLabel.Text = string.format("Coins %d", coins)
	end
	for id, _ in pairs(weaponRows) do
		refreshWeaponRow(id)
	end
	for id, _ in pairs(perkRows) do
		refreshPerkRow(id)
	end
end

-- Public API ----------------------------------------------------------------

function ShopUI.Start(plrGui: any)
	if started then return end
	playerGui = plrGui
	ensureGui()
	buildWeaponRows()
	buildPerkRows()
	started = true
	refreshAll()
end

function ShopUI.IsStarted(): boolean
	return started
end

function ShopUI.SetVisible(visible: boolean)
	visibleNow = visible
	if not started then return end
	if root then
		root.Visible = visible
	end
	if visible then
		refreshAll()
	end
end

function ShopUI.IsVisible(): boolean
	return visibleNow
end

-- Called by ClientController on ShopStateChanged with the server payload.
function ShopUI.SetShopState(state: any?)
	if not started then return end
	if not state then return end

	local s: ShopState = state

	if s.OwnedWeapons then
		ownedWeapons = s.OwnedWeapons
	end
	if s.CurrentWeapon then
		currentWeapon = s.CurrentWeapon
	end
	if s.Perks then
		perkStacks = s.Perks
	end
	if s.Coins then
		if not currentStats then
			currentStats = {
				Coins = safeNumber(s.Coins, 0),
				XP = 0,
				Level = 1,
				Kills = 0,
				Health = 100,
				MaxHealth = 100,
				Lives = 0,
				BestWave = 0,
			}
		else
			local coins: number = safeNumber(s.Coins, 0)
			local old: PlayerStats = currentStats
			currentStats = {
				Coins = coins,
				XP = old.XP,
				Level = old.Level,
				Kills = old.Kills,
				Health = old.Health,
				MaxHealth = old.MaxHealth,
				Lives = old.Lives,
				BestWave = old.BestWave,
			}
		end
	end

	-- Show only during Intermission; the phase -> Active transition hides it.
	if s.Phase == "Intermission" then
		ShopUI.SetVisible(true)
	else
		ShopUI.SetVisible(false)
	end

	refreshAll()
end

-- Called on every PlayerStatsChanged so affordability tracks the live wallet.
function ShopUI.SetStats(stats: any?)
	if not stats then return end
	currentStats = stats
	if visibleNow then
		refreshAll()
	end
end

-- Called on every PlayerStatsChanged-shaped run payload (perks/owned weapons).
function ShopUI.SetRunState(run: any?)
	if not run then return end
	_currentRun = run
	if run.OwnedWeapons then
		ownedWeapons = run.OwnedWeapons
	end
	if run.Perks then
		perkStacks = run.Perks
	end
	if run.CurrentWeapon then
		currentWeapon = run.CurrentWeapon
	end
	if visibleNow then
		refreshAll()
	end
end

function ShopUI.Refresh()
	if started then
		refreshAll()
	end
end

function ShopUI.GetWeaponRows(): { [string]: RowRefs }
	return weaponRows
end

function ShopUI.GetPerkRows(): { [string]: RowRefs }
	return perkRows
end

export type WeaponDefMirror = WeaponDef
export type PerkDefMirror = PerkDef
export type RowRefsMirror = RowRefs

return ShopUI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>