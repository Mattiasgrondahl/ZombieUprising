-- Signs and the flagpole
----------------------------------------------------------------------

local function buildSignage(root: Folder)
	-- School sign on the south wing's north face (aerial pin position).
	local post = newPart({
		Name = "SignPost",
		Size = Vector3.new(0.8, 7, 0.8),
		Position = Vector3.new(12, 3.5, -52),
		Material = Enum.Material.Metal,
		Color = COL_METAL_DARK,
	})
	post.Parent = root
	local panel = newPart({
		Name = "SignPanel",
		Size = Vector3.new(14, 4.5, 0.6),
		Position = Vector3.new(12, 8, -52),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(24, 60, 44),
	})
	panel.Parent = root

	local gui = Instance.new("BillboardGui")
	gui.Name = "SignText"
	gui.Size = UDim2.new(0, 340, 0, 110)
	gui.MaxDistance = 160
	gui.Adornee = panel
	gui.Parent = panel
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = COL_WHITE
	label.TextStrokeTransparency = 0.35
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	local schoolName = "Lovisedalsskolan"
	pcall(function()
		schoolName = tostring(Config.Map.SchoolName or "Lovisedalsskolan")
	end)
	label.Text = schoolName
	label.Parent = gui

	-- Swedish flag on a pole by the entrance road stub.
	local pole = newPart({
		Name = "Flagpole",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(18, 0.6, 0.6),
		CFrame = CFrame.new(-70, 9.2, 86) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Metal,
		Color = COL_METAL_DARK,
	})
	pole.Parent = root
	local flagY = 15.6
	local flag = newPart({
		Name = "FlagBlue",
		Size = Vector3.new(0.25, 2, 4),
		Position = Vector3.new(-70, flagY, 84),
		Material = Enum.Material.SmoothPlastic,
		Color = COL_FLAG_BLUE,
		CanCollide = false,
	})
	flag.Parent = root
	local stripeV = newPart({
		Name = "FlagCrossV",
		Size = Vector3.new(0.3, 2, 0.9),
		Position = Vector3.new(-70, flagY, 85),
		Material = Enum.Material.SmoothPlastic,
		Color = COL_FLAG_YELLOW,
		CanCollide = false,
	})
	stripeV.Parent = root
	local stripeH = newPart({
		Name = "FlagCrossH",
		Size = Vector3.new(0.3, 0.7, 4),
		Position = Vector3.new(-70, flagY + 0.55, 84),
		Material = Enum.Material.SmoothPlastic,
		Color = COL_FLAG_YELLOW,
		CanCollide = false,
	})
	stripeH.Parent = root
end

----------------------------------------------------------------------
-- Trees: pines for the forest ring, birches scattered on the grounds
----------------------------------------------------------------------

local function addPine(root: Folder, x: number, z: number, rand: Random)
	local height = rand:Range(9, 14)
	local trunk = newPart({
		Name = "PineTrunk",
		Size = Vector3.new(1.4, height, 1.4),
		Position = Vector3.new(x, height / 2, z),
		Material = Enum.Material.Wood,
		Color = COL_TRUNK,
	})
	trunk.Parent = root
	local tiers = {
		{ w = 7, h = 4, y = height + 1 },
		{ w = 5, h = 3.5, y = height + 3 },
		{ w = 3, h = 3, y = height + 5 },
	}
	for _, tier in ipairs(tiers) do
		local rot = CFrame.Angles(0, math.rad(45), 0)
		local foliage = newPart({
			Name = "PineCrow",
			Size = Vector3.new(tier.w, tier.h, tier.w),
			CFrame = CFrame.new(x, tier.y, z) * rot,
			Material = Enum.Material.Grass,
			Color = COL_PINE,
			CanCollide = false,
		})
		foliage.Parent = root
	end
end

-- Deciduous tree for the lawn edges (trunk + two foliage spheres).
local function addBirch(root: Folder, x: number, z: number, rand: Random)
	local height = rand:Range(11, 15)
	local trunk = newPart({
		Name = "Trunk",
		Size = Vector3.new(1.2, height, 1.2),
		Position = Vector3.new(x, height / 2, z),
		Material = Enum.Material.Wood,
		Color = Color3.fromRGB(196, 190, 172),
	})
	trunk.Parent = root
	local leafLow = newPart({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(8, 7, 8),
		Position = Vector3.new(x, height + 1.4, z),
		Material = Enum.Material.Grass,
		Color = COL_LEAF,
		CanCollide = false,
	})
	leafLow.Parent = root
	local leafHigh = newPart({
		Name = "Leaves",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(5.6, 5, 5.6),
		Position = Vector3.new(x + 1.2, height + 4.6, z - 1),
		Material = Enum.Material.Grass,
		Color = COL_LEAF,
		CanCollide = false,
	})
	leafHigh.Parent = root
end

local function buildForest(root: Folder, rand: Random)
	-- Pine ring OUTSIDE the fence.
	local step = 22
	for side = 1, 4 do
		for i = -6, 6 do
			local t: number = i * step
			local jit: number = rand:Range(-6, 6)
			local x: number, z: number
			if side == 1 then
				x, z = t + jit, 150
			elseif side == 2 then
				x, z = t + jit, -155
			elseif side == 3 then
				x, z = 150, t + jit
			else
				x, z = -155, t + jit
			end
			addPine(root, x, z, rand)
		end
	end
	for _, c in ipairs({ { 145, 145 }, { -150, 145 }, { 145, -150 }, { -150, -155 } }) do
		addPine(root, c[1], c[2], rand)
	end

	-- Pines inside the mapped forest patches (SW, NE, NW, SE).
	local patchPines = {
		{ -125, -90 }, { -110, -110 }, { -92, -85 }, { -80, -120 }, { -62, -140 },
		{ -42, -160 }, { -25, -170 }, { -8, -178 }, { -45, -95 }, { -70, -75 },
		{ 30, 12 }, { 52, 18 }, { 75, 22 }, { 100, 30 }, { 122, 48 },
		{ 110, 70 }, { 90, 68 }, { 70, 60 }, { 48, 52 }, { 36, 70 },
		{ 25, 92 }, { 45, 105 }, { 118, 95 }, { 128, 72 },
		{ -140, 40 }, { -140, 75 }, { -122, 25 }, { -145, 92 },
		{ 118, -120 }, { 128, -142 }, { 104, -140 }, { 140, -110 }, { 122, -95 },
	}
	for _, p in ipairs(patchPines) do
		addPine(root, p[1] + rand:Range(-2, 2), p[2] + rand:Range(-2, 2), rand)
	end

	-- Birches rooting the lawn edges: north-lawn cluster by the court, the
	-- yard shoulder east of the school road, and the west lawn edge.
	local birches = {
		{ -62, 44 }, { -58, 50 }, { -64, 54 }, { -70, 48 },
		{ 0, -60 }, { -4, -57 }, { 7, -64 }, { 11, -70 },
		{ -120, -40 }, { -122, -55 }, { 20, 42 }, { 26, 35 },
		{ -118, -150 }, { 40, -132 },
	}
	for _, p in ipairs(birches) do
		addBirch(root, p[1], p[2], rand)
	end
end

----------------------------------------------------------------------
-- Villa houses on the forest edges (backdrop scenery)
----------------------------------------------------------------------

local function addVilla(root: Folder, name: string, x: number, z: number, xSize: number, zSize: number, height: number, yawDeg: number, roofColor: Color3)
	local cf = CFrame.new(x, height / 2, z) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local body = newPart({
		Name = name,
		Size = Vector3.new(xSize, height, zSize),
		CFrame = cf,
		Material = Enum.Material.SmoothPlastic,
		Color = COL_WALL_WHITE,
	})
	body.Parent = root
	local roof = newPart({
		Name = name .. "_Roof",
		Size = Vector3.new(xSize + 1.6, 1.6, zSize + 1.6),
		CFrame = CFrame.new(x, height + 1, z) * CFrame.Angles(0, math.rad(yawDeg), 0),
		Material = Enum.Material.Slate,
		Color = roofColor,
	})
	roof.Parent = root
end

local function buildVillas(root: Folder)
	-- North-west villa inside the fence corner.
	addVilla(root, "Villa_NW", -114, 42, 26, 20, 11, 15, COL_ROOF)
	-- North-east houses along the top edge, mostly beyond the fence.
	addVilla(root, "Villa_NE_A", 36, 110, 18, 14, 10, 15, COL_ROOF)
	addVilla(root, "Villa_NE_B", 54, 112, 17, 15, 10, 15, COL_ROOF)
	addVilla(root, "Villa_NE_C", 71, 116, 13, 12, 9, 15, COL_ROOF)
	addVilla(root, "Villa_NE_D", 85, 121, 15, 12, 10, 15, COL_ROOF)
	-- Small utility sheds: one by the branch road, one north of the hall's
	-- west face (the pump-house clear of the road's south leg).
	addVilla(root, "Shed_South", 35.5, -92, 9, 8, 6, 15, COL_ROOF_WHITE)
	addVilla(root, "Shed_Hall", 58, -26, 10, 6, 6, 15, COL_ROOF_WHITE)
end

----------------------------------------------------------------------
-- Boundary: invisible walls, low black fence, stray-proofing
----------------------------------------------------------------------

local function buildBoundary(root: Folder, m: MapSettings)
	local size: number = m.ArenaSize
	local h: number = m.WallHeight
	local t: number = m.WallThickness
	local half: number = size / 2

	local specs = {
		{ "Boundary_North", Vector3.new(size, h, t), Vector3.new(0, h / 2, -half - t / 2) },
		{ "Boundary_South", Vector3.new(size, h, t), Vector3.new(0, h / 2, half + t / 2) },
		{ "Boundary_East", Vector3.new(t, h, size), Vector3.new(half + t / 2, h / 2, 0) },
		{ "Boundary_West", Vector3.new(t, h, size), Vector3.new(-half - t / 2, h / 2, 0) },
	}
	for _, s in ipairs(specs) do
		local w = newPart({
			Name = s[1],
			Size = s[2],
			Position = s[3],
			Transparency = 1,
			CanCollide = true,
		})
		w.Parent = root
	end

	-- Low black chain-link fence just inside the boundary.
	local fenceHalf = half - 1
	local fenceSpecs = {
		{ Vector3.new(size - 2, 4.2, 0.3), Vector3.new(0, 2.6, -fenceHalf) },
		{ Vector3.new(size - 2, 4.2, 0.3), Vector3.new(0, 2.6, fenceHalf) },
		{ Vector3.new(0.3, 4.2, size - 2), Vector3.new(fenceHalf, 2.6, 0) },
		{ Vector3.new(0.3, 4.2, size - 2), Vector3.new(-fenceHalf, 2.6, 0) },
	}
	for i, fs in ipairs(fenceSpecs) do
		local slat = newPart({
			Name = "FenceSlat_" .. tostring(i),
			Size = fs[1],
			Position = fs[2],
			Material = Enum.Material.DiamondPlate,
			Color = COL_FENCE,
			Transparency = 0.35,
			CanCollide = false,
		})
		slat.Parent = root
	end
	for i = 0, 10 do
		local along = -half + 2 + i * ((size - 4) / 10)
		for _, side in ipairs({ -1, 1 }) do
			local postA = newPart({
				Name = "FencePost",
				Size = Vector3.new(0.5, 4.6, 0.5),
				Position = Vector3.new(along, 2.3, side * fenceHalf),
				Material = Enum.Material.Metal,
				Color = COL_FENCE,
				CanCollide = false,
			})
			postA.Parent = root
			local postB = newPart({
				Name = "FencePost",
				Size = Vector3.new(0.5, 4.6, 0.5),
				Position = Vector3.new(side * fenceHalf, 2.3, along),
				Material = Enum.Material.Metal,
				Color = COL_FENCE,
				CanCollide = false,
			})
			postB.Parent = root
		end
	end

	local lid = newPart({
		Name = "KillBrick_Ceiling",
		Size = Vector3.new(size, 2, size),
		Position = Vector3.new(0, h + 40, 0),
		Transparency = 1,
		CanCollide = false,
	})
	lid.Parent = root
end

----------------------------------------------------------------------
-- Zone fences and buyable doors
--
-- Boundary lines run along the site's own fence lines, with each gap
-- placed at a genuine passage:
--   boundary 1 (z -65): gate between the south wing and the hall forecourt
--   boundary 2 (z 0):   gate across the school road east of the east bar
--   boundary 3 (z 65):  gate where the school road leaves the north park
-- Where the line crosses actual buildings (south wing, east bar,
-- cafeteria, sports hall) no wall is drawn: the buildings seal the line.
----------------------------------------------------------------------

type WallSeg = { x1: number, x2: number }
type DoorSpec = { index: number, z: number, xCenter: number, width: number, opensFree: boolean }

local function buildZoneFences(root: Folder, m: MapSettings)
	local count: number = m.ZoneCount
	if count < 2 then
		return
	end
	local half: number = m.ArenaSize / 2
	local width: number = m.ZoneWidth

	local zones = Instance.new("Folder")
	zones.Name = "Zones"
	zones.Parent = root
	for i = 1, count do
		local zCenter: number = -half + width * (i - 1) + width / 2
		local marker = newPart({
			Name = "Zone_" .. tostring(i),
			Size = Vector3.new(4, 2, 4),
			Position = Vector3.new(0, 1.5, zCenter),
			Transparency = 1,
			CanCollide = false,
		})
		marker:SetAttribute("ZoneIndex", i)
		marker.Parent = zones
	end

	local doorsFolder = Instance.new("Folder")
	doorsFolder.Name = "Doors"
	doorsFolder.Parent = root

	local doorSpecs: { DoorSpec } = {
		{ index = 1, z = -65, xCenter = 62, width = 22, opensFree = true },
		{ index = 2, z = 0, xCenter = 6, width = 24, opensFree = false },
		{ index = 3, z = 65, xCenter = 1, width = 24, opensFree = false },
	}
	-- Visual fence + invisible barrier runs per boundary, excluding both the
	-- door gap and building-crossing spans.
	local wallRuns: { { number } } = {
		{ -130, -37, -65 },
		{ 73.5, 74.5, -65 },
		{ 118, 130, -65 },
		{ -130, -118, 0 },
		{ -88, -37, 0 },
		{ 18, 74, 0 },
		{ 118, 130, 0 },
		{ -130, -11, 65 },
		{ 13, 130, 65 },
	}

	for _, run in ipairs(wallRuns) do
		local x1, x2, z = run[1], run[2], run[3]
		local length = x2 - x1
		local cx = (x1 + x2) / 2
		-- Invisible collider keeping zones sealed at full height.
		local barrier = newPart({
			Name = string.format("ZoneFence_%d_Barrier", z),
			Size = Vector3.new(length, m.WallHeight, m.DoorThickness),
			Position = Vector3.new(cx, m.WallHeight / 2, z),
			Transparency = 1,
			CanCollide = true,
		})
		barrier.Parent = root
		-- Visual black fence matching the site's yard fences.
		local slat = newPart({
			Name = string.format("ZoneFence_%d_Slat", z),
			Size = Vector3.new(length, 4.2, 0.35),
			Position = Vector3.new(cx, 2.6, z),
			Material = Enum.Material.DiamondPlate,
			Color = COL_FENCE,
			Transparency = 0.25,
			CanCollide = false,
		})
		slat.Parent = root
		local posts = math.max(2, math.floor(length / 11))
		for i = 0, posts do
			local px = x1 + (length / posts) * i
			local post = newPart({
				Name = "ZoneFencePost",
				Size = Vector3.new(0.5, 4.6, 0.5),
				Position = Vector3.new(px, 2.3, z),
				Material = Enum.Material.Metal,
				Color = COL_FENCE,
				CanCollide = false,
			})
			post.Parent = root
		end
	end

	for _, spec in ipairs(doorSpecs) do
		local isExit: boolean = spec.opensFree
		local cost: number = if isExit then 0 else math.floor(
			m.DoorCost * (m.DoorCostGrowth ^ (spec.index - 2)) + 0.5)
		local door = newPart({
			Name = string.format("Door_%d", spec.index),
			Size = Vector3.new(spec.width, DOOR_HEIGHT, m.DoorThickness),
			Position = Vector3.new(spec.xCenter, DOOR_HEIGHT / 2, spec.z),
			Material = Enum.Material.Metal,
			Color = Color3.fromRGB(120, 80, 50),
			Transparency = 0.15,
			CanCollide = not isExit,
		})
		door:SetAttribute("IsDoor", true)
		door:SetAttribute("DoorIndex", spec.index)
		door:SetAttribute("Cost", cost)
		door:SetAttribute("Open", isExit)
		door:SetAttribute("LeadsToZone", spec.index + 1)
		door.Parent = doorsFolder

		if isExit then
			-- Sink the open exit out of the way so it reads as a passage.
			local d: any = door
			d.Position = Vector3.new(spec.xCenter, -20, spec.z)
		else
			local gui = Instance.new("BillboardGui")
			gui.Name = "PriceLabel"
			gui.Size = UDim2.new(0, 160, 0, 44)
			gui.StudsOffset = Vector3.new(0, 4, 0)
			gui.AlwaysOnTop = false
			gui.MaxDistance = 60
			gui.Adornee = door
			gui.Parent = door

			local label = Instance.new("TextLabel")
			label.Name = "Text"
			label.Size = UDim2.new(1, 0, 1, 0)
			label.BackgroundTransparency = 1
			label.TextColor3 = Color3.fromRGB(255, 215, 120)
			label.TextStrokeTransparency = 0.4
			label.TextScaled = true
			label.Font = Enum.Font.GothamBold
			label.Text = string.format("Open — %d coins", cost)
			label.Parent = gui
		end
	end
end

----------------------------------------------------------------------
-- Zombie spawn points: hand-placed on open ground per zone
----------------------------------------------------------------------

local SPAWN_POINTS: { { number } } = {
	-- Zone 1: south lawn, forecourt and field south edge.
	{ -30, -88 }, { -8, -108 }, { 12, -114 }, { 32, -112 },
	{ 55, -108 }, { 78, -100 }, { 100, -92 }, { 116, -78 },
	-- Zone 2: quadrangle shoulders and the hall forecourt.
	{ -78, -40 }, { -58, -56 }, { -38, -44 }, { -16, -62 },
	{ 8, -52 }, { 28, -60 }, { 46, -64 }, { 62, -55 },
	-- Zone 3: north lawn west pockets and field's north shoulder.
	{ -110, 18 }, { -80, 52 }, { -58, 58 }, { -44, 36 },
	{ -14, 55 }, { 2, 42 }, { 20, 55 }, { 26, 30 },
	-- Zone 4: court lawn, north yard and park edge.
	{ -112, 80 }, { -90, 112 }, { -66, 92 }, { -45, 104 },
	{ -25, 120 }, { -7, 108 }, { 12, 75 }, { 30, 68 },
}

local function buildSpawnPoints(root: Folder)
	local f = Instance.new("Folder")
	f.Name = "ZombieSpawnPoints"
	f.Parent = root
	for i, p in ipairs(SPAWN_POINTS) do
		local zone = math.floor((p[2] + 130) / 65) + 1
		if zone < 1 then
			zone = 1
		end
		if zone > 4 then
			zone = 4
		end
		local pt = newPart({
			Name = string.format("Spawn_Z%d_%d", zone, i),
			Size = Vector3.new(2, 2, 2),
			Position = Vector3.new(p[1], 2, p[2]),
			Transparency = 1,
			CanCollide = false,
			Anchored = true,
		})
		pt:SetAttribute("Zone", zone)
		pt.Parent = f
	end
end

----------------------------------------------------------------------
-- Floodlights and mist
----------------------------------------------------------------------

local function buildLightFittings(root: Folder, rand: Random)
	local f = Instance.new("Folder")
	f.Name = "Ambience"
	f.Parent = root

	local poles: { { number } } = {
		{ 10, -40 }, { 76, -40 }, { 10, 2 }, { 76, 2 },
		{ -100, -50 }, { 55, -30 },
	}
	for i, pole in ipairs(poles) do
		local shaft = newPart({
			Name = "Floodlight_" .. tostring(i),
			Size = Vector3.new(0.8, 15, 0.8),
			Position = Vector3.new(pole[1], 7.5, pole[2]),
			Material = Enum.Material.Metal,
			Color = COL_METAL_DARK,
		})
		shaft.Parent = f
		local head = newPart({
			Name = "FloodlightHead_" .. tostring(i),
			Size = Vector3.new(3, 1.1, 1.4),
			Position = Vector3.new(pole[1], 15.4, pole[2]),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 244, 214),
			CanCollide = false,
		})
		head.Parent = f
		local light = Instance.new("PointLight")
		light.Name = "ZA_LampLight"
		light.Range = 70
		light.Brightness = 1.5
		light.Color = Color3.fromRGB(255, 190, 120)
		light.Shadows = true
		light.Parent = head
	end

	for i = 1, 10 do
		local px = rand:Range(-100, 100)
		local pz = rand:Range(-100, 100)
		local patch = newPart({
			Name = "Fog_" .. tostring(i),
			Size = Vector3.new(rand:Range(20, 45), 0.4, rand:Range(20, 45)),
			Position = Vector3.new(px, 0.6, pz),
			Material = Enum.Material.SmoothPlastic,
			Color = Color3.fromRGB(80, 86, 104),
			Transparency = 0.72,
			CanCollide = false,
		})
		patch.Parent = f
	end
end

local function buildLighting()
	local lighting: Lighting = game:GetService("Lighting")
	lighting.ClockTime = 22.5
	lighting.Brightness = 1.1
	lighting.Ambient = Color3.fromRGB(60, 62, 78)
	lighting.OutdoorAmbient = Color3.fromRGB(52, 54, 70)
	lighting.FogColor = Color3.fromRGB(38, 40, 52)
	lighting.FogStart = 40
	lighting.FogEnd = 260
	lighting.GlobalShadows = true
	lighting.ShadowSoftness = 0.35
	lighting.ExposureCompensation = -0.25

	local oldAtmo = lighting:FindFirstChild("ZA_Atmosphere")
	if oldAtmo then oldAtmo:Destroy() end
	local atmo = Instance.new("Atmosphere")
	atmo.Name = "ZA_Atmosphere"
	atmo.Density = 0.32
	atmo.Haze = 0.6
	atmo.Color = Color3.fromRGB(70, 74, 92)
	atmo.Decay = Color3.fromRGB(50, 54, 70)
	atmo.Glare = 0.15
	atmo.Parent = lighting

	local oldBloom = lighting:FindFirstChild("ZA_Bloom")
	if oldBloom then oldBloom:Destroy() end
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "ZA_Bloom"
	bloom.Intensity = 0.35
	bloom.Size = 18
	bloom.Threshold = 0.85
	bloom.Parent = lighting

	local oldCC = lighting:FindFirstChild("ZA_ColorCorrection")
	if oldCC then oldCC:Destroy() end
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "ZA_ColorCorrection"
	cc.Saturation = -0.22
	cc.Contrast = 0.12
	cc.TintColor = Color3.fromRGB(228, 232, 245)
	cc.Parent = lighting

	pcall(function()
		local ws: Workspace = game:GetService("Workspace")
		ws.Gravity = 196.2
	end)
end

----------------------------------------------------------------------
-- Player spawn
----------------------------------------------------------------------

local function buildPlayerSpawn()
	local ws: Workspace = game:GetService("Workspace")
	local old = ws:FindFirstChild("PlayerSpawnPad")
	if old then
		old:Destroy()
	end
	local pos: Vector3 = MapBuilder.GetPlayerSpawn()
	local pad = newPart({
		Name = "PlayerSpawnPad",
		Size = Vector3.new(24, 2, 24),
		Position = Vector3.new(pos.X, 1, pos.Z),
		Material = Enum.Material.Concrete,
		Color = Color3.fromRGB(96, 96, 102),
	})
	pad.Parent = ws
end

-- Where players appear: the south lawn's west corner, beside the parking
-- forecourt of the school (the Uthamra skolväg vista from Street View).
function MapBuilder.GetPlayerSpawn(): Vector3
	return Vector3.new(-44, 5, -92)
end

-- Kept for compatibility with existing call sites (ZombieAI's drift
-- fallback and the player respawn).
function MapBuilder.GetCenterSpawn(): Vector3
	return MapBuilder.GetPlayerSpawn()
end

----------------------------------------------------------------------
-- Build orchestration
----------------------------------------------------------------------

function MapBuilder.Build(): Folder
	local m = mapSettings()
	local rand = RNG.new(m.Seed)

	local root = ensureRoot()
	buildTerrain(root)
	buildSchool(root)
	buildHall(root)
	buildCafeteria(root)
	buildOctagon(root)
	buildRoads(root)
	buildPitch(root)
	buildCourt(root)
	buildParking(root, rand)
	buildYardProps(root)
	buildSignage(root)
	buildVillas(root)
	buildForest(root, rand)
	buildBoundary(root, m)
	buildZoneFences(root, m)
	buildSpawnPoints(root)
	buildPlayerSpawn()
	buildLightFittings(root, rand)
	buildLighting()

	return root
end

-- All valid zombie spawn positions, read by the wave director.
function MapBuilder.GetSpawnPoints(): { Part }
	local ws: Workspace = game:GetService("Workspace")
	local map = ws:FindFirstChild("Map")
	if not map then
		return {}
	end
	local folder = map:FindFirstChild("ZombieSpawnPoints")
	if not folder then
		return {}
	end
	local out: { Part } = {}
	for _, c in ipairs(folder:GetChildren()) do
		local part: any = c
		if part:IsA("Part") then
			table.insert(out, part :: Part)
		end
	end
	return out
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Music</string>
          <string name="Source"><![CDATA[--!strict
-- Music and layered audio for Zombie Uprising.
--
-- Roblox cannot synthesize PCM from Luau, so unlike the particle effects this
-- system necessarily uses catalogue asset ids (all Roblox-owned, long-lived).
-- Every call is pcall-guarded and every asset load is treated as fallible:
-- if audio is unavailable the game runs exactly as before, just silent.
--
-- Layering, in priority order:
--   1. Ambient drone  — always on once the server boots, quiet.
--   2. Wave music     — crossfades in when a wave goes active; playback speed
--                       rises with wave number so round 20 feels more frantic
--                       than round 2 (the escalating-intensity trick the genre
--                       uses instead of scoring more tracks).
--   3. Boss music     — replaces wave music on boss rounds, louder and slower.
--
-- The server owns the "what should be playing" decision and broadcasts it;
-- clients own actual playback, because only the local player hears their mix.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Music = {}

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))

local A: any = Config.Audio

local currentTrack: any = nil
local targetName: string = "None"
local started: boolean = false

local TRACKS: { [string]: { Id: string, Volume: number, Looped: boolean } } = {
	Ambient = {
		Id = A.AmbientMusicId,
		Volume = A.AmbientVolume,
		Looped = true,
	},
	Wave = {
		Id = A.WaveMusicId,
		Volume = A.WaveMusicVolume,
		Looped = true,
	},
	Boss = {
		Id = A.BossMusicId,
		Volume = A.BossMusicVolume,
		Looped = true,
	},
}

-- Tracks are crossfaded by ramping Volume in small steps (see crossfadeTo).
-- TweenService would be tidier but adds a service dependency that can fail;
-- this cannot.

local function ensureTrack(name: string): any
	local def = TRACKS[name]
	if not def then return nil end
	local ok, snd = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "ZA_Music_" .. name
		s.SoundId = def.Id
		s.Volume = 0
		s.Looped = true
		s.RollOffMaxDistance = 100000
		s.Parent = SoundService
		return s
	end)
	if not ok then return nil end
	return snd
end

-- Fades whatever is playing out and `name` in. Both tracks live in SoundService
-- so the crossfade is audible rather than a hard cut.
local function crossfadeTo(name: string, pitch: number)
	if not A.Enabled then return end
	if targetName == name then
		-- Already on the right bed; just retune pitch (wave escalation).
		pcall(function()
			if currentTrack then
				local t: any = currentTrack
				t.PlaybackSpeed = pitch
			end
		end)
		return
	end

	local incoming = ensureTrack(name)
	if not incoming then return end

	local outgoing = currentTrack
	currentTrack = incoming
	targetName = name

	pcall(function()
		local inc: any = incoming
		inc.PlaybackSpeed = pitch
		inc.Volume = 0
		inc:Play()
	end)

	local steps = math.max(1, math.floor((tonumber(A.MusicFadeTime) or 1.8) / 0.1))
	task.spawn(function()
		for i = 1, steps do
			task.wait(0.1)
			local t = i / steps
			pcall(function()
				local inc: any = incoming
				inc.Volume = (TRACKS[name].Volume) * t
			end)
			if outgoing then
				pcall(function()
					local out: any = outgoing
					out.Volume = (out.Volume) * (1 - t)
				end)
			end
		end
		if outgoing then
			pcall(function()
				local out: any = outgoing
				out:Stop()
				out:Destroy()
			end)
		end
	end)
end

-- Public: decide what should be playing from the authoritative wave state.
function Music.SetWavePhase(phase: string, waveNumber: number, isBoss: boolean)
	if not A.Enabled then return end
	if phase == "Active" then
		if isBoss then
			crossfadeTo("Boss", 1.0)
		else
			local base = tonumber(A.WavePitchBase) or 1.0
			local per = tonumber(A.WavePitchPerWave) or 0.01
			local max = tonumber(A.WavePitchMax) or 1.35
			local n = math.max(1, tonumber(waveNumber) or 1)
			local pitch = math.min(max, base + per * (n - 1))
			crossfadeTo("Wave", pitch)
		end
	elseif phase == "Intermission" or phase == "Ended" then
		crossfadeTo("Ambient", 1.0)
	end
end

function Music.Start()
	if started then return end
	started = true
	crossfadeTo("Ambient", 1.0)
end

function Music.Init()
	Music.Start()
end

----------------------------------------------------------------------
-- Client-side playback
--
-- The server decides *what* should be playing (see SetWavePhase) but only a
-- client can actually produce audio for its own player. Start local playback
-- and follow the server's phase broadcasts.
----------------------------------------------------------------------

local RunService = game:GetService("RunService")
local clientStarted: boolean = false

local function clientBoot()
	if clientStarted then
		return
	end
	clientStarted = true

	Music.Start()

	pcall(function()
		local waveRemote = Remotes.WaveStateChanged()
		waveRemote.OnClientEvent:Connect(function(payload: any)
			local p: any = payload
			local phase: string = tostring(p.Phase or "")
			if phase == "" then
				return
			end
			-- The WaveState payload carries no boss flag, so derive it from the
			-- same parity rule the WaveDirector uses for scheduling bosses.
			local every: number = 0
			pcall(function()
				every = Config.Wave.BossEveryNWaves
			end)
			local wave: number = tonumber(p.Wave) or 1
			local isBoss: boolean = every > 0 and wave % every == 0
			Music.SetWavePhase(phase, wave, isBoss)
		end)
	end)
end

-- Called by ClientController on the client; a no-op everywhere else.
function Music.StartClient()
	pcall(function()
		if RunService:IsClient() then
			clientBoot()
		end
	end)
end

return Music
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Progression
--
-- Owns everything that lives and dies with a single *run*:
--   * per-run perk stacks (Config.Perks, capped by MaxStacks)
--   * owned weapons and the currently equipped weapon
--   * lives (Config.Perks.ExtraLife grants revives)
--   * deriving Types.StatModifiers from perk stacks
--   * handling RequestPurchaseWeapon / RequestPurchasePerk / RequestRespawn
--
-- Persistent coins/XP/level are owned by Economy; Progression only asks it to
-- spend. Both live in ReplicatedStorage.Systems so either may be required by
-- server or client code.
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local Types = require(script.Parent.Shared.Types)

-- Structural mirrors of cross-module exports. luau-analyze cannot resolve
-- exported types through `require`, so we redeclare the shapes locally.
-- These are lint-time aliases only; the runtime values are real.
type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type PerkDef = {
	Id: string,
	DisplayName: string,
	Description: string,
	Cost: number,
	MaxStacks: number,
	DamageMult: number?,
	FireRateMult: number?,
	ReloadMult: number?,
	MoveSpeedFlat: number?,
	MaxHealthFlat: number?,
	MagazineMult: number?,
	LifestealPct: number?,
	ExtraLives: number?,
	CoinMult: number?,
}

type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type PurchaseResult = { Ok: boolean, Reason: string? }

type PerkStacks = { [string]: number }

-- Economy is written alongside this module. Resolved lazily so a load-order
-- difference or a missing file degrades to "cannot afford" instead of erroring.
type EconomyApi = {
	GetStats: (Player) -> any,
	CanAfford: (Player, number) -> boolean,
	Spend: (Player, number, string?) -> boolean,
	PlayerRemoving: (Player) -> (),
}

local Progression = {}

local _Players = game:GetService("Players")

type PerkTable = { [string]: PerkDef }
type WeaponTable = { [string]: WeaponDef }

local PerkConfig: PerkTable = Config.Perks :: PerkTable
local WeaponConfig: WeaponTable = Config.Weapons :: WeaponTable

local DEFAULT_WEAPON = "Pistol"

------------------------------------------------------------------------------
-- Per-run player state
------------------------------------------------------------------------------

export type RunEntry = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: PerkStacks,
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
	SpentThisRun: number,
	PackAPunched: boolean,
	PackAPunchMult: number,
}

local runs: { [Player]: RunEntry } = {}

local function nowTime(): number
	return os.clock()
end

local function playerKey(player: Player): string
	return "P_" .. tostring(player.UserId)
end

local function newRun(): RunEntry
	return {
		Active = true,
		StartedAt = nowTime(),
		Wave = 0,
		Kills = 0,
		Perks = {},
		OwnedWeapons = { [DEFAULT_WEAPON] = true },
		CurrentWeapon = DEFAULT_WEAPON,
		Lives = 0,
		SpentThisRun = 0,
		PackAPunched = false,
		PackAPunchMult = 1,
	}
end

function Progression.GetRun(player: Player): RunEntry
	local r = runs[player]
	if not r then
		r = newRun()
		runs[player] = r
	end
	return r
end

-- (Re)starts a fresh run: perks reset, only the starter weapon is owned.
function Progression.StartRun(player: Player): RunEntry
	runs[player] = newRun()
	return runs[player]
end

function Progression.GetPerkStacks(player: Player): PerkStacks
	return Progression.GetRun(player).Perks
end

function Progression.GetLives(player: Player): number
	return Progression.GetRun(player).Lives
end

function Progression.GetCurrentWeapon(player: Player): string
	return Progression.GetRun(player).CurrentWeapon
end

function Progression.OwnsWeapon(player: Player, weaponId: string): boolean
	return Progression.GetRun(player).OwnedWeapons[weaponId] == true
end

------------------------------------------------------------------------------
-- Stat modifiers derived from perk stacks
------------------------------------------------------------------------------

function Progression.GetStatModifiers(player: Player): StatModifiers
	local m = Types.NewStatModifiers()
	local run = Progression.GetRun(player)

	-- Pack-a-Punch multiplies damage on top of every perk bonus.
	if run.PackAPunched then
		local mult: number = run.PackAPunchMult
		if mult <= 0 then
			mult = 1
		end
		m.DamageMult = m.DamageMult * mult
	end

	for perkId, stacks in pairs(run.Perks) do
		local def = PerkConfig[perkId]
		if def then
			local n: number = stacks
			if n > 0 then
				-- Multiplicative stats layer as (1 + delta)^stacks.
				if def.DamageMult ~= nil then
					local d: number = def.DamageMult
					m.DamageMult *= math.pow(1 + d, n)
				end
				if def.FireRateMult ~= nil then
					local d: number = def.FireRateMult
					m.FireRateMult *= math.pow(1 + d, n)
				end
				if def.ReloadMult ~= nil then
					-- Reload deltas are negative (faster), so 1+(-0.15)=0.85 per stack.
					local d: number = def.ReloadMult
					m.ReloadMult *= math.pow(1 + d, n)
				end
				if def.MagazineMult ~= nil then
					local d: number = def.MagazineMult
					m.MagazineMult *= math.pow(1 + d, n)
				end
				if def.CoinMult ~= nil then
					local d: number = def.CoinMult
					m.CoinMult *= math.pow(1 + d, n)
				end
				-- Flat stats accumulate additively.
				if def.MoveSpeedFlat ~= nil then
					local d: number = def.MoveSpeedFlat
					m.MoveSpeedFlat += d * n
				end
				if def.MaxHealthFlat ~= nil then
					local d: number = def.MaxHealthFlat
					m.MaxHealthFlat += d * n
				end
				if def.LifestealPct ~= nil then
					local d: number = def.LifestealPct
					m.LifestealPct += d * n
				end
			end
		end
	end

	-- Guard against absurd values from any future config edit.
	m.ReloadMult = math.max(m.ReloadMult, 0.1)
	m.CoinMult = math.max(m.CoinMult, 0)
	m.DamageMult = math.max(m.DamageMult, 0)

	return m
end

------------------------------------------------------------------------------
-- Economy bridge (resolved lazily, never fatal)
------------------------------------------------------------------------------

local economyCache: any = nil
local economyTried = false

local function getEconomy(): EconomyApi?
	if economyCache ~= nil then
		return economyCache :: EconomyApi
	end
	if economyTried then
		return nil
	end
	economyTried = true

	local ok, mod = pcall(function()
		return require(script.Parent:FindFirstChild("Economy"))
	end)
	if ok and typeof(mod) == "table" then
		economyCache = mod
		return mod :: EconomyApi
	end
	warn("[Progression] Economy module unavailable; purchases will be denied")
	return nil
end

local function coinsOf(player: Player): number
	local econ = getEconomy()
	if not econ then
		return 0
	end
	local ok, stats = pcall(function()
		return econ.GetStats(player)
	end)
	if not ok or typeof(stats) ~= "table" then
		return 0
	end
	local view: any = stats
	local coins = tonumber(view.Coins)
	if coins == nil then
		return 0
	end
	return coins
end

local function spendCoins(player: Player, amount: number, reason: string?): boolean
	local econ = getEconomy()
	if not econ then
		return false
	end
	local ok, res = pcall(function()
		return econ.Spend(player, amount, reason)
	end)
	if not ok then
		return false
	end
	return res == true
end

-- Weapons is required lazily: it resolves Progression too, so a top-level
-- require here would be circular.
local weaponsCache: any = nil
local weaponsTried = false

local function resolveWeapons(): any?
	if weaponsCache ~= nil then
		return weaponsCache
	end
	if weaponsTried then
		return nil
	end
	weaponsTried = true
	local ok, mod = pcall(function()
		return require(script.Parent:FindFirstChild("Weapons"))
	end)
	if ok and typeof(mod) == "table" then
		weaponsCache = mod
		return mod
	end
	return nil
end

local function notify(player: Player, message: string)
	pcall(function()
		Remotes.Notify():FireClient(player, message)
	end)
end

------------------------------------------------------------------------------
-- Purchases
------------------------------------------------------------------------------

function Progression.PurchaseWeapon(player: Player, weaponId: string): PurchaseResult
	if typeof(weaponId) ~= "string" then
		return { Ok = false, Reason = "InvalidWeapon" }
	end
	local def = WeaponConfig[weaponId]
	if not def then
		return { Ok = false, Reason = "UnknownWeapon" }
	end

	local run = Progression.GetRun(player)
	if run.OwnedWeapons[weaponId] == true then
		return { Ok = false, Reason = "AlreadyOwned" }
	end

	local cost: number = def.UnlockCost
	if cost > 0 and coinsOf(player) < cost then
		notify(player, "Not enough coins for " .. def.DisplayName)
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	if cost > 0 and not spendCoins(player, cost, "weapon:" .. weaponId) then
		notify(player, "Purchase failed")
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	run.OwnedWeapons[weaponId] = true
	run.SpentThisRun += cost
	Progression.EquipWeapon(player, weaponId)

	-- Refresh (not Equip): a NEW weapon arrives with a full loadout, and the
	-- fire path reads entry.WeaponId which only Weapons.Refresh updates. Without
	-- this call the just-bought gun shows on the HUD yet still fires nothing.
	local wsys = resolveWeapons()
	if wsys and type((wsys :: any).Refresh) == "function" then
		pcall(function()
			local fn: any = (wsys :: any).Refresh
			fn(wsys, player)
		end)
	end

	notify(player, "Purchased " .. def.DisplayName)
	return { Ok = true }
end

function Progression.PurchasePerk(player: Player, perkId: string): PurchaseResult
	if typeof(perkId) ~= "string" then
		return { Ok = false, Reason = "InvalidPerk" }
	end
	local def = PerkConfig[perkId]
	if not def then
		return { Ok = false, Reason = "UnknownPerk" }
	end

	local run = Progression.GetRun(player)
	local current: number = run.Perks[perkId] or 0
	local maxStacks: number = def.MaxStacks
	if current >= maxStacks then
		notify(player, def.DisplayName .. " is fully stacked")
		return { Ok = false, Reason = "MaxStacks" }
	end

	-- Cost grows per stack already owned so players must commit to a build
	-- instead of trivially maxing every perk once the economy ramps up.
	local owned: number = run.Perks[perkId] or 0
	local cost: number = math.floor(def.Cost * (Config.Economy.PerkCostGrowth ^ owned) + 0.5)
	if coinsOf(player) < cost then
		notify(player, "Not enough coins for " .. def.DisplayName)
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	if not spendCoins(player, cost, "perk:" .. perkId) then
		notify(player, "Purchase failed")
		return { Ok = false, Reason = "InsufficientFunds" }
	end

	run.Perks[perkId] = current + 1
	run.SpentThisRun += cost

	-- ExtraLife grants an immediate revive rather than a combat stat.
	if def.ExtraLives ~= nil then
		local extra: number = def.ExtraLives
		run.Lives += extra
	end

	notify(player, def.DisplayName .. " x" .. tostring(current + 1))
	return { Ok = true }
end

function Progression.EquipWeapon(player: Player, weaponId: string): boolean
	local def = WeaponConfig[weaponId]
	if not def then
		return false
	end
	local run = Progression.GetRun(player)
	if run.OwnedWeapons[weaponId] ~= true then
		return false
	end
	run.CurrentWeapon = weaponId
	return true
end

-- Grants a weapon directly without payment (used by the mystery box).
function Progression.GrantWeapon(player: Player, weaponId: string): boolean
	local def = WeaponConfig[weaponId]
	if not def then
		return false
	end
	local run = Progression.GetRun(player)
	run.OwnedWeapons[weaponId] = true
	run.CurrentWeapon = weaponId

	-- Full loadout for a fresh prize, and the fire path must actually switch
	-- to it — entry.WeaponId only changes through Weapons.Refresh.
	local wsys = resolveWeapons()
	if wsys and type((wsys :: any).Refresh) == "function" then
		pcall(function()
			local fn: any = (wsys :: any).Refresh
			fn(wsys, player)
		end)
	end
	return true
end

local function packAPunchMult(): number
	local p: any = Config.Progression2
	local v = tonumber(p and p.PackAPunchDamageMult) or 2.0
	return v
end

-- Pack-a-Punch: permanently boosts this run's damage for all owned weapons.
function Progression.PackAPunch(player: Player): boolean
	local run = Progression.GetRun(player)
	run.PackAPunched = true
	run.PackAPunchMult = packAPunchMult()
	return true
end

-- True once the player has used Pack-a-Punch this run.
function Progression.HasPackAPunch(player: Player): boolean
	local run = Progression.GetRun(player)
	return run.PackAPunched == true
end

------------------------------------------------------------------------------
-- Lives / respawn / run end
------------------------------------------------------------------------------

local respawnLocks: { [string]: boolean } = {}
local recentlyResolved: { [string]: boolean } = {}

-- Applies perk-derived health to a freshly spawned character. Safe to call even
-- when the character does not exist yet.
function Progression.ApplyStatsToCharacter(player: Player)
	pcall(function()
		local mods = Progression.GetStatModifiers(player)
		local character = player.Character
		if not character then
			return
		end
		local humanoid: any = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end
		local base: number = Config.Player.BaseMaxHealth
		humanoid.MaxHealth = base + mods.MaxHealthFlat
		humanoid.Health = humanoid.MaxHealth

		local speed: number = Config.Player.BaseWalkSpeed
		humanoid.WalkSpeed = speed + mods.MoveSpeedFlat
	end)
end

-- Attempts to consume a life and revive `player`. Returns true when revived.
function Progression.TryConsumeLife(player: Player): boolean
	local run = Progression.GetRun(player)
	if run.Lives <= 0 then
		return false
	end
	run.Lives -= 1

	pcall(function()
		player:LoadCharacter()
	end)
	task.delay(0.25, function()
		Progression.ApplyStatsToCharacter(player)
	end)
	notify(player, "Revived! Lives left: " .. tostring(run.Lives))
	return true
end

local function endRun(player: Player, wave: number)
	local run = Progression.GetRun(player)
	run.Active = false
	pcall(function()
		Remotes.RunEnded():FireClient(player, {
			Wave = wave,
			Kills = run.Kills,
			Reason = "OutOfLives",
		})
	end)
end

-- Marks a death as already handled so a duplicate revive cannot eat two lives.
function Progression.MarkDeathResolved(player: Player)
	local key = playerKey(player)
	recentlyResolved[key] = true
	task.delay(3.0, function()
		recentlyResolved[key] = nil
	end)
end

function Progression.SetWave(player: Player, wave: number)
	Progression.GetRun(player).Wave = wave
end

function Progression.AddKill(player: Player)
	local run = Progression.GetRun(player)
	run.Kills += 1
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

-- Aliases used by GameServer's defensive lifecycle wiring.
function Progression.PlayerJoined(player: Player)
	Progression.StartRun(player)
	task.delay(0.25, function()
		Progression.ApplyStatsToCharacter(player)
	end)
end

function Progression.PlayerLeft(player: Player)
	runs[player] = nil
	respawnLocks[playerKey(player)] = nil
	local econ = getEconomy()
	if econ then
		pcall(function()
			econ.PlayerRemoving(player)
		end)
	end
end

function Progression.Init()
	if booted then
		return
	end
	booted = true

	-- Player lifecycle is owned by GameServer, which calls PlayerJoined /
	-- PlayerLeft. Registering PlayerAdded here as well would duplicate run
	-- setup and leak CharacterAdded connections (see AUDIT P1-1/P1-2).

	-- Shop + respawn entry points. All arguments are treated as untrusted.
	Remotes.RequestPurchaseWeapon().OnServerEvent:Connect(function(player: Player, weaponId: any)
		local res = Progression.PurchaseWeapon(player, weaponId)
		if not res.Ok then
			notify(player, "Purchase failed: " .. tostring(res.Reason))
		end
	end)

	Remotes.RequestPurchasePerk().OnServerEvent:Connect(function(player: Player, perkId: any)
		local res = Progression.PurchasePerk(player, perkId)
		if not res.Ok then
			notify(player, "Purchase failed: " .. tostring(res.Reason))
		end
	end)

	-- Hotkey weapon swap (1-4). Equipping is validated server-side: the player
	-- must actually own the weapon, so the client cannot equip a locked gun.
	Remotes.RequestSwitchWeapon().OnServerEvent:Connect(function(player: Player, weaponId: any)
		local id: string = tostring(weaponId or "")
		if id == "" then
			return
		end
		if not Progression.OwnsWeapon(player, id) then
			notify(player, "You do not own that weapon")
			return
		end
		if Progression.EquipWeapon(player, id) then
			-- Equip, not Refresh: a swap must not restock the reserve, or the
			-- 1-4 hotkeys become an infinite-ammo exploit around the economy.
			local wsys = resolveWeapons()
			if wsys and type((wsys :: any).Equip) == "function" then
				pcall(function()
					local fn: any = (wsys :: any).Equip
					fn(wsys, player, id)
				end)
			end
			notify(player, "Equipped " .. tostring(id))
		end
	end)

	Remotes.RequestRespawn().OnServerEvent:Connect(function(player: Player)
		local key = playerKey(player)
		if respawnLocks[key] then
			return
		end
		-- Guard: a bleed-out already resolved this death via the Downed system.
		-- Without this, a late client request would consume a second life.
		if recentlyResolved[key] then
			return
		end
		respawnLocks[key] = true

		local revived = Progression.TryConsumeLife(player)
		if not revived then
			local run = Progression.GetRun(player)
			endRun(player, run.Wave)
		end

		task.delay(1.0, function()
			respawnLocks[key] = nil
		end)
	end)
end

return Progression
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">WaveDirector</string>
          <string name="Source"><![CDATA[--!strict
-- Wave pacing and match flow. Owns the Intermission -> Active -> Intermission
-- cycle, decides how many zombies each wave contains, which archetypes appear,
-- and broadcasts Types.WaveState to every client on each change.
--
-- No Economy/Progression hard dependency: WaveDirector receives them through
-- SetEconomy / SetProgression (wired by GameServer). If they are absent the
-- waves still run, only the payouts are skipped. Likewise it spawns through a
-- ZombieAI instance injected with SetZombieAI, falling back to a lazily
-- required ZombieAI so the director also works standalone.

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local RNG = require(script.Parent.Shared.RNG)
-- MapBuilder is intentionally not required here: WaveDirector drives only wave
-- timing and archetype choice, and ZombieAI owns spawn placement. The map's
-- spawn ring is consumed by ZombieAI via MapBuilder.GetSpawnPoints(), keeping a
-- single owner for positional decisions.

-- Structural mirror of RNG.Random (kept in sync with Shared/RNG.luau). The
-- offline analyzer cannot resolve exported types across `require`.
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

-- Structural mirror of Config.Wave (see Shared/Config.luau).
type WaveSettings = {
	IntermissionTime: number,
	FirstWaveDelay: number,
	MaxConcurrentZombies: number,
	MultiplayerCountScale: number,
	SpecialWaveEvery: number,
	ExtractionWave: number,
	ExtractionBonus: number,
	RunnerSpeedMult: number,
	SwarmCountMult: number,
	SwarmHealthMult: number,
	BruteCountMult: number,
	BruteHealthMult: number,
	SpawnBatchInterval: number,
	BossEveryNWaves: number,
	BaseZombieCount: number,
	CountGrowthPerWave: number,
	HPScalePerWave: number,
	SpeedScalePerWave: number,
	MaxSpeedScale: number,
	DamageScalePerWave: number,
}

-- Structural mirror of Config.ZombieArchetype (see Shared/Config.luau).
type Archetype = {
	Id: string,
	DisplayName: string,
	Health: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CoinReward: number,
	XPReward: number,
	Scale: number,
	BodyColor: any,
	UnlockWave: number,
	Weight: number,
	IsBoss: boolean?,
}

-- Structural mirror of Types.WaveState (see Shared/Types.luau). Kept as the
-- single source for what we put on the wire.
export type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

local WaveDirector = {}

local Badges = require(script.Parent.Badges)

local Chat = require(script.Parent.Chat)

local Effects = require(script.Parent.Effects)

local PHASE_INTERMISSION = "Intermission"
local PHASE_ACTIVE = "Active"
local PHASE_ENDED = "Ended"

local RunService: any = nil
local Players: any = nil
local servicesReady = false

local function ensureServices()
	if servicesReady then
		return true
	end
	local ok = pcall(function()
		RunService = game:GetService("RunService")
		Players = game:GetService("Players")
	end)
	servicesReady = ok
	return ok
end

-- Injected collaborators (see GameServer wiring). All optional.
local zombieAI: any = nil
local economy: any = nil
local progression: any = nil

local rand: Random? = nil
local running = false
local mainThread: thread? = nil

local state: WaveState = {
	Wave = 0,
	Phase = PHASE_INTERMISSION,
	ZombiesRemaining = 0,
	ZombiesTotal = 0,
	TimeRemaining = 0,
}

-- Zombies spawned this wave that have not yet been killed.
local aliveModels: { any } = {}

local function waveSettings(): WaveSettings
	return Config.Wave :: WaveSettings
end

local function getRandom(): Random
	local r = rand
	if r then
		return r
	end
	local fresh: Random = RNG.new(0x5EED + os.time()) :: Random
	rand = fresh
	return fresh
end

local function toNumber(v: any, fallback: number): number
	if typeof(v) == "number" then
		return v :: number
	end
	local n = tonumber(v)
	if n then
		return n
	end
	return fallback
end

----------------------------------------------------------------------
-- ZombieAI resolution
----------------------------------------------------------------------

local function getZombieAI(): any
	if zombieAI then
		return zombieAI
	end
	local got: any = nil
	pcall(function()
		local self: any = script
		local parent: any = self.Parent
		local inst = parent:FindFirstChild("ZombieAI")
		if inst then
			got = require(inst)
		end
	end)
	if got then
		zombieAI = got
	end
	return zombieAI
end

----------------------------------------------------------------------
-- Broadcasting
----------------------------------------------------------------------

-- Pushes the current state to every client. Wrapped so a networking failure
-- can never take the wave loop down.
local function broadcast()
	pcall(function()
		Remotes.WaveStateChanged():FireAllClients({
			Wave = state.Wave,
			Phase = state.Phase,
			ZombiesRemaining = state.ZombiesRemaining,
			ZombiesTotal = state.ZombiesTotal,
			TimeRemaining = state.TimeRemaining,
		})
	end)
end

local function setPhase(phase: string)
	if state.Phase ~= phase then
		state.Phase = phase
	end
	broadcast()

	-- Music beds follow the phase: ambient while shopping, combat when a wave
	-- is live, and a heavier cue on boss rounds. Driven from setPhase so every
	-- transition is covered in exactly one place.
	pcall(function()
		local musicInst = script.Parent:FindFirstChild("Music")
		if not musicInst then
			return
		end
		local okM, mod = pcall(function()
			return require(musicInst)
		end)
		if not okM or not mod or type((mod :: any).SetWavePhase) ~= "function" then
			return
		end
		local mset: any = (mod :: any).SetWavePhase
		local wave: number = state.Wave
		local isBoss: boolean = phase == PHASE_ACTIVE and WaveDirector.IsBossWave(wave)
		-- Spawn: a slow asset load must never stall the wave loop.
		task.spawn(function()
			pcall(function()
				mset(mod, phase, wave, isBoss)
			end)
		end)
	end)
end

----------------------------------------------------------------------
-- Wave maths
----------------------------------------------------------------------

-- Wave N size = BaseZombieCount + floor((N-1) * CountGrowthPerWave), capped.
function WaveDirector.ZombieCountForWave(waveNumber: number): number
	local w = waveSettings()
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	local base: number = w.BaseZombieCount
	local growth: number = w.CountGrowthPerWave
	local raw = base + math.floor((n - 1) * growth)

	-- Multiplayer scaling: more players means more zombies so co-op stays
	-- challenging. Sub-linear so four players is not four times the chaos.
	pcall(function()
		local count = #Players:GetPlayers()
		if count > 1 then
			local scale: number = 1 + (w.MultiplayerCountScale * (count - 1))
			raw = math.floor(raw * scale + 0.5)
		end
	end)

	-- Special waves reshape the wave's shape.
	local special = WaveDirector.SpecialWaveType(n)
	if special == "SwarmWave" then
		raw = math.floor(raw * w.SwarmCountMult + 0.5)
	elseif special == "BruteWave" then
		raw = math.floor(raw * w.BruteCountMult + 0.5)
	end

	local cap: number = w.MaxConcurrentZombies
	if raw > cap then
		raw = cap
	end
	if raw < 1 then
		raw = 1
	end
	if raw < 1 then
		raw = 1
	end
	return raw
end

function WaveDirector.IsBossWave(waveNumber: number): boolean
	local every = math.floor(waveSettings().BossEveryNWaves)
	if every <= 0 then
		return false
	end
	return waveNumber % every == 0
end

-- Special waves break monotony: every Nth non-boss wave has a theme.
function WaveDirector.SpecialWaveType(waveNumber: number): string?
	if WaveDirector.IsBossWave(waveNumber) then
		return nil
	end
	local every = 0
	pcall(function()
		every = waveSettings().SpecialWaveEvery
	end)
	if every <= 0 then
		return nil
	end
	if waveNumber % every ~= 0 then
		return nil
	end
	-- Deterministic so ZombieAI can derive the same theme without extra state.
	local kinds: { string } = { "RunnerWave", "SwarmWave", "BruteWave" }
	local slot: number = math.floor(waveNumber / every) % 3
	local kind: string = kinds[slot + 1]
	if kind ~= nil and kind ~= "" then
		return kind
	end
	return nil
end

function WaveDirector.HealthScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	return math.pow(waveSettings().HPScalePerWave, n - 1)
end

function WaveDirector.SpeedScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	local raw = math.pow(waveSettings().SpeedScalePerWave, n - 1)
	local cap: number = waveSettings().MaxSpeedScale
	if raw > cap then
		raw = cap
	end
	return raw
end

function WaveDirector.DamageScaleForWave(waveNumber: number): number
	local n: number = waveNumber
	if n < 1 then
		n = 1
	end
	return math.pow(waveSettings().DamageScalePerWave, n - 1)
end

----------------------------------------------------------------------
-- Archetype selection
----------------------------------------------------------------------

local ARCHETYPE_ORDER = { "Walker", "Runner", "Brute", "Spitter", "Boss" }

local function archetypeTable(): { [string]: Archetype }
	return Config.Zombies :: { [string]: Archetype }
end

-- Weighted roll honouring UnlockWave; Weight <= 0 entries are skipped, which is
-- how Boss (Weight = 0) stays out of normal waves and only appears explicitly.
function WaveDirector.RollArchetype(waveNumber: number): string
	-- Special waves force a themed archetype.
	local special = WaveDirector.SpecialWaveType(waveNumber)
	if special == "RunnerWave" then
		return "Runner"
	elseif special == "BruteWave" then
		return "Brute"
	end

	local r = getRandom()
	local entries: { { weight: number, value: any } } = {}
	local tbl = archetypeTable()

	for _, id in ipairs(ARCHETYPE_ORDER) do
		local key: any = id
		local arch: Archetype? = tbl[key]
		if arch then
			local weight: number = arch.Weight
			local unlock: number = arch.UnlockWave
			if weight > 0 and unlock <= waveNumber then
				entries[#entries + 1] = { weight = weight, value = id }
			end
		end
	end

	if #entries == 0 then
		return "Walker"
	end

	local picked: any = r:Weighted(entries)
	if typeof(picked) == "string" then
		return picked :: string
	end
	return "Walker"
end

----------------------------------------------------------------------
-- Spawning
----------------------------------------------------------------------

local function spawnOne(waveNumber: number, archetypeId: string?, forceBoss: boolean): any?
	local ai = getZombieAI()
	if not ai then
		return nil
	end

	local id: string
	if forceBoss then
		id = "Boss"
	elseif archetypeId ~= nil then
		id = archetypeId :: string
	else
		id = WaveDirector.RollArchetype(waveNumber)
	end

	local self: any = ai
	local spawnFn: any = self.Spawn
	if type(spawnFn) ~= "function" then
		return nil
	end

	local callSpawn: any = spawnFn
	local model: any = nil
	pcall(function()
		-- ZombieAI.Spawn is declared with dots, so it must be called WITHOUT a
		-- self argument. Passing the function as `self` shifted every parameter
		-- by one, so archetypeId received a function and archetypeOf() silently
		-- fell back to Walker — every wave was cloned Walkers and Brutes,
		-- Runners, Spitters and theme waves never appeared at all.
		model = callSpawn(id, waveNumber)
	end)
	if model then
		-- Special-wave scaling is derived deterministically inside ZombieAI
		-- using the same formula as SpecialWaveType, so nothing needs passing.
		aliveModels[#aliveModels + 1] = model
	end
	return model
end

-- Counts zombies still alive by asking ZombieAI (authoritative) and pruning
-- models it no longer tracks.
local function aliveCount(): number
	local ai = getZombieAI()
	if not ai then
		aliveModels = {}
		return 0
	end
	local isZombie: any = ai.IsZombie
	local self: any = ai
	local n = 0
	local kept: { any } = {}
	for _, model in ipairs(aliveModels) do
		local still = false
		if type(isZombie) == "function" then
			local checker: any = isZombie
			pcall(function()
				still = checker(self, model) == true
			end)
		else
			still = model.Parent ~= nil
		end
		if still then
			n += 1
			kept[#kept + 1] = model
		end
	end
	aliveModels = kept
	return n
end

----------------------------------------------------------------------
-- Rewards
----------------------------------------------------------------------

local function playerIterator(): { any }
	if not Players then
		return {}
	end
	local list: any = nil
	pcall(function()
		list = Players:GetPlayers()
	end)
	if typeof(list) ~= "table" then
		return {}
	end
	return list :: { any }
end

-- Wave-clear payout. Best-effort: skipped entirely when Economy was not wired.
local function awardWaveClear(waveNumber: number)
	if not economy then
		return
	end
	local waveClear: any = economy.OnWaveClear
	if type(waveClear) ~= "function" then
		return
	end
	local self: any = economy
	local pay: any = waveClear
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			pay(self, player, waveNumber, nil)
		end)
	end
end

-- Keeps Progression's record of the current wave in sync.
local function pushWaveToProgression(waveNumber: number)
	if not progression then
		return
	end
	local setWave: any = progression.SetWave
	if type(setWave) ~= "function" then
		return
	end
	local self: any = progression
	local push: any = setWave
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			push(self, player, waveNumber)
		end)
	end
end

----------------------------------------------------------------------
-- Timers
----------------------------------------------------------------------

-- Waits `seconds` of wall time while refreshing the broadcast TimeRemaining so
-- clients can render the intermission countdown. Returns early if stopped.
local function countdown(seconds: number)
	local interval = 0.25
	local remaining: number = seconds
	if remaining < 0 then
		remaining = 0
	end
	while remaining > 0 and running do
		state.TimeRemaining = remaining
		broadcast()
		local step = interval
		if remaining < interval then
			step = remaining
		end
		pcall(function()
			if RunService then
				RunService.Heartbeat:Wait()
				task.wait(step - 0.016)
			else
				task.wait(step)
			end
		end)
		remaining -= step
	end
	state.TimeRemaining = 0
	broadcast()
	return running
end

----------------------------------------------------------------------
-- Wave lifecycle
----------------------------------------------------------------------

local function clearTracking()
	aliveModels = {}
end

-- Runs a single wave to completion: spawn the batch, then wait until every
-- zombie is dead before returning.
local function runWave(waveNumber: number)
	local w = waveSettings()

	state.Wave = waveNumber
	local isBoss = WaveDirector.IsBossWave(waveNumber)

	local total: number = WaveDirector.ZombieCountForWave(waveNumber)
	local bossSlots = 0
	if isBoss then
		bossSlots = 1 + math.floor(waveNumber / (w.BossEveryNWaves * 5))
		if bossSlots < 1 then
			bossSlots = 1
		end
		if bossSlots > 3 then
			bossSlots = 3
		end
	end

	local normalSlots = total
	if normalSlots > w.MaxConcurrentZombies - bossSlots then
		normalSlots = w.MaxConcurrentZombies - bossSlots
	end
	if normalSlots < 0 then
		normalSlots = 0
	end

	state.ZombiesTotal = normalSlots + bossSlots
	state.ZombiesRemaining = state.ZombiesTotal
	setPhase(PHASE_ACTIVE)
	pushWaveToProgression(waveNumber)

	pcall(function()
		Remotes.Notify():FireAllClients(
			if isBoss then
				string.format("Wave %d — BOSS INCOMING", waveNumber)
			else
				string.format("Wave %d started", waveNumber)
		)
	end)

	-- Audio + screen tint so a wave start is unmistakable.
	pcall(function()
		Effects.PlaySound("WaveStart", 0.7, if isBoss then 0.75 else 1)
		Effects.WaveStartFlash()
	end)

	pcall(function()
		Chat.WaveStart(waveNumber, isBoss)
	end)

	-- Announce special wave themes so players can prepare.
	pcall(function()
		local special = WaveDirector.SpecialWaveType(waveNumber)
		if special and type((Chat :: any).SpecialWave) == "function" then
			local fn: any = (Chat :: any).SpecialWave
			local g: any = fn
			g(special)
		end
	end)

	clearTracking()

	-- Bosses first so they are on the field for the whole wave.
	for _ = 1, bossSlots do
		if not running then
			break
		end
		spawnOne(waveNumber, nil, true)
	end

	local interval: number = w.SpawnBatchInterval
	if interval < 0 then
		interval = 0
	end

	for i = 1, normalSlots do
		if not running then
			break
		end
		spawnOne(waveNumber, nil, false)
		-- Refresh the live remaining count while the batch is still coming out.
		state.ZombiesRemaining = (state.ZombiesTotal - i) + aliveCount()
		broadcast()
		if interval > 0 then
			pcall(function()
				task.wait(interval)
			end)
		end
	end

	-- All queued zombies are in play; wait for the field to be cleared.
	while running do
		local remaining = aliveCount()
		state.ZombiesRemaining = remaining
		if remaining <= 0 then
			broadcast()
			break
		end
		broadcast()
		pcall(function()
			task.wait(0.35)
		end)
	end

	if not running then
		return false
	end

	state.ZombiesRemaining = 0
	broadcast()

	awardWaveClear(waveNumber)
	pcall(function()
		Remotes.Notify():FireAllClients(string.format("Wave %d cleared", waveNumber))
	end)

	-- Extraction: reaching the target wave wins the run with a bonus payout.
	pcall(function()
		local w = waveSettings()
		local target: number = tonumber(w.ExtractionWave) or 0
		if target > 0 and waveNumber >= target then
			local bonus: number = tonumber(w.ExtractionBonus) or 0
			for _, player in ipairs(playerIterator()) do
				pcall(function()
					local econ = economy
					if econ and type(econ.AddCoins) == "function" then
						local fn: any = econ.AddCoins
						local g: any = fn
						g(econ, player, bonus)
					end
					Remotes.RunEnded():FireClient(player, {
						Wave = waveNumber,
						Reason = "Extracted",
						Bonus = bonus,
					})
				end)
			end
			pcall(function()
				Chat.System(string.format("🏆 EXTRACTION at wave %d! +%d coins each.", waveNumber, bonus))
			end)
			WaveDirector.Stop()
		end
	end)

	pcall(function()
		Chat.WaveCleared(waveNumber)
	end)

	-- Milestone badges for surviving notable waves.
	pcall(function()
		for _, player in ipairs(playerIterator()) do
			pcall(function()
				Badges.OnWaveCleared(player, waveNumber)
			end)
		end
	end)
	return true
end

local function mainLoop()
	local w = waveSettings()

	-- Initial delay before wave 1 so players can spawn and orient.
	if not countdown(toNumber(w.FirstWaveDelay, 5)) then
		return
	end

	while running do
		local nextWave: number = state.Wave + 1

		-- Intermission before each wave (including subsequent ones).
		if state.Wave >= 0 then
			setPhase(PHASE_INTERMISSION)
			if not countdown(toNumber(w.IntermissionTime, 10)) then
				return
			end
			if not running then
				return
			end
		end

		local cleared = runWave(nextWave)
		if not cleared then
			return
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function WaveDirector.Init()
	if running then
		return
	end
	if not ensureServices() then
		warn("[WaveDirector] services unavailable; wave loop not started")
		return
	end
	running = true
	state.Wave = 0
	state.TimeRemaining = 0
	clearTracking()
	mainThread = task.spawn(function()
		local ok, err = pcall(mainLoop)
		if not ok then
			warn("[WaveDirector] loop error: " .. tostring(err))
		end
	end)
end

function WaveDirector.Start()
	WaveDirector.Init()
end

-- Stops the loop in place; does not reset the published state so a HUD reading
-- it keeps showing the last known values.
function WaveDirector.Stop()
	running = false
	if mainThread then
		pcall(function()
			task.cancel(mainThread)
		end)
		mainThread = nil
	end
end

function WaveDirector.Reset()
	WaveDirector.Stop()
	clearTracking()
	state.Wave = 0
	state.ZombiesRemaining = 0
	state.ZombiesTotal = 0
	state.TimeRemaining = 0
	state.Phase = PHASE_INTERMISSION
	broadcast()
end

function WaveDirector.GetState(): WaveState
	return {
		Wave = state.Wave,
		Phase = state.Phase,
		ZombiesRemaining = state.ZombiesRemaining,
		ZombiesTotal = state.ZombiesTotal,
		TimeRemaining = state.TimeRemaining,
	}
end

function WaveDirector.GetWave(): number
	return state.Wave
end

function WaveDirector.GetPhase(): string
	return state.Phase
end

function WaveDirector.GetRemaining(): number
	return state.ZombiesRemaining
end

function WaveDirector.IsRunning(): boolean
	return running
end

-- Used by GameServer to publish a terminal state when the run ends.
function WaveDirector.EndRun(waveNumber: number?)
	if waveNumber ~= nil then
		state.Wave = toNumber(waveNumber, state.Wave)
	end
	WaveDirector.Stop()
	state.Phase = PHASE_ENDED
	state.ZombiesRemaining = 0
	state.TimeRemaining = 0
	broadcast()
end

----------------------------------------------------------------------
-- Dependency injection (all optional)
----------------------------------------------------------------------

function WaveDirector.SetZombieAI(mod: any?)
	zombieAI = mod
	local m: any = mod
	if m and type(m.SetRandom) == "function" then
		local setR: any = m.SetRandom
		pcall(function()
			setR(os.time())
		end)
	end
end

function WaveDirector.SetEconomy(mod: any?)
	economy = mod
end

function WaveDirector.SetProgression(mod: any?)
	progression = mod
end

function WaveDirector.SetSeed(seed: number)
	rand = RNG.new(seed) :: Random
	local aiRef: any = zombieAI
	if aiRef and type(aiRef.SetRandom) == "function" then
		local setR: any = aiRef.SetRandom
		pcall(function()
			setR(seed)
		end)
	end
end

-- Debug/testing helper: spawn a specific archetype without starting a wave.
function WaveDirector.DebugSpawn(archetypeId: string, waveNumber: number?): any?
	return spawnOne(toNumber(waveNumber, math.max(1, state.Wave)), archetypeId, false)
end

return WaveDirector
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WeaponView</string>
          <string name="Source"><![CDATA[--!strict
-- Visible held weapon.
--
-- Firing is a server-side raycast the player never sees in their own hands, so
-- before this module the character fought bare-handed and a new player could
-- not tell they had a weapon they could shoot at all. This module builds a
-- small stud-part gun welded to the character's right hand and rebuilds it on
-- every equip/refresh, purely visual: it holds no Tool, swallows no input and
-- changes nothing about combat itself.
--
-- Barrel alignment: built along -Z, the Roblox look-forward convention, so the
-- muzzle points where the character faces once welded.

local Config = require(script.Parent.Shared.Config)

local WeaponView = {}

local COL_GUNMETAL = Color3.fromRGB(38, 40, 44)
local COL_STEEL = Color3.fromRGB(120, 124, 132)
local COL_WOOD = Color3.fromRGB(96, 62, 38)
local COL_ACCENT = Color3.fromRGB(70, 170, 210)
local COL_ORANGE = Color3.fromRGB(200, 120, 40)

type PartSpec = {
	Name: string,
	Size: Vector3,
	CFrame: CFrame,
	Color: Color3,
	-- The offline analyzer's Roblox definitions do not resolve Enum.Material as
	-- a type, so Enum values are typed through `any` (runtime values are real).
	Material: any,
}

local RIG_NAME = "ZA_WeaponRig"

-- One welded assembly per weapon id: grip part at the origin, forward -Z.
local BUILDERS: { [string]: { PartSpec } } = {}

BUILDERS.Pistol = {
	-- Slide/body pointing forward.
	{ Name = "Body", Size = Vector3.new(0.32, 0.58, 1.5),
		CFrame = CFrame.new(0, 0.1, -0.15), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
	-- Muzzle.
	{ Name = "Muzzle", Size = Vector3.new(0.2, 0.2, 0.35),
		CFrame = CFrame.new(0, 0.1, -1.05), Color = COL_STEEL, Material = Enum.Material.Metal },
	-- Grip hanging down at the rear.
	{ Name = "Grip", Size = Vector3.new(0.28, 0.75, 0.4),
		CFrame = CFrame.new(0, -0.35, 0.3), Color = Color3.fromRGB(24, 24, 26), Material = Enum.Material.SmoothPlastic },
}

BUILDERS.SMG = {
	{ Name = "Body", Size = Vector3.new(0.4, 0.62, 1.9),
		CFrame = CFrame.new(0, 0.1, -0.15), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
	{ Name = "Muzzle", Size = Vector3.new(0.18, 0.18, 0.4),
		CFrame = CFrame.new(0, 0.1, -1.25), Color = COL_STEEL, Material = Enum.Material.Metal },
	{ Name = "Magazine", Size = Vector3.new(0.26, 0.9, 0.35),
		CFrame = CFrame.new(0, -0.5, -0.25), Color = Color3.fromRGB(26, 27, 30), Material = Enum.Material.SmoothPlastic },
	-- Data port stripe, feeds the "Vector" identity.
	{ Name = "Stripe", Size = Vector3.new(0.44, 0.08, 0.9),
		CFrame = CFrame.new(0, 0.42, -0.15), Color = COL_ACCENT, Material = Enum.Material.Neon },
	{ Name = "Grip", Size = Vector3.new(0.28, 0.75, 0.4),
		CFrame = CFrame.new(0, -0.32, 0.42), Color = Color3.fromRGB(24, 24, 26), Material = Enum.Material.SmoothPlastic },
	{ Name = "Stock", Size = Vector3.new(0.26, 0.3, 0.85),
		CFrame = CFrame.new(0, 0.05, 0.9), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
}

BUILDERS.Shotgun = {
	{ Name = "Barrel", Size = Vector3.new(0.36, 0.36, 2.6),
		CFrame = CFrame.new(0, 0.15, -0.7), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
	{ Name = "Tube", Size = Vector3.new(0.28, 0.28, 2.2),
		CFrame = CFrame.new(0, -0.16, -0.65), Color = COL_STEEL, Material = Enum.Material.Metal },
	{ Name = "Pump", Size = Vector3.new(0.42, 0.22, 0.75),
		CFrame = CFrame.new(0, -0.18, -0.25), Color = COL_ORANGE, Material = Enum.Material.SmoothPlastic },
	{ Name = "Receiver", Size = Vector3.new(0.4, 0.5, 0.9),
		CFrame = CFrame.new(0, 0.12, 0.35), Color = Color3.fromRGB(28, 29, 32), Material = Enum.Material.SmoothPlastic },
	{ Name = "Stock", Size = Vector3.new(0.32, 0.6, 1.1),
		CFrame = CFrame.new(0, -0.08, 1.15), Color = COL_WOOD, Material = Enum.Material.Wood },
}

BUILDERS.Rifle = {
	{ Name = "Barrel", Size = Vector3.new(0.3, 0.3, 3.4),
		CFrame = CFrame.new(0, 0.12, -1.15), Color = COL_STEEL, Material = Enum.Material.Metal },
	{ Name = "Receiver", Size = Vector3.new(0.4, 0.55, 1.4),
		CFrame = CFrame.new(0, 0.1, 0.05), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
	{ Name = "Magazine", Size = Vector3.new(0.28, 0.85, 0.4),
		CFrame = CFrame.new(0, -0.45, 0.15), Color = Color3.fromRGB(26, 27, 30), Material = Enum.Material.SmoothPlastic },
	-- Marksman scope.
	{ Name = "Scope", Size = Vector3.new(0.26, 0.26, 1.15),
		CFrame = CFrame.new(0, 0.62, -0.1), Color = Color3.fromRGB(20, 20, 22), Material = Enum.Material.Metal },
	{ Name = "Stock", Size = Vector3.new(0.3, 0.55, 1.7),
		CFrame = CFrame.new(0, -0.02, 1.35), Color = COL_GUNMETAL, Material = Enum.Material.Metal },
	{ Name = "Grip", Size = Vector3.new(0.28, 0.7, 0.38),
		CFrame = CFrame.new(0, -0.34, 0.72), Color = Color3.fromRGB(24, 24, 26), Material = Enum.Material.SmoothPlastic },
}

-- Fallback so an unknown id (hotkey typo, future weapon) still shows a gun.
BUILDERS.Default = BUILDERS.Pistol

local function specsFor(weaponId: string): { PartSpec }
	local spec: any = (BUILDERS :: any)[weaponId]
	if spec then
		return spec :: { PartSpec }
	end
	return BUILDERS.Default :: { PartSpec }
end

local function displayNameOf(weaponId: string): string
	local defs: any = Config.Weapons
	local def: any = defs[weaponId]
	if def and type(def.DisplayName) == "string" then
		return def.DisplayName
	end
	return weaponId
end

----------------------------------------------------------------------
-- Equip / clear
----------------------------------------------------------------------

-- Destroys any existing rig on the character (idempotent before every attach).
local function destroyRig(character: Instance?)
	if character == nil then
		return
	end
	local function kill(inst: any)
		pcall(function()
			local c: any = inst
			c:Destroy()
		end)
	end
	pcall(function()
		local existing: any = (character :: any):FindFirstChild(RIG_NAME)
		if existing then
			kill(existing)
		end
	end)
end

local function buildParts(weaponId: string): (any, any)
	local model = Instance.new("Model")
	model.Name = RIG_NAME

	local specs = specsFor(weaponId)
	-- The weld spine: prefer explicit body/receiver parts, else the first spec.
	local primary: any = nil
	local parts: { any } = {}

	for i, spec in ipairs(specs) do
		local part = Instance.new("Part")
		part.Name = spec.Name
		part.Size = spec.Size
		part.Color = spec.Color
		part.Material = spec.Material
		part.CFrame = spec.CFrame
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Massless = true
		part:SetAttribute("RigIndex", i)
		part.Parent = model
		parts[#parts + 1] = part
		if primary == nil then
			primary = part
		elseif spec.Name == "Body" or spec.Name == "Receiver" then
			primary = part
		end
	end

	if not primary then
		return model, nil
	end

	-- Weld every part to the spine so the gun is one rigid assembly; without
	-- this the loose parts fall apart the moment they touch physics.
	for _, part in ipairs(parts) do
		if part ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Name = "ZA_RigPartWeld"
			weld.Part0 = primary
			weld.Part1 = part
			weld.Parent = part
		end
	end

	return model, primary
end

-- Attaches the gun for `weaponId` to the player's right hand. Safe to call on
-- every weapon change; rebuilds from scratch so shape and stats can never drift.
function WeaponView.Equip(player: any, weaponId: string)
	if player == nil then
		return
	end
	local character: any = player.Character
	if not character then
		return
	end

	-- Hand placement: R15 avatars have RightHand; R6 has Right Arm. Either way
	-- the rig must keep working, hence the fallback chain.
	local hand: any = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
	local root: any = character:FindFirstChild("HumanoidRootPart")
	if not hand or not root then
		return
	end

	destroyRig(character)

	local rigModel, spine = buildParts(weaponId)
	if not spine then
		pcall(function()
			rigModel:Destroy()
		end)
		return
	end
	rigModel.PrimaryPart = spine

	local hrp: any = root
	-- Hold the gun slightly ahead of the hand along the character's facing so
	-- the muzzle visibly points where they aim.
	local look: any = hrp.CFrame.LookVector
	local right: any = hrp.CFrame.RightVector
	local holdPos: Vector3 = hand.Position
		+ Vector3.new(look.X * 0.7, 0.25, look.Z * 0.7)
		+ Vector3.new(right.X * 0.1, 0, right.Z * 0.1)
	local holdCFrame: CFrame = CFrame.lookAt(holdPos, holdPos + look)
	rigModel:PivotTo(holdCFrame)
	rigModel.Parent = character

	-- WeldConstraint keeps the relative placement captured by the pivot above.
	local weld = Instance.new("WeldConstraint")
	weld.Name = "ZA_WeaponWeld"
	weld.Part0 = hand
	weld.Part1 = spine
	weld.Parent = spine

	-- Label the weapon so hovering players and future systems can read it.
	pcall(function()
		rigModel:SetAttribute("WeaponId", weaponId)
		rigModel:SetAttribute("DisplayName", displayNameOf(weaponId))
	end)
end

function WeaponView.Clear(player: any)
	if player == nil then
		return
	end
	local ok, char = pcall(function()
		return player.Character
	end)
	if ok and char then
		destroyRig(char)
	end
end

return WeaponView
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Weapons</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Weapons
--
-- Server-authoritative hitscan combat. The client may *request* a shot but the
-- server decides whether it happens, from where, at what, and for how much
-- damage. Nothing the client sends is trusted.
--
-- For every Config.Weapons definition this system honours: Damage,
-- HeadshotMultiplier, FireRate, MagazineSize, ReloadTime, SpreadDegrees, Range,
-- Pellets (shotgun fires multiple rays), Auto, UnlockCost and AmmoReserveMax,
-- after applying Types.StatModifiers from Progression to damage, fire rate,
-- reload time and magazine size.
--
-- Damage is routed to ZombieAI.Damage when that module is present, and falls
-- back to a local Health-attribute implementation otherwise, so combat still
-- works while ZombieAI is written concurrently.
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local Types = require(script.Parent.Shared.Types)
local MathUtil = require(script.Parent.Shared.MathUtil)

-- Structural mirrors of cross-module exports (lint-time aliases only).
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type SecuritySettings = {
	MaxFireRequestsPerSecond: number,
	MaxRequestsPerSecond: number,
	MaxDamageClaimPerRequest: number,
}

-- ZombieAI is written concurrently; resolved dynamically at runtime.
type ZombieAIApi = {
	Damage: (any, number, boolean?) -> boolean,
}

-- Economy resolved dynamically too (rewards on kill).
type EconomyApi = {
	OnKill: (Player, boolean, StatModifiers?, number?, number?) -> (),
	GetStats: (Player) -> any,
}

local Weapons = {}

local Effects = require(script.Parent.Effects)
local WeaponView = require(script.Parent.WeaponView)

local Players = game:GetService("Players")

local WeaponsConfig: { [string]: WeaponDef } = Config.Weapons :: { [string]: WeaponDef }
local SEC: SecuritySettings = Config.Security :: SecuritySettings

local DEFAULT_WEAPON = "Pistol"
local HEAD_NAME = "Head"

------------------------------------------------------------------------------
-- Injected collaborators (never fatal if absent)
------------------------------------------------------------------------------

local zombieAI: ZombieAIApi? = nil
local economy: EconomyApi? = nil

function Weapons.SetZombieAI(mod: any)
	if typeof(mod) == "table" and type((mod :: any).Damage) == "function" then
		zombieAI = mod :: ZombieAIApi
	end
end

function Weapons.SetEconomy(mod: any)
	if typeof(mod) == "table" then
		economy = mod :: EconomyApi
	end
end

-- Dynamic sibling lookup, used when nobody injected an AI explicitly. Safe when
-- ZombieAI does not exist yet or errors while loading.
local aiLookedUp = false
local function resolveZombieAI(): ZombieAIApi?
	if zombieAI ~= nil then
		return zombieAI
	end
	if aiLookedUp then
		return nil
	end
	aiLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("ZombieAI")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" and type((mod :: any).Damage) == "function" then
		zombieAI = mod :: ZombieAIApi
		return zombieAI
	end
	return nil
end

local econLookedUp = false
local function resolveEconomy(): EconomyApi?
	if economy ~= nil then
		return economy
	end
	if econLookedUp then
		return nil
	end
	econLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("Economy")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" then
		economy = mod :: EconomyApi
		return economy
	end
	return nil
end

local progLookedUp = false
local progressionMod: any = nil
local function resolveProgression(): ProgressionApi?
	if progressionMod ~= nil then
		return progressionMod
	end
	if progLookedUp then
		return nil
	end
	progLookedUp = true

	local Systems: any = script.Parent
	local inst = Systems:FindFirstChild("Progression")
	if not inst then
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if ok and typeof(mod) == "table" then
		progressionMod = mod
		return progressionMod
	end
	return nil
end

------------------------------------------------------------------------------
-- Per-player weapon state
------------------------------------------------------------------------------

type WeaponEntry = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
	LastFireTime: number,
	LastReloadRequest: number,
}

local entries: { [Player]: WeaponEntry } = {}

-- Rate limiter: rolling one-second window of request timestamps.
local fireWindows: { [Player]: { number } } = {}

local function nowTime(): number
	return os.clock()
end

local function defOf(weaponId: string): WeaponDef?
	return WeaponsConfig[weaponId]
end

type ProgressionApi = {
	GetStatModifiers: (Player) -> StatModifiers,
	GetCurrentWeapon: (Player) -> string,
}

function Weapons.GetModifiers(player: Player): StatModifiers
	local prog: ProgressionApi? = resolveProgression()
	if prog then
		local p: ProgressionApi = prog
		local ok, mods = pcall(function()
			return p.GetStatModifiers(player)
		end)
		if ok and typeof(mods) == "table" then
			local view: any = mods
			return {
				DamageMult = tonumber(view.DamageMult) or 1,
				FireRateMult = tonumber(view.FireRateMult) or 1,
				ReloadMult = tonumber(view.ReloadMult) or 1,
				MagazineMult = tonumber(view.MagazineMult) or 1,
				MoveSpeedFlat = tonumber(view.MoveSpeedFlat) or 0,
				MaxHealthFlat = tonumber(view.MaxHealthFlat) or 0,
				LifestealPct = tonumber(view.LifestealPct) or 0,
				CoinMult = tonumber(view.CoinMult) or 1,
			}
		end
	end
	return Types.NewStatModifiers()
end

-- Resolves the weapon the player should be using (owned + equipped).
local function currentWeaponFor(player: Player): (WeaponDef, string)
	local prog: ProgressionApi? = resolveProgression()
	local weaponId: string = DEFAULT_WEAPON
	if prog then
		local p: ProgressionApi = prog
		local ok, id = pcall(function()
			return p.GetCurrentWeapon(player)
		end)
		if ok and typeof(id) == "string" and defOf(id) ~= nil then
			weaponId = id
		end
	end
	local def = defOf(weaponId)
	if not def then
		local fallback: WeaponDef = WeaponsConfig[DEFAULT_WEAPON]
		weaponId = DEFAULT_WEAPON
		return fallback, weaponId
	end
	return def, weaponId
end

local function magazineSize(def: WeaponDef, mods: StatModifiers): number
	local base: number = def.MagazineSize
	local size = math.floor(base * mods.MagazineMult + 0.5)
	if size < 1 then
		size = 1
	end
	return size
end

local function makeEntry(player: Player): WeaponEntry
	local def, weaponId = currentWeaponFor(player)
	local mods = Weapons.GetModifiers(player)
	local mag = magazineSize(def, mods)
	local reserve: number = def.AmmoReserveMax
	return {
		WeaponId = weaponId,
		AmmoInMag = mag,
		AmmoReserve = reserve,
		Reloading = false,
		ReloadEndsAt = nil,
		LastFireTime = 0,
		LastReloadRequest = 0,
	}
end

function Weapons.GetEntry(player: Player): WeaponEntry
	local e = entries[player]
	if not e then
		e = makeEntry(player)
		entries[player] = e
	end
	return e
end

function Weapons.GetState(player: Player): WeaponState
	local e = Weapons.GetEntry(player)
	return {
		WeaponId = e.WeaponId,
		AmmoInMag = e.AmmoInMag,
		AmmoReserve = e.AmmoReserve,
		Reloading = e.Reloading,
		ReloadEndsAt = e.ReloadEndsAt,
	}
end

function Weapons.Replicate(player: Player)
	pcall(function()
		local state = Weapons.GetState(player)
		Remotes.WeaponStateChanged():FireClient(player, state)
	end)
end

-- Forces a full rebuild of the player's weapon state, e.g. after buying a
-- weapon or gaining a magazine perk.
function Weapons.Refresh(player: Player)
	local def, weaponId = currentWeaponFor(player)
	local mods = Weapons.GetModifiers(player)
	local mag = magazineSize(def, mods)
	local e = Weapons.GetEntry(player)

	e.WeaponId = weaponId
	e.Reloading = false
	e.ReloadEndsAt = nil
	e.AmmoReserve = def.AmmoReserveMax
	if e.AmmoInMag > mag then
		e.AmmoInMag = mag
	else
		-- Top the magazine up to the new capacity.
		e.AmmoInMag = mag
	end
	Weapons.Replicate(player)
	-- Keep the visible gun in hand in sync with what they actually use.
	pcall(function()
		WeaponView.Equip(player, weaponId)
	end)
end

-- Hot-swaps to another owned weapon WITHOUT restocking ammo.
--
-- Refresh() deliberately tops everything up because it services purchases and
-- magazine perks. If the 1-4 hotkeys went through it too, players could cycle
-- weapons for infinite reserve — a free pass around the entire ammo economy.
-- A swap still grants a full magazine so it is instantly useful, but reserve
-- carries over untouched.
function Weapons.Equip(player: Player, weaponId: string)
	local def = defOf(weaponId)
	if not def then
		return
	end
	local e = entries[player]
	if not e then
		return
	end
	if e.WeaponId == weaponId then
		return
	end
	e.WeaponId = weaponId
	e.Reloading = false
	e.ReloadEndsAt = nil
	e.AmmoInMag = magazineSize(def, Weapons.GetModifiers(player))
	Weapons.Replicate(player)
	pcall(function()
		WeaponView.Equip(player, weaponId)
	end)
end

------------------------------------------------------------------------------
-- Rate limiting / input validation
------------------------------------------------------------------------------

local function withinRateLimit(player: Player): boolean
	local maxPerSecond: number = SEC.MaxFireRequestsPerSecond
	if maxPerSecond <= 0 then
		return false
	end

	local window = fireWindows[player]
	if not window then
		window = {}
		fireWindows[player] = window
	end

	local t = nowTime()
	-- Drop timestamps older than one second.
	local cutoff = t - 1.0
	local alive: { number } = {}
	for _, ts in ipairs(window) do
		if ts >= cutoff then
			table.insert(alive, ts)
		end
	end

	if #alive >= maxPerSecond then
		fireWindows[player] = alive
		return false
	end

	table.insert(alive, t)
	fireWindows[player] = alive
	return true
end

-- Validates the three ray components the client sends. Anything malformed is
-- coerced to zero rather than trusted.
local function sanitizeVec(v: any): (number, number, number)
	if typeof(v) ~= "Vector3" then
		return 0, 0, 0
	end
	local view: any = v
	local x = tonumber(view.X)
	local y = tonumber(view.Y)
	local z = tonumber(view.Z)
	if x == nil or y == nil or z == nil then
		return 0, 0, 0
	end
	-- Reject non-finite and wildly out-of-bounds coordinates.
	if x ~= x or y ~= y or z ~= z then
		return 0, 0, 0
	end
	if math.abs(x) > 1e6 or math.abs(y) > 1e6 or math.abs(z) > 1e6 then
		return 0, 0, 0
	end
	return x, y, z
end

-- Server-side origin: derived from the character, never from the client, so a
-- cheater cannot shoot from inside a wall or across the map.
--
-- The fallback aim direction is the HEAD's look vector. Note the previous
-- version preferred workspace.CurrentCamera here — on the server that is not
-- the player's camera (it is a detached default-pose camera), so every shot
-- travelled along the character's body facing and the crosshair never lined up
-- with the ray. The client's camera look direction now takes precedence
-- (see extractAimDirection); this fallback only covers a bogus payload.
local function serverOrigin(player: Player): (Vector3?, Vector3?)
	local ok, res = pcall(function()
		local character = player.Character
		if not character then
			return nil
		end
		local head: any = character:FindFirstChild("Head")
		if not head then
			return nil
		end
		return head.Position, head.CFrame.LookVector
	end)
	if not ok or res == nil then
		return nil, nil
	end
	local anyRes: any = res
	local origin: any = anyRes[1]
	local dirAny: any = anyRes[2]
	if origin == nil then
		return nil, nil
	end
	return origin :: Vector3, dirAny :: Vector3
end

------------------------------------------------------------------------------
-- Damage routing
------------------------------------------------------------------------------

local function readNumberAttr(model: any, name: string): number?
	local ok, v = pcall(function()
		return model:GetAttribute(name)
	end)
	if not ok then
		return nil
	end
	local n = tonumber(v)
	if n == nil then
		return nil
	end
	return n
end

-- Fallback damage path used while ZombieAI is unavailable.
local function fallbackDamage(model: any, amount: number): boolean
	local maxHealth = readNumberAttr(model, "MaxHealth")
	local health = readNumberAttr(model, "Health")
	if health == nil then
		health = maxHealth
	end
	if health == nil then
		-- Nothing to damage; also try a Humanoid if the model has one.
		local ok, hum = pcall(function()
			return model:FindFirstChildOfClass("Humanoid")
		end)
		if ok and hum then
			pcall(function()
				(hum :: any):TakeDamage(amount)
			end)
			local h2 = hum :: any
			return h2.Health <= 0
		end
		return false
	end

	if maxHealth == nil then
		maxHealth = health
	end

	local newHealth: number = health - amount
	local died = newHealth <= 0
	pcall(function()
		model:SetAttribute("Health", math.max(newHealth, 0))
	end)
	if died then
		pcall(function()
			model:Destroy()
		end)
	end
	return died
end

-- Routes damage to ZombieAI when available, else the fallback. Never throws.
-- Returns true when the hit killed the zombie.
local function dealDamage(model: any, amount: number, headshot: boolean): boolean
	local ai = resolveZombieAI()
	if ai then
		local ok, died = pcall(function()
			return ai.Damage(model, amount, headshot)
		end)
		if ok then
			return died == true
		end
		warn("[Weapons] ZombieAI.Damage failed, using fallback: " .. tostring(died))
	end
	return fallbackDamage(model, amount)
end

local function rewardKill(player: Player, model: any, headshot: boolean)
	local econ = resolveEconomy()
	if not econ then
		return
	end
	local rewardCoins = readNumberAttr(model, "RewardCoins")
	local rewardXP = readNumberAttr(model, "RewardXP")
	pcall(function()
		econ.OnKill(player, headshot, Weapons.GetModifiers(player), rewardCoins, rewardXP)
	end)
end

-- True when the ray hit "Head" (or a part whose parent chain resolves to Head).
local function isHeadshot(result: any): boolean
	local ok, part = pcall(function()
		return result.Instance
	end)
	if not ok or part == nil then
		return false
	end
	local anyPart: any = part
	local nameOk, name = pcall(function()
		return anyPart.Name
	end)
	if nameOk and name == HEAD_NAME then
		return true
	end
	-- Some rigs nest the head mesh under a "Head" part.
	local ok2, parentName = pcall(function()
		local p = anyPart.Parent
		if p == nil then
			return nil
		end
		return p.Name
	end)
	if ok2 and parentName == HEAD_NAME then
		return true
	end
	return false
end

-- Extracts the aim direction from the (untrusted) fire payload.
--
-- The client sends ONE table argument: { AimPoint, Direction, Origin,
-- CameraCFrame, WeaponId, SentAt }. The old handler expected positional
-- arguments (aimPoint, clientDir), so clientDir was always nil and every shot
-- reverted to the server fallback direction — the character's body facing —
-- which is why the gun could never reliably kill zombies.
--
-- `Direction` is the client's (aimPoint - cameraOrigin) vector and is NOT
-- normalized, so it is unit-normalized here: MathUtil.ApplySpread adds
-- orthogonal*sin(angle) offsets scaled for a unit vector, and a 250-stud raw
-- vector collapsed the shotgun's spread to near zero.
--
-- Returns a unit Vector3, or nil when the payload carries nothing usable.
local function extractAimDirection(payload: any, originPos: Vector3): Vector3?
	if typeof(payload) ~= "table" then
		return nil
	end
	local view: any = payload

	local dx, dy, dz = sanitizeVec(view.Direction)
	local mag = math.sqrt(dx * dx + dy * dy + dz * dz)
	if mag >= 0.05 then
		return Vector3.new(dx / mag, dy / mag, dz / mag)
	end

	-- Fall back to deriving a direction from the world aim point against the
	-- server-side origin. Never trusted as an origin itself.
	local ax, ay, az = sanitizeVec(view.AimPoint)
	local originAny: any = originPos
	if ax ~= 0 or ay ~= 0 or az ~= 0 then
		local vx: number = ax - originAny.X
		local vy: number = ay - originAny.Y
		local vz: number = az - originAny.Z
		local vmag = math.sqrt(vx * vx + vy * vy + vz * vz)
		if vmag >= 1.0 then
			return Vector3.new(vx / vmag, vy / vmag, vz / vmag)
		end
	end

	return nil
end

-- Returns the zombie Model for a hit part, or nil if it is not a zombie.
local function modelFromPart(part: any): any?
	if part == nil then
		return nil
	end
	local current: any = part
	for _ = 1, 8 do
		if current == nil then
			return nil
		end
		local ok, cls = pcall(function()
			return current.ClassName
		end)
		if ok and cls == "Model" then
			-- Zombies are tagged; fall back to any Model for resilience.
			return current
		end
		local ok2, parent = pcall(function()
			return current.Parent
		end)
		if not ok2 or parent == nil then
			return nil
		end
		current = parent
	end
	return nil
end

------------------------------------------------------------------------------
-- Firing
------------------------------------------------------------------------------

local function beginReload(player: Player, entry: WeaponEntry)
	local def = defOf(entry.WeaponId)
	if not def then
		return
	end
	if entry.Reloading then
		return
	end
	if entry.AmmoReserve <= 0 then
		return
	end
	local magCap = magazineSize(def, Weapons.GetModifiers(player))
	if entry.AmmoInMag >= magCap then
		return
	end

	local mods = Weapons.GetModifiers(player)
	local reloadTime: number = def.ReloadTime * mods.ReloadMult
	if reloadTime < 0.05 then
		reloadTime = 0.05
	end

	entry.Reloading = true
	entry.ReloadEndsAt = nowTime() + reloadTime
	Weapons.Replicate(player)

	pcall(function()
		Effects.PlaySound("Reload", 0.4, 1)
	end)

	task.delay(reloadTime, function()
		-- Player may have left mid-reload.
		if entries[player] ~= entry then
			return
		end
		local d = defOf(entry.WeaponId)
		if not d then
			entry.Reloading = false
			entry.ReloadEndsAt = nil
			return
		end
		local cap = magazineSize(d, Weapons.GetModifiers(player))
		local need = cap - entry.AmmoInMag
		if need < 0 then
			need = 0
		end
		local take = need
		if take > entry.AmmoReserve then
			take = entry.AmmoReserve
		end
		entry.AmmoInMag += take
		entry.AmmoReserve -= take
		entry.Reloading = false
		entry.ReloadEndsAt = nil
		Weapons.Replicate(player)
	end)
end

-- Casts one ray and applies damage. Returns (hitZombie, headshot, damage).
local function castRay(player: Player, entry: WeaponEntry, def: WeaponDef, originPos: Vector3, dir: Vector3, rand01: (number, number) -> number): (boolean, boolean, number)
	local spread: number = def.SpreadDegrees
	local direction: Vector3 = MathUtil.ApplySpread(dir, spread, rand01)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Blacklist
	-- Character is read through an `any` view (members are invisible offline).
	local selfView: any = player
	local blacklist: { any } = {}
	if selfView.Character ~= nil then
		blacklist = { selfView.Character }
	end
	params.FilterDescendantsInstances = blacklist
	params.IgnoreWater = true

	local scaledDir: any = direction
	-- Muzzle flash + report at the shooter's origin.
	pcall(function()
		Effects.MuzzleFlash(originPos)
		Effects.PlaySound("Gunshot", 0.5, 0.95 + math.random() * 0.12)
	end)

	local result: any = workspace:Raycast(originPos, (scaledDir * def.Range) :: Vector3, params)
	if not result then
		return false, false, 0
	end

	local headshot = isHeadshot(result)
	local damage: number = def.Damage * Weapons.GetModifiers(player).DamageMult
	if headshot then
		damage *= def.HeadshotMultiplier
	end

	-- Anti-cheat ceiling: clamp any claimed/derived damage per request.
	local cap: number = SEC.MaxDamageClaimPerRequest
	if damage > cap then
		damage = cap
	end
	if damage < 0 then
		damage = 0
	end

	local hitPart: any = result.Instance
	local model = modelFromPart(hitPart)
	if not model then
		return false, headshot, 0
	end

	local died = dealDamage(model, damage, headshot)
	if died then
		rewardKill(player, model, headshot)
	end

	-- Visual/audio feedback: blood on hit, burst + growl on kill.
	pcall(function()
		local hitPos: Vector3 = result.Position
		Effects.BloodBurst(hitPos)
		if died then
			Effects.DeathBurst(hitPos)
			Effects.PlaySound("ZombieGrowl", 0.35, 0.9 + math.random() * 0.3)
		else
			Effects.PlaySound("Hit", 0.25, 1)
		end
	end)

	pcall(function()
		Remotes.DamageDealt():FireClient(player, {
			Position = result.Position,
			Amount = damage,
			Headshot = headshot,
			Killed = died,
		})
	end)

	return true, headshot, damage
end

-- Deterministic-enough per-shot spread source. The UserId is read through an
-- `any` view because luau-analyze cannot resolve Roblox instance members.
local function bulletRand(player: Player): (number, number) -> number
	local selfView: any = player
	local seedValue = tonumber(selfView.UserId)
	local seed: number = if seedValue ~= nil then (seedValue % 100000) + 1 else 1
	local counter: number = 0
	return function(_min: number, _max: number): number
		counter += 1
		-- Simple deterministic hash in [-1, 1].
		local x = math.sin((seed * 12.9898) + (counter * 78.233)) * 43758.5453
		local frac = x - math.floor(x)
		return (frac * 2) - 1
	end
end

local function tryFire(player: Player, firePayload: any)
	-- Rate limit first; everything else is cheaper than an exploit.
	if not withinRateLimit(player) then
		return
	end

	local entry = Weapons.GetEntry(player)
	local def = defOf(entry.WeaponId)
	if not def then
		return
	end

	local now = nowTime()

	if entry.Reloading then
		return
	end

	-- Fire-rate gate.
	local mods = Weapons.GetModifiers(player)
	local fireRate: number = def.FireRate * mods.FireRateMult
	if fireRate < 0.1 then
		fireRate = 0.1
	end
	local minInterval: number = 1 / fireRate
	if now - entry.LastFireTime < minInterval - 0.001 then
		return
	end

	if entry.AmmoInMag <= 0 then
		pcall(function()
			Remotes.Notify():FireClient(player, "Out of ammo — reload")
		end)
		return
	end

	local originPos, fallbackDir = serverOrigin(player)
	if originPos == nil or fallbackDir == nil then
		return
	end

	-- Aim where the player is looking (camera direction from the client
	-- payload), not where the character's body happens to face. Falls back to
	-- the head look vector when the payload is absent or malformed.
	local dir: Vector3 = extractAimDirection(firePayload, originPos) or fallbackDir :: Vector3

	entry.AmmoInMag -= 1
	entry.LastFireTime = now

	local rand = bulletRand(player)
	local pellets: number = def.Pellets
	if pellets < 1 then
		pellets = 1
	end
	-- Hard ceiling on rays per shot for perf safety.
	if pellets > 20 then
		pellets = 20
	end

	local totalDamage = 0
	for _ = 1, pellets do
		local _, _, dmg = castRay(player, entry, def, originPos, dir, rand)
		totalDamage += dmg
	end

	-- Lifesteal: heal for a percentage of damage actually dealt.
	local lifesteal: number = mods.LifestealPct
	if lifesteal > 0 and totalDamage > 0 then
		local healAmount = totalDamage * lifesteal
		pcall(function()
			local character = player.Character
			if not character then
				return
			end
			local humanoid: any = character:FindFirstChildOfClass("Humanoid")
			if not humanoid then
				return
			end
			local maxH: number = humanoid.MaxHealth
			local newH: number = humanoid.Health + healAmount
			if newH > maxH then
				newH = maxH
			end
			humanoid.Health = newH
		end)
	end

	Weapons.Replicate(player)

	if entry.AmmoInMag <= 0 then
		-- Auto-reload convenience when the magazine runs dry.
		beginReload(player, entry)
	end
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

-- One-time per player: tells a freshly spawned player, in one line, how they
-- shoot. Pairs with the Instructions panel for the full how-to.
local armedNotified: { [Player]: boolean } = {}

local function notifyArmed(player: Player)
	if armedNotified[player] then
		return
	end
	armedNotified[player] = true
	-- Fired after spawn settles so it does not battle the HUD boot-up noise.
	task.delay(4.5, function()
		pcall(function()
			Remotes.Notify():FireClient(
				player,
				"You are armed: Left Mouse to fire · R to reload · 1–4 to switch"
			)
		end)
	end)
end

-- Attaches the previously equipped weapon's visual rig to a fresh character.
-- The rig lives inside the character model, so every respawn needs a new copy.
function Weapons.EquipCurrentView(player: Player)
	pcall(function()
		local e = Weapons.GetEntry(player)
		WeaponView.Equip(player, e.WeaponId)
	end)
end

function Weapons.Init()
	if booted then
		return
	end
	booted = true

	Remotes.InitServer()

	Players.PlayerAdded:Connect(function(player: Player)
		Weapons.GetEntry(player)
		task.delay(1, function()
			Weapons.Replicate(player)
		end)
		pcall(function()
			player.CharacterAdded:Connect(function()
				-- Let the character finish assembling before the weld lands.
				task.delay(0.6, function()
					Weapons.EquipCurrentView(player)
				end)
			end)
		end)
		-- Character may already exist when we run.
		if player.Character then
			task.delay(0.6, function()
				Weapons.EquipCurrentView(player)
			end)
		end
		pcall(notifyArmed, player)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		entries[player] = nil
		fireWindows[player] = nil
		armedNotified[player] = nil
		pcall(function()
			WeaponView.Clear(player)
		end)
	end)

	-- Client -> Server. The client sends a single payload table; it arrives
	-- untrusted and we only take the aim direction from it (unit-normalized in
	-- extractAimDirection). The origin is always re-derived server-side.
	Remotes.RequestFire().OnServerEvent:Connect(function(player: Player, firePayload: any)
		tryFire(player, firePayload)
	end)

	Remotes.RequestReload().OnServerEvent:Connect(function(player: Player)
		local entry = Weapons.GetEntry(player)
		-- Cheap throttle on reload spam.
		local t = nowTime()
		if t - entry.LastReloadRequest < 0.25 then
			return
		end
		entry.LastReloadRequest = t
		beginReload(player, entry)
	end)

	-- Late joiners.
	for _, player in ipairs(Players:GetPlayers()) do
		pcall(function()
			Weapons.GetEntry(player)
		end)
	end
end

-- Aliases used by GameServer's defensive lifecycle wiring.
function Weapons.PlayerJoined(player: Player)
	pcall(function()
		Weapons.GetEntry(player)
		Weapons.Replicate(player)
	end)
	Weapons.EquipCurrentView(player)
	pcall(notifyArmed, player)
end

function Weapons.PlayerLeft(player: Player)
	entries[player] = nil
	fireWindows[player] = nil
	armedNotified[player] = nil
	pcall(function()
		WeaponView.Clear(player)
	end)
end

return Weapons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ZombieAI</string>
          <string name="Source"><![CDATA[--!strict
-- Server-authoritative zombie behaviour: spawning, chasing, attacking, damage
-- and death cleanup.
--
-- ZombieAI owns one long-lived coroutine per zombie. Each brain ticks on
-- RunService.Heartbeat, recomputes a PathfindingService path on a throttled
-- interval (never every frame), and attacks the nearest alive player humanoid
-- that is inside the archetype AttackRange once AttackCooldown has elapsed.
--
-- Contract for other systems:
--   * ZombieAI.Spawn(archetypeId, waveNumber) -> Model
--   * ZombieAI.Damage(zombieModel, amount, headshot) -> boolean (true == died)
-- Every spawned model carries the CollectionService tag "Zombie" and these
-- attributes so no system needs to reach into this module's tables:
--   ZombieId, Archetype, Health, MaxHealth, Wave, LastAttack, RewardCoins,
--   RewardXP, IsBoss.

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local RNG = require(script.Parent.Shared.RNG)
local MapBuilder = require(script.Parent.MapBuilder)

-- Structural mirror of RNG.Random. The offline analyzer cannot resolve exported
-- types across `require`, so the shape is redeclared locally (kept in sync with
-- Shared/RNG.luau). Lint-time alias only; the runtime value is real.
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

-- Structural mirror of Config.ZombieArchetype (see Shared/Config.luau).
type Archetype = {
	Id: string,
	DisplayName: string,
	Health: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CoinReward: number,
	XPReward: number,
	Scale: number,
	BodyColor: any,
	UnlockWave: number,
	Weight: number,
	IsBoss: boolean?,
}

-- Structural mirror of Config.Wave (see Shared/Config.luau).
type WaveSettings = {
	IntermissionTime: number,
	FirstWaveDelay: number,
	MaxConcurrentZombies: number,
	SpawnBatchInterval: number,
	BossEveryNWaves: number,
	BaseZombieCount: number,
	CountGrowthPerWave: number,
	HPScalePerWave: number,
	SpeedScalePerWave: number,
	MaxSpeedScale: number,
	DamageScalePerWave: number,
}

local ZombieAI = {}

export type Brain = {
	Model: any,
	Humanoid: any,
	Root: any,
	Archetype: Archetype,
	Health: number,
	MaxHealth: number,
	Damage: number,
	WalkSpeed: number,
	AttackRange: number,
	AttackCooldown: number,
	LastAttack: number,
	Wave: number,
	ZombieId: number,
	Alive: boolean,
	Target: any,
	NextRepathAt: number,
	NextWaypointIndex: number,
	Waypoints: { any },
	PathFailed: boolean,
	Thread: thread?,
}

-- Services are fetched lazily inside pcall so a missing service in a unit-test
-- host can never hard-error this module at require time.
local PathfindingService: any = nil
local RunService: any = nil
local Debris: any = nil
local CollectionService: any = nil
local Players: any = nil
local servicesReady = false

local function ensureServices()
	if servicesReady then
		return true
	end
	local ok = pcall(function()
		PathfindingService = game:GetService("PathfindingService")
		RunService = game:GetService("RunService")
		Debris = game:GetService("Debris")
		CollectionService = game:GetService("CollectionService")
		Players = game:GetService("Players")
	end)
	servicesReady = ok
	return ok
end

local TAG = "Zombie"

local brains: { [any]: Brain } = {}
local order: { any } = {}
local spawnPointsCache: { any } = {}
local rng: Random? = nil
local nextZombieId = 0

local function getRandom(): Random
	local r = rng
	if r then
		return r
	end
	local fresh: Random = RNG.new(os.time()) :: Random
	rng = fresh
	return fresh
end

-- Cached view of the map's spawn points. Never yields; MapBuilder returns an
-- True when a zone is reachable given which doors are open.
local function zoneReachable(zone: number): boolean
	if zone <= 1 then
		return true
	end
	local ok, maxZone = pcall(function()
		local systems = script.Parent
		local mod = systems:FindFirstChild("Doors")
		if not mod then
			return 99
		end
		local doors = require(mod)
		if type(doors.MaxReachableZone) ~= "function" then
			return 99
		end
		local fn: any = doors.MaxReachableZone
		local g: any = fn
		return g(doors)
	end)
	if not ok then
		return true
	end
	return zone <= (tonumber(maxZone) or 1)
end

-- Spawn points restricted to zones the players can actually reach. Without
-- this, zombies would spawn behind closed doors and never reach anyone.
local function spawnPoints(): { any }
	-- Touch the cache so it stays referenced by ClearAll.
	if #spawnPointsCache > 0 then
		table.clear(spawnPointsCache)
	end
	local got: any = MapBuilder.GetSpawnPoints()
	local out: { any } = {}
	if typeof(got) == "table" then
		for _, v in ipairs(got :: any) do
			local zone: number = 1
			pcall(function()
				local a: any = v
				zone = tonumber(a:GetAttribute("Zone")) or 1
			end)
			if zoneReachable(zone) then
				out[#out + 1] = v
			end
		end
	end
	-- Fall back to every point if filtering left us with none.
	if #out == 0 then
		if typeof(got) == "table" then
			for _, v in ipairs(got :: any) do
				out[#out + 1] = v
			end
		end
	end
	return out
end

local function archetypeTable(): { [string]: Archetype }
	return Config.Zombies :: { [string]: Archetype }
end

local function waveSettings(): WaveSettings
	return Config.Wave :: WaveSettings
end

local function toNumber(v: any, fallback: number): number
	if typeof(v) == "number" then
		return v :: number
	end
	local n = tonumber(v)
	if n then
		return n
	end
	return fallback
end

local ZOMBIE_IDS = { "Walker", "Runner", "Brute", "Spitter", "Boss" }

function ZombieAI.ArchetypeIds(): { string }
	local out: { string } = {}
	for _, id in ipairs(ZOMBIE_IDS) do
		out[#out + 1] = id
	end
	return out
end

-- Resolves an archetype, tolerating nil/unknown ids by falling back to Walker.
local function archetypeOf(id: string?): Archetype
	local tbl = archetypeTable()
	if id ~= nil then
		local key: any = id
		local found: Archetype? = tbl[key]
		if found then
			return found
		end
	end
	return tbl.Walker
end

function ZombieAI.GetArchetype(id: string): Archetype?
	local tbl = archetypeTable()
	local key: any = id
	return tbl[key]
end

----------------------------------------------------------------------
-- Model construction
----------------------------------------------------------------------

-- Builds a rig from scratch so the place has zero external asset dependencies.
local function buildModel(arch: Archetype): any
	local model = Instance.new("Model")
	model.Name = arch.DisplayName

	local s: number = arch.Scale
	if s <= 0 then
		s = 1
	end

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2 * s, 2 * s, 1 * s)
	root.Transparency = 1
	root.CanCollide = false
	root.Anchored = false
	root.Parent = model

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2 * s, 2 * s, 1 * s)
	torso.Color = arch.BodyColor
	torso.Material = Enum.Material.SmoothPlastic
	torso.Parent = model
	local torsoWeld = Instance.new("WeldConstraint")
	torsoWeld.Part0 = root
	torsoWeld.Part1 = torso
	torsoWeld.Parent = root

	-- Limbs so walk cycles read visually. Welded, animated procedurally.
	local limbDefs = {
		{ Name = "LeftArm", Size = Vector3.new(0.6 * s, 1.8 * s, 0.6 * s), Offset = Vector3.new(-1.4 * s, 0.2 * s, 0) },
		{ Name = "RightArm", Size = Vector3.new(0.6 * s, 1.8 * s, 0.6 * s), Offset = Vector3.new(1.4 * s, 0.2 * s, 0) },
		{ Name = "LeftLeg", Size = Vector3.new(0.7 * s, 1.8 * s, 0.7 * s), Offset = Vector3.new(-0.55 * s, -1.9 * s, 0) },
		{ Name = "RightLeg", Size = Vector3.new(0.7 * s, 1.8 * s, 0.7 * s), Offset = Vector3.new(0.55 * s, -1.9 * s, 0) },
	}
	for _, d in ipairs(limbDefs) do
		local limb = Instance.new("Part")
		limb.Name = d.Name
		limb.Size = d.Size
		limb.Color = arch.BodyColor
		limb.Material = Enum.Material.SmoothPlastic
		limb.CanCollide = false
		limb.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = limb
		w.Parent = root
		limb:SetAttribute("BaseOffsetX", d.Offset.X)
		limb:SetAttribute("BaseOffsetY", d.Offset.Y)
		limb:SetAttribute("BaseOffsetZ", d.Offset.Z)
	end

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2 * s, 1.2 * s, 1.2 * s)
	head.Color = arch.BodyColor
	head.Material = Enum.Material.SmoothPlastic
	head.Parent = model
	local headWeld = Instance.new("WeldConstraint")
	headWeld.Part0 = root
	headWeld.Part1 = head
	headWeld.Parent = root

	local humanoid = Instance.new("Humanoid")
	humanoid.Name = "ZombieHumanoid"
	humanoid.MaxHealth = arch.Health
	humanoid.Health = arch.Health
	humanoid.WalkSpeed = arch.WalkSpeed
	humanoid.Parent = model

	pcall(function()
		local animator = Instance.new("Animator")
		animator.Name = "ZombieAnimator"
		animator.Parent = humanoid
	end)

	model.PrimaryPart = root
	return model
end

----------------------------------------------------------------------
-- Targeting / players
----------------------------------------------------------------------

local function playersList(): { any }
	if not Players then
		return {}
	end
	local list: any = Players:GetPlayers()
	if typeof(list) ~= "table" then
		return {}
	end
	return list :: { any }
end

-- Nearest alive player humanoid root part; nil when nobody is targetable.
local function nearestTarget(brain: Brain): any?
	local bestRoot: any = nil
	local bestHumanoid: any = nil
	local bestDist = math.huge

	local rootPos: any = brain.Root.Position
	for _, player in ipairs(playersList()) do
		local char: any = player.Character
		if char then
			local hum: any = char:FindFirstChildOfClass("Humanoid")
			local rp: any = char:FindFirstChild("HumanoidRootPart")
			-- Skip downed players so teammates can actually revive them.
			local isDowned: boolean = false
			pcall(function()
				isDowned = player:GetAttribute("Downed") == true
			end)

			if hum and rp and hum.Health > 0 and not isDowned then
				local p: any = rp.Position
				local dx: number = p.X - rootPos.X
				local dy: number = p.Y - rootPos.Y
				local dz: number = p.Z - rootPos.Z
				local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
				if dist < bestDist then
					bestDist = dist
					bestRoot = rp
					bestHumanoid = hum
				end
			end
		end
	end

	if bestHumanoid then
		brain.Target = bestHumanoid
	end
	return bestRoot
end

----------------------------------------------------------------------
-- Combat
----------------------------------------------------------------------

local function damageHumanoid(humanoid: any, amount: number)
	pcall(function()
		humanoid:TakeDamage(amount)
	end)
end

-- Spitter: a fast unanchored projectile part. Damage is applied on touch
-- server-side; the visual is the part itself so no assets are needed.
local function fireSpitter(brain: Brain, humanoid: any, targetPos: any)
	pcall(function()
		local rootPos: any = brain.Root.Position
		local dx: number = targetPos.X - rootPos.X
		local dy: number = targetPos.Y - rootPos.Y
		local dz: number = targetPos.Z - rootPos.Z
		local mag = math.sqrt(dx * dx + dy * dy + dz * dz)
		if mag <= 0.001 then
			return
		end
		local speed = 70
		local vel: any = Vector3.new(dx / mag * speed, dy / mag * speed + 8, dz / mag * speed)

		local proj = Instance.new("Part")
		proj.Name = "SpitterProjectile"
		proj.Shape = Enum.PartType.Ball
		proj.Size = Vector3.new(1.1, 1.1, 1.1)
		proj.Material = Enum.Material.Neon
		proj.Color = Color3.fromRGB(150, 220, 70)
		proj.CanCollide = false
		proj.Anchored = false
		proj.CastShadow = false
		proj.CFrame = CFrame.new(rootPos + Vector3.new(0, 1.5, 0))
		proj.AssemblyLinearVelocity = vel
		proj:SetAttribute("Damage", brain.Damage)
		proj:SetAttribute("OwnerId", brain.ZombieId)
		proj.Parent = workspace

		local hit = false
		local conn: any = nil
		conn = proj.Touched:Connect(function(other: any)
			if hit then
				return
			end
			local model: any = other.Parent
			if not model then
				return
			end
			local hum: any = model:FindFirstChildOfClass("Humanoid")
			if not hum then
				return
			end
			local cs: any = CollectionService
			if cs and cs:HasTag(model, TAG) then
				return -- never damage other zombies
			end
			hit = true
			damageHumanoid(hum, brain.Damage)
			if conn then
				conn:Disconnect()
				conn = nil
			end
			proj:Destroy()
		end)

		task.delay(4, function()
			if conn then
				conn:Disconnect()
				conn = nil
			end
			pcall(function()
				if proj.Parent then
					proj:Destroy()
				end
			end)
		end)
	end)
end

local function tryAttack(brain: Brain, now: number)
	if now - brain.LastAttack < brain.AttackCooldown then
		return
	end
	local targetRoot = nearestTarget(brain)
	if not targetRoot then
		return
	end

	local rootPos: any = brain.Root.Position
	local tp: any = targetRoot.Position
	local dx: number = tp.X - rootPos.X
	local dy: number = tp.Y - rootPos.Y
	local dz: number = tp.Z - rootPos.Z
	local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
	if dist > brain.AttackRange then
		return
	end

	brain.LastAttack = now
	pcall(function()
		brain.Model:SetAttribute("LastAttack", now)
	end)

	if brain.Archetype.Id == "Spitter" then
		fireSpitter(brain, brain.Target, tp)
		return
	end

	local humanoid: any = brain.Target
	if humanoid then
		damageHumanoid(humanoid, brain.Damage)
		pcall(function()
			Remotes.ZombieDamagedPlayer():FireAllClients(tostring(brain.Archetype.Id), brain.Damage)
		end)
	end
end

----------------------------------------------------------------------
-- Pathing
----------------------------------------------------------------------

local REPATH_INTERVAL = 0.6
local WAYPOINT_DISTANCE = 4

-- How often a brain may retry pathfinding after a failure. A permanent
-- PathFailed flag meant one bad ComputeAsync silenced navigation for the rest
-- of that zombie's life; with dozens of rigid-part zombies spawning on cover
-- this silently produced a field of statues. Allow periodic retries instead.
local FAIL_RETRY_INTERVAL = 2.0

-- Lunge tuning: within LUNGE_RANGE studs a zombie gains up to LUNGE_BONUS of
-- extra move speed, ramping linearly as it gets closer.
local LUNGE_RANGE = 22
local LUNGE_BONUS = 0.45

-- Recomputes the chase path. On any failure we set PathFailed so the brain
-- falls back to direct MoveTo for the rest of its life (perf: no repeated
-- doomed ComputeAsync calls every tick).
local function computePath(brain: Brain, goal: any)
	if brain.PathFailed or not PathfindingService then
		return
	end
	local path: any = nil
	local ok = pcall(function()
		path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = false,
			AgentCanClimb = false,
			WaypointSpacing = WAYPOINT_DISTANCE,
		})
	end)
	if not ok or not path then
		brain.PathFailed = true
		return
	end

	local computed = false
	pcall(function()
		local startPos: any = brain.Root.Position
		path:ComputeAsync(startPos, goal)
		computed = true
	end)
	if not computed then
		brain.PathFailed = true
		return
	end

	local status: any = nil
	pcall(function()
		status = path.Status
	end)
	if status ~= nil then
		local s: any = status
		if s ~= Enum.PathStatus.Success then
			-- Partial/blocked: fall back to MoveTo this tick and retry later.
			brain.Waypoints = {}
			brain.NextWaypointIndex = 1
			return
		end
	end

	local wps: any = nil
	pcall(function()
		wps = path:GetWaypoints()
	end)
	if typeof(wps) ~= "table" then
		brain.Waypoints = {}
		brain.NextWaypointIndex = 1
		return
	end

	local list: { any } = {}
	local src: any = wps
	for _, w in ipairs(src) do
		list[#list + 1] = w
	end
	brain.Waypoints = list
	brain.NextWaypointIndex = 2 -- waypoint 1 is the start position
end

local function moveDirect(brain: Brain, goal: any)
	pcall(function()
		brain.Humanoid:MoveTo(goal)
	end)
end

local function chaseStep(brain: Brain, goal: any, now: number)
	-- Recover from a previously failed path: the obstruction may have cleared
	-- (explosive barrel gone, another zombie moved) so retry occasionally.
	if brain.PathFailed and now >= (brain.NextRepathAt or 0) then
		brain.PathFailed = false
		brain.NextRepathAt = 0
	end

	if now >= brain.NextRepathAt then
		brain.NextRepathAt = now + REPATH_INTERVAL
		computePath(brain, goal)
	end

	-- If navigation just failed again, back off before retrying rather than
	-- hammering ComputeAsync every frame, and fall through to direct MoveTo.
	if brain.PathFailed then
		brain.NextRepathAt = now + FAIL_RETRY_INTERVAL
	end

	local wps = brain.Waypoints
	if not brain.PathFailed and #wps > 0 and brain.NextWaypointIndex <= #wps then
		local wp: any = wps[brain.NextWaypointIndex]
		local pos: any = wp.Position
		local rp: any = brain.Root.Position
		local dx: number = pos.X - rp.X
		local dy: number = pos.Y - rp.Y
		local dz: number = pos.Z - rp.Z
		if math.sqrt(dx * dx + dy * dy + dz * dz) < 3.0 then
			brain.NextWaypointIndex += 1
		end
		local nxt: any = wps[math.min(brain.NextWaypointIndex, #wps)]
		moveDirect(brain, nxt.Position)
		return
	end

	moveDirect(brain, goal)
end

----------------------------------------------------------------------
-- Brain lifecycle
----------------------------------------------------------------------

local function untrack(model: any)
	brains[model] = nil
	for i = #order, 1, -1 do
		if order[i] == model then
			table.remove(order, i)
		end
	end
end

-- Procedural walk/attack animation. No external animation assets are needed:
-- limbs are welded parts whose offsets we oscillate, giving a visible gait.
local function animate(brain: Brain, now: number, moving: boolean, attacking: boolean)
	local model: any = brain.Model
	if not model then
		return
	end
	local root: any = brain.Root
	if not root then
		return
	end

	local speed: number = if moving then 9 else 3
	local phase: number = now * speed
	local swing: number = if attacking then 1.5 else 1.0

	for _, obj in ipairs(model:GetChildren()) do
		local part: any = obj
		if part:IsA("Part") then
			local bx = part:GetAttribute("BaseOffsetX")
			local by = part:GetAttribute("BaseOffsetY")
			local bz = part:GetAttribute("BaseOffsetZ")
			if bx ~= nil then
				local name: string = part.Name
				local isLeft = string.sub(name, 1, 4) == "Left"
				local dir: number = if isLeft then 1 else -1
				local isArm = string.find(name, "Arm") ~= nil

				local offY: number = 0
				local offZ: number = 0
				if attacking and isArm then
					-- Arms swing down/forward during an attack.
					offY = -1.0 * swing
					offZ = 0.9 * swing
				elseif moving then
					if isArm then
						offZ = math.sin(phase) * 0.55 * dir * swing
					else
						offZ = math.sin(phase) * 0.75 * dir
					end
				else
					-- Idle sway so zombies never look frozen.
					offY = math.sin(phase * 0.5) * 0.08
				end

				local target = Vector3.new(
					tonumber(bx) or 0,
					(tonumber(by) or 0) + offY,
					(tonumber(bz) or 0) + offZ
				)
				part.Position = root.Position + target
			end
		end
	end
end

local function brainLoop(brain: Brain)
	while brain.Alive do
		local stepped = RunService.Heartbeat:Wait()
		if not brain.Alive then
			break
		end

		local now: number = toNumber(stepped, os.clock())
		-- Lunge: zombies accelerate as they close on a target. This is what
		-- turns "walk away and shoot" into real pressure — disengaging must
		-- cost you, which is the core of the zombie-survival feel.
		pcall(function()
			local targetRoot = brain.Target
			if not targetRoot or not brain.Root then
				return
			end
			local rp: any = brain.Root.Position
			local tp: any = targetRoot.Position
			local dx: number = tp.X - rp.X
			local dy: number = tp.Y - rp.Y
			local dz: number = tp.Z - rp.Z
			local dist = math.sqrt(dx * dx + dy * dy + dz * dz)
			if dist < LUNGE_RANGE then
				local t: number = 1 - (dist / LUNGE_RANGE)
				brain.Humanoid.WalkSpeed = brain.WalkSpeed * (1 + LUNGE_BONUS * t)
			else
				brain.Humanoid.WalkSpeed = brain.WalkSpeed
			end
		end)

		local goal = nearestTarget(brain)
		if goal then
			chaseStep(brain, goal.Position, now)
			tryAttack(brain, now)
			-- Treat "just attacked" (cooldown freshly started) as mid-swing.
			local swinging: boolean = (now - brain.LastAttack) < 0.35
			animate(brain, now, true, swinging)
		else
			-- Nobody alive: drift toward the centre so zombies stay findable.
			chaseStep(brain, MapBuilder.GetCenterSpawn(), now)
			animate(brain, now, true, false)
		end
	end
end

local function detach(model: any)
	pcall(function()
		local cs: any = CollectionService
		if cs and cs:HasTag(model, TAG) then
			cs:RemoveTag(model, TAG)
		end
	end)
	pcall(function()
		-- Freeze immediately so a corpse cannot keep pushing players.
		local hum: any = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.PlatformStand = true
		end
	end)
	pcall(function()
		local d: any = Debris
		if d then
			d:AddItem(model, 3)
		else
			task.delay(3, function()
				if model.Parent then
					model:Destroy()
				end
			end)
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Spawns one zombie of `archetypeId` scaled for `waveNumber`.
-- Returns the Model (already parented to Workspace) or nil on failure.
function ZombieAI.Spawn(archetypeId: string, waveNumber: number): any
	if not ensureServices() then
		return nil
	end

	local waveNo: number = waveNumber
	if waveNo < 1 then
		waveNo = 1
	end

	local arch = archetypeOf(archetypeId)
	local w = waveSettings()

	-- Scaling curves shared with WaveDirector so a hand-spawned zombie and a
	-- wave-spawned one of the same wave are identical.
	local hpScale: number = math.pow(w.HPScalePerWave, waveNo - 1)
	local speedScale: number = math.min(math.pow(w.SpeedScalePerWave, waveNo - 1), w.MaxSpeedScale)
	local dmgScale: number = math.pow(w.DamageScalePerWave, waveNo - 1)

	-- Special-wave modifiers (applied by WaveDirector via attributes). Because
	-- they are set right after Spawn returns, they are read here for the NEXT
	-- spawn; we also honour any already-present attribute on this model.
	local hpMult: number = 1
	local spMult: number = 1
	pcall(function()
		local w2: any = Config.Wave
		local v: any = w2
		if waveNo % (tonumber(v.SpecialWaveEvery) or 0) == 0 then
			-- Theme chosen by WaveDirector; approximate by wave parity so both
			-- sides agree deterministically without extra state.
			local kinds: { string } = { "RunnerWave", "SwarmWave", "BruteWave" }
			local idx = ((waveNo / (tonumber(v.SpecialWaveEvery) or 1)) % 3)
			local kind = kinds[math.floor(idx) + 1]
			if kind == "SwarmWave" then
				hpMult = tonumber(v.SwarmHealthMult) or 1
			elseif kind == "BruteWave" then
				hpMult = tonumber(v.BruteHealthMult) or 1
			elseif kind == "RunnerWave" then
				spMult = tonumber(v.RunnerSpeedMult) or 1
			end
		end
	end)

	local maxHealth: number = math.max(1, math.floor(arch.Health * hpScale * hpMult + 0.5))
	local speed: number = arch.WalkSpeed * speedScale * spMult
	local damage: number = arch.Damage * dmgScale

	nextZombieId += 1

	local model: any = nil
	local ok = pcall(function()
		model = buildModel(arch)
		local hum: any = model:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.MaxHealth = maxHealth
			hum.Health = maxHealth
			hum.WalkSpeed = speed
		end

		model:SetAttribute("ZombieId", nextZombieId)
		model:SetAttribute("Archetype", arch.Id)
		model:SetAttribute("DisplayName", arch.DisplayName)
		model:SetAttribute("Health", maxHealth)
		model:SetAttribute("MaxHealth", maxHealth)
		model:SetAttribute("Wave", waveNo)
		model:SetAttribute("Damage", damage)
		model:SetAttribute("LastAttack", 0)
		model:SetAttribute("RewardCoins", arch.CoinReward)
		model:SetAttribute("RewardXP", arch.XPReward)
		model:SetAttribute("IsBoss", arch.IsBoss == true)

		local points = spawnPoints()
		local ws: any = workspace
		if #points > 0 then
			local pick = getRandom():Int(1, #points)
			local sp: any = points[pick]
			local jitter = 6
			local r1: number = getRandom():Range(-jitter, jitter)
			local r2: number = getRandom():Range(-jitter, jitter)
			local base: any = sp.Position
			model:PivotTo(CFrame.new(base.X + r1, base.Y + 3, base.Z + r2))
		else
			model:PivotTo(CFrame.new(MapBuilder.GetCenterSpawn() + Vector3.new(0, 8, 0)))
		end
		model.Parent = ws
		CollectionService:AddTag(model, TAG)
	end)
	if not ok or not model then
		if model then
			pcall(function()
				model:Destroy()
			end)
		end
		return nil
	end

	local humanoid: any = model:FindFirstChildOfClass("Humanoid")
	local root: any = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		pcall(function()
			model:Destroy()
		end)
		return nil
	end

	local brain: Brain = {
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Archetype = arch,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Damage = damage,
		WalkSpeed = speed,
		AttackRange = arch.AttackRange,
		AttackCooldown = arch.AttackCooldown,
		LastAttack = 0,
		Wave = waveNo,
		ZombieId = nextZombieId,
		Alive = true,
		Target = nil,
		NextRepathAt = 0,
		NextWaypointIndex = 2,
		Waypoints = {},
		PathFailed = false,
		Thread = nil,
	}

	brains[model] = brain
	order[#order + 1] = model

	brain.Thread = task.spawn(brainLoop, brain)
	return model
end

-- Applies damage to a zombie model. Returns true only when this hit killed it.
-- Never errors: Weapons calls this from player input, so it must be total.
function ZombieAI.Damage(zombieModel: any, amount: number, headshot: boolean?): boolean
	if not zombieModel then
		return false
	end
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return false
	end

	local dmg: number = amount
	if dmg <= 0 then
		return false
	end

	brain.Health -= dmg
	if brain.Health < 0 then
		brain.Health = 0
	end
	brain.MaxHealth = brain.MaxHealth

	pcall(function()
		zombieModel:SetAttribute("Health", brain.Health)
		local hum: any = brain.Humanoid
		if hum then
			hum.Health = brain.Health
		end
	end)

	-- Hit feedback: Weapons.luau owns the DamageDealt remote (it fires a
	-- well-formed payload to the shooter). This module previously broadcast
	-- positional arguments (ZombieId, dmg, ...) that the client's table-based
	-- handler could not parse and that duplicated the shooter's hitmarker.

	if brain.Health <= 0 then
		if brain.Alive then
			brain.Alive = false
			detach(zombieModel)
			untrack(zombieModel)
		end
		return true
	end

	return false
end

-- Immediate removal, used when a run ends or the map is rebuilt.
function ZombieAI.Despawn(zombieModel: any)
	local brain: Brain? = brains[zombieModel]
	if brain then
		brain.Alive = false
	end
	untrack(zombieModel)
	pcall(function()
		zombieModel:Destroy()
	end)
end

function ZombieAI.IsZombie(instance: any): boolean
	if not instance then
		return false
	end
	local b: Brain? = brains[instance]
	return b ~= nil
end

function ZombieAI.GetHealth(zombieModel: any): number
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return 0
	end
	return brain.Health
end

function ZombieAI.GetMaxHealth(zombieModel: any): number
	local brain: Brain? = brains[zombieModel]
	if not brain then
		return 0
	end
	return brain.MaxHealth
end

function ZombieAI.AliveCount(): number
	local n = 0
	for _ in pairs(brains) do
		n += 1
	end
	return n
end

function ZombieAI.GetAlive(): { any }
	local out: { any } = {}
	for _, model in ipairs(order) do
		out[#out + 1] = model
	end
	return out
end

-- Drops every zombie immediately. Called on run end / map rebuild.
function ZombieAI.ClearAll()
	for model in pairs(brains) do
		local brain: Brain = brains[model]
		brain.Alive = false
		pcall(function()
			local hum: any = brain.Humanoid
			if hum then
				hum.Health = 0
			end
		end)
	end
	for i = #order, 1, -1 do
		local m = order[i]
		order[i] = nil
		pcall(function()
			m:Destroy()
		end)
	end
	local n = 0
	for k in pairs(brains) do
		brains[k] = nil
		n += 1
	end
	spawnPointsCache = {}
	return n
end

-- Weighted archetype roll honouring UnlockWave. `waveNumber` gates which
-- archetypes may appear; entries with weight <= 0 are skipped entirely, which
-- is exactly how Boss (Weight = 0) is excluded from normal rolls.
function ZombieAI.RollArchetype(waveNumber: number, randSource: Random?): string
	local r: Random = randSource or getRandom()
	local entries: { { weight: number, value: any } } = {}
	local tbl = archetypeTable()

	for _, id in ipairs(ZOMBIE_IDS) do
		local key: any = id
		local arch: Archetype? = tbl[key]
		if arch then
			local weight: number = arch.Weight
			local unlock: number = arch.UnlockWave
			if weight > 0 and unlock <= waveNumber then
				entries[#entries + 1] = { weight = weight, value = id }
			end
		end
	end

	if #entries == 0 then
		return "Walker"
	end

	local picked: any = r:Weighted(entries)
	if typeof(picked) == "string" then
		return picked :: string
	end
	return "Walker"
end

function ZombieAI.SetRandom(seed: number)
	rng = RNG.new(seed) :: Random
end

-- Number of concurrent zombies this module is willing to host.
function ZombieAI.MaxConcurrent(): number
	return waveSettings().MaxConcurrentZombies
end

return ZombieAI
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="22">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="23">
      <Properties>
        <string name="Name">GameServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server entry point. Boots the map, then starts every gameplay system.
--
-- Design note: each system is required defensively. If a subsystem is missing
-- or errors during Init, the rest of the game still comes up and the failure is
-- logged. That matters because this project is built and verified without
-- Studio, so a single bad module must never take the whole experience down.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Systems = ReplicatedStorage:WaitForChild("Systems", 10)

local started: { [string]: boolean } = {}

local function trace(msg: string)
	print("[ZombieUprising] " .. msg)
end

local function tryRequire(name: string): any?
	if not Systems then
		warn("[ZombieUprising] no Systems folder; cannot load " .. name)
		return nil
	end
	local inst = Systems:FindFirstChild(name)
	if not inst then
		warn("[ZombieUprising] system missing: " .. name)
		return nil
	end
	local ok, mod = pcall(function()
		return require(inst)
	end)
	if not ok or not mod then
		warn("[ZombieUprising] failed to require " .. name .. ": " .. tostring(mod))
		return nil
	end
	return mod
end

local function startSystem(name: string, ...: any)
	local mod = tryRequire(name)
	if not mod then
		return nil
	end
	if started[name] then
		return mod
	end
	if type(mod.Init) == "function" then
		local init: any = mod.Init
		local args: any = { ... }
		local ok, err = pcall(function()
			init(table.unpack(args))
		end)
		if not ok then
			warn("[ZombieUprising] " .. name .. ".Init failed: " .. tostring(err))
			return nil
		end
	end
	started[name] = true
	trace("started system: " .. name)
	return mod
end

-- 1. Networking must exist before anything else talks to clients.
Remotes.InitServer()
trace("remotes initialised")

-- 2. Build the procedural arena (no external assets required).
local mapBuilderMod: any = tryRequire("MapBuilder")
if mapBuilderMod and type(mapBuilderMod.Build) == "function" then
	local _mb_build: any = mapBuilderMod.Build
	local ok, err = pcall(function()
		_mb_build()
	end)
	if ok then
		trace("map built")
	else
		warn("[ZombieUprising] MapBuilder.Build failed: " .. tostring(err))
	end
else
	warn("[ZombieUprising] MapBuilder unavailable — arena not generated")
end

-- 3. Gameplay systems.
local waveDirector: any = startSystem("WaveDirector")
local zombieAI: any = startSystem("ZombieAI")
local economy: any = startSystem("Economy")
local progression: any = startSystem("Progression")
local weapons: any = startSystem("Weapons")
local _doorsSystem: any = startSystem("Doors")
local machinesSystem: any = startSystem("Machines")
local _downedSystem: any = startSystem("Downed")
local _badgesSystem: any = startSystem("Badges")
local _musicSystem: any = startSystem("Music")

-- Machines are physical objects, so place them once the map exists.
do
	local _ms: any = machinesSystem
	if _ms and type(_ms.Build) == "function" then
		pcall(function()
			local _mb: any = _ms.Build
			local g: any = _mb
			g()
			trace("machines placed")
		end)
	end
end
local _chatSystem: any = startSystem("Chat")

-- Cross-system wiring: weapons need to damage zombies.
if weapons and zombieAI then
	local _w1: any = weapons.SetZombieAI
	if type(_w1) == "function" then
		pcall(function()
			local g: any = _w1
			g(zombieAI)
		end)
	end
	local _w2: any = weapons.SetEconomy
	if type(_w2) == "function" then
		pcall(function()
			local g: any = _w2
			g(economy)
		end)
	end
end

-- Wave director needs to spawn through the AI and pay through economy.
if waveDirector and zombieAI then
	local _w3: any = waveDirector.SetZombieAI
	if type(_w3) == "function" then
		pcall(function()
			local g: any = _w3
			g(zombieAI)
		end)
	end
end
if waveDirector and economy then
	local _w4: any = waveDirector.SetEconomy
	if type(_w4) == "function" then
		pcall(function()
			local g: any = _w4
			g(economy)
		end)
	end
end

----------------------------------------------------------------------
-- Player lifecycle
----------------------------------------------------------------------
local function setupLeaderstats(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"

	local wave = Instance.new("IntValue")
	wave.Name = "Wave"
	wave.Value = 0
	wave.Parent = folder

	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = Config.Economy and 0 or 0
	coins.Parent = folder

	folder.Parent = player
end

-- Per-player connections, released on removal so long-lived servers do not
-- accumulate listeners (see AUDIT P1-1).
local playerConnections: { [Player]: { any } } = {}

local function cleanupPlayer(player: Player)
	local conns = playerConnections[player]
	if conns then
		for _, c in ipairs(conns) do
			pcall(function()
				c:Disconnect()
			end)
		end
		playerConnections[player] = nil
	end
end

local function onPlayerAdded(player: Player)
	setupLeaderstats(player)
	cleanupPlayer(player)
	playerConnections[player] = {}

	local charConn: any = player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		local h: any = humanoid
		-- MaxHealth comes from Config; perks raise it via Progression.
		h.MaxHealth = Config.Player.BaseMaxHealth
		h.Health = h.MaxHealth
		h.WalkSpeed = Config.Player.BaseWalkSpeed

		local hrp = character:WaitForChild("HumanoidRootPart", 10)
		if hrp then
			-- Place the player at the zone-1 spawn pad. This must never be the
			-- geometric arena centre: interior boundary walls run through it.
			local spawnPos: Vector3 = Vector3.new(0, 6, -Config.Map.ArenaSize / 2 + Config.Map.ZoneWidth / 2)
			pcall(function()
				if type(mapBuilderMod.GetPlayerSpawn) == "function" then
					local fn: any = mapBuilderMod.GetPlayerSpawn
					spawnPos = fn(mapBuilderMod)
				end
			end)
			;(hrp :: any).CFrame = CFrame.new(spawnPos + Vector3.new(0, 5, 0))
		end
	end)

	-- Track it so it is released when the player leaves.
	local bucket = playerConnections[player]
	if bucket then
		bucket[#bucket + 1] = charConn
	end

	local _economy_j: any = economy
	if _economy_j and type(_economy_j.PlayerJoined) == "function" then
		local _pj: any = _economy_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
	local _progression_j: any = progression
	if _progression_j and type(_progression_j.PlayerJoined) == "function" then
		local _pj: any = _progression_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
	local _weapons_j: any = weapons
	if _weapons_j and type(_weapons_j.PlayerJoined) == "function" then
		local _pj: any = _weapons_j.PlayerJoined
		pcall(function()
			_pj(player)
		end)
	end
end

local function onPlayerRemoving(player: Player)
	cleanupPlayer(player)
	local _economy_l: any = economy
	if _economy_l and type(_economy_l.PlayerLeft) == "function" then
		local _pl: any = _economy_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
	local _progression_l: any = progression
	if _progression_l and type(_progression_l.PlayerLeft) == "function" then
		local _pl: any = _progression_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
	local _weapons_l: any = weapons
	if _weapons_l and type(_weapons_l.PlayerLeft) == "function" then
		local _pl: any = _weapons_l.PlayerLeft
		pcall(function()
			_pl(player)
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Players who joined before this script connected.
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

----------------------------------------------------------------------
-- Graceful shutdown: persist progress before the server closes.
----------------------------------------------------------------------
game:BindToClose(function()
	local _e_save: any = economy
	if _e_save and type(_e_save.SaveAll) == "function" then
		local _sv: any = _e_save.SaveAll
		pcall(function()
			_sv()
		end)
	end
	task.wait(1)
end)

-- Enable chat commands (!wave, !perks, !help) once systems are up.
do
	local _ci: any = _chatSystem
	if _ci and type(_ci.Init) == "function" then
		local _ciInit: any = _ci.Init
		pcall(function()
			local g: any = _ciInit
			g()
		end)
	end
end

trace(string.format("%s v%s boot complete", Config.GameName, Config.Version))
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="24">
    <Properties>
      <string name="Name">StarterGui</string>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="27">
        <Properties>
          <string name="Name">ClientController</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- client controller.
--
-- Owns all local player input and translates it into server requests, while
-- giving the shooter its "prediction feel": an instant crosshair kick, muzzle
-- flash and hitmarker that the server later confirms via DamageDealt.
--
-- Everything is defensive. The server may boot after (or independently of) this
-- script, so every remote is resolved through pcall'd WaitForChild and every
-- listener body is wrapped in pcall. A missing remote degrades to a silent
-- no-op -- the client must never error.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")

-- Cross-module requires are filtered analyzer noise (Unknown require).
local Config = require(Shared:WaitForChild("Config"))
local _Types = require(Shared:WaitForChild("Types"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local HUD = require(script.Parent:WaitForChild("HUD"))
local ShopUI = require(script.Parent:WaitForChild("ShopUI"))
local Interact = require(script.Parent:WaitForChild("Interact"))
local Instructions = require(script.Parent:WaitForChild("Instructions"))
local Music = require(ReplicatedStorage:WaitForChild("Systems"):WaitForChild("Music"))

-- Structural mirrors. luau-analyze cannot resolve exported types across
-- `require`, so each shape is redeclared locally (kept in sync with the shared
-- modules). Lint-time aliases only; runtime values are real.
type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

type RunEndedPayload = {
	Reason: string?,
	Wave: number?,
	Kills: number?,
	Coins: number?,
	CanRespawn: boolean?,
}

local REMOTE_TIMEOUT: number = 6

-------------------------------------------------------------------------------
-- Local state
-------------------------------------------------------------------------------

local localPlayer: any = Players.LocalPlayer

local started: boolean = false
local connections: { any } = {}
local boundActions: { string } = {}

local fireRemote: any = nil
local reloadRemote: any = nil
local respawnRemote: any = nil
local switchRemote: any = nil
local _shopToggleRemote: any = nil

local weaponState: WeaponState? = nil
local statsState: PlayerStats? = nil
local _waveState: WaveState? = nil

local firing: boolean = false
local sprinting: boolean = false
local dead: boolean = false

local nextShotAt: number = 0
local _lastFireSentAt: number = 0

local camera: any = nil

-- Sprint handling -----------------------------------------------------------
local baseWalkSpeed: number = 16
local sprintSpeed: number = 26

-------------------------------------------------------------------------------
-- Remote plumbing (all failures are swallowed on purpose)
-------------------------------------------------------------------------------

local function resolveRemote(name: string): any
	-- Prefer the lazily-created Remotes accessor; fall back to a direct
	-- timeout-guarded lookup so we still work if only the folder exists.
	local accessorFn: (() -> any)? = nil
	pcall(function()
		local accessor: any = (Remotes :: any)[name]
		if typeof(accessor) == "function" then
			accessorFn = accessor
		end
	end)

	local ok1: boolean = false
	local r1: any = nil
	if accessorFn then
		local fn: () -> any = accessorFn
		ok1, r1 = pcall(fn)
	end
	if ok1 and r1 then
		return r1
	end

	local ok2: boolean, r2: any = pcall(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", REMOTE_TIMEOUT)
		if not folder then return nil end
		return folder:WaitForChild(name, REMOTE_TIMEOUT)
	end)
	if ok2 then
		return r2
	end
	return nil
end

local function ensureRemotes()
	if fireRemote == nil then
		fireRemote = resolveRemote("RequestFire")
	end
	if reloadRemote == nil then
		reloadRemote = resolveRemote("RequestReload")
	end
	if respawnRemote == nil then
		respawnRemote = resolveRemote("RequestRespawn")
	end
	if switchRemote == nil then
		switchRemote = resolveRemote("RequestSwitchWeapon")
	end
end

-- Ordered weapon slots for the 1-4 hotkeys. Mirrors Config.Weapons' intent and
-- stays stable so muscle memory survives balance tweaks.
local WEAPON_SLOTS: { string } = { "Pistol", "SMG", "Shotgun", "Rifle" }

local function requestEquipSlot(slot: number)
	if dead then return end
	local weaponId = WEAPON_SLOTS[slot]
	if not weaponId then return end
	ensureRemotes()
	if switchRemote then
		pcall(function()
			switchRemote:FireServer(weaponId)
		end)
	end
end

local function safeConnect(remote: any, handler: (...any) -> ()): any
	if not remote then return nil end
	local ok: boolean, conn: any = pcall(function()
		return remote.OnClientEvent:Connect(function(...: any)
			pcall(handler, ...)
		end)
	end)
	if ok then
		return conn
	end
	return nil
end

-------------------------------------------------------------------------------
-- Aim: build the shot payload from the camera look direction
-------------------------------------------------------------------------------

local function getCamera(): any
	if camera and camera.Parent then
		return camera
	end
	local ws: any = workspace
	camera = ws.CurrentCamera
	return camera
end

local function aimPointAndDirection(): (Vector3, Vector3)
	local cam: any = getCamera()
	if not cam then
		local fallbackDir: Vector3 = Vector3.new(0, 0, -1)
		return Vector3.new(0, 0, 0), fallbackDir
	end

	local origin: Vector3 = cam.CFrame.Position
	local dir: Vector3 = cam.CFrame.LookVector

	-- Raycast forward so the server receives a concrete aim point (the surface
	-- the player is actually looking at), which makes hitscan feel correct.
	local params: any = Instance.new("RaycastParams")
	params.FilterType = Enum.RaycastFilterType.Blacklist
	-- The camera sits behind the character in third person: without blacklisting
	-- our own body this ray stops on our own torso and the aim point jumps to
	-- the shooter's chest instead of what they are looking at.
	local excluded: { any } = {}
	pcall(function()
		local ch: any = localPlayer and localPlayer.Character
		if ch then
			excluded = { ch }
		end
	end)
	params.FilterDescendantsInstances = excluded
	params.IgnoreWater = true

	local maxRange: number = 500
	if weaponState then
		local defs: any = Config.Weapons
		local def: WeaponDef? = defs[weaponState.WeaponId]
		if def then
			local d: WeaponDef = def
			maxRange = d.Range + 50
		end
	end

	local target: Vector3 = origin + dir * maxRange
	local okRay: boolean, result: any = pcall(function()
		local rayResult: any = workspace:Raycast(origin, dir * maxRange, params)
		return rayResult
	end)
	if okRay and result then
		local rr: any = result
		local p: Vector3 = rr.Position
		return p, (p - origin)
	end

	return target, (target - origin)
end

local function currentWeaponDef(): WeaponDef?
	if not weaponState then return nil end
	local defs: any = Config.Weapons
	local def: WeaponDef? = defs[weaponState.WeaponId]
	return def
end

-------------------------------------------------------------------------------
-- Firing
-------------------------------------------------------------------------------

local function canFire(): boolean
	if dead then return false end
	if not weaponState then return false end
	if weaponState.Reloading then return false end
	if weaponState.AmmoInMag <= 0 then return false end
	return true
end

local function tryFire()
	if not canFire() then
		if weaponState and weaponState.AmmoInMag <= 0 then
			HUD.Notify("Out of ammo — press R", "warn")
		end
		return
	end

	local nowSec: number = os.clock()
	if nowSec < nextShotAt then return end

	local def: WeaponDef? = currentWeaponDef()
	local delaySec: number = 0.1
	if def then
		local d: WeaponDef = def
		delaySec = 1 / math.max(0.1, d.FireRate)
	end
	nextShotAt = nowSec + delaySec

	ensureRemotes()
	if not fireRemote then
		-- Server not ready yet; keep the local feel anyway.
		applyPredictedShot(def)
		return
	end

	local aimPoint: Vector3, aimDir: Vector3 = aimPointAndDirection()
	local ok: boolean = pcall(function()
		fireRemote:FireServer({
			AimPoint = aimPoint,
			Direction = aimDir,
			Origin = aimPoint - aimDir,
			CameraCFrame = getCamera() and getCamera().CFrame or CFrame.new(),
			WeaponId = weaponState and weaponState.WeaponId or "Pistol",
			SentAt = os.clock(),
		})
	end)
	if ok then
		_lastFireSentAt = os.clock()
		applyPredictedShot(def)
	end
end

-- Local-only feedback so the gun feels instant regardless of latency.
function applyPredictedShot(def: WeaponDef?)
	HUD.ShowMuzzleFlash()
	local spread: number = 0.35
	if def then
		local d: WeaponDef = def
		spread = math.clamp(d.SpreadDegrees / 12, 0.08, 1)
	end
	HUD.PulseCrosshair(spread)
end

local function requestReload()
	if dead then return end
	if not weaponState then return end
	if weaponState.Reloading then return end
	if weaponState.AmmoReserve <= 0 then return end
	ensureRemotes()
	if reloadRemote then
		pcall(function()
			reloadRemote:FireServer()
		end)
	end
end

local function requestRespawn()
	ensureRemotes()
	if respawnRemote then
		pcall(function()
			respawnRemote:FireServer()
		end)
	end
	dead = false
	HUD.SetGameOverVisible(false)
end

-------------------------------------------------------------------------------
-- Sprint
-------------------------------------------------------------------------------

local function applySprint(on: boolean)
	sprinting = on
	local character: any = localPlayer and localPlayer.Character
	if not character then return end
	local humanoid: any = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	pcall(function()
		if on then
			humanoid.WalkSpeed = sprintSpeed
		else
			humanoid.WalkSpeed = baseWalkSpeed
		end
	end)
end

local function onCharacterAdded(character: any)
	pcall(function()
		baseWalkSpeed = 16
		sprintSpeed = 26
		local cfgPlayer: any = Config.Player
		local bwRaw: any = cfgPlayer.BaseWalkSpeed
		local swRaw: any = cfgPlayer.SprintSpeed
		local bwNum: number? = tonumber(bwRaw)
		local swNum: number? = tonumber(swRaw)
		if bwNum ~= nil then
			local b: number = bwNum
			baseWalkSpeed = b
		end
		if swNum ~= nil then
			local sw: number = swNum
			sprintSpeed = sw
		end
	end)
	pcall(function()
		character:WaitForChild("Humanoid", 4)
	end)
	applySprint(sprinting)
end

-------------------------------------------------------------------------------
-- Server -> Client listeners
-------------------------------------------------------------------------------

local function onWeaponStateChanged(state: any?)
	if not state then return end
	local s: WeaponState = state
	weaponState = s
	pcall(function()
		HUD.SetAmmo(s)
	end)
end

local function onPlayerStatsChanged(stats: any?)
	if not stats then return end
	local s: PlayerStats = stats
	statsState = s
	pcall(function()
		HUD.SetStats(s)
	end)
	pcall(function()
		ShopUI.SetStats(s)
	end)
	if s.Health <= 0 then
		dead = true
	end
end

local function onWaveStateChanged(state: any?)
	if not state then return end
	local s: WaveState = state
	_waveState = s
	pcall(function()
		HUD.SetWave(s)
	end)
	pcall(function()
		ShopUI.SetShopState({
			Phase = s.Phase,
			Coins = statsState and statsState.Coins or 0,
		})
	end)
end

local function onDamageDealt(payload: any?)
	if not payload then return end
	local p: any = payload
	local killed: boolean = p.Killed == true

	pcall(function()
		HUD.ShowHitmarker(killed)
	end)

	local amount: number = 0
	pcall(function()
		amount = tonumber(p.Amount) or 0
	end)

	local worldPos: Vector3? = nil
	pcall(function()
		worldPos = p.Position
	end)

	pcall(function()
		if amount > 0 then
			HUD.ShowDamageNumber(amount, worldPos, killed)
		end
	end)

	if killed then
		pcall(function()
			HUD.Notify("Kill", "kill")
		end)
	end
end

local function onZombieDamagedPlayer(payload: any?)
	local intensity: number = 0.35
	if payload then
		local p: any = payload
		local dmg: number = tonumber(p.Amount) or tonumber(p.Damage) or 12
		intensity = math.clamp(dmg / 40, 0.2, 1)
	end
	pcall(function()
		HUD.FlashDamage(intensity)
	end)
end

local function onShopStateChanged(payload: any?)
	pcall(function()
		ShopUI.SetShopState(payload)
	end)
end

local function onNotify(payload: any?)
	-- Accepts either a plain string or { Text = ..., Kind = ... }.
	if not payload then return end
	local text: string = ""
	local kind: string? = nil
	if typeof(payload) == "string" then
		text = payload
	else
		pcall(function()
			local p: any = payload
			text = tostring(p.Text or p.Message or "")
			kind = p.Kind
		end)
	end
	if text == "" then return end
	pcall(function()
		HUD.Notify(text, kind)
	end)
end

local function onRunEnded(payload: any?)
	dead = true
	local data: RunEndedPayload = {}
	pcall(function()
		local p: any = payload
		if typeof(p) == "table" then
			data = p
		else
			data = { Reason = tostring(p) }
		end
	end)
	pcall(function()
		ShopUI.SetVisible(false)
	end)
	pcall(function()
		HUD.SetGameOverVisible(true, data)
	end)
end

-------------------------------------------------------------------------------
-- Input
-------------------------------------------------------------------------------

local FIRE_ACTION: string = "ZU_Fire"
local RELOAD_ACTION: string = "ZU_Reload"
local SPRINT_ACTION: string = "ZU_Sprint"

local function handleFireAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		local state: string = tostring(inputState)
		if inputState == Enum.UserInputState.Begin then
			firing = true
			tryFire()
		elseif inputState == Enum.UserInputState.End then
			firing = false
		end
		-- Silence unused param warnings on the string mirror.
		local _mirror: string = state
	end)
	return Enum.ContextActionResult.Pass
end

local function handleReloadAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		if inputState == Enum.UserInputState.Begin then
			requestReload()
		end
	end)
	return Enum.ContextActionResult.Pass
end

local function handleSprintAction(_actionName: string, inputState: any, _inputObject: any): any
	pcall(function()
		if inputState == Enum.UserInputState.Begin then
			applySprint(true)
		elseif inputState == Enum.UserInputState.End then
			applySprint(false)
		end
	end)
	return Enum.ContextActionResult.Pass
end

local function bindActions()
	pcall(function()
		ContextActionService:BindAction(FIRE_ACTION, handleFireAction, false,
			Enum.UserInputType.MouseButton1)
		table.insert(boundActions, FIRE_ACTION)
	end)
	pcall(function()
		ContextActionService:BindAction(RELOAD_ACTION, handleReloadAction, false,
			Enum.KeyCode.R)
		table.insert(boundActions, RELOAD_ACTION)
	end)
	pcall(function()
		ContextActionService:BindAction(SPRINT_ACTION, handleSprintAction, false,
			Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift)
		table.insert(boundActions, SPRINT_ACTION)
	end)

	-- Weapon hotkeys 1-4 map to the slots above.
	pcall(function()
		local codes = {
			Enum.KeyCode.One, Enum.KeyCode.Two,
			Enum.KeyCode.Three, Enum.KeyCode.Four,
		}
		for slot, code in ipairs(codes) do
			local actionName = string.format("ZU_Weapon%d", slot)
			ContextActionService:BindAction(actionName, function(_n: string, state: any, _i: any)
				if state == Enum.UserInputState.Begin then
					pcall(requestEquipSlot, slot)
				end
				return Enum.ContextActionResult.Pass
			end, false, code)
			table.insert(boundActions, actionName)
		end
	end)

	-- B re-opens the shop during intermission.
	pcall(function()
		ContextActionService:BindAction("ZU_ShopToggle", function(_n: string, state: any, _i: any)
			if state == Enum.UserInputState.Begin then
				pcall(function()
					ShopUI.SetVisible(true)
				end)
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.B)
		table.insert(boundActions, "ZU_ShopToggle")
	end)
end

local function onInputBegan(input: any, gameProcessed: boolean)
	if gameProcessed then return end
	pcall(function()
		local keyCode: any = input.KeyCode
		if keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift then
			applySprint(true)
		end
	end)
end

local function onInputEnded(input: any, _gameProcessed: boolean)
	pcall(function()
		local keyCode: any = input.KeyCode
		if keyCode == Enum.KeyCode.LeftShift or keyCode == Enum.KeyCode.RightShift then
			applySprint(false)
		end
	end)
end

-------------------------------------------------------------------------------
-- Main loop: auto-fire for automatic weapons
-------------------------------------------------------------------------------

local function onHeartbeat(_dt: number)
	if not started then return end
	if not firing then return end
	pcall(function()
		local def: WeaponDef? = currentWeaponDef()
		if def then
			local d: WeaponDef = def
			if d.Auto then
				tryFire()
			end
		end
	end)
end

-------------------------------------------------------------------------------
-- Boot
-------------------------------------------------------------------------------

local function connectAllRemotes()
	ensureRemotes()

	local okRemotes: boolean = pcall(function()
		local r: any = Remotes
		local weaponRemote: any = nil
		local statsRemote: any = nil
		local waveRemote: any = nil
		local damageRemote: any = nil
		local hurtRemote: any = nil
		local shopRemote: any = nil
		local notifyRemote: any = nil
		local endedRemote: any = nil

		pcall(function() weaponRemote = r.WeaponStateChanged() end)
		pcall(function() statsRemote = r.PlayerStatsChanged() end)
		pcall(function() waveRemote = r.WaveStateChanged() end)
		pcall(function() damageRemote = r.DamageDealt() end)
		pcall(function() hurtRemote = r.ZombieDamagedPlayer() end)
		pcall(function() shopRemote = r.ShopStateChanged() end)
		pcall(function() notifyRemote = r.Notify() end)
		pcall(function() endedRemote = r.RunEnded() end)

		local c1: any = safeConnect(weaponRemote, onWeaponStateChanged)
		if c1 then table.insert(connections, c1) end
		local c2: any = safeConnect(statsRemote, onPlayerStatsChanged)
		if c2 then table.insert(connections, c2) end
		local c3: any = safeConnect(waveRemote, onWaveStateChanged)
		if c3 then table.insert(connections, c3) end
		local c4: any = safeConnect(damageRemote, onDamageDealt)
		if c4 then table.insert(connections, c4) end
		local c5: any = safeConnect(hurtRemote, onZombieDamagedPlayer)
		if c5 then table.insert(connections, c5) end
		local c6: any = safeConnect(shopRemote, onShopStateChanged)
		if c6 then table.insert(connections, c6) end
		local c7: any = safeConnect(notifyRemote, onNotify)
		if c7 then table.insert(connections, c7) end
		local c8: any = safeConnect(endedRemote, onRunEnded)
		if c8 then table.insert(connections, c8) end
	end)
	if not okRemotes then
		warn("[ZombieUprising] remote wiring failed; client will run headless")
	end
end

local function boot()
	if started then return end
	started = true

	-- PlayerGui resolution is guarded: a race here must not error the script.
	local plrGui: any = nil
	pcall(function()
		if localPlayer then
			plrGui = localPlayer:WaitForChild("PlayerGui", REMOTE_TIMEOUT)
		end
	end)
	if not plrGui then
		warn("[ZombieUprising] PlayerGui unavailable; UI disabled")
	end

	if plrGui then
		pcall(function()
			HUD.Start(plrGui)
		end)
		pcall(function()
			ShopUI.Start(plrGui)
		end)
		-- Door/machine prompts and the downed overlay.
		pcall(function()
			Interact.Init()
		end)
		pcall(function()
			Instructions.Init()
		end)
		pcall(function()
			Music.StartClient()
		end)
		pcall(function()
			HUD.OnRespawnRequested(function()
				requestRespawn()
			end)
		end)
	end

	pcall(onCharacterAdded, localPlayer and localPlayer.Character or nil)
	if localPlayer then
		pcall(function()
			local c: any = localPlayer.CharacterAdded:Connect(function(char: any)
				pcall(onCharacterAdded, char)
			end)
			table.insert(connections, c)
		end)
	end

	pcall(bindActions)

	pcall(function()
		local c: any = UserInputService.InputBegan:Connect(onInputBegan)
		table.insert(connections, c)
	end)
	pcall(function()
		local c: any = UserInputService.InputEnded:Connect(onInputEnded)
		table.insert(connections, c)
	end)
	pcall(function()
		local c: any = RunService.Heartbeat:Connect(onHeartbeat)
		table.insert(connections, c)
	end)

	pcall(connectAllRemotes)

	-- Seed the HUD so it never shows placeholder zeros forever if the server
	-- is slow to send the first snapshot.
	pcall(function()
		HUD.SetHealth(100, 100)
		HUD.SetAmmo({
			WeaponId = "Pistol",
			AmmoInMag = 12,
			AmmoReserve = 120,
			Reloading = false,
			ReloadEndsAt = nil,
		})
	end)
end

boot()

return nil
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">HUD</string>
          <string name="Source"><![CDATA[--!strict
-- Zombie Uprising -- client HUD.
--
-- Every visual element is generated in code: no .rbxmx GUI assets, no image
-- ids, no external dependencies. The game therefore ships fully self-contained
-- from a source-only repo and can be published straight from a `make build`.
--
-- Responsibilities:
--   * Own the ScreenGui "ZombieHUD" in PlayerGui (idempotent across respawns).
--   * Expose typed setters for health, ammo, wave, coins, XP/level, kills.
--   * Damage vignette driven by RunService (transient, non-intrusive).
--   * Notification toasts (kill / hit feedback) via an auto-expiring track.
--   * Game-over panel with RequestRespawn button and spectate fallback text.
--
-- This module never indexes `game` members blindly: it is a pure ModuleScript
-- with no top-level side effects, so it is safe to require from anywhere.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local Types = require(Shared:WaitForChild("Types"))
local Config = require(Shared:WaitForChild("Config"))
local _usedTypes = Types

-- Structural mirrors of the shared types. luau-analyze cannot resolve exported
-- types across `require`, so each shape is redeclared here (kept in sync with
-- Shared/Types.luau). These are lint-time aliases only; runtime values are real.
type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type WaveState = {
	Wave: number,
	Phase: string,
	ZombiesRemaining: number,
	ZombiesTotal: number,
	TimeRemaining: number,
}

type WeaponState = {
	WeaponId: string,
	AmmoInMag: number,
	AmmoReserve: number,
	Reloading: boolean,
	ReloadEndsAt: number?,
}

type WeaponDef = {
	Id: string,
	DisplayName: string,
	Damage: number,
	HeadshotMultiplier: number,
	FireRate: number,
	MagazineSize: number,
	ReloadTime: number,
	SpreadDegrees: number,
	Range: number,
	Pellets: number,
	UnlockCost: number,
	AmmoReserveMax: number,
	Auto: boolean,
}

type RunState = {
	Active: boolean,
	StartedAt: number,
	Wave: number,
	Kills: number,
	Perks: { [string]: number },
	OwnedWeapons: { [string]: boolean },
	CurrentWeapon: string,
	Lives: number,
}

type Toast = {
	Label: TextLabel,
	ExpiresAt: number,
}

local HUD = {}

-- Top-level locals are untyped tables; `Instance.new` is filtered analyzer
-- noise, so we annotate these as `any` to keep strict mode honest.
local playerGui: any = nil
local gui: ScreenGui = nil :: any
local screen: ScreenGui = nil :: any

local healthFill: Frame = nil :: any
local healthText: TextLabel = nil :: any
local _healthBarBack: Frame = nil :: any

local ammoText: TextLabel = nil :: any
local weaponText: TextLabel = nil :: any
local reloadFrame: Frame = nil :: any
local reloadFill: Frame = nil :: any

local waveText: TextLabel = nil :: any
local zombiesText: TextLabel = nil :: any
local timerText: TextLabel = nil :: any
local bannerText: TextLabel = nil :: any

local coinsText: TextLabel = nil :: any
local xpText: TextLabel = nil :: any
local killsText: TextLabel = nil :: any
local xpFill: Frame = nil :: any

local crosshair: Frame = nil :: any
local chTop: Frame = nil :: any
local chBottom: Frame = nil :: any
local chLeft: Frame = nil :: any
local chRight: Frame = nil :: any
local chDot: Frame = nil :: any
local hitmarker: Frame = nil :: any
local muzzleFlash: Frame = nil :: any
local vignette: Frame = nil :: any

local damageNumbersFrame: Frame = nil :: any
local notificationsFrame: Frame = nil :: any
local toasts: { Toast } = {}
-- (damage-number entries carry their own per-label lifetime data)

local gameOverPanel: Frame = nil :: any
local gameOverTitle: TextLabel = nil :: any
local gameOverBody: TextLabel = nil :: any
local respawnButton: TextButton = nil :: any
local spectateLabel: TextLabel = nil :: any

local activeDamageNumbers: { { Label: TextLabel, ExpiresAt: number, Origin: Vector3, Any: any } } = {}

local started: boolean = false
local vignetteLevel: number = 0
local lowHealthPulse: number = 0
local hitmarkerUntil: number = 0
local flashUntil: number = 0
local crosshairSpread: number = 0
local crosshairUntilSpread: number = 0
local spreadDecayAt: number = 0

-- Layout/tuning constants kept local so the HUD stays resolution independent
-- (everything is expressed as a UDim2 scale, never as raw pixel offsets).
local COL_BG = Color3.fromRGB(12, 14, 18)
local COL_PANEL = Color3.fromRGB(20, 23, 30)
local COL_ACCENT = Color3.fromRGB(232, 196, 88)
local COL_TEXT = Color3.fromRGB(236, 240, 247)
local COL_DIM = Color3.fromRGB(150, 158, 172)
local COL_GOOD = Color3.fromRGB(88, 208, 128)
local COL_BAD = Color3.fromRGB(226, 78, 78)
local COL_WARN = Color3.fromRGB(240, 168, 72)

local MAX_TOASTS: number = 5
local TOAST_LIFE: number = 3.0
local DAMAGE_NUMBER_LIFE: number = 0.9
local MAX_DAMAGE_NUMBERS: number = 14

local _runServiceConn: any = nil
local respawnCallback: any = nil
local cachedStats: PlayerStats? = nil

-- Local accessors -----------------------------------------------------------

local function now(): number
	return os.clock()
end

local function clamp01(v: number): number
	if v < 0 then return 0 end
	if v > 1 then return 1 end
	return v
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

local function wavePhaseName(phase: string): string
	if phase == "Intermission" then return "INTERMISSION" end
	if phase == "Active" then return "WAVE ACTIVE" end
	if phase == "Ended" then return "RUN OVER" end
	return "..."
end

-- Instance helpers (all three Roblox globals are analyzer-filtered noise) ----

local function newFrame(name: string): Frame
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.new(0, 0, 0, 0)
	f.Position = UDim2.new(0, 0, 0, 0)
	return f
end

local function newTextLabel(name: string): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.Size = UDim2.new(0, 0, 0, 0)
	l.Position = UDim2.new(0, 0, 0, 0)
	l.Text = ""
	l.TextColor3 = COL_TEXT
	l.TextScaled = false
	l.TextSize = 16
	l.Font = Enum.Font.GothamSemibold
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextYAlignment = Enum.TextYAlignment.Center
	return l
end

local function newTextButton(name: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.BorderSizePixel = 0
	b.Size = UDim2.new(0, 0, 0, 0)
	b.Position = UDim2.new(0, 0, 0, 0)
	b.Text = ""
	b.TextColor3 = COL_TEXT
	b.TextSize = 16
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = true
	return b
end

local function addCorner(parent: Instance, r: number): UICorner
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function addList(parent: Instance, axis: any, pad: number): UIListLayout
	local l = Instance.new("UIListLayout")
	l.FillDirection = axis
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, pad)
	l.Parent = parent
	return l
end

-- UI construction ----------------------------------------------------------

local function buildHealth(): Frame
	local root = newFrame("HealthRoot")
	root.Size = UDim2.new(0.26, 0, 0.055, 0)
	root.Position = UDim2.new(0.02, 0, 0.9, 0)
	root.AnchorPoint = Vector2.new(0, 1)

	local back = newFrame("HealthBack")
	back.Size = UDim2.new(1, 0, 0.52, 0)
	back.Position = UDim2.new(0, 0, 0.48, 0)
	back.BackgroundColor3 = COL_PANEL
	back.BackgroundTransparency = 0.35
	back.Parent = root
	addCorner(back, 4)

	local clip = Instance.new("Frame")
	clip.Name = "Clip"
	clip.Size = UDim2.new(1, 0, 1, 0)
	clip.BackgroundTransparency = 1
	clip.ClipsDescendants = true
	clip.Parent = back

	_healthBarBack = back

	local fill = newFrame("HealthFill")
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = COL_GOOD
	fill.BackgroundTransparency = 0.1
	fill.Parent = clip
	addCorner(fill, 4)
	healthFill = fill

	local label = newTextLabel("HealthText")
	label.Size = UDim2.new(1, 0, 0.45, 0)
	label.Position = UDim2.new(0, 0, 0, 0)
	label.Text = "100 / 100"
	label.TextSize = 15
	label.TextColor3 = COL_DIM
	label.Parent = root
	healthText = label

	return root
end

local function buildAmmo(): Frame
	local root = newFrame("AmmoRoot")
	root.Size = UDim2.new(0.24, 0, 0.09, 0)
	root.Position = UDim2.new(0.98, 0, 0.9, 0)
	root.AnchorPoint = Vector2.new(1, 1)

	local weapon = newTextLabel("WeaponName")
	weapon.Size = UDim2.new(1, 0, 0.3, 0)
	weapon.Position = UDim2.new(0, 0, 0, 0)
	weapon.TextXAlignment = Enum.TextXAlignment.Right
	weapon.Text = "Sidearm"
	weapon.TextSize = 14
	weapon.TextColor3 = COL_DIM
	weapon.Parent = root
	weaponText = weapon

	local ammo = newTextLabel("AmmoText")
	ammo.Size = UDim2.new(1, 0, 0.5, 0)
	ammo.Position = UDim2.new(0, 0, 0.3, 0)
	ammo.TextXAlignment = Enum.TextXAlignment.Right
	ammo.Text = "12 / 120"
	ammo.TextSize = 30
	ammo.TextColor3 = COL_TEXT
	ammo.Parent = root
	ammoText = ammo

	local reload = newFrame("ReloadIndicator")
