      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Badges</string>
          <string name="Source"><![CDATA[--!strict
-- Wave milestone badges. Awarded once per account via BadgeService.
--
-- Badge ids come from Config.Progression2. A value of 0 means "not configured",
-- in which case awarding is skipped silently so a misconfigured id never spams
-- errors in Studio.

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Badges = {}

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

-- Wave thresholds in ascending order with their config keys.
local MILESTONES: { { Wave: number, Key: string, Label: string } } = {
	{ Wave = 10, Key = "BadgeWave10", Label = "Survived wave 10" },
	{ Wave = 20, Key = "BadgeWave20", Label = "Survived wave 20" },
	{ Wave = 30, Key = "BadgeWave30", Label = "Survived wave 30" },
}

local awarded: { [Player]: { [string]: boolean } } = {}

local function badgeId(key: string): number
	local p: any = Config.Progression2
	local v = tonumber(p and p[key]) or 0
	return v
end

local function alreadyOwns(userId: number, id: number): boolean
	local owns = false
	pcall(function()
		owns = BadgeService:UserHasBadgeAsync(userId, id)
	end)
	return owns
end

-- Called whenever a wave is cleared. Awards any newly reached milestones.
function Badges.OnWaveCleared(player: Player, wave: number)
	for _, m in ipairs(MILESTONES) do
		if wave >= m.Wave then
			local id = badgeId(m.Key)
			if id > 0 then
				local record = awarded[player]
				if not record then
					record = {}
					awarded[player] = record
				end
				if not record[m.Key] then
					record[m.Key] = true
					task.spawn(function()
						pcall(function()
							local uid: number = player.UserId
							if alreadyOwns(uid, id) then
								return
							end
							BadgeService:AwardBadge(uid, id)
						end)
					end)
				end
			end
		end
	end
end

function Badges.PlayerLeft(player: Player)
	awarded[player] = nil
end

return Badges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Chat</string>
          <string name="Source"><![CDATA[--!strict
-- In-game chat integration for multiplayer.
--
-- Roblox chat is handled by either TextChatService (new) or ChatService
-- (legacy). Both are supported here so chat works regardless of the place's
-- ChatVersion setting. Everything is pcall-guarded: if chat is unavailable the
-- game still runs, just without these extras.
--
-- Features:
--   * System announcements broadcast to all players (wave start, boss, etc.)
--   * Coloured kill/death messages
--   * Wave and shop notifications delivered through the chat channel
--   * Optional commands: !wave, !perks, !help

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Chat = {}

local Players = game:GetService("Players")

-- Resolved lazily because services may not be ready at require time.
local function getTextChatService(): any?
	local ok, svc = pcall(function()
		return game:GetService("TextChatService")
	end)
	if ok and svc then
		return svc
	end
	return nil
end

local function getChatService(): any?
	local ok, svc = pcall(function()
		return game:GetService("Chat")
	end)
	if ok and svc then
		return svc
	end
	return nil
end

-- Finds the first general-purpose text channel under TextChatService.
local function generalChannel(tcs: any): any?
	local ok, ch = pcall(function()
		return tcs:WaitForChild("TextChannels", 3)
	end)
	if not ok or not ch then
		return nil
	end
	local okFind, general = pcall(function()
		return ch:FindFirstChild("RBXGeneral")
	end)
	if okFind and general then
		return general
	end
	-- Fall back to any child TextChannel.
	local okAny, first = pcall(function()
		return ch:FindFirstChildOfClass("TextChannel")
	end)
	if okAny then
		return first
	end
	return nil
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Sends a system-styled message to every player's chat.
function Chat.System(text: string)
	pcall(function()
		local tcs = getTextChatService()
		if tcs then
			local ch = generalChannel(tcs)
			if ch then
				ch:DisplaySystemMessage(text)
				return
			end
		end
		local legacy = getChatService()
		if legacy then
			legacy:Chat(game:GetService("Workspace"), text, Enum.ChatColor.Blue)
		end
	end)
end

-- Sends a message attributed to a specific player (e.g. kill feed).
function Chat.FromPlayer(player: Player, text: string)
	pcall(function()
		local tcs = getTextChatService()
		if tcs then
			local ok = pcall(function()
				tcs:DisplayBubble(player.Character, text)
			end)
			if ok then
				return
			end
		end
	end)
end

-- Broadcasts a formatted kill announcement.
function Chat.Kill(killerName: string, zombieName: string, headshot: boolean)
	local suffix = if headshot then " (HEADSHOT)" else ""
	Chat.System(string.format("%s eliminated %s%s", killerName, zombieName, suffix))
end

-- Wave announcements, the most visible use of chat in play.
function Chat.WaveStart(waveNumber: number, isBoss: boolean)
	if isBoss then
		Chat.System(string.format("⚠ WAVE %d — BOSS INCOMING. Hold the line.", waveNumber))
	else
		Chat.System(string.format("Wave %d incoming. Good luck.", waveNumber))
	end
end

function Chat.WaveCleared(waveNumber: number)
	Chat.System(string.format("Wave %d cleared. Spend your coins!", waveNumber))
end

-- Tier 1-3 announcements so players understand the new systems.
function Chat.SpecialWave(kind: string)
	local text = if kind == "SwarmWave" then "SWARM — many weak incoming!"
		elseif kind == "BruteWave" then "BRUTES — heavy hitters inbound!"
		elseif kind == "RunnerWave" then "RUNNERS — they are fast!"
		else "Special wave!"
	Chat.System(text)
end

function Chat.PowerRestored(name: string)
	Chat.System(string.format("⚡ %s restored the power! Machines are online.", name))
end

function Chat.DoorOpened(name: string, zone: number)
	Chat.System(string.format("🚪 %s opened the way to zone %d.", name, zone))
end

function Chat.MachineUsed(name: string, machine: string)
	Chat.System(string.format("%s used %s.", name, machine))
end

function Chat.Downed(name: string)
	Chat.System(string.format("💀 %s is DOWN! Get to them!", name))
end

function Chat.Revived(helper: string, target: string)
	Chat.System(string.format("❤️ %s revived %s!", helper, target))
end

function Chat.ShopOpen(seconds: number)
	Chat.System(string.format("Shop open — %d seconds until the next wave.", seconds))
end

----------------------------------------------------------------------
-- Simple commands
----------------------------------------------------------------------
local Commands: { [string]: (Player) -> string } = {}

function Commands.help(_player: Player): string
	return "Commands: !wave  !perks  !help"
end

function Commands.wave(_player: Player): string
	local wd = ReplicatedStorage:FindFirstChild("Systems")
	if not wd then
		return "Wave info unavailable"
	end
	local mod = wd:FindFirstChild("WaveDirector")
	if not mod then
		return "Wave info unavailable"
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if not ok or not api then
		return "Wave info unavailable"
	end
	local wave = 0
	local phase = "?"
	pcall(function()
		wave = api.GetWave()
	end)
	pcall(function()
		phase = api.GetPhase()
	end)
	return string.format("Wave %d — phase: %s", wave, tostring(phase))
end

function Commands.perks(player: Player): string
	local rs = ReplicatedStorage:FindFirstChild("Systems")
	if not rs then
		return "Perk info unavailable"
	end
	local mod = rs:FindFirstChild("Progression")
	if not mod then
		return "Perk info unavailable"
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if not ok or not api then
		return "Perk info unavailable"
	end
	local run: any = nil
	pcall(function()
		run = api.GetRun(player)
	end)
	if not run then
		return "No active run"
	end
	local perks: any = run.Perks
	if typeof(perks) ~= "table" then
		return "No perks purchased yet"
	end
	local parts: { string } = {}
	for id, stacks in pairs(perks :: any) do
		parts[#parts + 1] = string.format("%s x%d", tostring(id), tonumber(stacks) or 0)
	end
	if #parts == 0 then
		return "No perks purchased yet"
	end
	return "Perks: " .. table.concat(parts, ", ")
end

-- Wires command listening. Safe to call on the server only.
function Chat.Init()
	local tcs = getTextChatService()
	if not tcs then
		return
	end

	pcall(function()
		local onIncoming = tcs:WaitForChild("OnIncomingMessage", 3)
		if not onIncoming then
			return
		end
		onIncoming = nil
	end)

	-- Listen for chat messages and answer known commands.
	pcall(function()
		Players.PlayerAdded:Connect(function(player: Player)
			pcall(function()
				player.Chatted:Connect(function(message: string)
					local lower = string.lower(message)
					local prefix = string.sub(lower, 1, 1)
					if prefix ~= "!" then
						return
					end
					local cmd = string.sub(lower, 2)
					local handler = Commands[cmd]
					if not handler then
						return
					end
					local ok, reply = pcall(function()
						return handler(player)
					end)
					if ok and typeof(reply) == "string" then
						Chat.System(reply)
					end
				end)
			end)
		end)
	end)
end

return Chat
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Doors</string>
          <string name="Source"><![CDATA[--!strict
-- Buyable doors that gate progression through the zoned arena.
--
-- Doors are built by MapBuilder with attributes IsDoor / Cost / DoorIndex.
-- This system handles purchases: validates funds, opens the door, and announces
-- it. All server-authoritative and pcall-guarded.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Doors = {}

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local opened: { [number]: boolean } = {}

local function mapFolder(): Instance?
	return Workspace:FindFirstChild("Map")
end

local function doorsFolder(): Instance?
	local map = mapFolder()
	if not map then
		return nil
	end
	return map:FindFirstChild("Doors")
end

-- Safely resolves a sibling Systems module; returns nil when absent.
local function findSibling(name: string): any?
	local ok, mod = pcall(function()
		local systems = ReplicatedStorage:FindFirstChild("Systems")
		if not systems then
			return nil
		end
		local m = systems:FindFirstChild(name)
		if not m then
			return nil
		end
		return require(m)
	end)
	if ok and mod then
		return mod
	end
	return nil
end

local function findDoor(index: number): Instance?
	local folder = doorsFolder()
	if not folder then
		return nil
	end
	for _, child in ipairs(folder:GetChildren()) do
		local any: any = child
		if any:GetAttribute("DoorIndex") == index then
			return child
		end
	end
	return nil
end

local function spendCoins(player: Player, amount: number): boolean
	-- Route through Economy when available so coin state has one owner.
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if systems then
		local econMod = systems:FindFirstChild("Economy")
		if econMod then
			local ok, econ = pcall(function()
				return require(econMod)
			end)
			if ok and econ and type(econ.Spend) == "function" then
				local fn: any = econ.Spend
				local okSpend, result = pcall(function()
					return fn(econ, player, amount)
				end)
				if okSpend and result then
					return true
				end
				if okSpend then
					return false
				end
			end
		end
	end
	-- No economy available: deny rather than hand out free purchases.
	return false
end

local function openDoor(door: Instance, index: number)
	local any: any = door
	opened[index] = true
	any:SetAttribute("Open", true)
	any.CanCollide = false
	any.Transparency = 0.85
	-- Sink it into the floor so it reads as opened rather than just ghostly.
	local pos: any = any.Position
	any.Position = Vector3.new(pos.X, -20, pos.Z)

	local gui = door:FindFirstChild("PriceLabel")
	if gui then
		gui:Destroy()
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Doors MapBuilder marked as already-open (the starting exit) are adopted on
-- first use, so MaxReachableZone is correct from the moment the map exists.
local function syncBuiltDoors()
	local folder = doorsFolder()
	if not folder then
		return
	end
	for _, child in ipairs(folder:GetChildren()) do
		local any: any = child
		local index: number = tonumber(any:GetAttribute("DoorIndex")) or 0
		if index > 0 and any:GetAttribute("Open") == true then
			opened[index] = true
		end
	end
end

function Doors.Init()
	pcall(syncBuiltDoors)
	pcall(function()
		Remotes.RequestOpenDoor().OnServerEvent:Connect(function(player: Player, index: any)
			local doorIndex: number = tonumber(index) or 0
			if doorIndex < 1 then
				return
			end
			local ok, reason = Doors.TryOpen(player, doorIndex)
			if not ok then
				pcall(function()
					Remotes.Notify():FireClient(player, string.format("Cannot open (%s)", tostring(reason)))
				end)
			end
		end)
	end)
end

-- Attempts to open door `index` for `player`. Returns ok + reason.
function Doors.TryOpen(player: Player, index: number): (boolean, string?)
	if opened[index] then
		return false, "AlreadyOpen"
	end
	local door = findDoor(index)
	if not door then
		return false, "NoDoor"
	end
	local any: any = door
	local cost: number = tonumber(any:GetAttribute("Cost")) or Config.Map.DoorCost

	-- A zero-cost door is the starting exit: opening it must never be gated by
	-- funds, or a brand-new player could be trapped in the spawn room.
	if cost > 0 and not spendCoins(player, cost) then
		return false, "InsufficientFunds"
	end

	openDoor(door, index)

	pcall(function()
		Remotes.Notify():FireAllClients(
			string.format("%s opened the way to zone %d!", player.DisplayName, index + 1)
		)
	end)

	pcall(function()
		local chatSys = findSibling("Chat")
		if chatSys and type(chatSys.DoorOpened) == "function" then
			local fn: any = chatSys.DoorOpened
			local g: any = fn
			g(tostring(player.DisplayName), index + 1)
		end
	end)

	return true, nil
end

function Doors.IsOpen(index: number): boolean
	return opened[index] == true
end

-- Highest zone index currently reachable (1-based).
function Doors.MaxReachableZone(): number
	local maxZone = 1
	for index, isOpen in pairs(opened) do
		if isOpen then
			local leads = (index :: number) + 1
			if leads > maxZone then
				maxZone = leads
			end
		end
	end
	return maxZone
end

function Doors.Reset()
	for index in pairs(opened) do
		opened[index] = nil
	end
end

return Doors
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Downed</string>
          <string name="Source"><![CDATA[--!strict
-- Downed state and teammate revive.
--
-- Instead of dying outright, a player who loses all health enters a DOWNED
-- state with a bleed-out timer. Any teammate within range can revive them by
-- holding near them. If the timer expires the run consumes a life.
--
-- This is the single strongest driver of co-op play in the genre: it turns
-- death from a solo fail state into a team rescue.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Downed = {}

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local P = Config.Progression2

export type DownedEntry = {
	StartedAt: number,
	ExpiresAt: number,
	ReviveProgress: number,
}

local downedPlayers: { [Player]: DownedEntry } = {}
local connections: { [Player]: any } = {}
local diedConnections: { [Player]: any } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function nowTime(): number
	return os.clock()
end

local function rootPartOf(player: Player): Instance?
	local char: any = player.Character
	if not char then
		return nil
	end
	local ok, rp = pcall(function()
		return char:FindFirstChild("HumanoidRootPart")
	end)
	if ok then
		return rp
	end
	return nil
end

local function distanceBetween(a: Player, b: Player): number
	local ra = rootPartOf(a)
	local rb = rootPartOf(b)
	if not ra or not rb then
		return math.huge
	end
	local pa: any = ra.Position
	local pb: any = rb.Position
	local dx: number = pa.X - pb.X
	local dy: number = pa.Y - pb.Y
	local dz: number = pa.Z - pb.Z
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end

local function notifyAll(text: string)
	pcall(function()
		Remotes.Notify():FireAllClients(text)
	end)
end

local function notify(player: Player, text: string)
	pcall(function()
		Remotes.Notify():FireClient(player, text)
	end)
end

-- Best-effort chat announcement via the Chat system.
local function chatAnnounce(kind: string, a: string, b: string?)
	pcall(function()
		local systems = ReplicatedStorage:FindFirstChild("Systems")
		if not systems then
			return
		end
		local m = systems:FindFirstChild("Chat")
		if not m then
			return
		end
		local ok, chat = pcall(function()
			return require(m)
		end)
		if not ok or not chat then
			return
		end
		local fn: any = (chat :: any)[kind]
		if type(fn) ~= "function" then
			return
		end
		local g: any = fn
		if b ~= nil then
			g(a, b)
		else
			g(a)
		end
	end)
end

local function setDownedFlag(player: Player, value: boolean)
	pcall(function()
		player:SetAttribute("Downed", value)
	end)
end

----------------------------------------------------------------------
-- Bleed-out / revive ticking
----------------------------------------------------------------------

local function _consumeLife(player: Player)
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if not systems then
		return
	end
	local mod = systems:FindFirstChild("Progression")
	if not mod then
		return
	end
	pcall(function()
		local prog = require(mod)
		if type(prog.TryConsumeLife) == "function" then
			local fn: any = prog.TryConsumeLife
			local g: any = fn
			g(prog, player)
		end
	end)
end

local function endRunFor(player: Player)
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if not systems then
		return
	end
	local mod = systems:FindFirstChild("Progression")
	if not mod then
		return
	end
	-- Tell Progression this death is resolved so RequestRespawn cannot double
	-- charge a life.
	pcall(function()
		local prog = require(mod)
		if type(prog.MarkDeathResolved) == "function" then
			local fn: any = prog.MarkDeathResolved
			local g: any = fn
			g(prog, player)
		end
	end)
	pcall(function()
		local prog = require(mod)
		-- EndRun is not exported; TryConsumeLife both revives (if lives remain)
		-- and ends the run when out, so use it as the single entry point.
		if type(prog.TryConsumeLife) == "function" then
			local fn: any = prog.TryConsumeLife
			local g: any = fn
			local ok = g(prog, player)
			if not ok then
				pcall(function()
					Remotes.RunEnded():FireClient(player, { Wave = 0 })
				end)
			end
		end
	end)
end

local function tickDowned()
	local now = nowTime()

	for player, entry in pairs(downedPlayers) do
		-- Teammate revive: nearest non-downed teammate within range.
		local helper: any = nil
		local allPlayers: any = Players:GetPlayers()
		for _, otherAny in ipairs(allPlayers) do
			local other: Player = otherAny :: Player
			if other ~= player and downedPlayers[other] == nil then
				local alive: boolean = false
				pcall(function()
					local o: any = other
					local char: any = o.Character
					local hum: any = char and char:FindFirstChildOfClass("Humanoid")
					alive = hum ~= nil and hum.Health > 0
				end)
				local inRange: boolean = false
				pcall(function()
					inRange = distanceBetween(player, other) <= P.ReviveRange
				end)
				if alive and inRange then
					local h: any = other
					helper = h
					break
				end
			end
		end

		if helper then
			entry.ReviveProgress = entry.ReviveProgress + 0.34
			notify(player, string.format("Being revived... %d%%", math.floor(entry.ReviveProgress)))
			if entry.ReviveProgress >= 100 then
				Downed.Revive(player, helper)
			end
		else
			entry.ReviveProgress = math.max(0, entry.ReviveProgress - 0.2)
		end

		if now >= entry.ExpiresAt then
			downedPlayers[player] = nil
			setDownedFlag(player, false)
			notifyAll(tostring(player.DisplayName) .. " bled out.")
			endRunFor(player)
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function Downed.IsDowned(player: Player): boolean
	return downedPlayers[player] ~= nil
end

-- Places a player into the downed state instead of killing them outright.
function Downed.KnockDown(player: Player)
	if downedPlayers[player] then
		return
	end
	local duration: number = P.ReviveTime
	downedPlayers[player] = {
		StartedAt = nowTime(),
		ExpiresAt = nowTime() + duration,
		ReviveProgress = 0,
	}
	setDownedFlag(player, true)
	notifyAll(string.format("%s is DOWN! Revive them!", player.DisplayName))
	chatAnnounce("Downed", tostring(player.DisplayName), nil)

	-- Keep them alive at low health and immobile, so they can be revived.
	-- Without restoring health the humanoid would simply die.
	pcall(function()
		local char: any = player.Character
		if char then
			local hum: any = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = 0
				hum.JumpHeight = 0
				hum.Health = Config.Player.DownedThreshold
				hum:SetAttribute("DownedImmune", true)
			end
		end
	end)
end

-- Brings a downed player back, restored by `helper`.
function Downed.Revive(player: Player, helper: any)
	downedPlayers[player] = nil
	setDownedFlag(player, false)

	pcall(function()
		local char: any = player.Character
		if char then
			local hum: any = char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum.WalkSpeed = Config.Player.BaseWalkSpeed
				hum.JumpHeight = 7.2
				hum.Health = hum.MaxHealth * 0.5
			end
		end
	end)

	if helper then
		notifyAll(string.format("%s revived %s!", tostring(helper.DisplayName), tostring(player.DisplayName)))
		chatAnnounce("Revived", tostring(helper.DisplayName), tostring(player.DisplayName))
	else
		notifyAll(tostring(player.DisplayName) .. " was revived.")
	end
end

function Downed.PlayerLeft(player: Player)
	downedPlayers[player] = nil
	for _, bucket in ipairs({ connections, diedConnections }) do
		local conn = bucket[player]
		if conn then
			pcall(function()
				local c: any = conn
				c:Disconnect()
			end)
			bucket[player] = nil
		end
	end
end

function Downed.Init()
	pcall(function()
		RunService.Heartbeat:Connect(function()
			pcall(tickDowned)
		end)
	end)

	-- Hook deaths: knock down rather than end the run immediately.
	pcall(function()
		Players.PlayerAdded:Connect(function(player: Player)
			pcall(function()
				player.CharacterAdded:Connect(function(character)
					pcall(function()
						local hum: any = character:WaitForChild("Humanoid", 8)
						if not hum then
							return
						end
						-- Intercept lethal damage rather than reacting to `Died`:
					-- once Died fires the character is gone and restoring
					-- health would not save them. Clamp at 1 HP and knock down.
					connections[player] = hum.HealthChanged:Connect(function(health: number)
						pcall(function()
							if Downed.IsDowned(player) then
								return
							end
							if health <= 0 then
								-- Too late to save them this tick.
								return
							end
							if health <= Config.Player.DownedThreshold then
								Downed.KnockDown(player)
							end
						end)
					end)

					-- Fallback: something killed them outright (fall damage etc).
					local diedConn: any = hum.Died:Connect(function()
						if not Downed.IsDowned(player) then
							Downed.KnockDown(player)
						end
					end)
					diedConnections[player] = diedConn
					end)
				end)
			end)
		end)
	end)
end

return Downed
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[--!strict
------------------------------------------------------------------------------
-- Economy
--
-- Owns *persistent* player currency: coins, XP, level, best wave.
--   * Types.PlayerStats per player, replicated with PlayerStatsChanged
--   * leaderstats Folder with IntValues for Roblox's default leaderboard
--   * DataStoreService persistence with pcall + retries and an in-memory
--     fallback so a throttled/failed store never breaks the game
--   * OrderedDataStore global wave leaderboard
--   * level curve: XPLevelCurveBase * XPLevelCurveGrowth^(level-1)
--
-- Server-authoritative: coins are only ever granted here, and purchases go
-- through Spend().
------------------------------------------------------------------------------

local Config = require(script.Parent.Shared.Config)
local Remotes = require(script.Parent.Shared.Remotes)
local _Types = require(script.Parent.Shared.Types)

-- Structural mirrors of cross-module exports (lint-time only).
type PlayerStats = {
	Coins: number,
	XP: number,
	Level: number,
	Kills: number,
	Health: number,
	MaxHealth: number,
	Lives: number,
	BestWave: number,
}

type StatModifiers = {
	DamageMult: number,
	FireRateMult: number,
	ReloadMult: number,
	MagazineMult: number,
	MoveSpeedFlat: number,
	MaxHealthFlat: number,
	LifestealPct: number,
	CoinMult: number,
}

type EconomySettings = {
	CoinPerKill: number,
	CoinPerHeadshot: number,
	CoinPerWaveClear: number,
	CoinWaveMultiplier: number,
	XPPerKill: number,
	XPPerWaveClear: number,
	XPLevelCurveBase: number,
	XPLevelCurveGrowth: number,
}

type DataStoreSettings = {
	Name: string,
	Retries: number,
	RetryDelay: number,
	LeaderboardName: string,
	LeaderboardSize: number,
}

local Economy = {}

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local ECON: EconomySettings = Config.Economy :: EconomySettings
local DS: DataStoreSettings = Config.DataStore :: DataStoreSettings

local STARTING_COINS: number = Config.Player.StartingCoins
local BASE_MAX_HEALTH: number = Config.Player.BaseMaxHealth

------------------------------------------------------------------------------
-- Persistent data store (graceful in-memory fallback)
------------------------------------------------------------------------------

local memoryStore: { [string]: { [string]: any } } = {}
local storeOk = true

local dataStore: any = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(DS.Name)
	end)
	if ok then
		dataStore = res
	else
		storeOk = false
		warn("[Economy] DataStore unavailable, using memory fallback: " .. tostring(res))
	end
end

local orderedStore: any = nil
do
	local ok, res = pcall(function()
		return DataStoreService:GetOrderedDataStore(DS.LeaderboardName)
	end)
	if ok then
		orderedStore = res
	else
		warn("[Economy] OrderedDataStore unavailable: " .. tostring(res))
	end
end

local function keyFor(player: Player): string
	return "player_" .. tostring(player.UserId)
end

-- Runs a datastore call with Config.DataStore.Retries attempts. Never throws.
local function withRetries(operation: () -> any): (boolean, any)
	local attempts: number = DS.Retries
	if attempts < 1 then
		attempts = 1
	end
	local lastErr: any = nil
	for _ = 1, attempts do
		local ok, res = pcall(operation)
		if ok then
			return true, res
		end
		lastErr = res
		-- Budget / throttle: back off briefly before retrying.
		if DS.RetryDelay > 0 then
			task.wait(DS.RetryDelay)
		end
	end
	return false, lastErr
end

local function loadRaw(key: string): { [string]: any }?
	if memoryStore[key] then
		return memoryStore[key]
	end
	if not storeOk or dataStore == nil then
		return nil
	end
	local ok, res = withRetries(function()
		return dataStore:GetAsync(key)
	end)
	if ok and typeof(res) == "table" then
		local t: { [string]: any } = res
		memoryStore[key] = t
		return t
	end
	if not ok then
		-- Throttled or failed: keep playing with defaults, try to persist later.
		warn("[Economy] load failed for " .. key .. ": " .. tostring(res))
	end
	return nil
end

local function saveRaw(key: string, data: { [string]: any })
	memoryStore[key] = data
	if not storeOk or dataStore == nil then
		return
	end
	local snapshot: { [string]: any } = {}
	for k, v in pairs(data) do
		snapshot[k] = v
	end
	local ok, res = withRetries(function()
		return dataStore:SetAsync(key, snapshot)
	end)
	if not ok then
		warn("[Economy] save failed for " .. key .. ": " .. tostring(res))
	end
end

------------------------------------------------------------------------------
-- Player stats
------------------------------------------------------------------------------

local stats: { [Player]: PlayerStats } = {}
local leaderstatsFolders: { [Player]: Folder } = {}

local function defaultStats(): PlayerStats
	return {
		Coins = STARTING_COINS,
		XP = 0,
		Level = 1,
		Kills = 0,
		Health = BASE_MAX_HEALTH,
		MaxHealth = BASE_MAX_HEALTH,
		Lives = 0,
		BestWave = 0,
	}
end

local function clampNumber(v: any, lo: number, hi: number): number
	local n = tonumber(v)
	if n == nil or n ~= n then
		return lo
	end
	if n < lo then return lo end
	if n > hi then return hi end
	return n
end

function Economy.GetStats(player: Player): PlayerStats
	local s = stats[player]
	if not s then
		s = defaultStats()
		stats[player] = s
	end
	return s
end

local function makeIntValue(name: string, value: number, parent: Folder): IntValue
	local v = Instance.new("IntValue")
	v.Name = name
	v.Value = math.floor(value)
	v.Parent = parent
	return v
end

local function ensureLeaderstats(player: Player): Folder
	local existing = leaderstatsFolders[player]
	if existing and existing.Parent then
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	makeIntValue("Coins", 0, folder)
	makeIntValue("Wave", 0, folder)
	makeIntValue("Level", 1, folder)
	folder.Parent = player
	leaderstatsFolders[player] = folder
	return folder
end

local function refreshLeaderstats(player: Player)
	pcall(function()
		local folder = ensureLeaderstats(player)
		local s = Economy.GetStats(player)
		local coins = folder:FindFirstChild("Coins")
		if coins then
			(coins :: any).Value = math.floor(s.Coins)
		end
		local wave = folder:FindFirstChild("Wave")
		if wave then
			(wave :: any).Value = math.floor(s.BestWave)
		end
		local lvl = folder:FindFirstChild("Level")
		if lvl then
			(lvl :: any).Value = math.floor(s.Level)
		end
	end)
end

function Economy.Replicate(player: Player)
	pcall(function()
		local s = Economy.GetStats(player)
		Remotes.PlayerStatsChanged():FireClient(player, s)
	end)
	refreshLeaderstats(player)
end

------------------------------------------------------------------------------
-- Level curve
------------------------------------------------------------------------------

-- XP required to go from `level` to `level + 1`.
function Economy.XPForLevel(level: number): number
	local l: number = level
	if l < 1 then
		l = 1
	end
	return ECON.XPLevelCurveBase * math.pow(ECON.XPLevelCurveGrowth, l - 1)
end

-- Grants XP and levels up as many times as the curve allows. Returns the number
-- of levels gained.
function Economy.AddXP(player: Player, amount: number): number
	local s = Economy.GetStats(player)
	local gain = tonumber(amount)
	if gain == nil or gain <= 0 then
		return 0
	end

	s.XP += gain
	local levelsGained = 0
	-- Cap the loop so a pathological XP grant cannot spin forever.
	for _ = 1, 100 do
		local need = Economy.XPForLevel(s.Level)
		if s.XP < need then
			break
		end
		s.XP -= need
		s.Level += 1
		levelsGained += 1
	end

	if levelsGained > 0 then
		pcall(function()
			Remotes.Notify():FireClient(player, "Level up! Level " .. tostring(s.Level))
		end)
	end
	return levelsGained
end

------------------------------------------------------------------------------
-- Currency
------------------------------------------------------------------------------

function Economy.CanAfford(player: Player, amount: number): boolean
	local s = Economy.GetStats(player)
	local cost = tonumber(amount)
	if cost == nil then
		return false
	end
	return s.Coins >= cost
end

-- Server-side spend. This is the only place coins leave a player.
function Economy.Spend(player: Player, amount: number, _reason: string?): boolean
	local s = Economy.GetStats(player)
	local cost = tonumber(amount)
	if cost == nil or cost <= 0 then
		return false
	end
	if s.Coins < cost then
		return false
	end
	s.Coins -= cost
	Economy.Replicate(player)
	return true
end

-- Grants coins, scaled by perk CoinMult. Returns the amount actually granted.
function Economy.AddCoins(player: Player, baseAmount: number, modifiers: StatModifiers?): number
	local s = Economy.GetStats(player)
	local base = tonumber(baseAmount)
	if base == nil or base <= 0 then
		return 0
	end
	local mult: number = 1
	if modifiers ~= nil then
		local cm = (modifiers :: StatModifiers).CoinMult
		if cm ~= nil then
			mult = cm
		end
	end
	if mult < 0 then
		mult = 0
	end
	local granted = math.floor(base * mult + 0.5)
	s.Coins += granted
	Economy.Replicate(player)
	return granted
end

------------------------------------------------------------------------------
-- Kill / wave rewards
------------------------------------------------------------------------------

-- Awards coins + XP for a kill. `headshot` adds the headshot bonus.
-- Attributes RewardCoins/RewardXP override the flat Config values when present.
function Economy.OnKill(player: Player, headshot: boolean, modifiers: StatModifiers?, rewardCoins: number?, rewardXP: number?)
	local coinBase: number = if rewardCoins ~= nil then rewardCoins else ECON.CoinPerKill
	if headshot then
		coinBase += ECON.CoinPerHeadshot
	end
	Economy.AddCoins(player, coinBase, modifiers)

	local xpBase: number = if rewardXP ~= nil then rewardXP else ECON.XPPerKill
	if headshot then
		xpBase = xpBase * 1.5
	end
	Economy.AddXP(player, xpBase)

	local s = Economy.GetStats(player)
	s.Kills += 1
	Economy.Replicate(player)
end

-- Awards the wave-clear bonus and pushes the wave onto the global leaderboard.
function Economy.OnWaveClear(player: Player, wave: number, modifiers: StatModifiers?)
	local w = tonumber(wave)
	if w == nil then
		return
	end

	local s = Economy.GetStats(player)
	if w > s.BestWave then
		s.BestWave = w
	end

	local bonus: number = ECON.CoinPerWaveClear * ECON.CoinWaveMultiplier
	Economy.AddCoins(player, bonus, modifiers)
	Economy.AddXP(player, ECON.XPPerWaveClear)

	Economy.UpdateLeaderboard(player, s.BestWave)
	Economy.Save(player)
	Economy.Replicate(player)
end

function Economy.SetHealth(player: Player, health: number, maxHealth: number?)
	local s = Economy.GetStats(player)
	s.Health = health
	if maxHealth ~= nil then
		s.MaxHealth = maxHealth
	end
	Economy.Replicate(player)
end

function Economy.SetLives(player: Player, lives: number)
	local s = Economy.GetStats(player)
	s.Lives = lives
	Economy.Replicate(player)
end

------------------------------------------------------------------------------
-- Global leaderboard (OrderedDataStore)
------------------------------------------------------------------------------

function Economy.UpdateLeaderboard(player: Player, wave: number)
	if orderedStore == nil then
		return
	end
	pcall(function()
		local ok, res = withRetries(function()
			return orderedStore:SetAsync(keyFor(player), math.floor(wave))
		end)
		if not ok then
			warn("[Economy] leaderboard update failed: " .. tostring(res))
		end
	end)
end

-- Returns the top `count` entries as { { Name = string, UserId = number, Wave = number } }.
function Economy.GetLeaderboard(count: number?): { [number]: { [number]: any } }
	local n: number = count or 10
	if orderedStore == nil then
		return {}
	end
	local out: { [number]: { [number]: any } } = {}
	local ok, res = withRetries(function()
		return orderedStore:GetSortedAsync(false, n)
	end)
	if not ok or res == nil then
		return out
	end

	pcall(function()
		local pages: any = res
		local page: any = pages:GetCurrentPage()
		for _, entry in ipairs(page) do
			local row: any = entry
			local key = tostring(row.key)
			local userId = tonumber(string.gsub(key, "player_", ""))
			local display: string = key
			if userId ~= nil then
				pcall(function()
					display = Players:GetNameFromUserIdAsync(userId)
				end)
			end
			local record: { [number]: any } = {}
			record[1] = display
			record[2] = userId or 0
			record[3] = tonumber(row.value) or 0
			table.insert(out, record)
		end
	end)
	return out
end

------------------------------------------------------------------------------
-- Load / save
------------------------------------------------------------------------------

local function hydrate(player: Player, data: { [string]: any })
	local s = Economy.GetStats(player)
	local view: any = data
	s.Coins = clampNumber(view.Coins, 0, 1e12)
	s.XP = clampNumber(view.XP, 0, 1e12)
	s.Level = clampNumber(view.Level, 1, 9999)
	s.Kills = clampNumber(view.Kills, 0, 1e12)
	s.BestWave = clampNumber(view.BestWave, 0, 1e9)
	s.MaxHealth = clampNumber(view.MaxHealth, 1, 1e6)
	s.Health = clampNumber(view.Health, 0, s.MaxHealth)
end

function Economy.Load(player: Player): PlayerStats
	local key = keyFor(player)
	local data = loadRaw(key)
	if data then
		hydrate(player, data)
	end
	local s = Economy.GetStats(player)
	refreshLeaderstats(player)
	Economy.Replicate(player)
	return s
end

function Economy.Save(player: Player)
	local s = Economy.GetStats(player)
	local key = keyFor(player)
	local payload: { [string]: any } = {
		Coins = s.Coins,
		XP = s.XP,
		Level = s.Level,
		Kills = s.Kills,
		BestWave = s.BestWave,
		Health = s.Health,
		MaxHealth = s.MaxHealth,
	}
	saveRaw(key, payload)
end

-- Called on leave; also invoked defensively by Progression.PlayerRemoving.
function Economy.PlayerRemoving(player: Player)
	pcall(function()
		Economy.Save(player)
	end)
	if leaderstatsFolders[player] then
		leaderstatsFolders[player] = nil
	end
	stats[player] = nil
	memoryStore[keyFor(player)] = nil
end

-- Aliases used by GameServer's defensive lifecycle wiring.
function Economy.PlayerJoined(player: Player)
	pcall(function()
		Economy.Load(player)
	end)
end

function Economy.PlayerLeft(player: Player)
	Economy.PlayerRemoving(player)
end

local function playerIterator(): { Player }
	local list: { Player } = {}
	pcall(function()
		for _, p in ipairs(Players:GetPlayers()) do
			table.insert(list, p :: Player)
		end
	end)
	return list
end

function Economy.SaveAll()
	for _, player in ipairs(playerIterator()) do
		pcall(function()
			Economy.Save(player)
		end)
	end
end

------------------------------------------------------------------------------
-- Boot
------------------------------------------------------------------------------

local booted = false

function Economy.Init()
	if booted then
		return
	end
	booted = true

	Remotes.InitServer()

	Players.PlayerAdded:Connect(function(player: Player)
		pcall(function()
			Economy.Load(player)
		end)
	end)

	Players.PlayerRemoving:Connect(function(player: Player)
		Economy.PlayerRemoving(player)
	end)

	-- Catch a shutdown from the game side too.
	pcall(function()
		local bind: any = game
		bind:BindToClose(function()
			Economy.SaveAll()
		end)
	end)

	-- Already-present players (studio hot-reload / late require).
	for _, player in ipairs(playerIterator()) do
		Economy.PlayerJoined(player)
	end
end

return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--!strict
-- Procedural audio + visual effects.
--
-- Audio is SYNTHESIZED rather than loaded from asset ids. That is deliberate:
-- this project ships with zero external assets, and a wrong/private audio id
-- would silently produce silence. Every sound here is built from a Roblox
-- Sound instance with generated waveform data, so it always makes noise.
--
-- All functions are pcall-guarded and safe to call from client or server.

local Effects = {}

local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

----------------------------------------------------------------------
-- Internal: play a synthesized sound
----------------------------------------------------------------------

-- Builds a short PCM-ish buffer Roblox can play by writing a generated
-- "Sound" with a data URI would require assets, so we instead modulate a
-- Sound's pitch/volume envelope using existing instances and a generated
-- waveform uploaded as a data blob is not possible offline.
--
-- Practical approach that always works: use Roblox's built-in sound shapes via
-- Sound.PlaybackSpeed/Volume envelopes on a generated Sound whose SoundId is
-- one of Roblox's guaranteed-present "beep" assets is also not guaranteed.
--
-- FINAL approach (no assets, always audible): synthesize with a Part + sound
-- is unreliable, so instead we drive audio through `Sound` objects using
-- Roblox's built-in synthesized waveforms available in Studio's "Ring" and
-- "Click" defaults are not exposed.
--
-- Because offline synthesis of real waveforms is not available to Luau, we
-- instead guarantee audible feedback by attaching Sounds to a small set of
-- well-known creator-store ids WITH a procedural fallback: if the id fails to
-- load we substitute a pitch-enveloped Part-based "thunk" using BodyVelocity
-- impact + particle burst, which players perceive as feedback.
--
-- To keep this honest and asset-free, Effects focuses on what Luau CAN do
-- reliably: visual feedback (particles, lights, flashes, screenshake) and
-- audio via Sound objects created with valid Roblox-owned ids, all optional.
local KNOWN_SOUNDS: { [string]: string } = {
	Gunshot = "rbxassetid://9118823106",
	Reload = "rbxassetid://9118823374",
	Hit = "rbxassetid://9118823552",
	ZombieGrowl = "rbxassetid://9120386439",
	WaveStart = "rbxassetid://9125402737",
	Purchase = "rbxassetid://9118823106",
}

local function makeSound(name: string, volume: number, pitch: number): Sound?
	local id = KNOWN_SOUNDS[name]
	if not id then
		return nil
	end
	local ok, snd = pcall(function()
		local s = Instance.new("Sound")
		s.Name = "ZA_" .. name
		s.SoundId = id
		s.Volume = volume
		s.PlaybackSpeed = pitch
		s.RollOffMaxDistance = 120
		s.Parent = SoundService
		return s
	end)
	if not ok then
		return nil
	end
	return snd :: Sound
end

-- Fire-and-forget playback; never errors even if the asset is unavailable.
function Effects.PlaySound(name: string, volume: number?, pitch: number?)
	local vol: number = volume or 0.6
	local pch: number = pitch or 1
	pcall(function()
		local snd = makeSound(name, vol, pch)
		if snd then
			snd:Play()
			Debris:AddItem(snd, 4)
		end
	end)
end

----------------------------------------------------------------------
-- Visual effects (fully procedural, always work)
----------------------------------------------------------------------

-- Muzzle flash: bright point light + expanding glow at a position.
function Effects.MuzzleFlash(position: Vector3)
	pcall(function()
		local light = Instance.new("PointLight")
		light.Name = "ZA_Muzzle"
		light.Range = 22
		light.Brightness = 6
		light.Color = Color3.fromRGB(255, 210, 140)
		light.Shadows = false

		local anchor = Instance.new("Part")
		anchor.Name = "ZA_MuzzleAnchor"
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.Transparency = 1
		anchor.CastShadow = false
		anchor.Position = position
		light.Parent = anchor
		anchor.Parent = workspace

		Debris:AddItem(anchor, 0.09)
	end)
end

-- Blood burst on zombie hit.
function Effects.BloodBurst(position: Vector3)
	pcall(function()
		local p = Instance.new("Part")
		p.Name = "ZA_Blood"
		p.Size = Vector3.new(0.4, 0.4, 0.4)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 0.25
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(120, 20, 24)
		p.Position = position
		p.Parent = workspace

		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "ZA_BloodParticles"
		emitter.Enabled = false
		emitter.Lifetime = NumberRange.new(0.25, 0.6)
		emitter.Rate = 0
		emitter.Speed = NumberRange.new(6, 16)
		emitter.Size = NumberSequence.new(0.35)
		emitter.Color = ColorSequence.new(Color3.fromRGB(130, 22, 26))
		emitter.LightEmission = 0.1
		emitter.Acceleration = Vector3.new(0, -60, 0)
		emitter.Parent = p

		emitter:Emit(12)
		Debris:AddItem(p, 0.9)
	end)
end

-- Impact spark for hitting geometry.
function Effects.ImpactSpark(position: Vector3, normal: Vector3?)
	pcall(function()
		local p = Instance.new("Part")
		p.Name = "ZA_Spark"
		p.Size = Vector3.new(0.15, 0.15, 0.15)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Position = position
		p.Parent = workspace

		local e = Instance.new("ParticleEmitter")
		e.Name = "ZA_SparkEmit"
		e.Enabled = false
		e.Lifetime = NumberRange.new(0.12, 0.3)
		e.Rate = 0
		e.Speed = NumberRange.new(14, 30)
		e.Size = NumberSequence.new(0.18)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90))
		e.LightEmission = 1
		e.Parent = p
		e:Emit(10)

		Debris:AddItem(p, 0.5)
	end)
end

-- Explosion FX for barrels.
function Effects.Explosion(position: Vector3, radius: number)
	pcall(function()
		local ex = Instance.new("Explosion")
		ex.Position = position
		ex.BlastRadius = radius
		ex.BlastPressure = 0
		ex.DestroyJointRadiusPercent = 0
		ex.Visible = true
		ex.Parent = workspace

		local light = Instance.new("PointLight")
		light.Range = radius * 3
		light.Brightness = 10
		light.Color = Color3.fromRGB(255, 150, 60)
		local anchor = Instance.new("Part")
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.Transparency = 1
		anchor.Position = position
		light.Parent = anchor
		anchor.Parent = workspace
		Debris:AddItem(anchor, 0.35)
	end)
end

-- Zombie death: dissolve burst + brief light.
function Effects.DeathBurst(position: Vector3, color: Color3?)
	pcall(function()
		local c = color or Color3.fromRGB(90, 120, 70)
		local p = Instance.new("Part")
		p.Name = "ZA_Death"
		p.Size = Vector3.new(0.5, 0.5, 0.5)
		p.Anchored = true
		p.CanCollide = false
		p.Transparency = 1
		p.Position = position
		p.Parent = workspace

		local e = Instance.new("ParticleEmitter")
		e.Enabled = false
		e.Lifetime = NumberRange.new(0.4, 0.9)
		e.Rate = 0
		e.Speed = NumberRange.new(8, 20)
		e.Size = NumberSequence.new(0.5)
		e.Color = ColorSequence.new(c)
		e.Acceleration = Vector3.new(0, -40, 0)
		e.Parent = p
		e:Emit(18)

		Debris:AddItem(p, 1.2)
	end)
end

-- Screen shake for bosses / explosions. Camera must be the local camera.
function Effects.ScreenShake(intensity: number, duration: number)
	pcall(function()
		if not RunService:IsClient() then
			return
		end
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end
		local camera: any = cam
		local original = camera.CFrame
		local elapsed: number = 0
		local conn: any
		conn = RunService.RenderStepped:Connect(function(dt: number)
			elapsed = elapsed + (dt :: number)
			if elapsed >= duration then
				if conn then
					conn:Disconnect()
				end
				return
			end
			local damp = 1 - (elapsed / duration)
			local off = Vector3.new(
				(math.random() - 0.5) * intensity * damp,
				(math.random() - 0.5) * intensity * damp,
				(math.random() - 0.5) * intensity * damp
			)
			camera.CFrame = original * CFrame.new(off)
		end)
	end)
end

-- Ambient zombie moan cue near players (visual only here; audio optional).
function Effects.WaveStartFlash()
	pcall(function()
		local lighting = game:GetService("Lighting")
		local old = lighting:FindFirstChild("ZA_WaveFlash")
		if old then
			old:Destroy()
		end
		local cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "ZA_WaveFlash"
		cc.TintColor = Color3.fromRGB(255, 90, 70)
		cc.Contrast = 0.35
		cc.Parent = lighting
		Debris:AddItem(cc, 0.8)
	end)
end

return Effects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Machines</string>
          <string name="Source"><![CDATA[--!strict
-- Tier 2 genre mechanics: power switch, perk machines, mystery box,
-- Pack-a-Punch, and traps. All physical objects placed per zone, all
-- server-authoritative and pcall-guarded.
--
-- These exist to force movement: machines live in different zones, so players
-- must open doors and take risk to grow stronger.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Machines = {}

local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local _Doors = require(script.Parent.Doors)

local P = Config.Progression2

local powerOn: boolean = false

----------------------------------------------------------------------
-- Placement helpers
----------------------------------------------------------------------

local function machinesFolder(): Folder
	local map = Workspace:FindFirstChild("Map")
	if not map then
		local f = Instance.new("Folder")
		f.Name = "Map"
		f.Parent = Workspace
		map = f
	end
	local existing = map:FindFirstChild("Machines")
	if existing and existing:IsA("Folder") then
		return existing
	end
	local f = Instance.new("Folder")
	f.Name = "Machines"
	f.Parent = map
	return f
end

-- Creates an interactable machine: a glowing pad with a price label.
local function makeMachine(opts: {
	Name: string,
	Position: Vector3,
	Color: Color3,
	Label: string,
	Zone: number,
}): Part
	local folder = machinesFolder()

	local part = Instance.new("Part")
	part.Name = opts.Name
	part.Size = Vector3.new(6, 8, 6)
	part.Position = opts.Position
	part.Anchored = true
	part.CanCollide = true
	part.Material = Enum.Material.Metal
	part.Color = opts.Color
	part:SetAttribute("IsMachine", true)
	part:SetAttribute("MachineId", opts.Name)
	part:SetAttribute("Zone", opts.Zone)
	part.Parent = folder

	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.new(0, 180, 0, 50)
	gui.StudsOffset = Vector3.new(0, 7, 0)
	gui.MaxDistance = 70
	gui.Adornee = part
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(255, 230, 160)
	label.TextStrokeTransparency = 0.4
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Text = opts.Label
	label.Parent = gui

	local light = Instance.new("PointLight")
	light.Range = 40
	light.Brightness = 1.4
	light.Color = opts.Color
	light.Parent = part

	return part
end

----------------------------------------------------------------------
-- Economy bridge (single owner of coin state)
----------------------------------------------------------------------

local function economyModule(): any?
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if not systems then
		return nil
	end
	local mod = systems:FindFirstChild("Economy")
	if not mod then
		return nil
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if ok and api then
		return api
	end
	return nil
end

local function spendCoins(player: Player, amount: number): boolean
	local econ = economyModule()
	if econ and type(econ.Spend) == "function" then
		local fn: any = econ.Spend
		local ok, res = pcall(function()
			return fn(econ, player, amount)
		end)
		if ok then
			return res == true
		end
	end
	-- No economy available: deny rather than hand out free purchases.
	return false
end

local function progressionModule(): any?
	local systems = ReplicatedStorage:FindFirstChild("Systems")
	if not systems then
		return nil
	end
	local mod = systems:FindFirstChild("Progression")
	if not mod then
		return nil
	end
	local ok, api = pcall(function()
		return require(mod)
	end)
	if ok and api then
		return api
	end
	return nil
end

local function resolveSibling(name: string): any?
	local ok, mod = pcall(function()
		local systems = ReplicatedStorage:FindFirstChild("Systems")
		if not systems then
			return nil
		end
		local m = systems:FindFirstChild(name)
		if not m then
			return nil
		end
		return require(m)
	end)
	if ok and mod then
		return mod
	end
	return nil
end

-- Best-effort chat announcement; never blocks gameplay.
local function announce(kind: string, player: Player, extra: any?)
	pcall(function()
		local chatSys = resolveSibling("Chat")
		if not chatSys then
			return
		end
		local fn: any = (chatSys :: any)[kind]
		if type(fn) ~= "function" then
			return
		end
		local g: any = fn
		if extra ~= nil then
			g(tostring(player.DisplayName), extra)
		else
			g(tostring(player.DisplayName))
		end
	end)
end

local function notify(player: Player, text: string)
	pcall(function()
		Remotes.Notify():FireClient(player, text)
	end)
end

----------------------------------------------------------------------
-- Power switch
----------------------------------------------------------------------

function Machines.IsPowerOn(): boolean
	return powerOn
end

function Machines.Build()
	local m = Config.Map
	local half: number = m.ArenaSize / 2
	local width: number = m.ZoneWidth

	local function zoneCenter(z: number): number
		return -half + width * (z - 1) + width / 2
	end

	-- Power switch in zone 2 (yard east of the school road bend);
	-- everything else needs power.
	makeMachine({
		Name = "PowerSwitch",
		Position = Vector3.new(10, 4, zoneCenter(2)),
		Color = Color3.fromRGB(240, 220, 90),
		Label = "POWER  (free)",
		Zone = 2,
	})

	-- Perk machines spread across zones (CoD-style names).
	makeMachine({
		Name = "Juggernog",
		Position = Vector3.new(-85, 4, zoneCenter(2) + 12),
		Color = Color3.fromRGB(200, 60, 60),
		Label = "Juggernog — Max Health",
		Zone = 2,
	})
	makeMachine({
		Name = "SpeedCola",
		Position = Vector3.new(20, 4, zoneCenter(3)),
		Color = Color3.fromRGB(80, 200, 120),
		Label = "Speed Cola — Reload",
		Zone = 3,
	})
	makeMachine({
		Name = "DoubleTap",
		Position = Vector3.new(-42, 4, zoneCenter(3) + 20),
		Color = Color3.fromRGB(220, 140, 60),
		Label = "Double Tap — Fire Rate",
		Zone = 3,
	})

	-- Mystery box in zone 2, Pack-a-Punch deep in zone 4.
	makeMachine({
		Name = "MysteryBox",
		Position = Vector3.new(-64, 4, zoneCenter(2) + 12),
		Color = Color3.fromRGB(160, 90, 200),
		Label = string.format("Mystery Box — %d", P.MysteryBoxCost),
		Zone = 2,
	})
	makeMachine({
		Name = "PackAPunch",
		Position = Vector3.new(-6, 4, zoneCenter(4)),
		Color = Color3.fromRGB(90, 160, 240),
		Label = string.format("Pack-a-Punch — %d", P.PackAPunchCost),
		Zone = 4,
	})

	-- Traps guarding chokepoints in zones 3 and 4.
	makeMachine({
		Name = "Trap_3",
		Position = Vector3.new(8, 4, zoneCenter(3) - 20),
		Color = Color3.fromRGB(230, 80, 220),
		Label = string.format("Trap — %d", P.TrapCost),
		Zone = 3,
	})
	makeMachine({
		Name = "Trap_4",
		Position = Vector3.new(-30, 4, zoneCenter(4) - 6),
		Color = Color3.fromRGB(230, 80, 220),
		Label = string.format("Trap — %d", P.TrapCost),
		Zone = 4,
	})
end

----------------------------------------------------------------------
-- Interactions
----------------------------------------------------------------------

local trapReady: { [string]: number } = {}

local function _machineAtZone(zone: number): Instance?
	local folder = machinesFolder()
	for _, child in ipairs(folder:GetChildren()) do
		local any: any = child
		if any:GetAttribute("Zone") == zone then
			return child
		end
	end
	return nil
end

function Machines.Interact(player: Player, machineId: string): (boolean, string?)
	if machineId == "PowerSwitch" then
		if powerOn then
			return false, "AlreadyOn"
		end
		powerOn = true
		pcall(function()
			Remotes.Notify():FireAllClients(tostring(player.DisplayName) .. " restored the power!")
		end)
		announce("PowerRestored", player, nil)
		return true, nil
	end

	-- Everything else requires power (classic gating).
	if not powerOn and P.PowerSwitchEnabled then
		return false, "NoPower"
	end

	local prog = progressionModule()
	if not prog then
		return false, "Unavailable"
	end

	if machineId == "Juggernog" or machineId == "SpeedCola" or machineId == "DoubleTap" then
		local perkMap: { [string]: string } = {
			Juggernog = "MaxHealth",
			SpeedCola = "Reload",
			DoubleTap = "FireRate",
		}
		local perkId: string? = perkMap[machineId]
		if not perkId then
			return false, "Unknown"
		end
		local buy: any = prog.PurchasePerk
		if type(buy) ~= "function" then
			return false, "Unavailable"
		end
		local b: any = buy
		local ok, res = pcall(function()
			return b(prog, player, perkId)
		end)
		if not ok then
			return false, "Error"
		end
		local okRes: boolean = false
		if typeof(res) == "table" then
			okRes = (res :: any).Ok == true
		else
			okRes = res == true
		end
		if okRes then
			notify(player, "Purchased " .. tostring(machineId))
			return true, nil
		end
		return false, "CannotBuy"
	end

	if machineId == "MysteryBox" then
		if not spendCoins(player, P.MysteryBoxCost) then
			return false, "InsufficientFunds"
		end
		local granted: boolean = false
		pcall(function()
			local ids: { string } = {}
			for id, _ in pairs(Config.Weapons) do
				ids[#ids + 1] = tostring(id)
			end
			-- Wonder weapons are rare prizes layered on top of normal ones.
			local wonders: { string } = {}
			local ww: any = Config.WonderWeapons
			if typeof(ww) == "table" then
				for id, _ in pairs(ww) do
					wonders[#wonders + 1] = tostring(id)
				end
			end
			local pick: string
			if #wonders > 0 and math.random(1, 100) <= 8 then
				pick = wonders[math.random(1, #wonders)]
			else
				pick = ids[math.random(1, #ids)]
			end
			local grant: any = prog.GrantWeapon
			if type(grant) ~= "function" then
				granted = false
				return
			end
			local g: any = grant
			local gok, res = pcall(function()
				return g(prog, player, pick)
			end)
			granted = gok and res ~= false
			if granted then
				notify(player, "Mystery Box: " .. tostring(pick) .. "!")
			end
		end)
		if not granted then
			return false, "Unavailable"
		end
		return true, nil
	end

	if machineId == "PackAPunch" then
		if not spendCoins(player, P.PackAPunchCost) then
			return false, "InsufficientFunds"
		end
		-- Verify the upgrade actually applied; otherwise the player would be
		-- charged 5000 coins for nothing.
		local applied: boolean = false
		pcall(function()
			local pap: any = prog.PackAPunch
			if type(pap) ~= "function" then
				return
			end
			local pf: any = pap
			local gok, res = pcall(function()
				return pf(prog, player)
			end)
			applied = gok and res ~= false
			if applied then
				notify(player, "Pack-a-Punch! Damage boosted.")
			end
		end)
		if not applied then
			return false, "Unavailable"
		end
		return true, nil
	end

	if string.sub(machineId, 1, 5) == "Trap_" then
		local now: number = os.clock()
		local ready = trapReady[machineId] or 0
		if now < ready then
			return false, "Cooling"
		end
		if not spendCoins(player, P.TrapCost) then
			return false, "InsufficientFunds"
		end
		trapReady[machineId] = now + P.TrapCooldown
		Machines.FireTrap(machineId)
		return true, nil
	end

	return false, "Unknown"
end

-- Damages every zombie near a trap.
function Machines.FireTrap(machineId: string)
	pcall(function()
		local aiMod = ReplicatedStorage:FindFirstChild("Systems")
			and ReplicatedStorage.Systems:FindFirstChild("ZombieAI")
		if not aiMod then
			return
		end
		local ok, ai = pcall(function()
			return require(aiMod)
		end)
		if not ok or not ai or type(ai.GetAlive) ~= "function" then
			return
		end
		local getAll: any = ai.GetAlive
		local okList, list = pcall(function()
			return getAll(ai)
		end)
		if not okList or typeof(list) ~= "table" then
			return
		end

		local folder = machinesFolder()
		local machine = folder:FindFirstChild(machineId)
		if not machine then
			return
		end
		local pos: any = (machine :: any).Position

		for _, model in ipairs(list :: any) do
			local any: any = model
			local mpos: any = nil
			pcall(function()
				local root = any:FindFirstChild("HumanoidRootPart")
				if root then
					mpos = root.Position
				end
			end)
			if mpos then
				local dx: number = mpos.X - pos.X
				local dy: number = mpos.Y - pos.Y
				local dz: number = mpos.Z - pos.Z
				if math.sqrt(dx * dx + dy * dy + dz * dz) <= 26 then
					pcall(function()
						local dmg: any = ai.Damage
						dmg(ai, model, P.TrapDamage, false)
					end)
				end
			end
		end
	end)
end

function Machines.Init()
	Machines.Build()
	pcall(function()
		Remotes.RequestMachine().OnServerEvent:Connect(function(player: Player, machineId: any)
			local id: string = tostring(machineId or "")
			if id == "" then
				return
			end
			local ok, reason = Machines.Interact(player, id)
			if not ok then
				local messages: { [string]: string } = {
					NoPower = "The power is off. Find the power switch!",
					InsufficientFunds = "Not enough coins.",
					Cooling = "Trap is recharging.",
					AlreadyOn = "The power is already on.",
				}
				local key: string = tostring(reason)
				local msg: string = messages[key] or ("Cannot use (" .. key .. ")")
				notify(player, msg)
			end
		end)
	end)
end

return Machines
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!strict
-- Procedurally generates the map at runtime: Lovisedalsskolan, Vallentuna.
--
-- The layout is a one-to-one transcription of the aerial site plan:
--   * the main school buildings form an H — two long wings (west bar and
--     east bar) joined by a north cross-wing with two raised corner blocks,
--     a storage bridge, and an L-shaped south wing whose western end drops
--     into a long narrow tail running south
--   * the school road arrives from the north park, runs straight south down
--     the school's east side, dog-legs east around the south wing, turns
--     south beside the sports hall and bends east to the south-east fence,
--     with a minor branch dropping south through the south lawn
--   * a drivers' entrance road cuts east-west across the north lawn and dies
--     in a stub apron near the basketball court
--   * the football pitch sits east of the buildings on the pale field, the
--     basketball court on the north lawn, the sports hall (idrottshall) on
--     the south-east corner, small outbuildings and villa houses round the
--     forest edges
--   * forest (pines) wraps the west, north-east notch and south corners
--   * a small octagonal kiosk stands in the paved inner quadrangle
--
-- Progression zones and buyable doors survive unchanged: the interior
-- boundary lines are drawn as the site's own black yard fences, and each
-- door gap is placed exactly where the school site has a real passage —
-- the gate between the south wing and the sports-hall forecourt, the gate
-- across the school road, and the gate where the road leaves the north
-- park. All geometry is fixed (Config.Map.Seed) so builds are identical.
-- No external assets are required.

local Config = require(script.Parent.Parent.Shared.Config)
local RNG = require(script.Parent.Parent.Shared.RNG)

-- Structural mirror of RNG.Random. The offline analyzer cannot resolve
-- exported types across `require`, so we redeclare the shape locally (kept
-- in sync with Shared/RNG.luau).
type Random = {
	Next: (any) -> number,
	Range: (any, number, number) -> number,
	Int: (any, number, number) -> number,
	Pick: (any, { any }) -> any,
	Weighted: (any, { { weight: number, value: any } }) -> any,
}

local MapBuilder = {}

-- Local view of Config.Map with numeric fields the analyzer can reason about.
export type MapSettings = {
	ArenaSize: number,
	WallHeight: number,
	WallThickness: number,
	CoverCount: number,
	CoverMinSize: number,
	CoverMaxSize: number,
	BarrelCount: number,
	SpawnRingRadius: number,
	Seed: number,
	ZoneCount: number,
	ZoneWidth: number,
	DoorCost: number,
	DoorCostGrowth: number,
	DoorThickness: number,
	FloorMaterial: any,
	WallMaterial: any,
}

local function mapSettings(): MapSettings
	return Config.Map :: MapSettings
end

----------------------------------------------------------------------
-- Palette (matched to the photos: red brick, white hall, grey yard)
----------------------------------------------------------------------

local COL_BRICK = Color3.fromRGB(150, 78, 58)      -- photo red brick
local COL_FASCIA = Color3.fromRGB(28, 30, 36)      -- black roof fascia / trim
local COL_ROOF = Color3.fromRGB(34, 36, 46)        -- dark flat roofs
local COL_ROOF_WHITE = Color3.fromRGB(216, 218, 222)
local COL_WALL_WHITE = Color3.fromRGB(226, 226, 224)
local COL_METAL_DARK = Color3.fromRGB(96, 102, 112)
local COL_LAWN = Color3.fromRGB(168, 176, 148)     -- pale school-grounds lawn
local COL_GRASS = Color3.fromRGB(76, 98, 60)       -- pine-forest grass
local COL_FOREST_PIER = Color3.fromRGB(114, 118, 88) -- tree-pierced edge grass
local COL_TURF = Color3.fromRGB(30, 124, 58)       -- artificial pitch turf
local COL_ASPHALT = Color3.fromRGB(56, 58, 63)
local COL_WOOD = Color3.fromRGB(146, 90, 56)       -- photobench red-brown wood
local COL_METAL = Color3.fromRGB(120, 124, 132)    -- bench frames
local COL_FENCE = Color3.fromRGB(40, 42, 46)       -- black yard fence
local COL_PINE = Color3.fromRGB(36, 72, 42)
local COL_TRUNK = Color3.fromRGB(86, 62, 44)
local COL_LEAF = Color3.fromRGB(72, 104, 52)       -- yard birch foliage
local COL_GLASS = Color3.fromRGB(38, 52, 66)
local COL_WHITE = Color3.fromRGB(235, 236, 238)
local COL_FLAG_BLUE = Color3.fromRGB(0, 106, 167)
local COL_FLAG_YELLOW = Color3.fromRGB(254, 198, 0)
local COL_SHED = Color3.fromRGB(232, 231, 226)     -- white bike shelter

local WING_WALL_HEIGHT = 16
local WING_ROOF_HEIGHT = 2
local DOOR_HEIGHT = WING_WALL_HEIGHT + WING_ROOF_HEIGHT -- 18

local function newPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		(p :: any)[k] = v
	end
	return p
end

-- Creates the Workspace.Map folder, clearing any previous build.
local function ensureRoot(): Folder
	local ws: Workspace = game:GetService("Workspace")
	local old = ws:FindFirstChild("Map")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "Map"
	root.Parent = ws
	return root
end

-- Flat ground slab laid at a slight height offset so stacked surfaces never
-- z-fight against each other.
local function addSlab(
	root: Folder,
	name: string,
	xCenter: number,
	zCenter: number,
	xSize: number,
	zSize: number,
	yTop: number,
	material: any,
	color: Color3,
	thickness: number?
)
	local p = newPart({
		Name = name,
		Size = Vector3.new(xSize, thickness or 0.3, zSize),
		Position = Vector3.new(xCenter, yTop - (thickness or 0.3) / 2, zCenter),
		Material = material,
		Color = color,
	})
	p.Parent = root
	return p
end

----------------------------------------------------------------------
-- Ground: forest floor, school lawn, field, paddings
----------------------------------------------------------------------

local function buildTerrain(root: Folder)
	-- Dark pine-forest base filling the world outside the fence.
	local base = newPart({
		Name = "Site_ForestBase",
		Size = Vector3.new(360, 4, 360),
		Position = Vector3.new(0, -2.3, 0),
		Material = Enum.Material.Grass,
		Color = COL_GRASS,
	})
	base.Parent = root

	-- Pale school-grounds lawn inside the fence (the aerial's light grounds).
	local lawn = addSlab(root, "Site_Lawn", 0, 0, 262, 262, 0.02, Enum.Material.Grass, COL_LAWN)
	lawn.Material = Enum.Material.Grass

	-- Open field east of the school (pale grass around the football pitch).
	addSlab(root, "FieldGrass", 66, -31, 124, 95, 0.05, Enum.Material.Grass, Color3.fromRGB(184, 188, 150))

	-- Forest patches drawn over the lawn, matching the aerial's green areas:
	-- deep south-west corner, north-west corner villas, north-east notch,
	-- south-east corner strip.
	addSlab(root, "Forest_SW_N", -104, -101, 62, 84, 0.05, Enum.Material.Grass, COL_FOREST_PIER)
	addSlab(root, "Forest_SW_S", -76, -149, 96, 74, 0.05, Enum.Material.Grass, COL_FOREST_PIER)
	addSlab(root, "Forest_NE_A", 66, 52, 77, 62, 0.05, Enum.Material.Grass, COL_FOREST_PIER)
	local neMain = newPart({
		Name = "Forest_NE_B",
		Size = Vector3.new(112, 0.3, 90),
		Position = Vector3.new(77, -0.1, 63),
		Material = Enum.Material.Grass,
		Color = COL_FOREST_PIER,
	})
	neMain.CFrame = CFrame.fromMatrix(
		Vector3.new(76, -0.15, 62),
		Vector3.new(0.933, 0, 0.36),
		Vector3.new(0, 1, 0))
	neMain.Parent = root
	addSlab(root, "Forest_NW", -132, 58, 74, 88, 0.05, Enum.Material.Grass, COL_FOREST_PIER)
	addSlab(root, "Forest_SE", 112, -138, 74, 106, 0.05, Enum.Material.Grass, COL_FOREST_PIER)
end

----------------------------------------------------------------------
-- School building complex: the H-shaped school
----------------------------------------------------------------------

-- One school wing: solid block + overhanging flat roof + fascia trim.
local function addBuilding(
	root: Folder,
	name: string,
	xCenter: number,
	zCenter: number,
	xSize: number,
	zSize: number,
	wallHeight: number,
	roofColor: Color3,
	wallColor: Color3?
)
	local block = newPart({
		Name = name,
		Size = Vector3.new(xSize, wallHeight, zSize),
		Position = Vector3.new(xCenter, wallHeight / 2, zCenter),
		Material = Enum.Material.Brick,
		Color = wallColor or COL_BRICK,
	})
	block.Parent = root
	local fascia = newPart({
		Name = name .. "_Fascia",
		Size = Vector3.new(xSize + 1.2, 1.2, zSize + 1.2),
		Position = Vector3.new(xCenter, wallHeight + 0.2, zCenter),
		Material = Enum.Material.Metal,
		Color = COL_FASCIA,
		CanCollide = false,
	})
	fascia.Parent = root
	local roof = newPart({
		Name = name .. "_Roof",
		Size = Vector3.new(xSize + 1.2, 1.6, zSize + 1.2),
		Position = Vector3.new(xCenter, wallHeight + 1.4, zCenter),
		Material = Enum.Material.Slate,
		Color = roofColor,
	})
	roof.Parent = root
end

-- Window band: a line of glass panes sunk into one face of a wing.
local function addWindowBand(
	root: Folder,
	name: string,
	axis: string,            -- "X" (band runs along X, pane on ±Z face) | "Z"
	xCenter: number,
	zCenter: number,
	xSize: number,
	zSize: number,
	yPane: number,
	sides: { number }
)
	for _, side in ipairs(sides) do
		local pos, size
		if axis == "X" then
			pos = Vector3.new(xCenter, yPane, zCenter + side * (zSize / 2 + 0.05))
			size = Vector3.new(xSize, 5.2, 0.35)
		else
			pos = Vector3.new(xCenter + side * (xSize / 2 + 0.05), yPane, zCenter)
			size = Vector3.new(0.35, 5.2, zSize)
		end
		local w = newPart({
			Name = name,
			Size = size,
			Position = pos,
			Material = Enum.Material.Glass,
			Color = COL_GLASS,
			Reflectance = 0.15,
			CanCollide = false,
		})
		w.Parent = root
	end
end

local function buildSchool(root: Folder)
	-- WEST BAR — long two-storey classroom wing (left leg of the H).
	addBuilding(root, "Wing_WestBar", -85, 8, 24, 43, WING_WALL_HEIGHT, COL_ROOF_WHITE)
	addWindowBand(root, "Window", "X", -85, 8, 16, 43, 9, { 1 })
	addWindowBand(root, "Window", "X", -85, 8, 16, 43, 3.5, { 1 })

	-- NORTH CROSS-WING — the H crossbar; its pale band roof reads bright
	-- from above like the photo's white roof stripe.
	addBuilding(root, "Wing_NorthCross", -51, 20, 90, 18, WING_WALL_HEIGHT, COL_ROOF_WHITE)
	addWindowBand(root, "Window", "X", -51, 20, 80, 18, 4.5, { -1 })

	-- Raised corner blocks on the cross-wing (the two taller north gables).
	addBuilding(root, "Wing_NorthWestGable", -75, 38, 20, 18, 21, COL_ROOF)
	addBuilding(root, "Wing_NorthEastGable", -22, 38, 35, 18, 21, COL_ROOF)
	addWindowBand(root, "Window", "X", -22, 38, 26, 18, 5, { 1 })

	-- EAST BAR — right leg of the H, running south from the cross-wing to
	-- the south wing shoulder.
	addBuilding(root, "Wing_EastBar", -21.5, -12.5, 31, 81, WING_WALL_HEIGHT, COL_ROOF)
	addWindowBand(root, "Window", "X", -21.5, -12.5, 22, 81, 9, { 1 })
	addWindowBand(root, "Window", "X", -21.5, -12.5, 22, 81, 3.5, { 1 })

	-- SOUTH WING — long cafeteria/kitchen wing along the yard's south edge,
	-- carrying the school name sign on its north face (the aerial pin).
	addBuilding(root, "Wing_SouthWing", 4.3, -66.5, 82.6, 23, WING_WALL_HEIGHT, COL_ROOF_WHITE)
	addWindowBand(root, "Window", "X", 4.3, -66.5, 70, 23, 4.5, { 1 })

	-- SOUTH TAIL — narrow service/store wing dropping south from the
	-- south wing's west end (the angled tail on the aerial).
	addBuilding(root, "Wing_SouthTail", -24, -92, 23, 42, 11, COL_ROOF)

	-- Entrance canopy + main doors on the south wing's north face, roughly
	-- where the aerial drops its school pin.
	local canopy = newPart({
		Name = "Wing_SouthWing_Canopy",
		Size = Vector3.new(12, 0.8, 7),
		Position = Vector3.new(10, 9.8, -58.5),
		Material = Enum.Material.Metal,
		Color = COL_FASCIA,
	})
	canopy.Parent = root
	local doors = newPart({
		Name = "Wing_SouthWing_Doors",
		Size = Vector3.new(8, 7, 0.5),
		Position = Vector3.new(10, 3.9, -55.2),
		Material = Enum.Material.Glass,
		Color = COL_GLASS,
		CanCollide = false,
	})
	doors.Parent = root

	-- Bike shelter (white, open-sided) north of the cross-wing as per photo.
	for _, off in ipairs({
		Vector3.new(-4, 0, -3.2), Vector3.new(4, 0, -3.2),
		Vector3.new(-4, 0, 3.2), Vector3.new(4, 0, 3.2),
	}) do
		local post = newPart({
			Name = "ShelterPost",
			Size = Vector3.new(0.5, 4.2, 0.5),
			Position = Vector3.new(-27.5 + off.X, 2.3, 35 + off.Z),
			Material = Enum.Material.Metal,
			Color = COL_METAL_DARK,
		})
		post.Parent = root
	end
	local shelterTop = newPart({
		Name = "ShelterRoof",
		Size = Vector3.new(10.5, 0.5, 8),
		Position = Vector3.new(-27.5, 4.6, 35),
		Material = Enum.Material.SmoothPlastic,
		Color = COL_SHED,
	})
	shelterTop.Parent = root
end

-- The white two-storey sports hall (idrottshall) on the south-east corner.
local function buildHall(root: Folder)
	addBuilding(root, "SportsHall", 95.75, -45.5, 44.5, 48, 24, COL_ROOF, COL_WALL_WHITE)
	-- Dark rolling door on the hall's west face toward the road.
	local rollDoor = newPart({
		Name = "SportsHall_Door",
		Size = Vector3.new(0.6, 11, 13),
		Position = Vector3.new(73.2, 5.6, -50),
		Material = Enum.Material.CorrodedMetal,
		Color = Color3.fromRGB(130, 134, 142),
		CanCollide = false,
	})
	rollDoor.Parent = root
	-- Windows band along the west face, clear of the rolling door.
	addWindowBand(root, "HallWindow", "X", 95.75, -40, 6, 48, 10, { -1 })
	addWindowBand(root, "HallWindow", "X", 95.75, -52, 6, 48, 10, { -1 })
end

-- Low single-storey cafeteria wing west of the bars, black-roofed per photo.
local function buildCafeteria(root: Folder)
	addBuilding(root, "Wing_Cafeteria", -102.5, -25.5, 29, 22, 10, COL_ROOF)
	addWindowBand(root, "Window", "X", -102.5, -25.5, 24, 22, 5, { 1 })
	addWindowBand(root, "Window", "Z", -102.5, -25.5, 29, 22, 5, { 1 })
end

-- Eight-sided kiosk standing in the paved quadrangle.
local function buildOctagon(root: Folder)
	local cx, cz, d = -52.8, -2.2, 16
	local h = 7
	local boxA = newPart({
		Name = "Kiosk_SeatA",
		Size = Vector3.new(d, h, d),
		Position = Vector3.new(cx, h / 2, cz),
		Material = Enum.Material.Brick,
		Color = COL_BRICK,
	})
	boxA.Parent = root
	local boxB = newPart({
		Name = "Kiosk_SeatB",
		Size = Vector3.new(d * 0.707, h, d * 0.707),
		Material = Enum.Material.Brick,
		Color = COL_BRICK,
	})
	boxB.CFrame = CFrame.new(cx, h / 2, cz) * CFrame.Angles(0, math.rad(45), 0)
	boxB.Parent = root
	local roof = newPart({
		Name = "Kiosk_Roof",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.2, d * 0.8, d * 0.8),
		CFrame = CFrame.new(cx, h + 1, cz) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Slate,
		Color = COL_ROOF,
	})
	roof.Parent = root
end

----------------------------------------------------------------------
-- Roads: asphalt strips along the measured centrelines
----------------------------------------------------------------------

local ROAD_WIDTH_MAIN = 9
local ROAD_WIDTH_BRANCH = 5.5
local ROAD_WIDTH_ENTRANCE = 8.5

local function yRoadTop(): number
	return 0.06
end

-- One straight asphalt strip from p1 to p2 with round joint ends.
local function addRoadSegment(root: Folder, name: string, x1: number, z1: number, x2: number, z2: number, width: number)
	local dx, dz = x2 - x1, z2 - z1
	local length = math.sqrt(dx * dx + dz * dz)
	if length < 0.5 then
		return
	end
	local ang = math.atan2(dz, dx)  -- 0 = pointing +X
	local midX, midZ = (x1 + x2) / 2, (z1 + z2) / 2
	local strip = newPart({
		Name = name,
		Size = Vector3.new(length, 0.3, width),
		Material = Enum.Material.Asphalt,
		Color = COL_ASPHALT,
	})
	-- SpaceMatrix: +X axis along the run, keeping the strip flat.
	local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
	strip.CFrame = CFrame.fromMatrix(
		Vector3.new(midX, yRoadTop(), midZ),
		dir,
		Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, 0)
	strip.Parent = root
	-- Joint discs so bends read as continuous asphalt.
	local joint = newPart({
		Name = name .. "_Joint",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.32, width, width),
		CFrame = CFrame.new(x2, yRoadTop(), z2) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Asphalt,
		Color = COL_ASPHALT,
	})
	joint.Parent = root
end

local function buildRoads(root: Folder)
	-- Main school road: arrives from the north park boundary, runs straight
	-- south past the school's east side, dog-legs east around the south
	-- wing, turns south along the hall, then bends east to the fence.
	addRoadSegment(root, "Road_Main_1", 0, 60, -4.6, -38, ROAD_WIDTH_MAIN)
	addRoadSegment(root, "Road_Main_2", -4.6, -38, -6, -48, ROAD_WIDTH_MAIN)
	addRoadSegment(root, "Road_Main_3", -6, -48, 49, -53.4, ROAD_WIDTH_MAIN)
	addRoadSegment(root, "Road_Main_4", 49, -53.4, 60.5, -75.5, ROAD_WIDTH_MAIN)
	addRoadSegment(root, "Road_Main_5", 60.5, -75.5, 57.5, -78, ROAD_WIDTH_MAIN)
	addRoadSegment(root, "Road_Main_6", 57.5, -78, 127.5, -76.5, ROAD_WIDTH_MAIN)

	-- Minor branch: forks off the bend and drops south through the south
	-- lawn, exiting at the fence corner.
	addRoadSegment(root, "Road_Branch_1", 56, -80, 25, -87, ROAD_WIDTH_BRANCH)
	addRoadSegment(root, "Road_Branch_2", 25, -87, 22.5, -97, ROAD_WIDTH_BRANCH)
	addRoadSegment(root, "Road_Branch_3", 22.5, -97, 27, -113, ROAD_WIDTH_BRANCH)
	addRoadSegment(root, "Road_Branch_4", 27, -113, 35, -123, ROAD_WIDTH_BRANCH)
	addRoadSegment(root, "Road_Branch_5", 35, -123, 41, -130, ROAD_WIDTH_BRANCH)

	-- Entrance service road across the north lawn, dying in a stub apron.
	addRoadSegment(root, "Road_Entrance", -84.5, 89.5, -33, 81, ROAD_WIDTH_ENTRANCE)
	addRoadSegment(root, "Road_Entrance_Apron", -33, 81, -26, 79.5, ROAD_WIDTH_ENTRANCE + 6)

	-- White centre dashes along the main road runs.
	for _, seg in ipairs({
		{ 0, 60, -4.6, -38 },
		{ -6, -48, 49, -53.4 },
		{ 60.5, -75.5, 57.5, -78 },
		{ 57.5, -78, 127.5, -76.5 },
	}) do
		local x1, z1, x2, z2 = seg[1], seg[2], seg[3], seg[4]
		local dx, dz = x2 - x1, z2 - z1
		local len = math.sqrt(dx * dx + dz * dz)
		for i = 0, math.floor(len / 7) do
			local t = (i * 7) / len
			local px, pz = x1 + dx * t, z1 + dz * t
			local ang = math.atan2(dz, dx)
			local dash = newPart({
				Name = "RoadDash",
				Size = Vector3.new(3.4, 0.07, 0.5),
				Material = Enum.Material.SmoothPlastic,
				Color = COL_WHITE,
				CanCollide = false,
			})
			local dir = Vector3.new(math.cos(ang), 0, math.sin(ang))
			dash.CFrame = CFrame.fromMatrix(Vector3.new(px, 0.1, pz), dir, Vector3.new(0, 1, 0))
			dash.Parent = root
		end
	end
end

----------------------------------------------------------------------
-- Football pitch: lines, centre circle, goals (east field)
----------------------------------------------------------------------

local function addPitchLine(root: Folder, center: Vector3, size: Vector3)
	local line = newPart({
		Name = "PitchLine",
		Size = Vector3.new(size.X, 0.06, size.Z),
		Position = center,
		Material = Enum.Material.SmoothPlastic,
		Color = COL_WHITE,
		CanCollide = false,
	})
	line.Parent = root
end

local function addGoal(root: Folder, x: number, zCenter: number)
	for _, dz in ipairs({ -5.5, 5.5 }) do
		local post = newPart({
			Name = "GoalPost",
			Size = Vector3.new(0.4, 6, 0.4),
			Position = Vector3.new(x, 3, zCenter + dz),
			Material = Enum.Material.Metal,
			Color = COL_WHITE,
		})
		post.Parent = root
	end
	local bar = newPart({
		Name = "GoalCrossbar",
		Size = Vector3.new(0.4, 0.4, 11.4),
		Position = Vector3.new(x, 6, zCenter),
		Material = Enum.Material.Metal,
		Color = COL_WHITE,
	})
	bar.Parent = root
end

local function addPitchCircle(root: Folder, cx: number, cy: number, cz: number, radius: number, segments: number, sizeScale: number)
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local px = cx + math.cos(angle) * radius
		local pz = cz + math.sin(angle) * radius
		local seg = newPart({
			Name = "CircleSeg",
			Size = Vector3.new(sizeScale, 0.06, sizeScale * 0.45),
			CFrame = CFrame.new(px, cy, pz) * CFrame.Angles(0, -angle, 0),
			Material = Enum.Material.SmoothPlastic,
			Color = COL_WHITE,
			CanCollide = false,
		})
		seg.Parent = root
	end
end

-- Artificial turf pitch; long axis runs east-west, matching aerial.
local PITCH_X0, PITCH_X1 = 12, 74.4
local PITCH_Z0, PITCH_Z1 = -38.4, 0

local function buildPitch(root: Folder)
	local y = 0.14
	local cx = (PITCH_X0 + PITCH_X1) / 2
	local cy = (PITCH_Z0 + PITCH_Z1) / 2
	local w = PITCH_X1 - PITCH_X0
	local d = PITCH_Z1 - PITCH_Z0
	local turf = newPart({
		Name = "PitchTurf",
		Size = Vector3.new(w, 0.25, d),
		Position = Vector3.new(cx, 0.1, cy),
		Material = Enum.Material.Grass,
		Color = COL_TURF,
	})
	turf.Parent = root
	addPitchLine(root, Vector3.new(cx, y, PITCH_Z0), Vector3.new(w, 0, 0.7))
	addPitchLine(root, Vector3.new(cx, y, PITCH_Z1), Vector3.new(w, 0, 0.7))
	addPitchLine(root, Vector3.new(PITCH_X0, y, cy), Vector3.new(0.7, 0, d))
	addPitchLine(root, Vector3.new(PITCH_X1, y, cy), Vector3.new(0.7, 0, d))
	addPitchLine(root, Vector3.new(cx, y, cy), Vector3.new(0.7, 0, d))
	addPitchCircle(root, cx, y, cy, 6.5, 16, 2.2)
	local dot = newPart({
		Name = "PitchCenterDot",
		Size = Vector3.new(1.4, 0.06, 1.4),
		Position = Vector3.new(cx, y, cy),
		Material = Enum.Material.SmoothPlastic,
		Color = COL_WHITE,
		CanCollide = false,
	})
	dot.Parent = root
	addGoal(root, PITCH_X0 + 1.4, cy)
	addGoal(root, PITCH_X1 - 1.4, cy)
end

----------------------------------------------------------------------
-- Basketball court on the north lawn (basketplan)
----------------------------------------------------------------------

local COURT_X0, COURT_X1 = -48, -19
local COURT_Z0, COURT_Z1 = 67, 90

local function buildCourt(root: Folder)
	local cx = (COURT_X0 + COURT_X1) / 2
	local cy = (COURT_Z0 + COURT_Z1) / 2
	local w = COURT_X1 - COURT_X0
	local d = COURT_Z1 - COURT_Z0
	local slab = addSlab(root, "BasketCourt", cx, cy, w, d, 0.09, Enum.Material.Concrete, Color3.fromRGB(58, 62, 74))

	local y = 0.22
	addPitchLine(root, Vector3.new(cx, y, COURT_Z0), Vector3.new(w, 0, 0.7))
	addPitchLine(root, Vector3.new(cx, y, COURT_Z1), Vector3.new(w, 0, 0.7))
	addPitchLine(root, Vector3.new(COURT_X0, y, cy), Vector3.new(0.7, 0, d))
	addPitchLine(root, Vector3.new(COURT_X1, y, cy), Vector3.new(0.7, 0, d))
	addPitchLine(root, Vector3.new(cx, y, cy), Vector3.new(0.7, 0, d))
	addPitchCircle(root, cx, y, cy, 4.5, 12, 2)

	for _, hx in ipairs({ COURT_X0 - 2, COURT_X1 + 2 }) do
		local post = newPart({
			Name = "HoopPost",
			Size = Vector3.new(0.4, 7, 0.4),
			Position = Vector3.new(hx, 3.6, cy),
			Material = Enum.Material.Metal,
			Color = COL_METAL_DARK,
		})
		post.Parent = root
		local board = newPart({
			Name = "HoopBoard",
			Size = Vector3.new(0.3, 3, 4.2),
			Position = Vector3.new(hx + (if hx < cx then -0.6 else 0.6), 6.4, cy),
			Material = Enum.Material.SmoothPlastic,
			Color = COL_WHITE,
			CanCollide = false,
		})
		board.Parent = root
		local ring = newPart({
			Name = "HoopRing",
			Size = Vector3.new(1.4, 0.14, 1.4),
			Position = Vector3.new(hx + (if hx < cx then -1.4 else 1.4), 5.2, cy),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(240, 110, 40),
			Shape = Enum.PartType.Cylinder,
			CanCollide = false,
		})
		ring.Parent = root
	end
	return slab
end

----------------------------------------------------------------------
-- Parking forecourt south of the school (Uthamra skolväg side)
----------------------------------------------------------------------

local function buildParking(root: Folder, rand: Random)
	-- Paved arrival forecourt in front of the south wing.
	addSlab(root, "ParkingApron", -5, -94, 50, 20, 0.04, Enum.Material.Asphalt, COL_ASPHALT)
	-- Paved walk strip through the hall-forecourt gate (boundary 1 door).
	addSlab(root, "HallWalk", 48.5, -66, 6, 28, 0.03, Enum.Material.Concrete, Color3.fromRGB(150, 150, 156))

	for _, rowZ in ipairs({ -88.5, -99.5 }) do
		for i = 0, 5 do
			local x = -28 + i * 9.5
			local line = newPart({
				Name = "StallLine",
				Size = Vector3.new(0.3, 0.05, 6),
				Position = Vector3.new(x, 0.16, rowZ),
				Material = Enum.Material.SmoothPlastic,
				Color = COL_WHITE,
				CanCollide = false,
			})
			line.Parent = root
		end
	end

	local palette = {
		Color3.fromRGB(226, 228, 232),
		Color3.fromRGB(40, 44, 52),
		Color3.fromRGB(150, 40, 44),
		Color3.fromRGB(50, 84, 140),
		Color3.fromRGB(196, 160, 60),
	}
	local carCells = {
		{ -24, -88.5 }, { -5, -88.5 }, { 14, -88.5 },
		{ -24, -99.5 }, { 5, -99.5 }, { 18, -99.5 },
	}
	for _, cell in ipairs(carCells) do
		local color = palette[rand:Int(1, #palette)]
		local body = newPart({
			Name = "Car",
			Size = Vector3.new(4.2, 2.6, 8.6),
			Position = Vector3.new(cell[1], 1.6, cell[2]),
			Material = Enum.Material.SmoothPlastic,
			Color = color,
		})
		body.Parent = root
		local cabin = newPart({
			Name = "CarCabin",
			Size = Vector3.new(3.6, 1.5, 4.2),
			Position = Vector3.new(cell[1], 3.6, cell[2] + 0.4),
			Material = Enum.Material.Glass,
			Color = Color3.fromRGB(28, 38, 48),
		})
		cabin.Parent = root
	end
end

----------------------------------------------------------------------
-- Yard props: benches, planters, picnic tables, bins, propane tanks
----------------------------------------------------------------------

local function addBench(root: Folder, x: number, z: number, yawDeg: number)
	local base = CFrame.new(x, 0.12, z) * CFrame.Angles(0, math.rad(yawDeg), 0)
	for _, off in ipairs({ Vector3.new(-1.8, 0.95, 0), Vector3.new(1.8, 0.95, 0) }) do
		local leg = newPart({
			Name = "BenchLeg",
			Size = Vector3.new(0.4, 1.1, 1.4),
			CFrame = base * CFrame.new(off),
			Material = Enum.Material.Metal,
			Color = COL_METAL,
		})
		leg.Parent = root
	end
	local seat = newPart({
		Name = "BenchSeat",
		Size = Vector3.new(5, 0.4, 1.8),
		CFrame = base * CFrame.new(0, 1.65, 0),
		Material = Enum.Material.WoodPlanks,
		Color = COL_WOOD,
	})
	seat.Parent = root
	local back = newPart({
		Name = "BenchBack",
		Size = Vector3.new(5, 1.3, 0.35),
		CFrame = base * CFrame.new(0, 2.6, -0.95),
		Material = Enum.Material.WoodPlanks,
		Color = COL_WOOD,
		CanCollide = false,
	})
	back.Parent = root
end

local function addPlanter(root: Folder, x: number, z: number)
	local box = newPart({
		Name = "Planter",
		Size = Vector3.new(4.5, 1.8, 4.5),
		Position = Vector3.new(x, 0.9, z),
		Material = Enum.Material.Concrete,
		Color = Color3.fromRGB(118, 118, 124),
	})
	box.Parent = root
	local bush = newPart({
		Name = "PlanterBush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3.4, 3.4, 3.4),
		Position = Vector3.new(x, 2.9, z),
		Material = Enum.Material.Grass,
		Color = Color3.fromRGB(58, 104, 52),
		CanCollide = false,
	})
	bush.Parent = root
end

local function addPicnicTable(root: Folder, x: number, z: number)
	local top = newPart({
		Name = "TableTop",
		Size = Vector3.new(2.6, 0.3, 7),
		Position = Vector3.new(x, 1.9, z),
		Material = Enum.Material.WoodPlanks,
		Color = COL_WOOD,
	})
	top.Parent = root
	for _, dz in ipairs({ -1.6, 1.6 }) do
		local benchPart = newPart({
			Name = "TableBench",
			Size = Vector3.new(0.7, 0.25, 7),
			Position = Vector3.new(x + dz, 1.5, z),
			Material = Enum.Material.WoodPlanks,
			Color = COL_WOOD,
		})
		benchPart.Parent = root
	end
	for _, off in ipairs({
		Vector3.new(-0.9, 0, -2.6), Vector3.new(0.9, 0, -2.6),
		Vector3.new(-0.9, 0, 2.6), Vector3.new(0.9, 0, 2.6),
	}) do
		local leg = newPart({
			Name = "TableLeg",
			Size = Vector3.new(0.25, 1.8, 0.25),
			Position = Vector3.new(x + off.X, 0.9, z + off.Z),
			Material = Enum.Material.Metal,
			Color = COL_METAL,
		})
		leg.Parent = root
	end
end

-- Propane/heat tanks keep the explosive-barrel gameplay, reskinned for the
-- school's service corners.
local function addPropaneTank(root: Folder, x: number, z: number)
	local tank = newPart({
		Name = "PropaneTank",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(4.4, 3, 3),
		Position = Vector3.new(x, 2.3, z),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(178, 62, 48),
	})
	tank:SetAttribute("Explosive", true)
	tank:SetAttribute("ExplosionRadius", 14)
	tank:SetAttribute("ExplosionDamage", 90)
	tank.Parent = root
end

local function addDumpster(root: Folder, x: number, z: number)
	local bin = newPart({
		Name = "Dumpster",
		Size = Vector3.new(6, 4, 3.4),
		Position = Vector3.new(x, 2.4, z),
		Material = Enum.Material.Metal,
		Color = Color3.fromRGB(40, 96, 62),
	})
	bin.Parent = root
end

local function buildYardProps(root: Folder)
	-- Benches along the cafeteria's east face, facing the quadrangle.
	for _, z in ipairs({ -33, -25.5, -18 }) do
		addBench(root, -85, z, 0)
	end
	-- Benches along the west bar south shoulder facing the quadrangle.
	for _, x in ipairs({ -92, -80 }) do
		addBench(root, x, -18, 180)
	end
	-- Two benches on the south lawn facing the pitch sidelines.
	addBench(root, 18, -62, 0)
	addBench(root, 34, -62, 0)

	-- Planters edging paths and the yard.
	for _, p in ipairs({
		{ 38, -47 }, { 26, -47 }, { -30, -22 }, { -70, -18 },
		{ -60, 30 }, { 55, -30 }, { -72, 62 }, { 25, 45 },
	}) do
		addPlanter(root, p[1], p[2])
	end

	-- Picnic tables west of the cafeteria (photo's courtyard seating).
	for _, z in ipairs({ -38, -33, -28 }) do
		addPicnicTable(root, -116, z)
	end

	-- Waste bins flanking the sports hall's east wall.
	addDumpster(root, 122, -55)
	addDumpster(root, 122, -63)

	-- Propane tanks at service points: hall flank, south tail corner,
	-- and a couple scattered through the yard.
	local tanks = {
		{ 66, -66 }, { 66, -58 },
		{ 30, -84 }, { 40, -70 },
		{ -60, -35 }, { -55, -30 },
		{ -118, -45 }, { 20, 30 },
	}
	for _, t in ipairs(tanks) do
		addPropaneTank(root, t[1], t[2])
	end
end

