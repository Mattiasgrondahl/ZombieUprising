          <string name="Source"><![CDATA[--!strict
-- Central tuning for Zombie Uprising. Every other system reads from here
-- so balance changes never require touching gameplay code.

local Config = {}

Config.GameName = "Zombie Uprising"
Config.Version = "2.2.0"

----------------------------------------------------------------------
-- Audio
--
-- Roblox cannot synthesize waveforms from Luau, so music and SFX come from
-- catalogue asset ids. Every id is Roblox-owned and long-lived. If any fails
-- to load the Music/Audio system degrades silently rather than erroring.
----------------------------------------------------------------------
Config.Audio = {
	Enabled = true,
	MusicVolume = 0.35,
	SFXVolume = 0.6,

	-- Ambient drone looped from the moment the server boots.
	AmbientMusicId = "rbxassetid://1843941676",  -- dark ambient drone
	AmbientVolume = 0.22,

	-- Combat music crossfades in when a wave goes active; tempo/pitch rises
	-- with wave number so late waves feel more frantic.
	WaveMusicId = "rbxassetid://9044416607",     -- tense combat loop
	WaveMusicVolume = 0.30,
	WavePitchBase = 1.0,
	WavePitchPerWave = 0.01,
	WavePitchMax = 1.35,

	-- Boss waves get their own heavier cue.
	BossMusicId = "rbxassetid://9125402737",
	BossMusicVolume = 0.42,

	MusicFadeTime = 1.8,
}

----------------------------------------------------------------------
-- Wave / match flow
----------------------------------------------------------------------
Config.Wave = {
	IntermissionTime = 20,      -- seconds of shop phase between waves
	FirstWaveDelay = 8,
	MaxConcurrentZombies = 60,  -- hard ceiling for perf safety
	-- Faster batches: a swarm should pour in, not trickle one every 0.75s.
	SpawnBatchInterval = 0.28,
	BossEveryNWaves = 5,
	-- Special wave types to break mid-game monotony.
	-- RunnerWave: all-fast. SwarmWave: many weak. BruteWave: few tanky.
	SpecialWaveEvery = 4,
	-- Extraction: survive to this wave to win the run with a bonus.
	ExtractionWave = 25,
	ExtractionBonus = 2500,
	RunnerSpeedMult = 1.35,
	SwarmCountMult = 1.6,
	SwarmHealthMult = 0.6,
	BruteCountMult = 0.5,
	BruteHealthMult = 1.8,
	-- Extra zombies per additional player (sub-linear).
	MultiplayerCountScale = 0.65,
	BaseZombieCount = 8,
	CountGrowthPerWave = 3.8,
	-- Flattened from 1.18: geometric HP growth outran weapon damage so hard
	-- that waves became mathematically unwinnable around wave 20. Many weak
	-- zombies is the zombie-rouguelike feel; few tanky ones is a slog.
	HPScalePerWave = 1.085,
	SpeedScalePerWave = 1.015,
	MaxSpeedScale = 1.55,
	DamageScalePerWave = 1.05,
}

----------------------------------------------------------------------
-- Player
----------------------------------------------------------------------
Config.Player = {
	BaseMaxHealth = 125,
	BaseWalkSpeed = 16,
	SprintSpeed = 24,
	RespawnDelay = 5,
	-- Not zero: players must be able to afford the first door / perk without
	-- a lucky early wave, otherwise a bad round one can stall the whole run.
	StartingCoins = 150,
	InvulnerabilityAfterSpawn = 3.0,
	-- Health at/below which a player is knocked down instead of killed.
	DownedThreshold = 1,
	-- Brief mercy window after being revived.
	ReviveInvulnerability = 2.5,
}

----------------------------------------------------------------------
-- Economy
----------------------------------------------------------------------
Config.Economy = {
	CoinPerKill = 10,
	CoinPerHeadshot = 20,
	CoinPerWaveClear = 75,
	CoinWaveMultiplier = 1.0,
	XPPerKill = 10,
	XPPerWaveClear = 75,
	XPLevelCurveBase = 100,
	XPLevelCurveGrowth = 1.35,
	-- Perk cost multiplier applied per stack already owned.
	PerkCostGrowth = 1.45,
}

----------------------------------------------------------------------
-- Zombie archetypes
----------------------------------------------------------------------
export type ZombieArchetype = {
	Id: string,
	DisplayName: string,
	Health: number,
	WalkSpeed: number,
	Damage: number,
	AttackRange: number,
	AttackCooldown: number,
	CoinReward: number,
	XPReward: number,
	Scale: number,
	BodyColor: Color3,
	UnlockWave: number,
	Weight: number,    -- spawn weighting once unlocked
	IsBoss: boolean?,
}

local Zombies: { [string]: ZombieArchetype } = {
	Walker = {
		Id = "Walker",
		DisplayName = "Walker",
		Health = 60,
		-- Walkers must be faster than the player's WALK speed (16) or there is
		-- no pressure to shoot: you could stroll away forever. They stay slower
		-- than SPRINT (24) so escaping is possible but costs stamina/distance.
		WalkSpeed = 18,
		Damage = 12,
		AttackRange = 4.5,
		AttackCooldown = 1.2,
		CoinReward = 8,
		XPReward = 10,
		Scale = 1.0,
		BodyColor = Color3.fromRGB(96, 128, 72),
		UnlockWave = 1,
		Weight = 100,
	},
	Runner = {
		Id = "Runner",
		DisplayName = "Runner",
		Health = 40,
		-- Faster than the player's sprint: runners WILL catch you.
		WalkSpeed = 27,
		Damage = 9,
		AttackRange = 4.0,
		AttackCooldown = 0.8,
		CoinReward = 12,
		XPReward = 14,
		Scale = 0.95,
		BodyColor = Color3.fromRGB(158, 92, 60),
		UnlockWave = 3,
		Weight = 55,
	},
	Brute = {
		Id = "Brute",
		DisplayName = "Brute",
		Health = 320,
		WalkSpeed = 6.5,
		Damage = 34,
		AttackRange = 6.0,
		AttackCooldown = 2.0,
		CoinReward = 40,
		XPReward = 45,
		Scale = 1.45,
		BodyColor = Color3.fromRGB(110, 70, 70),
		UnlockWave = 6,
		Weight = 22,
	},
	Spitter = {
		Id = "Spitter",
		DisplayName = "Spitter",
		Health = 70,
		WalkSpeed = 9,
		Damage = 16,
		AttackRange = 45,
		AttackCooldown = 2.6,
		CoinReward = 22,
		XPReward = 24,
		Scale = 1.05,
		BodyColor = Color3.fromRGB(120, 150, 60),
		UnlockWave = 8,
		Weight = 30,
	},
	Boss = {
		Id = "Boss",
		DisplayName = "Abomination",
		Health = 2600,
		WalkSpeed = 7.5,
		Damage = 55,
		AttackRange = 7.0,
		AttackCooldown = 1.6,
		CoinReward = 350,
		XPReward = 400,
		Scale = 2.2,
		BodyColor = Color3.fromRGB(140, 40, 55),
		UnlockWave = 5,
		Weight = 0,   -- bosses are scheduled explicitly, never rolled by weight
		IsBoss = true,
	},
}

Config.Zombies = Zombies

----------------------------------------------------------------------
